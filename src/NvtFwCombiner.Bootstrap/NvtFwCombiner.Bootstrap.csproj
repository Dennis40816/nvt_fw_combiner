<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="NvtFwCombiner.Bootstrap.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NvtFwCombiner.Application\NvtFwCombiner.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.Infrastructure\NvtFwCombiner.Infrastructure.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.Profiles\NvtFwCombiner.Profiles.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <BuiltInProfileSourceRoot>$(MSBuildProjectDirectory)\..\..\profiles\built-in</BuiltInProfileSourceRoot>
    <ProfileContractRoot>$(MSBuildProjectDirectory)\..\..\docs\contracts</ProfileContractRoot>
    <BuiltInProfileMaterializedRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\materialized-profiles\built-in</BuiltInProfileMaterializedRoot>
    <BuiltInProfilePublishedRoot>$(OutDir)profiles\built-in</BuiltInProfilePublishedRoot>
    <DefaultCompositionProfileSchemaFile>composition-profile-v2.schema.json</DefaultCompositionProfileSchemaFile>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <BuiltInProfileBundle>
      <CompositionProfileSchemaFile>$(DefaultCompositionProfileSchemaFile)</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuiltInProfileBundle Include="nt51920-standard-merge" />
    <BuiltInProfileBundle Include="nt51920-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51917-nt51927-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51919-nt51929-nt51932-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51923-nt51926-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51928-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51930-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51931-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51950-nt51951-general-merge-logical-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.5.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51926-ctrlram-replace-candidate">
      <CompositionProfileSchemaFile>composition-profile-v2.7.schema.json</CompositionProfileSchemaFile>
    </BuiltInProfileBundle>
    <BuiltInProfileBundle Include="nt51923-standard-merge" />
    <BuiltInProfileBundle Include="nt51927-standard-merge" />
    <BuiltInProfileBundle Include="nt51928-standard-merge" />
    <BuiltInProfileBundle Include="nt51929-standard-merge" />
    <BuiltInProfileBundle Include="nt51919-nt51929-nt51932-ab-merge" />
    <BuiltInProfileBundle Include="nt51930-standard-merge" />
    <BuiltInProfileBundle Include="nt51931-standard-merge" />
    <BuiltInProfileBundle Include="nt51950-nt51951-standard-merge" />
  </ItemGroup>
  <Target Name="MaterializeBuiltInProfileBundles" BeforeTargets="AssignTargetPaths">
    <RemoveDir Directories="$(BuiltInProfileMaterializedRoot);$(BuiltInProfilePublishedRoot)" />
    <ItemGroup>
      <_BuiltInProfileSource Include="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\**\*"
        Exclude="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\schemas\**\*">
        <BundleDirectory>%(BuiltInProfileBundle.Identity)</BundleDirectory>
      </_BuiltInProfileSource>
      <_BuiltInProfileFamilySchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\firmware-family-v1.schema.json</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\firmware-family-v1.schema.json</DestinationFile>
      </_BuiltInProfileFamilySchema>
      <_BuiltInProfileCompositionSchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\%(BuiltInProfileBundle.CompositionProfileSchemaFile)</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\composition-profile-v2.schema.json</DestinationFile>
      </_BuiltInProfileCompositionSchema>
    </ItemGroup>
    <Copy
      SourceFiles="@(_BuiltInProfileSource)"
      DestinationFiles="@(_BuiltInProfileSource->'$(BuiltInProfileMaterializedRoot)\%(BundleDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileFamilySchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileFamilySchema->'%(DestinationFile)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileCompositionSchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileCompositionSchema->'%(DestinationFile)')" />
    <ItemGroup>
      <_BuiltInProfileMaterializedFiles Include="$(BuiltInProfileMaterializedRoot)\**\*" />
      <Content Include="@(_BuiltInProfileMaterializedFiles)">
        <Link>profiles\built-in\%(_BuiltInProfileMaterializedFiles.RecursiveDir)%(_BuiltInProfileMaterializedFiles.Filename)%(_BuiltInProfileMaterializedFiles.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
