<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="NvtFwCombiner.Bootstrap.Tests" />
    <InternalsVisibleTo Include="NvtFwCombiner.GoldenRegression.Tests" />
    <InternalsVisibleTo Include="NvtFwCombiner.UiSmoke.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NvtFwCombiner.Application\NvtFwCombiner.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.Infrastructure\NvtFwCombiner.Infrastructure.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.VersionManagement.Application\NvtFwCombiner.VersionManagement.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.VersionManagement.Infrastructure\NvtFwCombiner.VersionManagement.Infrastructure.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <BuiltInProfileSourceRoot>$(MSBuildProjectDirectory)\..\..\profiles\built-in</BuiltInProfileSourceRoot>
    <ProfileContractRoot>$(MSBuildProjectDirectory)\..\..\docs\contracts</ProfileContractRoot>
    <BuiltInProfileTrustIndex>$(BuiltInProfileSourceRoot)\package-trust-index.json</BuiltInProfileTrustIndex>
    <BuiltInProfileMaterializedRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\materialized-profiles\built-in</BuiltInProfileMaterializedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content
      Include="$(BuiltInProfileTrustIndex)"
      Link="profiles\built-in\package-trust-index.json"
      CopyToOutputDirectory="Always"
      CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Import Project="..\..\eng\profile-bundle-materializer\NvtFwCombiner.ProfileBundleMaterializer.targets" />
</Project>
