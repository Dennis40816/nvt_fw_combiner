  <Target Name="MaterializeBuiltInProfileBundles" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_BuiltInProfilePublishedRoot>$(OutDir)profiles\built-in</_BuiltInProfilePublishedRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(BuiltInProfileMaterializedRoot);$(_BuiltInProfilePublishedRoot)" />
    <ItemGroup>
      <_BuiltInProfileSource Include="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\**\*"
        Exclude="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\schemas\**\*">
        <BundleDirectory>%(BuiltInProfileBundle.Identity)</BundleDirectory>
      </_BuiltInProfileSource>
      <_BuiltInProfileFamilySchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\%(BuiltInProfileBundle.FirmwareFamilySchemaFile)</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\firmware-family-v1.schema.json</DestinationFile>
      </_BuiltInProfileFamilySchema>
      <_BuiltInProfileCompositionSchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\%(BuiltInProfileBundle.CompositionProfileSchemaFile)</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\composition-profile-v2.schema.json</DestinationFile>
      </_BuiltInProfileCompositionSchema>
      <_BuiltInProfileCanonicalFamily Include="@(BuiltInProfileBundle)"
        Condition="'%(BuiltInProfileBundle.CanonicalFirmwareFamilySource)' != '' Or '%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)' != ''">
        <SourceFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.CanonicalFirmwareFamilySource)'))</SourceFile>
        <SourceRoot>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\'))</SourceRoot>
        <BundleSourceFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)'))</BundleSourceFile>
        <DestinationFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileMaterializedRoot)\%(BuiltInProfileBundle.Identity)\%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)'))</DestinationFile>
        <DestinationRoot>$([System.IO.Path]::GetFullPath('$(BuiltInProfileMaterializedRoot)\%(BuiltInProfileBundle.Identity)\families\'))</DestinationRoot>
      </_BuiltInProfileCanonicalFamily>
    </ItemGroup>
    <Error
      Condition="'%(_BuiltInProfileCanonicalFamily.CanonicalFirmwareFamilySource)' == '' Or '%(_BuiltInProfileCanonicalFamily.CanonicalFirmwareFamilyDestination)' == ''"
      Text="Built-in profile canonical firmware-family metadata must declare both source and destination for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="$([System.String]::Copy(%(_BuiltInProfileCanonicalFamily.SourceFile)).StartsWith(%(_BuiltInProfileCanonicalFamily.SourceRoot), System.StringComparison.OrdinalIgnoreCase)) != 'True'"
      Text="Built-in profile canonical firmware-family source escapes the approved source root for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="$([System.String]::Copy(%(_BuiltInProfileCanonicalFamily.DestinationFile)).StartsWith(%(_BuiltInProfileCanonicalFamily.DestinationRoot), System.StringComparison.OrdinalIgnoreCase)) != 'True'"
      Text="Built-in profile canonical firmware-family destination escapes the bundle families root for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="!Exists('%(_BuiltInProfileCanonicalFamily.SourceFile)')"
      Text="Built-in profile canonical firmware-family source is missing for '%(_BuiltInProfileCanonicalFamily.Identity)': %(_BuiltInProfileCanonicalFamily.SourceFile)" />
    <Error
      Condition="Exists('%(_BuiltInProfileCanonicalFamily.BundleSourceFile)')"
      Text="Built-in profile canonical firmware-family destination collides with a checked-in bundle file for '%(_BuiltInProfileCanonicalFamily.Identity)': %(_BuiltInProfileCanonicalFamily.BundleSourceFile)" />
    <Copy
      SourceFiles="@(_BuiltInProfileSource)"
      DestinationFiles="@(_BuiltInProfileSource->'$(BuiltInProfileMaterializedRoot)\%(BundleDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileFamilySchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileFamilySchema->'%(DestinationFile)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileCompositionSchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileCompositionSchema->'%(DestinationFile)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileCanonicalFamily->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileCanonicalFamily->'%(DestinationFile)')" />
    <ItemGroup>
      <_BuiltInProfileMaterializedFiles Include="$(BuiltInProfileMaterializedRoot)\**\*" />
      <Content Include="@(_BuiltInProfileMaterializedFiles)">
        <Link>profiles\built-in\%(_BuiltInProfileMaterializedFiles.RecursiveDir)%(_BuiltInProfileMaterializedFiles.Filename)%(_BuiltInProfileMaterializedFiles.Extension)</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
