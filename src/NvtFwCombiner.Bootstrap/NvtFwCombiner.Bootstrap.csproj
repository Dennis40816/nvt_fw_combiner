<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="NvtFwCombiner.Bootstrap.Tests" />
    <InternalsVisibleTo Include="NvtFwCombiner.GoldenRegression.Tests" />
    <InternalsVisibleTo Include="NvtFwCombiner.UiSmoke.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NvtFwCombiner.Application\NvtFwCombiner.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.Infrastructure\NvtFwCombiner.Infrastructure.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.VersionManagement.Application\NvtFwCombiner.VersionManagement.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.VersionManagement.Infrastructure\NvtFwCombiner.VersionManagement.Infrastructure.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <BuiltInProfileSourceRoot>$(MSBuildProjectDirectory)\..\..\profiles\built-in</BuiltInProfileSourceRoot>
    <ProfileContractRoot>$(MSBuildProjectDirectory)\..\..\docs\contracts</ProfileContractRoot>
    <BuiltInProfileTrustIndex>$(BuiltInProfileSourceRoot)\package-trust-index.json</BuiltInProfileTrustIndex>
    <BuiltInProfileMaterializedRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\materialized-profiles\built-in</BuiltInProfileMaterializedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content
      Include="$(BuiltInProfileTrustIndex)"
      Link="profiles\built-in\package-trust-index.json"
      CopyToOutputDirectory="Always"
      CopyToPublishDirectory="Always" />
  </ItemGroup>

  <UsingTask
    TaskName="LoadProfileBundleTrustIndex"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TrustIndexPath ParameterType="System.String" Required="true" />
      <TrustIndexSchemaPath ParameterType="System.String" Required="true" />
      <BuiltInProfileSourceRoot ParameterType="System.String" Required="true" />
      <ProfileContractRoot ParameterType="System.String" Required="true" />
      <Bundles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(MSBuildToolsPath)\Sdks\Microsoft.NET.Sdk\tools\net472\Newtonsoft.Json.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Newtonsoft.Json" />
      <Using Namespace="Newtonsoft.Json.Linq" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, int, byte[]> readBoundedFile =
            (path, maximumBytes) =>
            {
                using (var stream = new FileStream(
                    path,
                    FileMode.Open,
                    FileAccess.Read,
                    FileShare.Read,
                    4096,
                    FileOptions.SequentialScan))
                {
                    long length = stream.Length;
                    if (length > maximumBytes)
                    {
                        throw new InvalidDataException(
                            path + " exceeds its " + maximumBytes + "-byte materialization bound.");
                    }
                    var bytes = new byte[checked((int)length)];
                    int total = 0;
                    while (total < bytes.Length)
                    {
                        int read = stream.Read(bytes, total, bytes.Length - total);
                        if (read == 0)
                        {
                            throw new EndOfStreamException(path + " changed while it was being read.");
                        }
                        total += read;
                    }
                    if (stream.ReadByte() != -1)
                    {
                        throw new IOException(path + " changed while it was being read.");
                    }
                    return bytes;
                }
            };
        Func<byte[], string> sha256Hex = bytes =>
        {
            using (var sha256 = SHA256.Create())
            {
                return BitConverter.ToString(sha256.ComputeHash(bytes))
                    .Replace("-", string.Empty)
                    .ToLowerInvariant();
            }
        };

        var loadSettings = new JsonLoadSettings
        {
            DuplicatePropertyNameHandling = DuplicatePropertyNameHandling.Error,
        };
        byte[] trustIndexBytes = readBoundedFile(TrustIndexPath, 131072);
        JObject root;
        using (var memory = new MemoryStream(trustIndexBytes, writable: false))
        using (var textReader = new StreamReader(
            memory,
            new UTF8Encoding(false, true),
            detectEncodingFromByteOrderMarks: false,
            bufferSize: 1024))
        using (var reader = new JsonTextReader(textReader) { MaxDepth = 16 })
        {
            root = JObject.Load(reader, loadSettings);
            if (reader.Read())
            {
                throw new InvalidDataException(
                    "Profile bundle package trust index contains trailing JSON content.");
            }
        }
        const string expectedSchemaSha256 =
            "5cbcb27e312ef1ac2d047990043f356966153bf5d9393527b98d5abd982aeb7e";
        string actualSchemaSha256 = sha256Hex(readBoundedFile(TrustIndexSchemaPath, 131072));
        if (!string.Equals(actualSchemaSha256, expectedSchemaSha256, StringComparison.Ordinal))
        {
            throw new InvalidDataException(
                "Profile bundle package trust-index validator is not bound to the normative schema bytes.");
        }
        const string expectedProfileBundleSchemaSha256 =
            "7aa5e063c0c7f8f059e1032f6719f3cd5be778217f75e6e843f29e04dd6ae47e";
        string profileBundleSchemaPath = Path.Combine(
            ProfileContractRoot,
            "profile-bundle-v1.schema.json");
        if (sha256Hex(readBoundedFile(profileBundleSchemaPath, 131072)) !=
            expectedProfileBundleSchemaSha256)
        {
            throw new InvalidDataException(
                "Profile bundle materialization validator is not bound to the normative schema bytes.");
        }

        JObject normativeSchema;
        using (var reader = new JsonTextReader(File.OpenText(TrustIndexSchemaPath)) { MaxDepth = 32 })
        {
            normativeSchema = JObject.Load(reader, loadSettings);
        }
        if (!(normativeSchema["$id"] is JValue schemaIdToken) ||
            schemaIdToken.Type != JTokenType.String ||
            (string)schemaIdToken !=
            "https://novatek.example/nvt-fw-combiner/profile-bundle-package-trust-index-v1.schema.json")
        {
            throw new InvalidDataException("Profile bundle package trust-index normative schema identity is invalid.");
        }

        Action<JObject, string, string[], string[]> requireProperties =
            (value, path, required, optional) =>
            {
                var allowed = new HashSet<string>(required.Concat(optional), StringComparer.Ordinal);
                if (required.Any(name => value.Property(name, StringComparison.Ordinal) == null) ||
                    value.Properties().Any(property => !allowed.Contains(property.Name)))
                {
                    throw new InvalidDataException(path + " does not satisfy the closed package trust-index shape.");
                }
            };
        Func<JObject, string, string, string> readRequiredString =
            (value, name, path) =>
            {
                JProperty property = value.Property(name, StringComparison.Ordinal);
                if (property == null || property.Value.Type != JTokenType.String)
                {
                    throw new InvalidDataException(path + "." + name + " must be a JSON string.");
                }
                return (string)property.Value;
            };
        Func<JObject, string, string, string> readOptionalString =
            (value, name, path) =>
            {
                JProperty property = value.Property(name, StringComparison.Ordinal);
                if (property == null)
                {
                    return null;
                }
                if (property.Value.Type != JTokenType.String)
                {
                    throw new InvalidDataException(path + "." + name + " must be a JSON string.");
                }
                return (string)property.Value;
            };
        Func<string, string, string> resolveUnderRoot =
            (rootPath, relativePath) =>
            {
                string closedRoot = Path.GetFullPath(
                    rootPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) +
                    Path.DirectorySeparatorChar);
                string fullPath = Path.GetFullPath(Path.Combine(
                    closedRoot,
                    relativePath.Replace('/', Path.DirectorySeparatorChar)));
                if (!fullPath.StartsWith(closedRoot, StringComparison.OrdinalIgnoreCase))
                {
                    throw new InvalidDataException(
                        "Materialization source escapes its approved root: " + relativePath);
                }
                return fullPath;
            };
        Func<string, bool> isToken = value =>
            value != null && Regex.IsMatch(value, "^[a-z0-9]+(?:-[a-z0-9]+)*$", RegexOptions.CultureInvariant);
        Func<string, bool> isFileName = value =>
            value != null && Regex.IsMatch(value, "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$", RegexOptions.CultureInvariant);
        Func<string, bool> isRelativeJsonPath = value =>
            value != null &&
            Regex.IsMatch(
                value,
                "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$",
                RegexOptions.CultureInvariant) &&
            !Path.IsPathRooted(value) &&
            value.Split('/').All(segment => segment.Length != 0 && segment != "." && segment != "..");
        Func<string, bool> isBundleId = value =>
            value != null && Regex.IsMatch(
                value,
                "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                RegexOptions.CultureInvariant);
        Func<string, bool> isBundleVersion = value =>
            value != null && Regex.IsMatch(
                value,
                "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
                RegexOptions.CultureInvariant);
        Func<string, bool> isManifestEntryPath = value =>
            value != null && Regex.IsMatch(
                value,
                "^(?:schemas|families|profiles|evidence|saved-rules)/(?:[a-z0-9][a-z0-9.-]*/)*[a-z0-9][a-z0-9.-]*\\.json$",
                RegexOptions.CultureInvariant);
        Func<string, bool> isManifestSchemaId = value =>
            value != null && Regex.IsMatch(
                value,
                "^https://example\\.invalid/nfc/schemas/[a-z0-9-]+\\.schema\\.json$",
                RegexOptions.CultureInvariant);

        requireProperties(
            root,
            "trust-index root",
            new[] { "schemaVersion", "trustIndexId", "trustIndexVersion", "trustAnchorBindingId", "bundles" },
            new string[0]);
        string schemaVersion = readRequiredString(root, "schemaVersion", "trust-index root");
        string trustIndexId = readRequiredString(root, "trustIndexId", "trust-index root");
        string trustIndexVersion = readRequiredString(root, "trustIndexVersion", "trust-index root");
        string trustAnchorBindingId = readRequiredString(root, "trustAnchorBindingId", "trust-index root");
        if (schemaVersion != "1.1")
        {
            throw new InvalidDataException("Unsupported profile bundle package trust-index schema.");
        }

        var directories = new HashSet<string>(StringComparer.Ordinal);
        var bundles = new List<ITaskItem>();
        if (!isToken(trustIndexId) ||
            !isToken(trustAnchorBindingId) ||
            string.IsNullOrWhiteSpace(trustIndexVersion) ||
            trustIndexVersion.Length > 128 ||
            !(root["bundles"] is JArray bundleArray) ||
            bundleArray.Count == 0 || bundleArray.Count > 128)
        {
            throw new InvalidDataException("Profile bundle package trust-index root values are invalid.");
        }

        var registrationKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (JObject bundle in bundleArray)
        {
            requireProperties(
                bundle,
                "bundle entry",
                new[] { "bundleDirectory", "bundleSchemaVersion", "bundleVersion", "contentHash", "materialization", "runtimeRegistrations" },
                new[] { "metadataProviderFamilies" });
            string directory = readRequiredString(bundle, "bundleDirectory", "bundle entry");
            string bundleSchemaVersion = readRequiredString(bundle, "bundleSchemaVersion", "bundle entry");
            string bundleVersion = readRequiredString(bundle, "bundleVersion", "bundle entry");
            string contentHash = readRequiredString(bundle, "contentHash", "bundle entry");
            if (!directories.Add(directory) || !isToken(directory) ||
                bundleSchemaVersion != "1.0" ||
                string.IsNullOrWhiteSpace(bundleVersion) ||
                bundleVersion.Length > 128 ||
                !Regex.IsMatch(contentHash, "^[0-9a-f]{64}$"))
            {
                throw new InvalidDataException("Bundle identity must be unique, canonical, and hash closed.");
            }

            if (!(bundle["materialization"] is JObject materialization))
            {
                throw new InvalidDataException("Bundle materialization must be an object.");
            }
            requireProperties(
                materialization,
                "bundle materialization",
                new[] { "compositionProfileSchemaFile", "firmwareFamilySchemaFile" },
                new[] { "canonicalFirmwareFamily" });
            string compositionProfileSchemaFile = readRequiredString(
                materialization,
                "compositionProfileSchemaFile",
                "bundle materialization");
            string firmwareFamilySchemaFile = readRequiredString(
                materialization,
                "firmwareFamilySchemaFile",
                "bundle materialization");
            if (!isFileName(compositionProfileSchemaFile) ||
                !isFileName(firmwareFamilySchemaFile))
            {
                throw new InvalidDataException("Bundle materialization schema files must be closed JSON file names.");
            }
            string canonicalSource = null;
            string canonicalDestination = null;
            JToken canonicalToken = materialization["canonicalFirmwareFamily"];
            if (canonicalToken != null)
            {
                if (!(canonicalToken is JObject canonical))
                {
                    throw new InvalidDataException("Canonical firmware-family materialization must be an object.");
                }
                requireProperties(
                    canonical,
                    "canonical firmware-family materialization",
                    new[] { "source", "destination" },
                    new string[0]);
                canonicalSource = readRequiredString(
                    canonical,
                    "source",
                    "canonical firmware-family materialization");
                canonicalDestination = readRequiredString(
                    canonical,
                    "destination",
                    "canonical firmware-family materialization");
                if (!isRelativeJsonPath(canonicalSource) ||
                    !isRelativeJsonPath(canonicalDestination) ||
                    !canonicalDestination.StartsWith("families/", StringComparison.Ordinal) ||
                    canonicalDestination.Split('/').Length != 2)
                {
                    throw new InvalidDataException("Canonical firmware-family paths must remain inside closed roots.");
                }
            }

            JToken metadataProvidersToken = bundle["metadataProviderFamilies"];
            if (metadataProvidersToken != null)
            {
                if (!(metadataProvidersToken is JArray metadataProviders))
                {
                    throw new InvalidDataException("Metadata provider families must be an array.");
                }
                if (metadataProviders.Count > 32)
                {
                    throw new InvalidDataException("Bundle metadata providers exceed the closed array bound.");
                }
                foreach (JObject provider in metadataProviders)
                {
                    requireProperties(
                        provider,
                        "metadata provider family",
                        new[] { "familyId", "familyVersion" },
                        new string[0]);
                    string providerFamilyId = readRequiredString(
                        provider,
                        "familyId",
                        "metadata provider family");
                    string providerFamilyVersion = readRequiredString(
                        provider,
                        "familyVersion",
                        "metadata provider family");
                    if (!isToken(providerFamilyId) ||
                        !Regex.IsMatch(providerFamilyVersion, "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"))
                    {
                        throw new InvalidDataException("Metadata provider family identity is invalid.");
                    }
                }
            }

            if (!(bundle["runtimeRegistrations"] is JArray registrations) || registrations.Count > 128)
            {
                throw new InvalidDataException("Bundle runtime registrations exceed the closed array bound.");
            }
            foreach (JObject registration in registrations)
            {
                requireProperties(
                    registration,
                    "runtime registration",
                    new[] { "workflowId", "icId", "profileId", "profileVersion" },
                    new[] { "mapVariantSetId", "familyId", "postbuildProcessorId", "postbuildBranch", "reportMetadataMapId" });
                string workflow = readRequiredString(registration, "workflowId", "runtime registration");
                string icId = readRequiredString(registration, "icId", "runtime registration");
                string profileId = readRequiredString(registration, "profileId", "runtime registration");
                string profileVersion = readRequiredString(registration, "profileVersion", "runtime registration");
                string mapVariantSetId = readOptionalString(registration, "mapVariantSetId", "runtime registration");
                string familyId = readOptionalString(registration, "familyId", "runtime registration");
                string processor = readOptionalString(registration, "postbuildProcessorId", "runtime registration");
                string branch = readOptionalString(registration, "postbuildBranch", "runtime registration");
                string reportMetadataMapId = readOptionalString(
                    registration,
                    "reportMetadataMapId",
                    "runtime registration");
                bool mapSetAllowed = workflow == "standard-merge" || workflow == "dp-replace";
                bool generalMerge = workflow == "general-merge";
                bool ctrlRam = workflow == "ctrlram-replace";
                string registrationKey = string.Join(
                    "\n",
                    workflow,
                    icId,
                    processor ?? string.Empty,
                    branch ?? string.Empty);
                if (!(new[] { "standard-merge", "ab-merge", "dp-replace", "general-merge", "general-replace", "ctrlram-replace" }).Contains(workflow) ||
                    !Regex.IsMatch(icId, "^NT[0-9]{5}$") ||
                    !isToken(profileId) ||
                    !Regex.IsMatch(profileVersion, "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$") ||
                    (mapVariantSetId != null && (!mapSetAllowed || !isToken(mapVariantSetId))) ||
                    ((familyId != null) != generalMerge) ||
                    (generalMerge && !isToken(familyId)) ||
                    ((processor != null) != ctrlRam) ||
                    (ctrlRam && !Regex.IsMatch(processor ?? string.Empty, "^[a-z0-9]+(?:[.-][a-z0-9]+)*$")) ||
                    ((branch != null) != ctrlRam) ||
                    (ctrlRam && !(new[] { "single-chip", "two-chip", "three-chip", "cascade" }).Contains(branch)) ||
                    (reportMetadataMapId != null &&
                        (!ctrlRam || !isToken(reportMetadataMapId) || reportMetadataMapId.Length > 128)) ||
                    !registrationKeys.Add(registrationKey))
                {
                    throw new InvalidDataException("Runtime registration does not satisfy its closed workflow shape.");
                }
            }

            string manifestPath = resolveUnderRoot(
                BuiltInProfileSourceRoot,
                directory + "/profile-bundle.json");
            byte[] manifestBytes = readBoundedFile(manifestPath, 16384);
            JObject manifest;
            using (var memory = new MemoryStream(manifestBytes, writable: false))
            using (var textReader = new StreamReader(
                memory,
                new UTF8Encoding(false, true),
                detectEncodingFromByteOrderMarks: false,
                bufferSize: 1024))
            using (var jsonReader = new JsonTextReader(textReader) { MaxDepth = 16 })
            {
                manifest = JObject.Load(jsonReader, loadSettings);
                if (jsonReader.Read())
                {
                    throw new InvalidDataException(
                        "Bundle manifest contains trailing JSON content.");
                }
            }
            requireProperties(
                manifest,
                "bundle manifest",
                new[] { "schemaVersion", "bundleId", "bundleVersion", "hashAlgorithm", "contentHash", "trustAnchorBindingId", "entries" },
                new string[0]);
            string manifestSchemaVersion = readRequiredString(
                manifest,
                "schemaVersion",
                "bundle manifest");
            string manifestBundleId = readRequiredString(manifest, "bundleId", "bundle manifest");
            string manifestBundleVersion = readRequiredString(
                manifest,
                "bundleVersion",
                "bundle manifest");
            string manifestHashAlgorithm = readRequiredString(
                manifest,
                "hashAlgorithm",
                "bundle manifest");
            string manifestContentHash = readRequiredString(
                manifest,
                "contentHash",
                "bundle manifest");
            string manifestTrustAnchor = readRequiredString(
                manifest,
                "trustAnchorBindingId",
                "bundle manifest");
            if (manifestSchemaVersion != bundleSchemaVersion ||
                !isBundleId(manifestBundleId) ||
                !isBundleVersion(manifestBundleVersion) ||
                manifestBundleVersion != bundleVersion ||
                manifestHashAlgorithm != "sha256-rfc8785-entry-array-v1" ||
                manifestContentHash != contentHash ||
                !isBundleId(manifestTrustAnchor) ||
                manifestTrustAnchor != trustAnchorBindingId ||
                !(manifest["entries"] is JArray manifestEntries) ||
                manifestEntries.Count == 0 ||
                manifestEntries.Count > 16)
            {
                throw new InvalidDataException(
                    "Bundle manifest identity does not match its package trust-index entry.");
            }

            var entryIds = new HashSet<string>(StringComparer.Ordinal);
            var entryPaths = new HashSet<string>(StringComparer.Ordinal);
            var canonicalEntries = new List<JObject>();
            int totalEntryBytes = 0;
            foreach (JToken entryToken in manifestEntries)
            {
                if (!(entryToken is JObject entry))
                {
                    throw new InvalidDataException("Bundle manifest entries must be objects.");
                }
                requireProperties(
                    entry,
                    "bundle manifest entry",
                    new[] { "entryId", "kind", "path", "schemaId", "contentHash" },
                    new string[0]);
                string entryId = readRequiredString(entry, "entryId", "bundle manifest entry");
                string entryKind = readRequiredString(entry, "kind", "bundle manifest entry");
                string entryPath = readRequiredString(entry, "path", "bundle manifest entry");
                string entrySchemaId = readRequiredString(entry, "schemaId", "bundle manifest entry");
                string entryContentHash = readRequiredString(
                    entry,
                    "contentHash",
                    "bundle manifest entry");
                string entryRoot = entryKind == "schema"
                    ? "schemas"
                    : entryKind == "firmware-family"
                    ? "families"
                    : entryKind == "composition-profile"
                    ? "profiles"
                    : null;
                if (!entryIds.Add(entryId) ||
                    !entryPaths.Add(entryPath) ||
                    !isBundleId(entryId) ||
                    entryRoot == null ||
                    !isManifestEntryPath(entryPath) ||
                    !entryPath.StartsWith(entryRoot + "/", StringComparison.Ordinal) ||
                    !isManifestSchemaId(entrySchemaId) ||
                    !Regex.IsMatch(entryContentHash, "^[0-9a-f]{64}$"))
                {
                    throw new InvalidDataException(
                        "Bundle manifest entry identity is not closed and canonical.");
                }

                string entrySourcePath = entryPath == "schemas/composition-profile-v2.schema.json"
                    ? resolveUnderRoot(ProfileContractRoot, compositionProfileSchemaFile)
                    : entryPath == "schemas/firmware-family-v1.schema.json"
                    ? resolveUnderRoot(ProfileContractRoot, firmwareFamilySchemaFile)
                    : canonicalDestination != null && entryPath == canonicalDestination
                    ? resolveUnderRoot(BuiltInProfileSourceRoot, canonicalSource)
                    : resolveUnderRoot(
                        BuiltInProfileSourceRoot,
                        directory + "/" + entryPath);
                byte[] entryBytes = readBoundedFile(entrySourcePath, 131072);
                totalEntryBytes = checked(totalEntryBytes + entryBytes.Length);
                if (totalEntryBytes > 262144 || sha256Hex(entryBytes) != entryContentHash)
                {
                    throw new InvalidDataException(
                        "Bundle materialization source content hash differs: " +
                        directory + "/" + entryPath);
                }
                canonicalEntries.Add(new JObject(
                    new JProperty("contentHash", entryContentHash),
                    new JProperty("entryId", entryId),
                    new JProperty("kind", entryKind),
                    new JProperty("path", entryPath),
                    new JProperty("schemaId", entrySchemaId)));
            }
            JArray canonicalEntryArray = new JArray(canonicalEntries
                .OrderBy(entry => (string)entry["entryId"], StringComparer.Ordinal)
                .ThenBy(entry => (string)entry["kind"], StringComparer.Ordinal)
                .ThenBy(entry => (string)entry["path"], StringComparer.Ordinal)
                .ThenBy(entry => (string)entry["schemaId"], StringComparer.Ordinal)
                .ThenBy(entry => (string)entry["contentHash"], StringComparer.Ordinal));
            string calculatedContentHash = sha256Hex(
                Encoding.UTF8.GetBytes(canonicalEntryArray.ToString(Formatting.None)));
            if (calculatedContentHash != manifestContentHash)
            {
                throw new InvalidDataException(
                    "Bundle manifest canonical entry-array content hash differs from its trust-index identity.");
            }

            var item = new TaskItem(directory);
            item.SetMetadata(
                "CompositionProfileSchemaFile",
                compositionProfileSchemaFile);
            item.SetMetadata(
                "FirmwareFamilySchemaFile",
                firmwareFamilySchemaFile);
            if (canonicalSource != null || canonicalDestination != null)
            {
                item.SetMetadata(
                    "CanonicalFirmwareFamilySource",
                    canonicalSource);
                item.SetMetadata(
                    "CanonicalFirmwareFamilyDestination",
                    canonicalDestination);
            }

            bundles.Add(item);
        }

        Bundles = bundles.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MaterializeBuiltInProfileBundles" BeforeTargets="AssignTargetPaths">
    <LoadProfileBundleTrustIndex
      TrustIndexPath="$(BuiltInProfileTrustIndex)"
      TrustIndexSchemaPath="$(ProfileContractRoot)\profile-bundle-package-trust-index-v1.schema.json"
      BuiltInProfileSourceRoot="$(BuiltInProfileSourceRoot)"
      ProfileContractRoot="$(ProfileContractRoot)">
      <Output TaskParameter="Bundles" ItemName="BuiltInProfileBundle" />
    </LoadProfileBundleTrustIndex>
    <PropertyGroup>
      <_BuiltInProfilePublishedRoot>$(OutDir)profiles\built-in</_BuiltInProfilePublishedRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(BuiltInProfileMaterializedRoot);$(_BuiltInProfilePublishedRoot)" />
    <ItemGroup>
      <_BuiltInProfileSource Include="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\**\*"
        Exclude="$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\schemas\**\*">
        <BundleDirectory>%(BuiltInProfileBundle.Identity)</BundleDirectory>
      </_BuiltInProfileSource>
      <_BuiltInProfileFamilySchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\%(BuiltInProfileBundle.FirmwareFamilySchemaFile)</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\firmware-family-v1.schema.json</DestinationFile>
      </_BuiltInProfileFamilySchema>
      <_BuiltInProfileCompositionSchema Include="@(BuiltInProfileBundle)">
        <SourceFile>$(ProfileContractRoot)\%(BuiltInProfileBundle.CompositionProfileSchemaFile)</SourceFile>
        <DestinationFile>$(BuiltInProfileMaterializedRoot)\%(Identity)\schemas\composition-profile-v2.schema.json</DestinationFile>
      </_BuiltInProfileCompositionSchema>
      <_BuiltInProfileCanonicalFamily Include="@(BuiltInProfileBundle)"
        Condition="'%(BuiltInProfileBundle.CanonicalFirmwareFamilySource)' != '' Or '%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)' != ''">
        <SourceFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.CanonicalFirmwareFamilySource)'))</SourceFile>
        <SourceRoot>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\'))</SourceRoot>
        <BundleSourceFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileSourceRoot)\%(BuiltInProfileBundle.Identity)\%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)'))</BundleSourceFile>
        <DestinationFile>$([System.IO.Path]::GetFullPath('$(BuiltInProfileMaterializedRoot)\%(BuiltInProfileBundle.Identity)\%(BuiltInProfileBundle.CanonicalFirmwareFamilyDestination)'))</DestinationFile>
        <DestinationRoot>$([System.IO.Path]::GetFullPath('$(BuiltInProfileMaterializedRoot)\%(BuiltInProfileBundle.Identity)\families\'))</DestinationRoot>
      </_BuiltInProfileCanonicalFamily>
    </ItemGroup>
    <Error
      Condition="'%(_BuiltInProfileCanonicalFamily.CanonicalFirmwareFamilySource)' == '' Or '%(_BuiltInProfileCanonicalFamily.CanonicalFirmwareFamilyDestination)' == ''"
      Text="Built-in profile canonical firmware-family metadata must declare both source and destination for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="$([System.String]::Copy(%(_BuiltInProfileCanonicalFamily.SourceFile)).StartsWith(%(_BuiltInProfileCanonicalFamily.SourceRoot), System.StringComparison.OrdinalIgnoreCase)) != 'True'"
      Text="Built-in profile canonical firmware-family source escapes the approved source root for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="$([System.String]::Copy(%(_BuiltInProfileCanonicalFamily.DestinationFile)).StartsWith(%(_BuiltInProfileCanonicalFamily.DestinationRoot), System.StringComparison.OrdinalIgnoreCase)) != 'True'"
      Text="Built-in profile canonical firmware-family destination escapes the bundle families root for '%(_BuiltInProfileCanonicalFamily.Identity)'." />
    <Error
      Condition="!Exists('%(_BuiltInProfileCanonicalFamily.SourceFile)')"
      Text="Built-in profile canonical firmware-family source is missing for '%(_BuiltInProfileCanonicalFamily.Identity)': %(_BuiltInProfileCanonicalFamily.SourceFile)" />
    <Error
      Condition="Exists('%(_BuiltInProfileCanonicalFamily.BundleSourceFile)')"
      Text="Built-in profile canonical firmware-family destination collides with a checked-in bundle file for '%(_BuiltInProfileCanonicalFamily.Identity)': %(_BuiltInProfileCanonicalFamily.BundleSourceFile)" />
    <Copy
      SourceFiles="@(_BuiltInProfileSource)"
      DestinationFiles="@(_BuiltInProfileSource->'$(BuiltInProfileMaterializedRoot)\%(BundleDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileFamilySchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileFamilySchema->'%(DestinationFile)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileCompositionSchema->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileCompositionSchema->'%(DestinationFile)')" />
    <Copy
      SourceFiles="@(_BuiltInProfileCanonicalFamily->'%(SourceFile)')"
      DestinationFiles="@(_BuiltInProfileCanonicalFamily->'%(DestinationFile)')" />
    <ItemGroup>
      <_BuiltInProfileMaterializedFiles Include="$(BuiltInProfileMaterializedRoot)\**\*" />
      <Content Include="@(_BuiltInProfileMaterializedFiles)">
        <Link>profiles\built-in\%(_BuiltInProfileMaterializedFiles.RecursiveDir)%(_BuiltInProfileMaterializedFiles.Filename)%(_BuiltInProfileMaterializedFiles.Extension)</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
