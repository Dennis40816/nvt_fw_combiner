<UserControl x:Class="NvtFwCombiner.Presentation.Avalonia.Views.OutputDeliveryConfirmationModal"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
             x:DataType="vm:OutputDeliveryConfirmationViewModel"
             AutomationProperties.Name="{Binding Text.OutputDeliveryTitle}"
             Background="{DynamicResource NfcModalScrimBrush}" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle" KeyDown="OutputDeliveryConfirmationModal_OnKeyDown">
  <Border x:Name="BuildSettingsSurface" Classes="modalSurface" Width="760" MaxHeight="720" Margin="16" Padding="0"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Padding="22,18,14,16" BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="3">
            <TextBlock Classes="modalTitle" Text="{Binding Text.OutputDeliveryTitle}" />
            <TextBlock Classes="mutedText" Text="{Binding Text.OutputDeliverySummary}" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="1" Classes="semanticAction closeButton"
                  AutomationProperties.Name="{Binding Text.CloseLabel}" Command="{Binding CancelCommand}"
                  ToolTip.Tip="{Binding Text.CloseLabel}">
            <Path Width="16" Height="16" Data="{StaticResource NfcCloseIconGeometry}" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer x:Name="BuildSettingsViewport" Grid.Row="1" Classes="contentScrollSurface"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,0">
          <Border x:Name="OutputSettingSection" Padding="0,12,0,4">
            <Grid ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="3">
                <TextBlock Classes="fieldLabel" FontWeight="SemiBold" Text="{Binding Text.OutputDeliveryOutputLabel}" />
                <SelectableTextBlock x:Name="OutputFileNameDisplay" Grid.Row="1"
                                     AutomationProperties.Name="{Binding Text.OutputDeliveryOutputLabel}"
                                     IsVisible="{Binding !IsOutputFileNameEditing}" MinHeight="24"
                                     Text="{Binding OutputFileName}" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding OutputFileName}" VerticalAlignment="Center" />
                <TextBox x:Name="OutputFileNameInput" Grid.Row="1" VerticalAlignment="Center" Classes="buildSettingInput outputNameInput editable"
                         AutomationProperties.Name="{Binding Text.OutputDeliveryOutputLabel}"
                         IsVisible="{Binding IsOutputFileNameEditing}" Text="{Binding OutputFileName, Mode=OneWay}"
                         TextChanged="OutputFileNameInput_OnTextChanged" KeyDown="OutputFileNameInput_OnKeyDown" />
                <Button x:Name="EditOutputFileNameButton" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Classes="semanticAction inlineEdit outputNameEdit"
                        AutomationProperties.Name="{Binding Text.OutputDeliveryEditOutputNameLabel}"
                        Click="EditOutputFileNameButton_OnClick" IsEnabled="{Binding CanEditOutputFileName}"
                        IsVisible="{Binding !IsOutputFileNameEditing}"
                        ToolTip.Tip="{Binding Text.OutputDeliveryEditOutputNameLabel}">
                  <Path Width="16" Height="16" Data="{StaticResource NfcEditIconGeometry}"
                        Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" />
                </Button>
                <Button x:Name="CompleteOutputFileNameEditButton" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                        Classes="semanticAction inlineEdit outputNameEdit" IsVisible="{Binding IsOutputFileNameEditing}"
                        AutomationProperties.Name="{Binding Text.OutputDeliveryDoneOutputNameLabel}"
                        ToolTip.Tip="{Binding Text.OutputDeliveryDoneOutputNameLabel}" Click="CompleteOutputFileNameEditButton_OnClick">
                  <Path Width="16" Height="16" Data="M2 8L6 12L14 3" Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" />
                </Button>
                <ToggleButton x:Name="SourcesDisclosureToggle" Grid.Row="2" Grid.ColumnSpan="2" MinHeight="24" Padding="0,2"
                              HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" Classes="inlineDisclosure buildSettingsDisclosure"
                              AutomationProperties.Name="{Binding Text.OutputDeliverySourcesLabel}"
                              ToolTip.Tip="{Binding Text.OutputDeliverySourcesLabel}"
                              IsChecked="{Binding AreSourcesExpanded}"
                              IsCheckedChanged="SourcesDisclosureToggle_OnIsCheckedChanged">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
                    <TextBlock x:Name="SourcesCountLabel" Classes="detailText" Text="{Binding InputSourcesSummary}" VerticalAlignment="Center" />
                    <Path x:Name="SourcesCollapsedChevron" Width="10" Height="6" Data="M1 1L5 5L9 1" Fill="Transparent"
                          IsVisible="{Binding !AreSourcesExpanded}" VerticalAlignment="Center"
                          Stroke="{DynamicResource NfcTextMutedBrush}" StrokeThickness="1.5" Stretch="Uniform" />
                    <Path x:Name="SourcesExpandedChevron" Width="10" Height="6" Data="M1 5L5 1L9 5" Fill="Transparent"
                          IsVisible="{Binding AreSourcesExpanded}" VerticalAlignment="Center"
                          Stroke="{DynamicResource NfcTextMutedBrush}" StrokeThickness="1.5" Stretch="Uniform" />
                  </StackPanel>
                </ToggleButton>

              <Border x:Name="SourcesListPanel" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Classes="compactSubtleSurface"
                      Padding="10,5" IsVisible="{Binding AreSourcesExpanded}">
                <StackPanel>
                <ItemsControl x:Name="SourceFilesList" ItemsSource="{Binding InputRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="{DynamicResource NfcSpace2}" Margin="0,2">
                        <TextBlock Text="{Binding Role}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Role}" />
                        <TextBlock Grid.Column="1" FontWeight="Medium" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Size}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="warningText" IsVisible="{Binding HasWarning}"
                                   Foreground="{DynamicResource NfcWarningTextBrush}" Text="{Binding Warning}" TextWrapping="Wrap" />
                        <ToolTip.Tip>
                          <StackPanel Spacing="3" MaxWidth="500">
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                            <TextBlock Classes="detailText" Text="{Binding Size}" />
                            <TextBlock Classes="detailText" Text="{Binding Sha256}" TextWrapping="Wrap" />
                          </StackPanel>
                        </ToolTip.Tip>
                      </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="SourceChecksPanel" IsVisible="{Binding HasSourceChecks}" Padding="0,6,0,3">
                  <StackPanel Spacing="{DynamicResource NfcSpace2}">
                    <ItemsControl ItemsSource="{Binding ExpectedInputChecks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="170,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                            <TextBlock Classes="mutedText" Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="170,*" ColumnSpacing="{DynamicResource NfcSpace12}" IsVisible="{Binding HasEventBufferChecks}">
                      <TextBlock x:Name="OutputEventBufferFormatLabel" Classes="mutedText" Text="{Binding Text.OutputConfirmationEventLabel}" TextWrapping="Wrap" />
                      <ItemsControl x:Name="OutputEventBufferFormatChecks" Grid.Column="1" ItemsSource="{Binding EventBufferChecks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="34,*" ColumnSpacing="{DynamicResource NfcSpace8}" Margin="0,0,0,2">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Border>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <TextBlock Classes="warningText" Margin="0,4,0,8" IsVisible="{Binding HasGeneratedInputs}"
                     Text="{Binding Text.OutputConfirmationGeneratedHint}" TextWrapping="Wrap" />
          <Grid x:Name="OutputConfirmationSummary" ColumnDefinitions="188,*" RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="{DynamicResource NfcSpace8}" Margin="0,4,0,4" IsVisible="{Binding HasConfirmation}">
            <TextBlock Classes="mutedText" Text="{Binding Text.OutputConfirmationTargetLabel}" />
            <TextBlock x:Name="OutputTargetValue" Grid.Column="1" FontWeight="SemiBold" Text="{Binding TargetSummary}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="mutedText" Text="{Binding Text.OutputConfirmationModeLabel}" />
            <TextBlock x:Name="OutputModeValue" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding ModeSummary}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Classes="mutedText" Text="{Binding Text.OutputConfirmationFlashMapLabel}" />
            <TextBlock x:Name="OutputFlashMapValue" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding FlashMapSummary}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="mutedText" Text="{Binding Text.OutputConfirmationSizeLabel}" />
            <TextBlock x:Name="FlashOutputSizeValue" Grid.Row="3" Grid.Column="1" Text="{Binding FlashOutputSize}" TextWrapping="Wrap" />
          </Grid>

          <Border x:Name="CtrlRamVersionSettingSection" Padding="0,16" BorderBrush="{DynamicResource NfcBorderMutedBrush}"
                  BorderThickness="0,0,0,1" IsVisible="{Binding HasCtrlRamOptions}">
            <StackPanel>
            <Grid ColumnDefinitions="*,300" ColumnSpacing="{DynamicResource NfcSpace24}" IsVisible="{Binding CtrlRamOptions.IsStandardCtrlRamReference}">
              <StackPanel Spacing="3">
                <TextBlock Classes="fieldLabel" FontWeight="Medium" Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionTitle}" />
                <TextBlock x:Name="CtrlRamBaseVersionValue" Classes="versionValue"
                           FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium"
                           Text="{Binding CtrlRamOptions.CtrlRamFirmwareVersionCurrentValue}" />
                <TextBlock Classes="detailText" Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionDetail}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="CtrlRamVersionControlGroup" Grid.Column="1" Width="300"
                          Spacing="{DynamicResource NfcSpace12}">
                <Grid x:Name="CtrlRamVersionModeRow" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace4}">
                  <ToggleButton x:Name="CtrlRamVersionKeepChoice"
                                AutomationProperties.Name="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionKeepLabel}"
                                Classes="segment versionChoice"
                                FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium"
                                Command="{Binding CtrlRamOptions.SelectCtrlRamFirmwareVersionPreserveCommand}"
                                IsChecked="{Binding CtrlRamOptions.IsCtrlRamFirmwareVersionPreserveSelected, Mode=OneWay}">
                    <TextBlock Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionKeepLabel}" />
                  </ToggleButton>
                  <ToggleButton x:Name="CtrlRamVersionEditChoice" Grid.Column="1"
                                AutomationProperties.Name="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionEditLabel}"
                                Classes="segment versionChoice"
                                FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium"
                                Command="{Binding CtrlRamOptions.SelectCtrlRamFirmwareVersionEditCommand}"
                                IsChecked="{Binding CtrlRamOptions.IsCtrlRamFirmwareVersionEditSelected, Mode=OneWay}"
                                IsEnabled="{Binding CtrlRamOptions.CanEditCtrlRamFirmwareVersion}">
                    <TextBlock Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionEditLabel}" />
                  </ToggleButton>
                </Grid>
                <Grid x:Name="CtrlRamVersionFieldRow" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace12}"
                      IsVisible="{Binding CtrlRamOptions.IsCtrlRamFirmwareVersionEditSelected}">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" FontWeight="Medium" Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionByteLabel}" />
                    <TextBox x:Name="CtrlRamFirmwareVersionInput" Classes="technicalCenteredInput hexByteInput"
                             FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium"
                             AutomationProperties.Name="{Binding CtrlRamOptions.Text.CtrlRamFirmwareVersionByteLabel}"
                             Text="{Binding CtrlRamOptions.CtrlRamFirmwareVersionText, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="fieldLabel" FontWeight="Medium" Text="{Binding CtrlRamOptions.Text.CtrlRamFirmwareSubVersionByteLabel}" />
                    <TextBox x:Name="CtrlRamFirmwareSubVersionInput" Classes="technicalCenteredInput hexByteInput"
                             FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium"
                             AutomationProperties.Name="{Binding CtrlRamOptions.Text.CtrlRamFirmwareSubVersionByteLabel}"
                             Text="{Binding CtrlRamOptions.CtrlRamFirmwareSubVersionText, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="warningText" IsVisible="{Binding CtrlRamOptions.HasCtrlRamFirmwareVersionValidation}"
                           Text="{Binding CtrlRamOptions.CtrlRamFirmwareVersionValidationDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <ItemsControl x:Name="AbCtrlRamVersionEditors" ItemsSource="{Binding CtrlRamOptions.AbCtrlRamVersionEditors}"
                          IsVisible="{Binding CtrlRamOptions.IsAbCtrlRamReference}" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CtrlRamFirmwareVersionEditorViewModel">
                  <Grid Classes="abVersionEditor" ColumnDefinitions="*,300" ColumnSpacing="24" Margin="0,6">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="fieldLabel" FontWeight="Medium" Text="{Binding Title}" />
                      <TextBlock Classes="versionValue" FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium" Text="{Binding CurrentValue}" />
                      <TextBlock Classes="detailText" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace12}">
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace4}">
                        <ToggleButton Classes="segment versionChoice" FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium" Command="{Binding PreserveCommand}"
                                      IsChecked="{Binding IsPreserveSelected, Mode=OneWay}"
                                      AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionKeepLabel}">
                          <TextBlock Text="{Binding Text.CtrlRamFirmwareVersionKeepLabel}" />
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Classes="segment versionChoice" FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium" Command="{Binding EditCommand}"
                                      IsChecked="{Binding IsEditSelected, Mode=OneWay}" IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionEditLabel}">
                          <TextBlock Text="{Binding Text.CtrlRamFirmwareVersionEditLabel}" />
                        </ToggleButton>
                      </Grid>
                      <Grid Classes="abVersionFields" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace12}" IsVisible="{Binding IsEditSelected}">
                        <StackPanel Spacing="5">
                          <TextBlock Classes="fieldLabel" Text="{Binding Text.CtrlRamFirmwareVersionByteLabel}" />
                          <TextBox Classes="technicalCenteredInput hexByteInput" FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium" Text="{Binding VersionText, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionByteLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                          <TextBlock Classes="fieldLabel" Text="{Binding Text.CtrlRamFirmwareSubVersionByteLabel}" />
                          <TextBox Classes="technicalCenteredInput hexByteInput" FontFamily="{DynamicResource NfcUiFontFamily}" FontWeight="Medium" Text="{Binding SubVersionText, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Text.CtrlRamFirmwareSubVersionByteLabel}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="warningText" Text="{Binding Validation}" IsVisible="{Binding HasValidation}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="BuildWarningsPanel" Margin="0,12,0,12" Padding="16"
                  IsVisible="{Binding HasInputWarnings}" CornerRadius="{DynamicResource NfcCompactCornerRadius}"
                  Background="{DynamicResource NfcWarningSurfaceBrush}" BorderBrush="{DynamicResource NfcWarningBorderStrongBrush}" BorderThickness="1"
                  AutomationProperties.Name="{Binding BuildWarningsTitle}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="{DynamicResource NfcSpace12}">
              <Path Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" Stretch="Uniform"
                    Data="M9 1L17 17H1Z M9 6V11 M9 13V14" Fill="Transparent"
                    Stroke="{DynamicResource NfcWarningAccentStrongBrush}" StrokeThickness="1.5" />
              <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace8}">
                <TextBlock FontWeight="SemiBold" Text="{Binding BuildWarningsTitle}" />
                <ItemsControl ItemsSource="{Binding WarningRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputConfirmationWarningRow">
                      <StackPanel Spacing="{DynamicResource NfcSpace2}" Margin="0,0,0,4">
                        <TextBlock FontWeight="Medium" Text="{Binding Role}" />
                        <TextBlock Foreground="{DynamicResource NfcWarningTextBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="DeliverySettingSection" Padding="0,4,0,8">
            <StackPanel Spacing="{DynamicResource NfcSpace8}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel" FontWeight="SemiBold" Text="{Binding Text.OutputDeliverySectionLabel}" />
                  <TextBlock Text="{Binding DeliveryDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="BundleToggle" Grid.Column="1" Classes="buildSettingChoice"
                              Width="42" MinHeight="24"
                              AutomationProperties.Name="{Binding Text.OutputDeliveryBundleLabel}"
                              IsChecked="{Binding BundleEnabled}" IsCheckedChanged="BundleToggle_OnIsCheckedChanged"
                              VerticalAlignment="Center" />
              </Grid>
              <CheckBox x:Name="AdditionalToggle" Classes="buildSettingChoice"
                        AutomationProperties.Name="{Binding Text.OutputDeliveryAdditionalLabel}"
                        Content="{Binding AdditionalDeliveryLabel}" IsChecked="{Binding AdditionalDeliveryEnabled}"
                        IsVisible="{Binding OffersAdditionalDelivery}"
                        IsCheckedChanged="AdditionalToggle_OnIsCheckedChanged" />
              <StackPanel x:Name="DeliveredItemsSummary" Spacing="{DynamicResource NfcSpace8}">
                <Grid ColumnDefinitions="188,*" ColumnSpacing="{DynamicResource NfcSpace12}" IsVisible="{Binding ShowsBundleContents}">
                  <TextBlock Classes="mutedText" Text="Flash BIN" />
                  <TextBlock Grid.Column="1" Text="{Binding OutputFileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputFileName}" />
                </Grid>
                <Grid ColumnDefinitions="188,*" ColumnSpacing="{DynamicResource NfcSpace12}" IsVisible="{Binding AdditionalDeliveryEnabled}">
                  <TextBlock Classes="mutedText" Text="A FlashCode" />
                  <Grid Grid.Column="1" ColumnDefinitions="*,34" RowDefinitions="Auto,Auto"
                        ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="3">
                      <SelectableTextBlock x:Name="AdditionalOutputFileNameDisplay" MinHeight="24" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsAdditionalOutputFileNameEditing}"
                                           AutomationProperties.Name="A FlashCode"
                                           Text="{Binding AdditionalOutputFileName}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding AdditionalOutputFileName}" />
                      <TextBox x:Name="AdditionalOutputFileNameInput" VerticalAlignment="Center" Classes="buildSettingInput outputNameInput editable"
                               AutomationProperties.Name="A FlashCode" IsVisible="{Binding IsAdditionalOutputFileNameEditing}"
                               Text="{Binding AdditionalOutputFileName, Mode=OneWay}"
                               TextChanged="AdditionalOutputFileNameInput_OnTextChanged" KeyDown="AdditionalOutputFileNameInput_OnKeyDown" />
                      <Button x:Name="EditAdditionalOutputFileNameButton" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" Classes="semanticAction inlineEdit outputNameEdit"
                              AutomationProperties.Name="{Binding Text.OutputDeliveryEditAdditionalNameLabel}"
                              ToolTip.Tip="{Binding Text.OutputDeliveryEditAdditionalNameLabel}"
                              IsEnabled="{Binding CanEditAdditionalOutputFileName}" IsVisible="{Binding !IsAdditionalOutputFileNameEditing}"
                              Click="EditAdditionalOutputFileNameButton_OnClick">
                        <Path Width="16" Height="16" Data="{StaticResource NfcEditIconGeometry}" Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" />
                      </Button>
                      <Button x:Name="CompleteAdditionalOutputFileNameEditButton" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" Classes="semanticAction inlineEdit outputNameEdit"
                              AutomationProperties.Name="{Binding Text.OutputDeliveryDoneAdditionalNameLabel}"
                              ToolTip.Tip="{Binding Text.OutputDeliveryDoneAdditionalNameLabel}"
                              IsVisible="{Binding IsAdditionalOutputFileNameEditing}" Click="CompleteAdditionalOutputFileNameEditButton_OnClick">
                        <Path Width="16" Height="16" Data="M2 8L6 12L14 3" Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" />
                      </Button>
                    <TextBlock Grid.Row="1" Classes="detailText" Text="{Binding AdditionalOutputSize}" />
                  </Grid>
                </Grid>
                <Grid ColumnDefinitions="188,*" ColumnSpacing="{DynamicResource NfcSpace12}" IsVisible="{Binding ShowsBundleContents}">
                  <TextBlock Classes="mutedText" Text="{Binding Text.OutputConfirmationInputsLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding SourcesSummary}" />
                </Grid>
                <TextBlock Classes="detailText" Text="{Binding Text.OutputConfirmationLooseHint}"
                           IsVisible="{Binding !BundleEnabled}" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="compactSubtleSurface" Padding="14,12" IsVisible="{Binding BundleEnabled}">
                <StackPanel Spacing="{DynamicResource NfcSpace8}">
                  <Grid x:Name="BundleReviewPanel" ColumnDefinitions="*,34" RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="{DynamicResource NfcSpace2}">
                      <TextBlock Classes="fieldLabel" Text="{Binding Text.OutputDeliveryFolderNameLabel}" />
                      <SelectableTextBlock x:Name="BundleFolderNameDisplay" Grid.Row="1" VerticalAlignment="Center" IsVisible="{Binding !IsBundleDestinationEditing}"
                                           Text="{Binding BundleFolderName}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding BundleFolderName}" />
                      <TextBox x:Name="FolderNameInput" Grid.Row="1" VerticalAlignment="Center" Classes="buildSettingInput editable"
                               AutomationProperties.Name="{Binding Text.OutputDeliveryFolderNameLabel}"
                               IsVisible="{Binding IsBundleDestinationEditing}"
                               Text="{Binding BundleFolderName}" TextChanged="FolderNameInput_OnTextChanged" KeyDown="FolderNameInput_OnKeyDown" />
                    <Button x:Name="EditBundleDestinationButton" Grid.Row="1" Grid.Column="1"
                            Classes="semanticAction inlineEdit outputNameEdit" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Text.OutputDeliveryEditBundleDestinationLabel}"
                            Click="EditBundleDestinationButton_OnClick" IsEnabled="{Binding CanEditBundleDestination}"
                            IsVisible="{Binding !IsBundleDestinationEditing}"
                            ToolTip.Tip="{Binding Text.OutputDeliveryEditBundleDestinationLabel}">
                      <Path Width="16" Height="16" Data="{StaticResource NfcEditIconGeometry}"
                            Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CompleteBundleDestinationEditButton" Grid.Row="1" Grid.Column="1"
                            Classes="semanticAction inlineEdit outputNameEdit" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Text.OutputDeliveryDoneEditingLabel}"
                            Click="CompleteBundleDestinationEditButton_OnClick"
                            IsVisible="{Binding IsBundleDestinationEditing}"
                            ToolTip.Tip="{Binding Text.OutputDeliveryDoneEditingLabel}">
                      <Path Width="16" Height="16" Data="M2 8L6 12L14 3" Fill="Transparent"
                            StrokeThickness="1.5" Stretch="Uniform" />
                    </Button>
                      <TextBlock Grid.Row="2" Margin="0,8,0,0" Classes="fieldLabel" Text="{Binding Text.OutputDeliveryParentLabel}" />
                      <SelectableTextBlock x:Name="ParentDirectoryDisplay" Grid.Row="3" VerticalAlignment="Center" Text="{Binding ParentDirectory}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ParentDirectory}" />
                    <Button x:Name="ChooseParentButton" Grid.Row="3" Grid.Column="1"
                            Classes="semanticAction inlineEdit outputNameEdit folderPickerAction"
                            VerticalAlignment="Center" IsEnabled="{Binding CanEditBundleDestination}"
                            AutomationProperties.Name="{Binding Text.OutputDeliveryChooseParentLabel}"
                            Click="ChooseParentButton_OnClick"
                            ToolTip.Tip="{Binding Text.OutputDeliveryChooseParentLabel}">
                      <Path Width="18" Height="18"
                            Data="M2 5H7L9 7H16V9H7.5L5.5 16H2Z M7.8 10H16L14.2 16H6Z"
                            Fill="Transparent" StrokeThickness="1.7" Stretch="Uniform" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="22,14" BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,8" Classes="warningText"
                     AutomationProperties.LiveSetting="Assertive" IsVisible="{Binding HasValidationMessage}"
                     Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
          <TextBlock x:Name="BuildReadinessSummary" Grid.Row="1" Classes="detailText" VerticalAlignment="Center" Text="{Binding BuildReadinessSummary}"
                     IsVisible="{Binding CanConfirm}" />
          <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
            <Button x:Name="CancelButton" Classes="semanticAction secondary" Command="{Binding CancelCommand}"
                    Content="{Binding Text.OutputDeliveryCancelLabel}" />
            <Button x:Name="ConfirmButton" Classes="semanticAction primary action" Click="ConfirmButton_OnClick"
                    Content="{Binding Text.OutputDeliveryConfirmLabel}" IsEnabled="{Binding CanConfirm}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
