<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.AbAFlashCodeDeliveryPromptModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MergePresentationViewModel"
    AutomationProperties.Name="{Binding Text.AbAFlashCodePromptTitle}"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="540"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="5">
        <TextBlock Classes="modalTitle" Text="{Binding Text.AbAFlashCodePromptTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding Text.AbAFlashCodePromptDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            Classes="danger"
            AutomationProperties.Name="{Binding Text.AbAFlashCodePromptNoLabel}"
            Command="{Binding DeclineAbAFlashCodeDeliveryPromptCommand}"
            Content="{Binding Text.AbAFlashCodePromptNoLabel}" />
        <Button
            Classes="primary"
            AutomationProperties.Name="{Binding Text.AbAFlashCodePromptYesLabel}"
            Command="{Binding AcceptAbAFlashCodeDeliveryPromptCommand}"
            Content="{Binding Text.AbAFlashCodePromptYesLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
