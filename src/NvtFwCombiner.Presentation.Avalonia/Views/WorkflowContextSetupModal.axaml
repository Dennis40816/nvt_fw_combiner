<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.WorkflowContextSetupModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="520"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="modalTitle" Text="{Binding Text.DeviceContextTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding WorkflowContextDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Spacing="5">
          <TextBlock Classes="fieldLabel" Text="{Binding Text.IcLabel}" />
          <ComboBox
              Classes="technicalSelect"
              ItemsSource="{Binding WorkflowContextSetup.IcChoices}"
              SelectedItem="{Binding WorkflowContextSetup.SelectedIc, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Classes="monoText" FontSize="13" Text="{Binding}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding WorkflowContextSetup.IsNumberVisible}">
          <TextBlock Classes="fieldLabel" Text="{Binding Text.NumberLabel}" />
          <ComboBox
              Classes="technicalSelect"
              ItemsSource="{Binding WorkflowContextSetup.NumberChoices}"
              SelectedItem="{Binding WorkflowContextSetup.SelectedNumberChoice, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IcNumberChoiceViewModel">
                <TextBlock Classes="monoText" FontSize="13" Text="{Binding DisplayLabel}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Classes="insetSurface" Padding="10,8">
        <TextBlock Classes="detailText" Text="{Binding Text.WorkflowContextSafetyDetail}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Command="{Binding CancelWorkflowContextCommand}" Content="{Binding Text.CloseLabel}" />
        <Button Classes="primary" Command="{Binding ConfirmWorkflowContextCommand}" Content="{Binding Text.OpenLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
