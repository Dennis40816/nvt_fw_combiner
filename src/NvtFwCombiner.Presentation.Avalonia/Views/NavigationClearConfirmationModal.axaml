<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.NavigationClearConfirmationModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:ShellNavigationViewModel"
    IsVisible="{Binding IsNavigationClearConfirmationOpen}"
    Focusable="True"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyDown="NavigationClearConfirmationModal_OnKeyDown"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="520"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      BorderBrush="{DynamicResource NfcWarningAccentBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="5">
        <TextBlock Classes="modalTitle" Text="{Binding ConfirmationTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding ConfirmationDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Classes="insetSurface" Padding="10,8">
        <TextBlock
            Classes="detailText"
            Text="{Binding NavigationClearRoute}"
            TextWrapping="Wrap"
            AutomationProperties.Name="{Binding NavigationClearRoute}" />
      </Border>

      <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            x:Name="CancelButton"
            Classes="semanticAction secondary"
            Command="{Binding CancelNavigationClearCommand}"
            Content="{Binding ConfirmationCancelLabel}" />
        <Button
            Classes="semanticAction"
            Classes.primary="{Binding !IsExitConfirmationOpen}"
            Classes.danger="{Binding IsExitConfirmationOpen}"
            Command="{Binding ConfirmNavigationAndClearCommand}"
            Content="{Binding ConfirmationAcceptLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
