<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.ForegroundLoadingSurface"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:ForegroundLoadingState"
    AutomationProperties.Name="{Binding AccessibleStatus}"
    behaviors:FocusOnRevealBehavior.IsEnabled="True"
    Focusable="True"
    IsVisible="{Binding IsVisible}">
  <Grid Background="{DynamicResource NfcModalScrimBrush}">
    <ContentControl
        Width="430"
        Padding="28,26"
        Content="{Binding}"
        ContentTemplate="{DynamicResource ForegroundLoadingStatusTemplate}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
  </Grid>
</UserControl>
