<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.FirmwareIcMismatchModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:WorkflowSessionPresentationViewModel"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="540"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      BorderBrush="{DynamicResource NfcWarningAccentBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="5">
        <TextBlock Classes="modalTitle" Text="{Binding Text.FirmwareIcMismatchTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding Text.FirmwareIcMismatchDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="{DynamicResource NfcSpace8}">
        <TextBlock Classes="fieldLabel" Text="{Binding Text.FileLabel}" />
        <TextBlock Grid.Column="1" Classes="monoText bodyText" Text="{Binding FirmwareIcMismatchFileName}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Classes="fieldLabel" Text="{Binding Text.FirmwareIcMismatchCurrentLabel}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="monoText" FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextBrush}" Text="{Binding FirmwareIcMismatchCurrentIc}" />
        <TextBlock Grid.Row="2" Classes="fieldLabel" Text="{Binding Text.FirmwareIcMismatchDetectedLabel}" />
        <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcWarningTextMutedBrush}" Text="{Binding FirmwareIcMismatchDetectedIc}" />
      </Grid>

      <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button Classes="secondary" Command="{Binding DismissFirmwareIcMismatchCommand}" Content="{Binding Text.FirmwareIcMismatchKeepLabel}" />
        <Button Classes="primary" Command="{Binding AcceptFirmwareIcMismatchCommand}" Content="{Binding Text.FirmwareIcMismatchUseDetectedLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
