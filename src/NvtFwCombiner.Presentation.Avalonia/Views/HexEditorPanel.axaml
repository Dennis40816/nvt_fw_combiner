<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.HexEditorPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="{Binding Text.GeneralReplaceHexEditorDetail}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" MaxWidth="380" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding HexEditorReadinessStatus}" TextAlignment="Right" TextWrapping="Wrap" />
    </Grid>

    <ContentControl Content="{Binding ReplaceBaseSlot}" ContentTemplate="{StaticResource FirmwareSlotCardTemplate}" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.GeneralReplaceHexGoToLabel}" />
        <TextBox Width="132" Classes="addressInput" Text="{Binding GeneralReplaceHexViewportAddress, Mode=TwoWay}" />
        <Button Classes="secondary" Command="{Binding GoToGeneralReplaceHexViewportCommand}" Content="{Binding Text.GeneralReplaceHexGoToLabel}" />
      </StackPanel>
      <TextBlock Grid.Column="1" MaxWidth="400" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding GeneralReplaceHexViewportStatus}" TextAlignment="Right" TextWrapping="Wrap" />
    </Grid>

    <Grid ColumnDefinitions="*,292" ColumnSpacing="14">
      <Border Padding="12" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="70,*,142" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.GeneralReplaceHexAddressColumnLabel}" />
            <UniformGrid Grid.Column="1" Columns="16">
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="00" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="01" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="02" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="03" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="04" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="05" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="06" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="07" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="08" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="09" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0A" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0B" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0C" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0D" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0E" />
              <TextBlock HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#64748B" Text="0F" />
            </UniformGrid>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.GeneralReplaceHexAsciiColumnLabel}" />
          </Grid>
          <Border Height="1" Background="#CBD5E1" />
          <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GeneralReplaceHexViewportRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GeneralReplaceHexViewportRowViewModel">
                  <Grid Margin="0,1" ColumnDefinitions="70,*,142" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#475569" Text="{Binding Address}" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Bytes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="16" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GeneralReplaceHexByteCellViewModel">
                          <Button
                              Classes="hexCell"
                              Classes.changed="{Binding IsChanged}"
                              Classes.selected="{Binding IsSelected}"
                              Command="{ReflectionBinding $parent[Window].DataContext.SelectGeneralReplaceHexByteCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding AccessibleLabel}">
                            <TextBlock Text="{Binding ValueHex}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#475569" Text="{Binding AfterAscii}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="10">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceHexInspectorTitle}" />
          <StackPanel Spacing="4">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.GeneralReplaceHexApprovedRegionLabel}" />
            <ComboBox ItemsSource="{Binding GeneralReplaceEditableRanges}" SelectedItem="{Binding SelectedGeneralReplaceEditableRange, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GeneralReplaceEditableRangeViewModel">
                  <StackPanel Spacing="1">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SelectionLabel}" />
                    <TextBlock FontSize="10" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StartLabel}" />
              <TextBox Classes="addressInput" Text="{Binding GeneralReplacePatchDraft.StartAddress, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.EndLabel}" />
              <TextBox Classes="addressInput" Text="{Binding GeneralReplacePatchDraft.EndAddress, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.GeneralReplacePatchValueLabel}" />
            <TextBox FontFamily="Cascadia Mono, Consolas" FontSize="13" PlaceholderText="{Binding Text.GeneralReplacePatchValuePlaceholder}" Text="{Binding GeneralReplacePatchDraft.Value, Mode=TwoWay}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <ToggleButton Classes="segment" Command="{Binding SetGeneralReplacePatchOverwriteCommand}" IsChecked="{Binding IsGeneralReplacePatchOverwrite, Mode=OneWay}">
              <TextBlock Text="{Binding Text.GeneralReplacePatchOverwriteLabel}" />
            </ToggleButton>
            <ToggleButton Grid.Column="1" Classes="segment" Command="{Binding SetGeneralReplacePatchFillCommand}" IsChecked="{Binding IsGeneralReplacePatchFill, Mode=OneWay}">
              <TextBlock Text="{Binding Text.GeneralReplacePatchFillLabel}" />
            </ToggleButton>
          </Grid>
          <Button Classes="primary" Command="{Binding ApplyGeneralReplacePatchCommand}" Content="{Binding Text.GeneralReplaceApplyPatchLabel}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="secondary" Command="{Binding UndoGeneralReplacePatchCommand}" Content="{Binding Text.GeneralReplaceUndoPatchLabel}" />
            <Button Classes="secondary" Command="{Binding RedoGeneralReplacePatchCommand}" Content="{Binding Text.GeneralReplaceRedoPatchLabel}" />
          </StackPanel>
          <Button Classes="primary" Command="{Binding BuildHexEditorCommand}" Content="{Binding Text.HexEditorBuildLabel}" />
          <Border Height="1" Background="#E2E8F0" />
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceCommittedPatchesTitle}" />
          <TextBlock IsVisible="{Binding IsGeneralReplacePatchListEmpty}" FontSize="12" Foreground="#64748B" Text="{Binding Text.GeneralReplaceNoPatchesLabel}" />
          <ScrollViewer IsVisible="{Binding HasGeneralReplacePatches}" MaxHeight="188" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GeneralReplacePatches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GeneralReplacePatchViewModel">
                  <Grid Margin="0,3" ColumnDefinitions="26,76,*" ColumnSpacing="6">
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#64748B" Text="{Binding Index}" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding KindLabel}" />
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#334155" Text="{Binding RangeLabel}" />
                      <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#64748B" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
