<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.MessageCenterModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views"
    x:DataType="vm:MessageCenterViewModel"
    Focusable="True"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyDown="MessageCenterModal_OnKeyDown"
    Background="{DynamicResource NfcModalScrimBrush}">
  <UserControl.Styles>
    <Style Selector="Button.reportLoad /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
    </Style>
  </UserControl.Styles>
  <Grid>
  <Border
      IsEnabled="{Binding !Reports.IsHistoryDeleteConfirmationOpen}"
      x:Name="MessageCenterSurface"
      Classes="modalSurface"
      MaxWidth="1570"
      MaxHeight="910"
      Margin="32,24"
      Padding="0"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
    <Grid RowDefinitions="90,*">
      <Border Classes="messageCenterHeader">
        <Grid Margin="32,0,24,0" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
          <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="modalTitle" FontSize="24" Text="{Binding Text.MessageCenterTitle}" />
            <TextBlock Classes="mutedText" Text="{Binding Text.MessageCenterTooltip}" />
          </StackPanel>
          <Button
              x:Name="CloseButton"
              Grid.Column="1"
              Classes="semanticAction closeButton"
              AutomationProperties.Name="{Binding Text.CloseLabel}"
              Command="{Binding CloseCommand}"
              ToolTip.Tip="{Binding Text.CloseLabel}">
            <Path Width="16" Height="16" Data="{StaticResource NfcCloseIconGeometry}" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <Grid x:Name="MessageCenterBody" Grid.Row="1" ColumnDefinitions="324,*">
        <Border x:Name="MessageCenterNavigationRail" Classes="messageCenterNavigationSurface">
          <StackPanel Spacing="{DynamicResource NfcSpace12}">
            <TextBlock Margin="12,0,0,8" Classes="sectionLabel" Text="{Binding Text.MessageCenterTitle}" />
            <RadioButton
                Classes="messageCenterNavigationItem" GroupName="MessageCenterNavigation"
                Command="{Binding ShowRunReportsCommand}"
                IsChecked="{Binding IsRunReportsSelected, Mode=OneWay}">
              <Grid ColumnDefinitions="26,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                <Path Width="18" Height="18" Data="M3 4H15 M3 9H15 M3 14H15 M1 4H1.2 M1 9H1.2 M1 14H1.2"
                    Stretch="Uniform" Stroke="{DynamicResource NfcTextSecondaryBrush}" StrokeThickness="1.8" StrokeLineCap="Round" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="bodyStrongText" FontSize="{DynamicResource NfcFontSize14}" FontWeight="ExtraBold" Text="{Binding Text.RunReportsLabel}" />
              </Grid>
            </RadioButton>
            <RadioButton
                Classes="messageCenterNavigationItem" GroupName="MessageCenterNavigation"
                Command="{Binding ShowSystemInformationCommand}"
                IsChecked="{Binding IsSystemInformationSelected, Mode=OneWay}">
              <Grid ColumnDefinitions="26,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                <Path Width="18" Height="18" Data="M9 1A8 8 0 1 0 9 17A8 8 0 1 0 9 1 M9 5A4 4 0 1 0 9 13A4 4 0 1 0 9 5"
                    Stretch="Uniform" Stroke="{DynamicResource NfcTextSecondaryBrush}" StrokeThickness="1.6" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="bodyStrongText" FontSize="{DynamicResource NfcFontSize14}" FontWeight="ExtraBold" Text="{Binding Text.SystemActivityTitle}" />
              </Grid>
            </RadioButton>
          </StackPanel>
        </Border>

        <Grid x:Name="MessageCenterContent" Grid.Column="1" Margin="44,30,50,24">
          <Grid IsVisible="{Binding IsRunReportsSelected}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" FontSize="28" FontWeight="SemiBold" Text="{Binding Text.RunReportsLabel}" />
                <TextBlock Classes="pageSubtitle" FontSize="{DynamicResource NfcFontSize14}" Text="{Binding Text.RunReportsNewestFirst}" />
              </StackPanel>
              <Button x:Name="LoadRunReportButton" Grid.Column="1" Classes="semanticAction secondary reportLoad" Width="172" Height="52"
                  VerticalAlignment="Center" Click="LoadReportButton_OnClick"
                  AutomationProperties.Name="{Binding Text.LoadRunReportLabel}" ToolTip.Tip="{Binding Text.LoadJsonTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Width="18" Height="18" Data="M9 12V1 M4 6L9 1L14 6 M1 12V17H17V12"
                      Stroke="{DynamicResource NfcTextStrongBrush}" StrokeThickness="1.5" />
                  <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize14}" Text="{Binding Text.LoadRunReportLabel}" />
                </StackPanel>
              </Button>
            </Grid>
            <views:RunReportsTable x:Name="RunReportsList" Grid.Row="1" DataContext="{Binding Reports}" />
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace12}">
              <TextBlock Classes="captionText" FontSize="{DynamicResource NfcFontSize14}" TextWrapping="Wrap">
                <TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}">
                  <Binding Path="Reports.RunReportSummary" /><Binding Path="Reports.ReportHistoryStorageSummary" />
                </MultiBinding></TextBlock.Text>
              </TextBlock>
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" Classes="captionText" FontSize="{DynamicResource NfcFontSize14}" Text="{Binding Text.RunReportsSelectHint}" TextWrapping="Wrap" />
            </Grid>
          </Grid>

          <Grid
              x:Name="SystemActivityRoot"
              IsVisible="{Binding IsSystemInformationSelected}"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="{DynamicResource NfcSpace16}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" Text="{Binding Text.SystemActivityTitle}" />
                <TextBlock Classes="pageSubtitle" Text="{Binding Text.SystemActivitySubtitle}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="activitySessionPill" VerticalAlignment="Center">
                <TextBlock Classes="infoText" Text="{Binding SessionActivitySummary}" />
              </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
                <RadioButton Classes="activityFilter" GroupName="SystemActivityFilter" Command="{Binding ShowImportantActivityCommand}"
                    Content="{Binding Text.ImportantActivityLabel}" IsChecked="{Binding IsImportantActivitySelected, Mode=OneWay}" />
                <RadioButton Classes="activityFilter" GroupName="SystemActivityFilter" Command="{Binding ShowWarningActivityCommand}"
                    Content="{Binding Text.WarningActivityLabel}" IsChecked="{Binding IsWarningActivitySelected, Mode=OneWay}" />
                <RadioButton Classes="activityFilter" GroupName="SystemActivityFilter" Command="{Binding ShowErrorActivityCommand}"
                    Content="{Binding Text.ErrorActivityLabel}" IsChecked="{Binding IsErrorActivitySelected, Mode=OneWay}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="semanticAction secondary" Command="{Binding ToggleDebugActivityCommand}"
                  Content="{Binding DebugActivityActionLabel}" />
              <Button Grid.Column="3" Classes="semanticAction secondary"
                  Click="ExportDiagnosticsButton_OnClick" Content="{Binding Text.ExportActivityLabel}" />
            </Grid>

            <Border Grid.Row="2" Classes="messageCenterDivider" />

            <Grid Grid.Row="3">
              <ScrollViewer x:Name="SystemActivityTimelineViewport" Classes="contentScrollSurface" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl AutomationProperties.LiveSetting="Polite" ItemsSource="{Binding ActivityItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageCenterActivityItem">
                      <Border Classes="activityRow" AutomationProperties.Name="{Binding AccessibleText}" Focusable="True">
                        <Grid ColumnDefinitions="82,24,*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
                          <TextBlock Classes="captionText" Text="{Binding Time}" VerticalAlignment="Top" Margin="0,3,0,0" />
                          <Grid Grid.Column="1" Margin="0,5,0,0">
                            <Border Classes="activityDot info" IsVisible="{Binding IsInformation}" />
                            <Border Classes="activityDot success" IsVisible="{Binding IsSuccess}" />
                            <Border Classes="activityDot warning" IsVisible="{Binding IsWarning}" />
                            <Border Classes="activityDot error" IsVisible="{Binding IsError}" />
                          </Grid>
                          <StackPanel Grid.Column="2" Spacing="{DynamicResource NfcSpace4}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
                              <TextBlock Classes="bodyStrongText" Text="{Binding Title}" />
                              <TextBlock Classes="captionText" Text="{Binding Category}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="detailText" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Grid Grid.Column="3" VerticalAlignment="Top">
                            <TextBlock Classes="activityStatus info" Text="{Binding Status}" IsVisible="{Binding IsInformation}" />
                            <TextBlock Classes="activityStatus success" Text="{Binding Status}" IsVisible="{Binding IsSuccess}" />
                            <TextBlock Classes="activityStatus warning" Text="{Binding Status}" IsVisible="{Binding IsWarning}" />
                            <TextBlock Classes="activityStatus error" Text="{Binding Status}" IsVisible="{Binding IsError}" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Classes="mutedText" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding HasNoActivityItems}" Text="{Binding Text.NoActivityLabel}" />
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
              <TextBlock Classes="captionText" Text="{Binding Text.SessionActivityNotice}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace12}">
                <TextBlock Classes="infoText" AutomationProperties.LiveSetting="Polite" Text="{Binding ExportStatus}" VerticalAlignment="Center" />
                <Button Classes="semanticAction secondary" AutomationProperties.Name="{Binding Text.RefreshDiagnosticsLabel}"
                    Command="{Binding RefreshCommand}" Content="{Binding RefreshActionLabel}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
  <views:ReportHistoryDeleteConfirmationModal DataContext="{Binding Reports}" IsVisible="{Binding IsHistoryDeleteConfirmationOpen}" />
  </Grid>
</UserControl>
