<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.MessageCenterModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MessageCenterViewModel"
    Focusable="True"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyDown="MessageCenterModal_OnKeyDown"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="760"
      MaxHeight="680"
      Padding="0"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <Grid Margin="22,18,22,0" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="modalTitle" Text="{Binding Text.MessageCenterTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding Text.MessageCenterTooltip}" />
        </StackPanel>
        <Button
            x:Name="CloseButton"
            Grid.Column="1"
            Classes="semanticAction iconButton"
            AutomationProperties.Name="{Binding Text.CloseLabel}"
            Command="{Binding CloseCommand}"
            ToolTip.Tip="{Binding Text.CloseLabel}">
          <TextBlock Text="×" />
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="22,14,22,0" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace8}">
        <ToggleButton
            Classes="summaryChip"
            HorizontalAlignment="Stretch"
            Command="{Binding ShowRunReportsCommand}"
            Content="{Binding Text.RunReportsLabel}"
            IsChecked="{Binding IsRunReportsSelected, Mode=OneWay}" />
        <ToggleButton
            Grid.Column="1"
            Classes="summaryChip"
            HorizontalAlignment="Stretch"
            Command="{Binding ShowSystemInformationCommand}"
            Content="{Binding Text.SystemInformationLabel}"
            IsChecked="{Binding IsSystemInformationSelected, Mode=OneWay}" />
      </Grid>

      <ScrollViewer Grid.Row="2" Margin="22,16,22,0" MaxHeight="440">
        <Grid>
          <StackPanel IsVisible="{Binding IsRunReportsSelected}" Spacing="{DynamicResource NfcSpace12}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface messageCenterReportCard" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource NfcSpace8}">
                  <TextBlock Classes="sectionLabel" Text="{Binding Reports.ReportActionLabel}" />
                  <TextBlock Grid.Row="1" Classes="cardTitle" Text="{Binding Reports.ReportActionStatus}" TextWrapping="Wrap" />
                  <Button
                      Grid.Row="2"
                      HorizontalAlignment="Left"
                      Classes="semanticAction secondary"
                      AutomationProperties.Name="{Binding Reports.ReportActionLabel}"
                      Command="{Binding OpenCurrentReportCommand}"
                      Content="{Binding Reports.ReportActionLabel}"
                      IsEnabled="{Binding Reports.CanOpenReport}" />
                </Grid>
              </Border>
              <Border Grid.Column="1" Classes="insetSurface messageCenterReportCard" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource NfcSpace8}">
                  <TextBlock Classes="sectionLabel" Text="{Binding Text.OpenReportHistoryLabel}" />
                  <StackPanel Grid.Row="1" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="cardTitle" Text="{Binding Reports.ReportHistorySummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="mutedText" Text="{Binding Reports.ReportHistoryStorageSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="mutedText" IsVisible="{Binding Reports.IsReportHistoryEmpty}" Text="{Binding Text.NoReportHistoryLabel}" />
                  </StackPanel>
                  <Button
                      Grid.Row="2"
                      HorizontalAlignment="Left"
                      Classes="semanticAction secondary"
                      AutomationProperties.Name="{Binding Text.OpenReportHistoryLabel}"
                      Command="{Binding OpenReportHistoryCommand}"
                      Content="{Binding Text.OpenReportHistoryLabel}"
                      IsEnabled="{Binding Reports.CanOpenReportHistory}" />
                </Grid>
              </Border>
            </Grid>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSystemInformationSelected}" Spacing="{DynamicResource NfcSpace12}">
            <Grid
                Classes="systemFactsGrid"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="{DynamicResource NfcSpace12}"
                RowSpacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface systemFactCard" Padding="14">
                <StackPanel Spacing="{DynamicResource NfcSpace4}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ApplicationVersionLabel}" />
                  <TextBlock Classes="bodyStrongText" Text="{Binding Current.ApplicationVersion}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="insetSurface systemFactCard" Padding="14">
                <StackPanel Spacing="{DynamicResource NfcSpace4}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.RuntimeLabel}" />
                  <TextBlock Classes="bodyStrongText" Text="{Binding Current.Runtime.FrameworkDescription}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Classes="insetSurface systemFactCard" Padding="14">
                <StackPanel Spacing="{DynamicResource NfcSpace4}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.CatalogLabel}" />
                  <TextBlock Classes="bodyStrongText" Text="{Binding CatalogSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="insetSurface systemFactCard" Padding="14">
                <StackPanel Spacing="{DynamicResource NfcSpace4}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ExternalToolsLabel}" />
                  <TextBlock Classes="bodyStrongText" Text="{Binding ExternalEnvironmentSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Margin="0,4,0,0" Classes="sectionLabel" Text="{Binding Text.ActiveDiagnosticsLabel}" />
            <Border
                Classes="successInset"
                Padding="14"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding SystemStatusAnnouncement}"
                IsVisible="{Binding HasNoActiveDiagnostics}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="successText" FontWeight="SemiBold" Text="✓" />
                <TextBlock Classes="bodyStrongText" Text="{Binding Text.NoActiveDiagnosticsLabel}" />
              </StackPanel>
            </Border>
            <ItemsControl
                AutomationProperties.LiveSetting="Polite"
                ItemsSource="{Binding ActiveDiagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageCenterDiagnosticItem">
                  <Border
                      Classes="warningSurface contentPanel diagnosticCard"
                      AutomationProperties.Name="{Binding AccessibleText}"
                      Focusable="True"
                      Margin="0,0,0,8">
                    <StackPanel Spacing="{DynamicResource NfcSpace4}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="bodyEmphasisText" Text="{Binding Message}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="captionText" Text="{Binding Category}" />
                      </Grid>
                      <TextBlock Classes="detailText" Text="{Binding Action}" TextWrapping="Wrap" />
                      <TextBlock Classes="captionText" Text="{Binding Code}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Classes="infoText"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding ExportStatus}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="3" Margin="22,16,22,18" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <StackPanel
            IsVisible="{Binding IsSystemInformationSelected}"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="semanticAction secondary"
              AutomationProperties.Name="{Binding Text.RefreshDiagnosticsLabel}"
              Command="{Binding RefreshCommand}"
              Content="{Binding RefreshActionLabel}" />
          <Button
              Classes="semanticAction secondary"
              AutomationProperties.Name="{Binding Text.ExportDiagnosticsLabel}"
              Click="ExportDiagnosticsButton_OnClick"
              Content="{Binding Text.ExportDiagnosticsLabel}" />
        </StackPanel>
        <Button
            Grid.Column="1"
            Classes="semanticAction secondary"
            Command="{Binding CloseCommand}"
            Content="{Binding Text.CloseLabel}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
