<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.CtrlRamFirmwareVersionModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:ReplacePresentationViewModel"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="640"
      Padding="24"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      BorderBrush="{DynamicResource NfcAccentBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="{DynamicResource NfcSpace4}">
        <TextBlock Classes="modalTitle" Text="{Binding Text.CtrlRamFirmwareVersionTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding Text.CtrlRamFirmwareVersionDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource NfcSpace12}">
        <ToggleButton
            AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionKeepLabel}"
            Classes="segment versionChoice"
            Command="{Binding SelectCtrlRamFirmwareVersionPreserveCommand}"
            IsChecked="{Binding IsCtrlRamFirmwareVersionPreserveSelected, Mode=OneWay}">
          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
            <Path Data="M3 9L7 13L15 5" />
            <TextBlock Text="{Binding Text.CtrlRamFirmwareVersionKeepLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton
            Grid.Column="1"
            AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionEditLabel}"
            Classes="segment versionChoice"
            Command="{Binding SelectCtrlRamFirmwareVersionEditCommand}"
            IsChecked="{Binding IsCtrlRamFirmwareVersionEditSelected, Mode=OneWay}"
            IsEnabled="{Binding CanEditCtrlRamFirmwareVersion}">
          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
            <Path Data="M4 14L5 10L12.5 2.5L15.5 5.5L8 13Z M11 4L14 7" />
            <TextBlock Text="{Binding Text.CtrlRamFirmwareVersionEditLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </Grid>

      <Border Grid.Row="2" Classes="versionSummaryCard">
        <StackPanel Spacing="{DynamicResource NfcSpace12}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
            <StackPanel Spacing="{DynamicResource NfcSpace4}">
              <TextBlock Classes="fieldLabel" Text="{Binding Text.CtrlRamFirmwareVersionCurrentLabel}" />
              <TextBlock Classes="detailText" Text="{Binding CtrlRamFirmwareVersionMetadataDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="versionValueBadge" VerticalAlignment="Top">
              <TextBlock Classes="technicalValue versionValue" Text="{Binding CtrlRamFirmwareVersionCurrentValue}" />
            </Border>
          </Grid>
          <Grid
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource NfcSpace12}"
              IsVisible="{Binding IsCtrlRamFirmwareVersionEditSelected}">
            <StackPanel Spacing="5">
              <TextBlock Classes="fieldLabel" Text="{Binding Text.CtrlRamFirmwareVersionByteLabel}" />
              <TextBox
                  Classes="technicalCenteredInput hexByteInput"
                  AutomationProperties.Name="{Binding Text.CtrlRamFirmwareVersionByteLabel}"
                  Text="{Binding CtrlRamFirmwareVersionText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="fieldLabel" Text="{Binding Text.CtrlRamFirmwareSubVersionByteLabel}" />
              <TextBox
                  Classes="technicalCenteredInput hexByteInput"
                  AutomationProperties.Name="{Binding Text.CtrlRamFirmwareSubVersionByteLabel}"
                  Text="{Binding CtrlRamFirmwareSubVersionText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <TextBlock
              Classes="warningText"
              IsVisible="{Binding HasCtrlRamFirmwareVersionValidation}"
              Text="{Binding CtrlRamFirmwareVersionValidationDetail}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            Classes="secondary"
            Command="{Binding CloseCtrlRamFirmwareVersionCommand}"
            Content="{Binding Text.CloseLabel}" />
        <Button
            Classes="primary"
            Click="ConfirmCtrlRamFirmwareVersionBuildButton_OnClick"
            Content="{Binding Text.CtrlRamFirmwareVersionChooseOutputLabel}"
            IsEnabled="{Binding CanConfirmCtrlRamFirmwareVersion}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
