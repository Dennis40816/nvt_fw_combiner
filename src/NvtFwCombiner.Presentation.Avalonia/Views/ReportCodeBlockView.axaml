<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.ReportCodeBlockView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
  <Border Classes="compactSubtleSurface" Padding="8,6">
    <Grid RowDefinitions="Auto,*" RowSpacing="4">
      <Button
          Grid.Row="0"
          Classes="iconButton codeBlockCopy"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text.CopyCommandTooltip}"
          Click="CopyButton_OnClick"
          ToolTip.Tip="{ReflectionBinding $parent[Window].DataContext.Text.CopyCommandTooltip}">
        <Path
            Width="14"
            Height="14"
            Data="M5,3 L13,3 L13,11 L5,11 Z M3,5 L3,13 L11,13 L11,11"
            Stroke="{DynamicResource NfcTextBrush}"
            StrokeJoin="Round"
            StrokeThickness="1.5" />
      </Button>
      <TextBlock Grid.Row="1" Classes="technicalCompactDetail" Foreground="{DynamicResource NfcTextStrongBrush}" Text="{Binding Text, ElementName=Root}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
