<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.HexEditorSaveModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:HexEditorWorkspaceViewModel"
    Background="#660F172A">
  <Border
      Classes="modalSurface"
      Width="540"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      BorderBrush="#2563EB">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
      <StackPanel Spacing="7">
        <TextBlock Classes="modalTitle" Text="{Binding Text.HexEditorSaveConfirmationTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding Text.HexEditorSaveConfirmationDetail}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Command="{Binding CancelSaveCommand}" Content="{Binding Text.CloseLabel}" />
        <Button Classes="primary" Click="ConfirmHexEditorSaveButton_OnClick" Content="{Binding Text.HexEditorSaveConfirmationActionLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
