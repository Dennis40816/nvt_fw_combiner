<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.ReplaceSelectionModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:ReplacePresentationViewModel"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="720"
      MaxHeight="640"
      Padding="20"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="modalTitle" Text="{Binding Text.ReplaceSelectionTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding ReplaceSelectionSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <Button
            Grid.Column="1"
            Classes="semanticAction iconButton"
            Command="{Binding CloseReplaceSelectionCommand}"
            ToolTip.Tip="{Binding Text.CloseSelectionTooltip}">
          <TextBlock Text="×" />
        </Button>
      </Grid>

      <Border Grid.Row="1" Classes="subtlePanel contentPanel">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource NfcSpace12}">
          <Border Width="8" Height="38" VerticalAlignment="Top" Background="{DynamicResource NfcAccentBrush}" CornerRadius="{DynamicResource NfcPillCornerRadius}" />
          <StackPanel Grid.Column="1" Spacing="3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
              <TextBlock Classes="cardTitle" Text="{Binding ReplaceSelectionCountLabel}" />
              <TextBlock Grid.Column="1" Classes="infoText" Text="{Binding ReplaceSelectionStatusLabel}" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Classes="mutedText" Text="{Binding ReplaceSelectionRunHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="fieldLabel" Text="{Binding Text.SelectedReplacementsTitle}" />
            <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionRows}">
              <ItemsControl.ItemTemplate>
                <StaticResource ResourceKey="ReportSelectionRowTemplate" />
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Classes="warningSurface contentPanel" IsVisible="{Binding HasReplaceSelectionMissingRows}">
            <StackPanel Spacing="{DynamicResource NfcSpace8}">
              <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource NfcWarningTextBrush}" Text="{Binding Text.RequiredBeforeBuildTitle}" />
              <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionMissingRows}">
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="ReportMissingRequiredRowTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            Classes="semanticAction secondary"
            Command="{Binding CloseReplaceSelectionCommand}"
            Content="{Binding Text.CloseLabel}" />
        <Button
            Classes="semanticAction primary"
            Click="BuildReplaceButton_OnClick"
            Content="{Binding Text.BuildActionLabel}"
            IsEnabled="{Binding CanBuildReplace}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
