<UserControl
    x:Class="NvtFwCombiner.Presentation.Avalonia.Views.BuildCompletedModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    AutomationProperties.Name="{Binding Text.BuildCompletedTitle}"
    Background="{DynamicResource NfcModalScrimBrush}">
  <Border
      Classes="modalSurface"
      Width="580"
      Padding="22"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="5">
        <TextBlock Classes="modalTitle" Text="{Binding Text.BuildCompletedTitle}" />
        <TextBlock Classes="mutedText" Text="{Binding Text.BuildCompletedDetail}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Classes="subtleSurface" Padding="12,10">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="fieldLabel" Text="{Binding Text.BuildCompletedOutputLabel}" />
          <Button
              AutomationProperties.HelpText="{Binding BuildResult.OutputPath}"
              AutomationProperties.Name="{Binding BuildResult.OutputDisplayName}"
              Classes="fileRevealAction"
              Command="{Binding BuildResult.RevealOutputCommand}"
              Content="{Binding BuildResult.OutputDisplayName}"
              HorizontalAlignment="Left"
              Tag="{Binding BuildResult.OutputPath}"
              ToolTip.Tip="{Binding BuildResult.OutputPath}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="subtleSurface" IsVisible="{Binding BuildResult.HasAdditionalOutput}" Padding="12,10">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="fieldLabel" Text="{Binding Text.BuildCompletedAdditionalOutputLabel}" />
          <Button
              AutomationProperties.HelpText="{Binding BuildResult.AdditionalOutputPath}"
              AutomationProperties.Name="{Binding BuildResult.AdditionalOutputDisplayName}"
              Classes="fileRevealAction"
              Command="{Binding RevealFileCommand}"
              CommandParameter="{Binding BuildResult.AdditionalOutputPath}"
              Content="{Binding BuildResult.AdditionalOutputDisplayName}"
              HorizontalAlignment="Left"
              Tag="{Binding BuildResult.AdditionalOutputPath}"
              ToolTip.Tip="{Binding BuildResult.AdditionalOutputPath}" />
        </StackPanel>
      </Border>

      <TextBlock
          Grid.Row="3"
          Classes="warningText"
          AutomationProperties.LiveSetting="Polite"
          IsVisible="{Binding BuildResult.HasOpenFolderError}"
          Text="{Binding BuildResult.OpenFolderError}"
          TextWrapping="Wrap" />

      <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            Classes="semanticAction secondary"
            AutomationProperties.Name="{Binding Text.BuildCompletedOpenFolderLabel}"
            Command="{Binding BuildResult.RevealOutputCommand}"
            Content="{Binding Text.BuildCompletedOpenFolderLabel}" />
        <Button
            Classes="semanticAction primary"
            AutomationProperties.Name="{Binding Text.BuildCompletedOkLabel}"
            Command="{Binding BuildResult.CloseCommand}"
            Content="{Binding Text.BuildCompletedOkLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
