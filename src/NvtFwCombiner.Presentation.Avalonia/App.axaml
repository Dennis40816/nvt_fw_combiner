<Application
    x:Class="NvtFwCombiner.Presentation.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowControlStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MessageCenterStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/SettingsVersionStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MemoryCoverageStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/FirmwareSlotExperienceStyles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/ThemeTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
