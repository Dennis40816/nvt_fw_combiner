<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportModalHeaderTemplate" DataType="vm:MainWindowViewModel">
  <Border Padding="22,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="5">
        <TextBlock Classes="modalTitle" Text="{Binding LoadedReport.Title}" TextWrapping="Wrap" />
        <TextBlock Classes="mutedText" Text="{Binding LoadedReport.Subtitle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button
            Classes="iconButton"
            Command="{Binding CloseReportCommand}"
            ToolTip.Tip="{Binding Text.CloseReportTooltip}">
          <TextBlock Text="×" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHistoryPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border
      Classes="surface"
      Margin="16,14,16,0"
      Padding="16">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.ReportHistoryTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding ReportHistorySummary}" />
          <TextBlock Classes="captionText" Text="{Binding ReportHistoryStorageSummary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary" Command="{Binding CloseReportHistoryCommand}" Content="{Binding Text.BackToReportLabel}" />
          <Button
              Classes="danger"
              Command="{Binding ClearReportHistoryCommand}"
              Content="{Binding Text.ClearAllLabel}"
              ToolTip.Tip="{Binding Text.ClearHistoryTooltip}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Classes="warningSurface" Padding="10" IsVisible="{Binding HasReportHistoryStorageWarning}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock FontSize="12" Foreground="#9A3412" Text="{Binding ReportHistoryStorageWarning}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="danger" Command="{Binding ClearReportHistoryCommand}" Content="{Binding Text.ClearHistoryLabel}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="subtleSurface roomyPanel" IsVisible="{Binding IsReportHistoryEmpty}">
        <TextBlock Classes="supportingText" Text="{Binding Text.NoReportHistoryLabel}" />
      </Border>

      <ScrollViewer Grid.Row="2" IsVisible="{Binding HasReportHistory}">
        <Border Padding="0,0,4,0">
          <ItemsControl ItemsSource="{Binding ReportHistoryEntries}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportHistoryEntryTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </ScrollViewer>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportSummaryPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Classes="surface" Margin="16,14,16,0" Padding="0">
    <Expander IsExpanded="False">
      <Expander.Header>
        <Grid Margin="16,12" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
          <Grid Width="32" Height="32" AutomationProperties.Name="{Binding LoadedReport.OutcomeAccessibilityLabel}">
            <Border Background="#16A34A" CornerRadius="999" IsVisible="{Binding LoadedReport.IsClean}" />
            <Border Background="#D97706" CornerRadius="999" IsVisible="{Binding LoadedReport.HasWarningsWithoutBlockingIssues}" />
            <Border Background="#EA580C" CornerRadius="999" IsVisible="{Binding LoadedReport.HasPrimaryIssue}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                Text="{Binding LoadedReport.OutcomeIcon}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="tableHeader" Text="{Binding Text.RunLabel}" />
            <TextBlock Classes="cardTitle" Text="{Binding LoadedReport.OutcomeTitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Label Grid.Column="2" Classes="reportBadge" Content="{Binding LoadedReport.OutcomeMeta}" />
          <Button
              Grid.Column="3"
              Classes="iconButton"
              VerticalAlignment="Center"
              AutomationProperties.Name="{Binding Text.OpenReportHistoryAutomationName}"
              Command="{Binding ShowReportHistoryCommand}"
              IsVisible="{Binding HasReportHistory}"
              ToolTip.Tip="{Binding Text.OpenReportHistoryTooltip}">
            <Path
                Width="16"
                Height="16"
                Data="M10,2 A8,8 0 1 1 2,10 M2,10 L2,4 M2,10 L8,10 M10,6 L10,10 L13,12"
                Stretch="Uniform"
                Stroke="#475569"
                StrokeThickness="1.7" />
          </Button>
        </Grid>
      </Expander.Header>

      <Grid Margin="16,0,16,16" RowDefinitions="Auto,Auto" RowSpacing="14">
        <StackPanel Spacing="3">
          <TextBlock Classes="bodyText" Text="{Binding LoadedReport.OutcomeDetail}" TextWrapping="Wrap" />
          <TextBlock Classes="compactStrongText" Text="{Binding LoadedReport.NextStepTitle}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding LoadedReport.NextStepDetail}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*">
        <Border Padding="16" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="fieldLabel" Text="{Binding Text.OutputLabel}" />
            <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
              <TextBlock Classes="tableHeader" Text="{Binding Text.FileLabel}" />
              <TextBlock Grid.Column="1" Classes="bodyStrongText" Text="{Binding LoadedReport.OutputFileName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Classes="tableHeader" Text="{Binding Text.SizeLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="technicalDetail" Text="{Binding LoadedReport.OutputSizeLabel}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Classes="tableHeader" Text="{Binding Text.StateLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#166534" Text="{Binding LoadedReport.OutputCommitmentLabel}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.IsOutputCommitted}" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" Text="{Binding LoadedReport.OutputCommitmentLabel}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.IsOutputPreview}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="sectionLabel" Text="{Binding LoadedReport.OutputCommitmentLabel}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.IsOutputStateUnknown}" />
            </Grid>
            <TextBlock Classes="captionText" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="16">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Classes="fieldLabel" Text="{Binding Text.ChangeReviewTitle}" />
                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.ByteDifferenceTitle}" TextWrapping="Wrap" />
              </StackPanel>
              <Label Grid.Column="1" Classes="reportBadge large" Content="{Binding LoadedReport.ByteDifferenceMeta}" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
              <TextBlock Classes="detailText" Text="{Binding LoadedReport.ByteDifferenceDetail}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding LoadedReport.OutputDifferenceSummaryRows}">
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="ReportDifferenceSummaryRowTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
        </Grid>
      </Grid>
    </Expander>
  </Border>
</DataTemplate>
</ResourceDictionary>
