<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Classes="listRow" Padding="0,9">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          MinWidth="26"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="{DynamicResource NfcTechnicalFontFamily}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding Count}" />
      <Label Grid.Column="2" Classes="compactBadge neutralBadge reportBadge" Content="{Binding Status}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffViewportRowTemplate" DataType="vm:ReportHexDiffViewportRowViewModel">
  <Border
      Classes="reportHexDiffRow"
      Classes.changed="{Binding HasChanges}"
      AutomationProperties.Name="{Binding AccessibleLabel}">
    <StackPanel>
      <Grid ColumnDefinitions="112,*,112,Auto" ColumnSpacing="10">
        <TextBlock Classes="technicalCompactValue" Text="{Binding Address}" />
        <TextBlock Grid.Column="1" Classes="technicalCompactValue" Text="{Binding OutputHex}" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="2" Classes="technicalCompactDetail" Text="{Binding OutputAscii}" TextWrapping="NoWrap" />
        <Label
            Grid.Column="3"
            Classes="compactBadge neutralBadge reportBadge review"
            Content="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffChangedRowLabel}"
            IsVisible="{Binding HasChanges}" />
      </Grid>
      <Border
          Classes="reportHexDiffReferenceRow"
          IsVisible="{Binding IsOriginalVisible}">
        <Grid ColumnDefinitions="112,*,112" ColumnSpacing="10">
          <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffReferenceRowLabel}" />
          <TextBlock Grid.Column="1" Classes="technicalCompactDetail" Text="{Binding OriginalHex}" TextWrapping="NoWrap" />
          <TextBlock Grid.Column="2" Classes="technicalCompactDetail" Text="{Binding OriginalAscii}" TextWrapping="NoWrap" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffRangeRowTemplate" DataType="vm:ReportHexDiffRangeViewModel">
  <RadioButton
      Classes="reportHexDiffRange"
      AutomationProperties.Name="{Binding AccessibleLabel}"
      AutomationProperties.HelpText="{Binding Reason}"
      Command="{ReflectionBinding $parent[Window].DataContext.LoadedReport.HexDiff.SelectRangeCommand}"
      CommandParameter="{Binding}"
      GroupName="ReportHexDiffRangeNavigator"
      IsChecked="{Binding IsSelected, Mode=OneWay}"
      ToolTip.Tip="{Binding Reason}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3">
        <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="technicalCaption" Text="{Binding AccessibleRange}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding ChangedSummary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
        <Label
            Classes="compactBadge neutralBadge reportBadge info"
            Content="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffSelectedRangeLabel}"
            IsVisible="{Binding IsSelected}" />
        <Label
            Classes="compactBadge neutralBadge reportBadge success"
            Classes.review="{Binding IsReviewRequired}"
            Content="{Binding Status}" />
      </StackPanel>
    </Grid>
  </RadioButton>
</DataTemplate>

<DataTemplate x:Key="ReportOutputDifferenceGroupTemplate" DataType="vm:ReportDifferenceGroupViewModel">
  <Expander Margin="0,0,0,10" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
    <Expander.Header>
      <Border Classes="reportInputGroupHeader">
        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
          <Border Background="{DynamicResource NfcAccentBrush}" CornerRadius="2" />
          <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
            <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
            <Label MinWidth="28" Classes="compactBadge neutralBadge reportBadge info" Content="{Binding Count}" />
            <Label Classes="compactBadge neutralBadge reportBadge success" Content="{Binding Status}" IsVisible="{Binding IsAccepted}" />
            <Label Classes="compactBadge neutralBadge reportBadge review" Content="{Binding Status}" IsVisible="{Binding IsReviewRequired}" />
          </StackPanel>
        </Grid>
      </Border>
    </Expander.Header>
    <StackPanel>
      <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RowsPage.Items}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportOutputDifferenceRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ContentControl Content="{Binding RowsPage}" ContentTemplate="{StaticResource ReportPagerTemplate}" />
    </StackPanel>
  </Expander>
</DataTemplate>

<DataTemplate x:Key="ReportOutputDifferenceRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="0,8" BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="0,1,0,0">
    <Expander IsExpanded="False">
      <Expander.Header>
        <Grid Margin="0,2" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="3">
            <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock FontSize="{DynamicResource NfcFontSize11}" Foreground="{DynamicResource NfcTextSecondaryBrush}" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
              <TextBlock Classes="technicalCaption" Text="{Binding Range}" TextWrapping="Wrap" IsVisible="{Binding HasRange}" />
              <TextBlock Classes="tableHeader" Text="{Binding ChangedSummary}" TextWrapping="Wrap" IsVisible="{Binding HasChangedSummary}" />
            </StackPanel>
          </StackPanel>
          <ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineBadgeTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Expander.Header>
      <Border Margin="0,8,0,2" Padding="12,10" Background="{DynamicResource NfcSurfaceSubtleBrush}" BorderBrush="{DynamicResource NfcInfoBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource NfcCompactCornerRadius}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasBeforeAfter}">
            <StackPanel Spacing="{DynamicResource NfcSpace4}">
              <TextBlock Classes="tableHeader" Text="{Binding BeforeLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="technicalValue" Text="{Binding BeforeValue}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace4}">
              <TextBlock FontSize="{DynamicResource NfcFontSize10}" FontWeight="SemiBold" Foreground="{DynamicResource NfcSuccessTextBrush}" Text="{Binding AfterLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="technicalValue" Text="{Binding AfterValue}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineFactTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Expander>
  </Border>
</DataTemplate>
</ResourceDictionary>
