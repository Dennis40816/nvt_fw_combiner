<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<ControlTheme x:Key="ReportHexDiffRangeCardTheme" TargetType="RadioButton">
  <Setter Property="MinHeight" Value="54" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="Padding" Value="12,10" />
  <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border
          Name="PART_RangeCard"
          Padding="{TemplateBinding Padding}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
          <Border
              Name="PART_SelectedRail"
              Width="3"
              Background="Transparent"
              CornerRadius="{DynamicResource NfcPillCornerRadius}" />
          <ContentPresenter
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Stretch"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
  <Style Selector="^:pointerover /template/ Border#PART_RangeCard">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
  </Style>
  <Style Selector="^:checked /template/ Border#PART_RangeCard">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="^:checked /template/ Border#PART_SelectedRail">
    <Setter Property="Background" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="^:focus-visible /template/ Border#PART_RangeCard">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="^:disabled /template/ Border#PART_RangeCard">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</ControlTheme>

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Classes="listRow" Padding="0,9">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          MinWidth="26"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="{DynamicResource NfcTechnicalFontFamily}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding Count}" />
      <Label Grid.Column="2" Classes="compactBadge neutralBadge reportBadge" Content="{Binding Status}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffRangeRowTemplate" DataType="vm:ReportHexDiffRangeViewModel">
  <RadioButton
      Classes="reportHexDiffRange"
      AutomationProperties.Name="{Binding AccessibleLabel}"
      AutomationProperties.HelpText="{Binding Reason}"
      Command="{ReflectionBinding $parent[Window].DataContext.Reports.LoadedReport.HexDiff.SelectRangeCommand}"
      CommandParameter="{Binding}"
      GroupName="ReportHexDiffRangeNavigator"
      IsChecked="{Binding IsSelected, Mode=OneWay}"
      Margin="0,0,0,8"
      Theme="{StaticResource ReportHexDiffRangeCardTheme}"
      ToolTip.Tip="{Binding Reason}">
    <StackPanel Spacing="{DynamicResource NfcSpace8}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="3">
          <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="technicalCaption" Text="{Binding AccessibleRange}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding ChangedSummary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
          <Label
              Classes="compactBadge neutralBadge reportBadge info"
              Content="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffSelectedRangeLabel}"
              IsVisible="{Binding IsSelected}" />
          <Label
              Classes="compactBadge neutralBadge reportBadge success"
              Classes.review="{Binding IsReviewRequired}"
              Content="{Binding Status}" />
        </StackPanel>
      </Grid>
      <Grid
          ColumnDefinitions="76,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="{DynamicResource NfcSpace8}"
          RowSpacing="6"
          IsVisible="{Binding IsSelected}">
        <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.PrimaryReasonLabel}" />
        <TextBlock Grid.Column="1" Classes="bodyText" Text="{Binding Reason}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.ResultLabel}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="bodyStrongText" Text="{Binding Status}" TextWrapping="Wrap" />
      </Grid>
    </StackPanel>
  </RadioButton>
</DataTemplate>

</ResourceDictionary>
