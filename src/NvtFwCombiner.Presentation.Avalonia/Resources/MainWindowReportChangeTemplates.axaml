<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Classes="listRow" Padding="0,9">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          MinWidth="26"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="{DynamicResource NfcTechnicalFontFamily}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding Count}" />
      <Label Grid.Column="2" Classes="compactBadge neutralBadge reportBadge" Content="{Binding Status}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffViewportRowTemplate" DataType="vm:ReportHexDiffViewportRowViewModel">
  <Border
      Classes="reportHexDiffRow"
      AutomationProperties.Name="{Binding AccessibleLabel}">
    <StackPanel>
      <Grid ColumnDefinitions="112,*,152" ColumnSpacing="10">
        <TextBlock Classes="technicalCompactValue" Text="{Binding Address}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding OutputBytes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReportHexDiffByteViewModel">
              <Border Classes="reportHexDiffByte" Classes.changed="{Binding IsChanged}">
                <TextBlock Classes="technicalCompactValue" Text="{Binding Hex}" TextAlignment="Center" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Grid.Column="2" ItemsSource="{Binding OutputBytes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReportHexDiffByteViewModel">
              <Border Classes="reportHexDiffAsciiByte" Classes.changed="{Binding IsChanged}">
                <TextBlock Classes="technicalCompactDetail" Text="{Binding Ascii}" TextAlignment="Center" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <Border
          Classes="reportHexDiffReferenceRow"
          IsVisible="{Binding IsOriginalVisible}">
        <Grid ColumnDefinitions="112,*,152" ColumnSpacing="10">
          <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffReferenceRowLabel}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding OriginalBytes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportHexDiffByteViewModel">
                <Border Classes="reportHexDiffOriginalByte" Classes.changed="{Binding IsChanged}">
                  <TextBlock Classes="technicalCompactDetail" Text="{Binding Hex}" TextAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding OriginalBytes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportHexDiffByteViewModel">
                <Border Classes="reportHexDiffOriginalByte" Classes.changed="{Binding IsChanged}">
                  <TextBlock Classes="technicalCompactDetail" Text="{Binding Ascii}" TextAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffNavigatorPagerTemplate" DataType="vm:ReportWindowedListViewModel">
  <Grid
      Margin="0,8,0,0"
      ColumnDefinitions="Auto,*,Auto"
      ColumnSpacing="{DynamicResource NfcSpace8}"
      IsVisible="{Binding HasMultiplePages}">
    <Button
        Width="32"
        Height="32"
        Padding="0"
        Classes="iconButton"
        Command="{Binding PreviousPageCommand}"
        AutomationProperties.Name="{Binding PreviousPageLabel}"
        ToolTip.Tip="{Binding PreviousPageLabel}">
      <Path
          Width="16"
          Height="16"
          Data="M11 3L5 8L11 13"
          Stroke="{DynamicResource NfcTextStrongBrush}"
          StrokeLineCap="Round"
          StrokeJoin="Round"
          StrokeThickness="1.8" />
    </Button>
    <TextBlock
        Grid.Column="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Classes="captionText"
        Text="{Binding PageStatus}"
        AutomationProperties.Name="{Binding PageStatus}"
        AutomationProperties.LiveSetting="Polite" />
    <Button
        Grid.Column="2"
        Width="32"
        Height="32"
        Padding="0"
        Classes="iconButton"
        Command="{Binding NextPageCommand}"
        AutomationProperties.Name="{Binding NextPageLabel}"
        ToolTip.Tip="{Binding NextPageLabel}">
      <Path
          Width="16"
          Height="16"
          Data="M5 3L11 8L5 13"
          Stroke="{DynamicResource NfcTextStrongBrush}"
          StrokeLineCap="Round"
          StrokeJoin="Round"
          StrokeThickness="1.8" />
    </Button>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffRangeRowTemplate" DataType="vm:ReportHexDiffRangeViewModel">
  <RadioButton
      Classes="reportHexDiffRange"
      AutomationProperties.Name="{Binding AccessibleLabel}"
      AutomationProperties.HelpText="{Binding Reason}"
      Command="{ReflectionBinding $parent[Window].DataContext.LoadedReport.HexDiff.SelectRangeCommand}"
      CommandParameter="{Binding}"
      GroupName="ReportHexDiffRangeNavigator"
      IsChecked="{Binding IsSelected, Mode=OneWay}"
      ToolTip.Tip="{Binding Reason}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3">
        <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="technicalCaption" Text="{Binding AccessibleRange}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding ChangedSummary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
        <Label
            Classes="compactBadge neutralBadge reportBadge info"
            Content="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffSelectedRangeLabel}"
            IsVisible="{Binding IsSelected}" />
        <Label
            Classes="compactBadge neutralBadge reportBadge success"
            Classes.review="{Binding IsReviewRequired}"
            Content="{Binding Status}" />
      </StackPanel>
    </Grid>
  </RadioButton>
</DataTemplate>

</ResourceDictionary>
