<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<ControlTheme x:Key="ReportHexDiffRangeCardTheme" TargetType="ListBoxItem">
  <Setter Property="MinHeight" Value="54" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="Padding" Value="14,8" />
  <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  <Setter Property="Margin" Value="0,0,6,8" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border
          Name="PART_RangeCard"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
        <Grid>
          <Border
              Name="PART_SelectedRail"
              Width="3"
              HorizontalAlignment="Left"
              Background="Transparent"
              CornerRadius="{DynamicResource NfcPillCornerRadius}" />
          <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Stretch"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
  <Style Selector="^:pointerover /template/ Border#PART_RangeCard">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
  </Style>
  <Style Selector="^:selected /template/ Border#PART_RangeCard">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="^:selected /template/ Border#PART_SelectedRail">
    <Setter Property="Background" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="^:focus-visible /template/ Border#PART_RangeCard">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="^:disabled /template/ Border#PART_RangeCard">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</ControlTheme>

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Classes="listRow" Padding="0,9">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          MinWidth="26"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="{DynamicResource NfcTechnicalFontFamily}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding Count}" />
      <Label Grid.Column="2" Classes="compactBadge neutralBadge reportBadge" Content="{Binding Status}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportHexDiffRangeRowTemplate" DataType="vm:ReportHexDiffRangeViewModel">
  <StackPanel
      AutomationProperties.Name="{Binding AccessibleLabel}"
      AutomationProperties.HelpText="{Binding Reason}"
      Spacing="{DynamicResource NfcSpace8}"
      ToolTip.Tip="{Binding Reason}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Classes="bodyStrongText" FontSize="{DynamicResource NfcFontSize13}" VerticalAlignment="Center" Text="{Binding ChangedSummary}" />
      <Label
          Grid.Column="1"
          Classes="compactBadge neutralBadge reportBadge"
          Classes.review="{Binding IsReviewRequired}"
          Classes.success="{Binding IsAccepted}"
          Content="{Binding Status}"
          VerticalAlignment="Center" />
    </Grid>
    <TextBlock Classes="technicalDetail" Text="{Binding DisplayRange}" TextWrapping="Wrap" />
    <Border
        Padding="0,8,0,0"
        BorderBrush="{DynamicResource NfcBorderBrush}"
        BorderThickness="0,1,0,0"
        IsVisible="{Binding IsSelected}">
      <StackPanel Spacing="{DynamicResource NfcSpace8}">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="bodyStrongText" Text="{ReflectionBinding $parent[Window].DataContext.Text.HexDiffWhyLabel}" />
          <TextBlock Classes="bodyText" Text="{Binding Reason}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <TextBlock Classes="bodyStrongText" Text="{ReflectionBinding $parent[Window].DataContext.Text.ResultLabel}" />
          <TextBlock Classes="bodyText" Text="{Binding Result}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Classes="technicalCaption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}" AutomationProperties.Name="{Binding $self.Text}">
      <TextBlock.Text>
        <MultiBinding StringFormat="{}{0} · {1}">
          <Binding Path="OutputSpaceId" /><Binding Path="TraceId" />
        </MultiBinding>
      </TextBlock.Text>
    </TextBlock>
  </StackPanel>
</DataTemplate>

</ResourceDictionary>
