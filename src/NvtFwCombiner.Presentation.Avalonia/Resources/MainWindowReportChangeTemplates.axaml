<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Classes="listRow" Padding="0,9">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="2">
        <TextBlock Classes="bodyStrongText" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          MinWidth="26"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="Cascadia Mono, Consolas"
          FontWeight="SemiBold"
          Foreground="#0F172A"
          Text="{Binding Count}" />
      <Label Grid.Column="2" Classes="reportBadge" Content="{Binding Status}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="2">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportOutputDifferenceGroupTemplate" DataType="vm:ReportDifferenceGroupViewModel">
  <Border Margin="0,0,0,14" Padding="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding HasSharedReason}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
          <Label MinWidth="28" Classes="reportBadge" Content="{Binding Count}" />
          <Label Classes="reportBadge success" Content="{Binding Status}" IsVisible="{Binding IsAccepted}" />
          <Label Classes="reportBadge review" Content="{Binding Status}" IsVisible="{Binding IsReviewRequired}" />
        </StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportOutputDifferenceRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportOutputDifferenceRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="0,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
    <Expander>
      <Expander.Header>
        <Grid Margin="0,2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#475569" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="technicalCaption" Text="{Binding Range}" TextWrapping="Wrap" IsVisible="{Binding HasRange}" />
              <TextBlock Classes="tableHeader" Text="{Binding ChangedSummary}" TextWrapping="Wrap" IsVisible="{Binding HasChangedSummary}" />
            </StackPanel>
          </StackPanel>
          <ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineBadgeTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Expander.Header>
      <Border Margin="0,8,0,2" Padding="12,10" Background="#F8FAFC" BorderBrush="#D7E2F1" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasBeforeAfter}">
            <StackPanel Spacing="4">
              <TextBlock Classes="tableHeader" Text="{Binding BeforeLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="technicalValue" Text="{Binding BeforeValue}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#166534" Text="{Binding AfterLabel}" TextWrapping="Wrap" />
              <TextBlock Classes="technicalValue" Text="{Binding AfterValue}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineFactTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Expander>
  </Border>
</DataTemplate>
</ResourceDictionary>
