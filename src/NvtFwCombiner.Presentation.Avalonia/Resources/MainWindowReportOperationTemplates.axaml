<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportOperationFlowNodeTemplate" DataType="vm:ReportOperationFlowNodeViewModel">
  <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
    <Grid>
      <Border
          Width="2"
          HorizontalAlignment="Center"
          Background="#BFDBFE"
          IsVisible="{Binding HasConnector}" />
      <Border Width="32" Height="32" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="999">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Number}" />
      </Border>
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,3,0,18" MaxWidth="860" HorizontalAlignment="Left" Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
        <Label Grid.Column="1" MinWidth="44" Classes="reportBadge" Content="{Binding Status}" />
      </Grid>
      <TextBlock FontSize="12" Foreground="#475569" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportRangeTableTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="compactSubtleSurface" Padding="9,8">
    <StackPanel Spacing="5">
      <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeTableTitle}" />
      <ItemsControl ItemsSource="{Binding RangeRows}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportRangeTableRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportCommandOperationTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="34,*">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#BFDBFE" />
      <Border
          Width="16"
          Height="16"
          Margin="0,10,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="#2563EB"
          BorderBrush="#DBEAFE"
          BorderThickness="2"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,6,0,16" Spacing="7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
        <Label Grid.Column="1" MinWidth="52" Classes="reportBadge info" Content="{Binding OperationStatus}" />
      </Grid>
      <TextBlock Classes="bodyText" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
      <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineBadgeTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ContentControl
          Content="{Binding}"
          ContentTemplate="{StaticResource ReportRangeTableTemplate}"
          IsVisible="{Binding HasRangeRows}" />
      <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.CommandArgvLabel}" IsVisible="{Binding HasCodeBlock}" />
      <Border Classes="compactSubtleSurface" Padding="8,6" IsVisible="{Binding HasCodeBlock}">
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding CodeBlock}" TextWrapping="Wrap" />
      </Border>
      <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportStepOperationTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="34,*">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#CBD5E1" />
      <Border
          Width="13"
          Height="13"
          Margin="0,11,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="#64748B"
          BorderBrush="#F8FAFC"
          BorderThickness="2"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,6,0,16" Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
        <Label Grid.Column="1" MinWidth="52" Classes="reportBadge" Content="{Binding OperationStatus}" />
      </Grid>
      <TextBlock Classes="technicalDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
      <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineBadgeTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ContentControl
          Content="{Binding}"
          ContentTemplate="{StaticResource ReportRangeTableTemplate}"
          IsVisible="{Binding HasRangeRows}" />
      <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</DataTemplate>
</ResourceDictionary>
