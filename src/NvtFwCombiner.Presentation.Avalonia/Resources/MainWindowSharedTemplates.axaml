<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">

<ControlTheme x:Key="StretchContentPresenterTheme" TargetType="ContentPresenter">
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
</ControlTheme>

<ControlTheme x:Key="ProportionalContentPresenterTheme" TargetType="ContentPresenter">
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="views:ProportionalStackPanel.Weight" Value="{ReflectionBinding BarWidth}" />
</ControlTheme>

<DataTemplate x:Key="ForegroundLoadingStatusTemplate" DataType="vm:ForegroundLoadingState">
  <Border
      AutomationProperties.LiveSetting="Polite"
      AutomationProperties.Name="{Binding AccessibleStatus}"
      Padding="{Binding $parent[ContentControl].Padding}"
      Background="{DynamicResource NfcSurfaceBrush}"
      BorderBrush="{DynamicResource NfcBorderSoftBrush}"
      BorderThickness="2"
      BoxShadow="{DynamicResource NfcWorkflowCardHoverShadow}"
      CornerRadius="{DynamicResource NfcSurfaceCornerRadius}">
    <StackPanel Spacing="{DynamicResource NfcSpace12}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{DynamicResource NfcTextStrongBrush}"
            Text="{Binding Title}"
            TextWrapping="Wrap" />
        <TextBlock
            Grid.Column="1"
            FontSize="{DynamicResource NfcFontSize13}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource NfcAccentStrongBrush}"
            IsVisible="{Binding HasDeterminateProgress}"
            Text="{Binding ProgressPercentLabel}" />
      </Grid>
      <TextBlock
          FontSize="{DynamicResource NfcFontSize13}"
          Foreground="{DynamicResource NfcTextMutedBrush}"
          Text="{Binding Detail}"
          TextWrapping="Wrap" />
      <ProgressBar
          Height="5"
          Maximum="1"
          Foreground="{DynamicResource NfcAccentBrush}"
          IsIndeterminate="{Binding ShouldAnimate}"
          IsVisible="{Binding IsRunning}"
          Value="{Binding Progress}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            Classes="semanticAction secondary"
            Command="{Binding CancelCommand}"
            Content="{Binding CancelLabel}"
            IsVisible="{Binding CanCancel}" />
        <Button
            Classes="semanticAction primary"
            behaviors:FocusOnRevealBehavior.IsEnabled="True"
            Command="{Binding RetryCommand}"
            Content="{Binding RetryLabel}"
            IsVisible="{Binding CanRetry}" />
      </StackPanel>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="DisclosureStatusTemplate" DataType="vm:DisclosureStatusViewModel">
  <Border
      AutomationProperties.Name="{Binding AccessibleLabel}"
      Classes="statusNotice"
      Classes.error="{Binding IsError}"
      Classes.info="{Binding IsInfo}"
      Classes.warning="{Binding IsWarning}"
      Padding="12,10">
    <Grid ColumnDefinitions="4,*" ColumnSpacing="{DynamicResource NfcSpace8}">
      <Border
          Background="{DynamicResource NfcAccentBrush}"
          CornerRadius="2"
          Classes.error="{Binding IsError}"
          Classes.warning="{Binding IsWarning}" />
      <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="strongText" Text="{Binding Title}" />
        <TextBlock Classes="supportingText" Text="{Binding Detail}" TextWrapping="Wrap" />
        <TextBlock
            Classes="technicalDetail"
            IsVisible="{Binding HasTechnicalDetail}"
            Text="{Binding TechnicalDetail}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DrawingBrush
    x:Key="KeptDiagonalStripeBrush"
    DestinationRect="0,0,10,10"
    SourceRect="0,0,10,10"
    Stretch="None"
    TileMode="Tile">
  <DrawingBrush.Drawing>
    <GeometryDrawing Geometry="M -2,10 L 10,-2">
      <GeometryDrawing.Pen>
        <Pen Brush="{DynamicResource NfcKeptStripeBrush}" Thickness="1" />
      </GeometryDrawing.Pen>
    </GeometryDrawing>
  </DrawingBrush.Drawing>
</DrawingBrush>

<DataTemplate x:Key="FirmwareSlotGroupTemplate" DataType="vm:FirmwareSlotGroupViewModel">
  <views:SpaciousPanel Classes="compact firmwareSlotGroupSurface">
    <Expander Classes="inlineDisclosure firmwareSlotGroupDisclosure" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding SelectionSummary}">
      <Expander.Header>
        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="5">
            <TextBlock Classes="cardTitle" Text="{Binding Title}" />
            <TextBlock Classes="mutedText" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <Label Grid.Column="1" Classes="compactBadge neutralBadge countBadge" FontSize="{DynamicResource NfcFontSize11}" Content="{Binding CountLabel}" />
        </Grid>
      </Expander.Header>
      <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
  </views:SpaciousPanel>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageTooltipTemplate" DataType="vm:MemoryCoverageSegmentViewModel"><Border Classes="surface" MaxWidth="360" Padding="10">
    <StackPanel Spacing="{DynamicResource NfcSpace8}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}"><TextBlock Classes="bodyEmphasisText" Text="{Binding DisplayTitle}" TextWrapping="Wrap" /><Label Grid.Column="1" Classes="compactBadge neutralBadge countBadge coverageChangeBadge" Classes.changed="{Binding IsChanged}" Padding="7,2" Content="{Binding ChangeLabel}" IsVisible="{Binding HasChangeState}" /></Grid><Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5"><TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" /><StackPanel Grid.Column="1"><TextBlock Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" /><TextBlock Classes="captionText" Text="{Binding SourceCaption}" IsVisible="{Binding HasSourceCaption}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Row="1" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.ResultLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Classes="captionText" Text="{Binding PreservationSummary}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.DetailLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" /></Grid></StackPanel>
  </Border></DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Classes="memoryCoverageFill memoryCoverageMarker memoryCoverageBarSegment"
      Classes.linked="{Binding Interaction.IsActive}" Classes.reducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}"
      Classes.changed="{Binding IsChanged}"
      Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
      Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
      Classes.ctrlRamNf="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNf}}"
      Classes.ctrlRamNormal="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNormal}}"
      Classes.ctrlRamMp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamMp}}"
      Classes.ctrlRamVn="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVn}}"
      Classes.ctrlRamVector="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVector}}"
      Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
      Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
      Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
      Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
      Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
      Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
      Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:MemoryCoverageInteractionBehavior.IsEnabled="True"
      Focusable="False"
      RenderTransformOrigin="50%,50%"
      Height="34">
    <Border Background="{StaticResource KeptDiagonalStripeBrush}" IsVisible="{Binding UsesKeptPattern}" /><ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" /></ToolTip.Tip>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Classes="memoryCoverageFill memoryCoverageBarSegment"
      Classes.linked="{Binding Interaction.IsActive}" Classes.reducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}"
      Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
      Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
      Classes.ctrlRamNf="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNf}}"
      Classes.ctrlRamNormal="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNormal}}"
      Classes.ctrlRamMp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamMp}}"
      Classes.ctrlRamVn="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVn}}"
      Classes.ctrlRamVector="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVector}}"
      Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
      Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
      Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
      Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
      Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
      Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
      Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:MemoryCoverageInteractionBehavior.IsEnabled="True"
      RenderTransformOrigin="50%,50%"
      Focusable="False"
      Height="34">
    <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" /></ToolTip.Tip></Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageCompactMarkerTemplate">
  <Border
      Classes="memoryCoverageFill memoryCoverageMarker"
      Classes.conflict="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
      Classes.ctrlRam="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
      Classes.ctrlRamNf="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNf}}"
      Classes.ctrlRamNormal="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamNormal}}"
      Classes.ctrlRamMp="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamMp}}"
      Classes.ctrlRamVn="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVn}}"
      Classes.ctrlRamVector="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRamVector}}"
      Classes.diffDlm="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
      Classes.dp="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
      Classes.kept="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
      Classes.ldc="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
      Classes.source="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
      Classes.tp="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
      Classes.tpBackup="{ReflectionBinding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
      Width="10"
      Height="10"
      CornerRadius="2">
    <Border
        Background="{StaticResource KeptDiagonalStripeBrush}"
        CornerRadius="2"
        IsVisible="{ReflectionBinding UsesKeptPattern}" />
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageRegionCardTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <StackPanel Spacing="10">
    <StackPanel.Styles>
      <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader:focus-visible">
        <Setter Property="BorderThickness" Value="2" />
      </Style>
    </StackPanel.Styles>
    <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="8">
      <ContentControl VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageCompactMarkerTemplate}" />
      <TextBlock Grid.Column="1" Classes="bodyEmphasisText" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding DisplayTitle}" TextWrapping="Wrap" />
      <Label Grid.Column="2" Classes="compactBadge neutralBadge countBadge coverageChangeBadge" Classes.changed="{Binding IsChanged}" Padding="7,2" VerticalAlignment="Center" Content="{Binding ChangeLabel}" IsVisible="{Binding HasChangeState}" />
    </Grid>
    <Grid ColumnDefinitions="68,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
      <TextBlock Classes="captionText" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" />
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding AddressRangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Classes="captionText" Text="{ReflectionBinding $parent[Window].DataContext.Text.SizeLabel}" IsVisible="{Binding SizeValue, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="technicalValue" Text="{Binding SizeValue}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Classes="captionText" Text="{Binding SourceFieldLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Grid.Column="1" Classes="bodyText" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
    </Grid>
    <TextBlock Classes="captionText memoryInfoDescription" Text="{Binding PreservationSummary}" TextWrapping="Wrap" />
      <Border Name="MemoryHoverTechnicalSeparator" Classes="memoryHoverOnly" Height="1" Background="{DynamicResource NfcMemoryDividerBrush}" />
      <Expander Classes="inlineDisclosure firmwareSlotGroupDisclosure" MinHeight="28" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" IsExpanded="False"
          AutomationProperties.Name="{ReflectionBinding $parent[Window].DataContext.Text.MemoryProcessingDetailsLabel}">
        <Expander.Header><TextBlock Classes="captionText" Text="{ReflectionBinding $parent[Window].DataContext.Text.MemoryProcessingDetailsLabel}" /></Expander.Header>
        <StackPanel Spacing="6" Margin="0,6,0,0">
          <TextBlock Classes="captionText memoryHoverOnly" Text="{Binding AddressSpaceId}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText memoryHoverOnly" Text="{Binding PreservationSummary}" TextWrapping="Wrap" />
          <Border Name="MemoryTechnicalSeparator" Height="1" Background="{DynamicResource NfcMemoryDividerBrush}" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding ProcessingFacts}" IsVisible="{Binding HasProcessingFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:MemoryRegionFact">
                <Grid ColumnDefinitions="94,*" ColumnSpacing="8" Margin="0,0,0,6">
                  <TextBlock Classes="captionText" Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding !HasProcessingFacts}" />
        </StackPanel>
      </Expander>
  </StackPanel>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border IsVisible="{Binding IsPrimaryContent}" Classes="surface memoryInfoRow memoryCoverageLinkedRow" Classes.linked="{Binding Interaction.IsActive}" Classes.reducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}"
      Padding="12" Margin="0,0,0,8" BorderThickness="1" CornerRadius="8"
      AutomationProperties.HelpText="{Binding AccessibleDetail}" AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:FocusToolTipBehavior.IsEnabled="True" behaviors:MemoryCoverageInteractionBehavior.IsEnabled="True" Focusable="True">
    <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" /></ToolTip.Tip>
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageRegionCardTemplate}" />
        <Button
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.HelpText="{Binding AccessibleDetail}"
            AutomationProperties.Name="{Binding DetailsLabel}"
            Classes="semanticAction secondary"
            Content="{Binding DetailsLabel}"
            IsVisible="{Binding HasPreservationDetails}">
          <Button.Flyout>
            <Flyout Placement="RightEdgeAlignedTop">
              <Border Classes="surface" MaxWidth="420" Padding="12">
                <StackPanel Spacing="{DynamicResource NfcSpace8}">
                  <TextBlock Classes="panelTitle" Text="{Binding PreservationSummary}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding PreservationDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:DiffDlmPreservationDetailViewModel" x:DataType="vm:DiffDlmPreservationDetailViewModel">
                        <Border Classes="subtleSurface" Margin="0,0,0,6" Padding="9,7">
                          <StackPanel Spacing="{DynamicResource NfcSpace2}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
                              <TextBlock Classes="bodyEmphasisText" Text="{Binding IcLabel}" />
                              <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding BlockLabel}" />
                            </Grid>
                            <TextBlock Classes="technicalValue" Text="{Binding ArtifactRangeLabel}" TextWrapping="Wrap" />
                            <TextBlock Classes="technicalValue" Text="{Binding FlashRangeLabel}" TextWrapping="Wrap" />
                            <TextBlock Classes="captionText" Text="{Binding DispositionLabel}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border Classes="surface memoryInfoRow memoryCoverageLinkedRow" Classes.linked="{Binding Interaction.IsActive}" Classes.reducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}"
      Padding="12" Margin="0,0,0,8" BorderThickness="1" CornerRadius="8"
      AutomationProperties.HelpText="{Binding AccessibleDetail}" AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:FocusToolTipBehavior.IsEnabled="True" behaviors:MemoryCoverageInteractionBehavior.IsEnabled="True" Focusable="True">
    <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" /></ToolTip.Tip>
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageRegionCardTemplate}" />

    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageLogicalRangeTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Padding="0,6"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}">
    <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace8}" RowSpacing="{DynamicResource NfcSpace2}">
      <ContentControl
          VerticalAlignment="Center"
          Content="{Binding}"
          ContentTemplate="{StaticResource MemoryCoverageCompactMarkerTemplate}" />
      <TextBlock
          Grid.Column="2"
          Classes="memoryCoverageStateText"
          Text="{Binding ChangeLabel}"
          IsVisible="{Binding HasChangeState}" />
      <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="{DynamicResource NfcSpace8}">
        <TextBlock Classes="microInfoText memoryInfoRangeGroup" Text="{Binding RegionGroupLabel}" />
        <TextBlock Classes="technicalValue" Text="{Binding AddressRangeLabel}" />
        <TextBlock Classes="technicalValue" Text="·" />
        <TextBlock Classes="technicalValue" Text="{Binding LengthLabel}" />
      </StackPanel>
      <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Classes="captionText memoryInfoDescription"
          Text="{Binding CompactDetail}"
          TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageLogicalSingleRangeTemplate" DataType="vm:MemoryCoverageLogicalItemViewModel">
  <Border
      Padding="0,7"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}">
    <Grid ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace8}" RowSpacing="{DynamicResource NfcSpace2}">
      <ContentControl
          VerticalAlignment="Center"
          Content="{Binding PrimaryRange}"
          ContentTemplate="{StaticResource MemoryCoverageCompactMarkerTemplate}" />
      <TextBlock
          Grid.Column="1"
          Classes="bodyEmphasisText"
          Text="{Binding SourceLabel}"
          TextWrapping="Wrap" />
      <TextBlock
          Grid.Column="2"
          Classes="memoryCoverageStateText"
          Text="{Binding PrimaryRange.ChangeLabel}"
          IsVisible="{Binding PrimaryRange.HasChangeState}" />
      <StackPanel
          Grid.Row="1"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Orientation="Horizontal"
          Spacing="{DynamicResource NfcSpace8}">
        <TextBlock Classes="technicalValue" Text="{Binding PrimaryRange.AddressRangeLabel}" />
        <TextBlock Classes="technicalValue" Text="·" />
        <TextBlock Classes="technicalValue" Text="{Binding PrimaryRange.LengthLabel}" />
      </StackPanel>
      <TextBlock
          Grid.Row="2"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Classes="captionText memoryInfoDescription"
          Text="{Binding PrimaryRange.CompactDetail}"
          TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageLogicalItemTemplate" DataType="vm:MemoryCoverageLogicalItemViewModel">
  <Border
      Classes="listRow memoryInfoRow memoryCoverageLinkedRow"
      Classes.linked="{Binding Interaction.IsActive}" Classes.reducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}"
      Padding="0,10"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:FocusToolTipBehavior.IsEnabled="True" behaviors:MemoryCoverageInteractionBehavior.IsEnabled="True"
      Focusable="True">
    <ToolTip.Tip><ContentControl Content="{Binding PrimaryRange}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" /></ToolTip.Tip>
    <StackPanel>
      <ContentControl
          Content="{Binding}"
          ContentTemplate="{StaticResource MemoryCoverageLogicalSingleRangeTemplate}"
          IsVisible="{Binding HasSingleRange}" />
      <Grid IsVisible="{Binding HasMultipleRanges}" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource NfcSpace2}">
        <TextBlock
            VerticalAlignment="Center"
            Classes="bodyEmphasisText"
            Text="{Binding SourceLabel}"
            TextWrapping="Wrap" />
        <TextBlock
            Grid.Row="1"
            Classes="microInfoText memoryInfoRangeSummary"
            IsVisible="{Binding HasMultipleRanges}"
            Text="{Binding RangeSummaryLabel}"
            TextWrapping="Wrap" />
      </Grid>
      <Border
          Classes="memoryInfoRangeList"
          Classes.multiple="{Binding HasMultipleRanges}"
          IsVisible="{Binding HasMultipleRanges}">
        <ItemsControl
            ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
            ItemTemplate="{StaticResource MemoryCoverageLogicalRangeTemplate}"
            ItemsSource="{Binding Ranges}" />
      </Border>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReplaceMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding PrimaryLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="memoryFlowText" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="memoryFlowText" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeOutputLayoutPanelTemplate" DataType="vm:MergePresentationViewModel">
  <Border Classes="panelSurface memoryInfoPanel">
    <views:SpaciousPanel>
      <StackPanel Spacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="{DynamicResource NfcSpace8}">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.OutputLayoutTitle}" />
          <TextBlock Classes="mutedText memoryInfoDescription" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="compactSubtleSurface memoryInfoAddress" Padding="8,4">
          <TextBlock Classes="monoText detailText memoryInfoAddressText" Text="{Binding MergeMemoryRangeLabel}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <views:MemoryCoverageBar ItemsSource="{Binding MergeCoverageSegments}" Labels="{Binding Text}" IsPlain="True" ReducedMotion="{ReflectionBinding $parent[Window].DataContext.IsReducedMotionEnabled}" />

      <ItemsControl ItemTemplate="{StaticResource MemoryCoveragePlainSegmentListTemplate}" ItemsSource="{Binding MergeCoverageRows}" />

      <TextBlock Classes="sectionLabel" Text="{Binding Text.PlanTitle}" />
      <ItemsControl ItemTemplate="{StaticResource MergeMemoryMapRowTemplate}" ItemsSource="{Binding MergeMemoryRows}" />
      </StackPanel>
    </views:SpaciousPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="FirmwareSlotInformationFactTemplate" DataType="vm:FirmwareSlotFactViewModel">
  <Border
      AutomationProperties.Name="{Binding StateAutomationText}"
      Classes="firmwareSlotFact"
      Classes.error="{Binding IsError}"
      Classes.pendingInput="{Binding IsPendingInput}"
      Classes.unknown="{Binding IsUnknown}"
      Classes.warning="{Binding IsWarning}"
      HorizontalAlignment="Stretch"
      Padding="0,0,16,0">
    <StackPanel Orientation="Vertical" Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="firmwareSlotFactLabel" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace4}" HorizontalAlignment="Stretch">
        <TextBlock Classes="firmwareSlotFactValue" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
        <Path Grid.Column="1"
            AutomationProperties.Name="{Binding StateAutomationText}"
            behaviors:FocusToolTipBehavior.IsEnabled="True"
            Classes="firmwareSlotFactStateIcon"
            Data="{Binding StateIconPathData}"
            Focusable="True"
            Height="12"
            IsVisible="{Binding HasStateIcon}"
            Stretch="Uniform"
            ToolTip.Tip="{Binding StateAutomationText}"
            Width="12" />
      </Grid>
    </StackPanel>
  </Border>
</DataTemplate>

</ResourceDictionary>
