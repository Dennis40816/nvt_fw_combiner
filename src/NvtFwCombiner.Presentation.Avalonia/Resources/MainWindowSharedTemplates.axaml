<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<ControlTheme x:Key="StretchContentPresenterTheme" TargetType="ContentPresenter">
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
</ControlTheme>

<DataTemplate x:Key="FirmwareSlotGroupTemplate" DataType="vm:FirmwareSlotGroupViewModel">
  <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
    <Expander.Header>
      <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="{Binding Title}" />
          <TextBlock Classes="mutedText" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Label Grid.Column="1" Classes="countBadge" FontSize="11" Content="{Binding CountLabel}" />
      </Grid>
    </Expander.Header>
    <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Slots}">
      <ItemsControl.ItemTemplate>
        <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Expander>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageTooltipTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      MaxWidth="360"
      Padding="10"
      Background="#FFFFFF"
      BorderBrush="#CBD5E1"
      BorderThickness="1"
      CornerRadius="8">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Border
            Width="10"
            Height="10"
            VerticalAlignment="Center"
            Background="{Binding FillBrush}"
            BorderBrush="{Binding OutlineBrush}"
            BorderThickness="{Binding OutlineThickness}"
            CornerRadius="2" />
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="#0F172A"
            Text="{Binding SourceLabel}"
            TextWrapping="Wrap" />
        <Label
            Grid.Column="2"
            Classes="countBadge"
            Padding="7,2"
            Background="{Binding ChangeBadgeBackgroundBrush}"
            BorderBrush="{Binding ChangeBadgeBorderBrush}"
            Foreground="{Binding ChangeBadgeForegroundBrush}"
            Content="{Binding ChangeLabel}" />
      </Grid>

      <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
        <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" />
        <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.ResultLabel}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            FontSize="11"
            Foreground="#334155"
            Text="{Binding CompactDetail}"
            TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.DetailLabel}" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            MaxWidth="280"
            Classes="captionText"
            Text="{Binding Detail}"
            TextWrapping="Wrap" />
      </Grid>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Width="{Binding BarWidth}"
      Height="22"
      Background="{Binding FillBrush}"
      BorderBrush="{Binding OutlineBrush}"
      BorderThickness="{Binding OutlineThickness}">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Width="{Binding BarWidth}"
      Height="22"
      Background="{Binding FillBrush}">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border Classes="listRow" Padding="0,8">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
    <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
      <Border
          Width="10"
          Height="10"
          Margin="0,3,0,0"
          VerticalAlignment="Top"
          Background="{Binding FillBrush}"
          BorderBrush="{Binding OutlineBrush}"
          BorderThickness="{Binding OutlineThickness}"
          CornerRadius="2" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="bodyEmphasisText" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border Classes="listRow" Padding="0,8">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
    <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
      <Border
          Width="10"
          Height="10"
          Margin="0,3,0,0"
          VerticalAlignment="Top"
          Background="{Binding FillBrush}"
          CornerRadius="2" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="bodyEmphasisText" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageGroupTemplate" DataType="vm:MemoryCoverageGroupViewModel">
  <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
    <Expander.Header>
      <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="panelTitle" Text="{Binding Title}" />
          <TextBlock Classes="captionText" Text="{Binding ChangeSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Label Grid.Column="1" Classes="countBadge" Content="{Binding CountLabel}" />
      </Grid>
    </Expander.Header>
    <ItemsControl
        HorizontalAlignment="Stretch"
        ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
        ItemTemplate="{StaticResource MemoryCoverageSegmentListTemplate}"
        ItemsSource="{Binding Segments}" />
  </Expander>
</DataTemplate>

<DataTemplate x:Key="ReplaceMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <StackPanel Spacing="2">
        <TextBlock Classes="bodyStrongText" Text="{Binding PrimaryLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReplaceOutputLayoutPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Padding="18,16" Background="#FFFFFF" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="14">
      <StackPanel Spacing="8">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.OutputLayoutTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding ReplaceMemorySummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="compactSubtleSurface" Padding="8,4">
          <TextBlock Classes="monoText detailText" Text="{Binding ReplaceMemoryRangeLabel}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Padding="6" Background="#EEF4FA" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
        <ItemsControl ItemTemplate="{StaticResource MemoryCoverageSegmentBarTemplate}" ItemsSource="{Binding ReplaceCoverageSegments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>

      <ItemsControl ItemTemplate="{StaticResource MemoryCoverageSegmentListTemplate}" ItemsSource="{Binding ReplaceCoverageSegments}" IsVisible="{Binding IsReplaceCoverageFlat}" />

      <ItemsControl
          HorizontalAlignment="Stretch"
          ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
          ItemTemplate="{StaticResource MemoryCoverageGroupTemplate}"
          ItemsSource="{Binding ReplaceCoverageGroups}"
          IsVisible="{Binding IsReplaceCoverageGrouped}" />

      <TextBlock Classes="sectionLabel" Text="{Binding Text.PlanTitle}" />
      <ItemsControl ItemTemplate="{StaticResource ReplaceMemoryMapRowTemplate}" ItemsSource="{Binding ReplaceMemoryRows}" />
      <Border Classes="subtleSurface" Padding="10,8">
        <TextBlock Classes="readinessText" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeOutputLayoutPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Classes="panelSurface roomyPanel">
    <StackPanel Spacing="14">
      <StackPanel Spacing="8">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.OutputLayoutTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="compactSubtleSurface" Padding="8,4">
          <TextBlock Classes="monoText detailText" Text="{Binding MergeMemoryRangeLabel}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Classes="subtleSurface" Padding="10">
        <ItemsControl ItemTemplate="{StaticResource MemoryCoveragePlainSegmentBarTemplate}" ItemsSource="{Binding MergeCoverageSegments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>

      <ItemsControl ItemTemplate="{StaticResource MemoryCoveragePlainSegmentListTemplate}" ItemsSource="{Binding MergeCoverageSegments}" />

      <TextBlock Classes="sectionLabel" Text="{Binding Text.PlanTitle}" />
      <ItemsControl ItemTemplate="{StaticResource MergeMemoryMapRowTemplate}" ItemsSource="{Binding MergeMemoryRows}" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="FirmwareSlotFactTemplate" DataType="vm:FirmwareSlotFactViewModel">
  <Border
      Margin="0,2,6,0"
      Padding="7,2"
      Background="{Binding BackgroundBrush}"
      BorderBrush="{Binding BorderBrush}"
      BorderThickness="1"
      CornerRadius="999">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding LabelForegroundBrush}" Text="{Binding Label}" />
      <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="{Binding ValueForegroundBrush}" Text="{Binding Value}" />
    </StackPanel>
  </Border>
</DataTemplate>

</ResourceDictionary>
