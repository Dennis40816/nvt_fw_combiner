<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">

<ControlTheme x:Key="StretchContentPresenterTheme" TargetType="ContentPresenter">
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
</ControlTheme>

<DataTemplate x:Key="ForegroundLoadingStatusTemplate" DataType="vm:ForegroundLoadingState">
  <Border
      AutomationProperties.LiveSetting="Polite"
      AutomationProperties.Name="{Binding AccessibleStatus}"
      Padding="{Binding $parent[ContentControl].Padding}"
      Background="{DynamicResource NfcSurfaceBrush}"
      BorderBrush="{DynamicResource NfcBorderSoftBrush}"
      BorderThickness="1"
      BoxShadow="{DynamicResource NfcWorkflowCardHoverShadow}"
      CornerRadius="{DynamicResource NfcSurfaceCornerRadius}"
      IsVisible="{Binding IsVisible}">
    <StackPanel Spacing="{DynamicResource NfcSpace12}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{DynamicResource NfcTextStrongBrush}"
            Text="{Binding Title}"
            TextWrapping="Wrap" />
        <TextBlock
            Grid.Column="1"
            FontSize="{DynamicResource NfcFontSize13}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource NfcAccentStrongBrush}"
            IsVisible="{Binding HasDeterminateProgress}"
            Text="{Binding ProgressPercentLabel}" />
      </Grid>
      <TextBlock
          FontSize="{DynamicResource NfcFontSize13}"
          Foreground="{DynamicResource NfcTextMutedBrush}"
          Text="{Binding Detail}"
          TextWrapping="Wrap" />
      <ProgressBar
          Height="5"
          Maximum="1"
          Foreground="{DynamicResource NfcAccentBrush}"
          IsIndeterminate="{Binding ShouldAnimate}"
          IsVisible="{Binding IsRunning}"
          Value="{Binding Progress}" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Button
            AutomationProperties.Name="{Binding CancelLabel}"
            Command="{Binding CancelCommand}"
            Content="{Binding CancelLabel}"
            IsVisible="{Binding CanCancel}" />
        <Button
            Classes="primary"
            AutomationProperties.Name="{Binding RetryLabel}"
            behaviors:FocusOnRevealBehavior.IsEnabled="True"
            Command="{Binding RetryCommand}"
            Content="{Binding RetryLabel}"
            IsVisible="{Binding CanRetry}" />
      </StackPanel>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="DisclosureStatusTemplate" DataType="vm:DisclosureStatusViewModel">
  <Border
      AutomationProperties.Name="{Binding AccessibleLabel}"
      Classes="statusNotice"
      Classes.error="{Binding IsError}"
      Classes.info="{Binding IsInfo}"
      Classes.warning="{Binding IsWarning}"
      Padding="12,10">
    <Grid ColumnDefinitions="4,*" ColumnSpacing="{DynamicResource NfcSpace8}">
      <Border
          Background="{DynamicResource NfcAccentBrush}"
          CornerRadius="2"
          Classes.error="{Binding IsError}"
          Classes.warning="{Binding IsWarning}" />
      <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="strongText" Text="{Binding Title}" />
        <TextBlock Classes="supportingText" Text="{Binding Detail}" TextWrapping="Wrap" />
        <TextBlock
            Classes="technicalDetail"
            IsVisible="{Binding HasTechnicalDetail}"
            Text="{Binding TechnicalDetail}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DrawingBrush
    x:Key="KeptDiagonalStripeBrush"
    DestinationRect="0,0,10,10"
    SourceRect="0,0,10,10"
    Stretch="None"
    TileMode="Tile">
  <DrawingBrush.Drawing>
    <GeometryDrawing Geometry="M -2,10 L 10,-2">
      <GeometryDrawing.Pen>
        <Pen Brush="{DynamicResource NfcKeptStripeBrush}" Thickness="1" />
      </GeometryDrawing.Pen>
    </GeometryDrawing>
  </DrawingBrush.Drawing>
</DrawingBrush>

<DataTemplate x:Key="FirmwareSlotGroupTemplate" DataType="vm:FirmwareSlotGroupViewModel">
  <views:SpaciousPanel Classes="compact">
    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
      <Expander.Header>
        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="{DynamicResource NfcSpace2}">
            <TextBlock Classes="cardTitle" Text="{Binding Title}" />
            <TextBlock Classes="mutedText" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <Label Grid.Column="1" Classes="compactBadge neutralBadge countBadge" FontSize="{DynamicResource NfcFontSize11}" Content="{Binding CountLabel}" />
        </Grid>
      </Expander.Header>
      <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
  </views:SpaciousPanel>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageTooltipTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Classes="surface"
      MaxWidth="360"
      Padding="10">
    <StackPanel Spacing="{DynamicResource NfcSpace8}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
        <Border
            Classes="memoryCoverageFill memoryCoverageMarker"
            Classes.changed="{Binding IsChanged}"
            Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
            Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
            Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
            Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
            Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
            Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
            Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
            Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
            Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
            Width="10"
            Height="10"
            VerticalAlignment="Center"
            CornerRadius="2">
          <Border
              Background="{StaticResource KeptDiagonalStripeBrush}"
              CornerRadius="2"
              IsVisible="{Binding UsesKeptPattern}" />
        </Border>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="{DynamicResource NfcFontSize12}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource NfcTextStrongBrush}"
            Text="{Binding SourceLabel}"
            TextWrapping="Wrap" />
        <Label
            Grid.Column="2"
            Classes="compactBadge neutralBadge countBadge coverageChangeBadge"
            Classes.changed="{Binding IsChanged}"
            Padding="7,2"
            Content="{Binding ChangeLabel}" />
      </Grid>

      <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
        <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" />
        <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.ResultLabel}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            FontSize="{DynamicResource NfcFontSize11}"
            Foreground="{DynamicResource NfcTextBrush}"
            Text="{Binding PreservationSummary}"
            TextWrapping="Wrap" />

        <TextBlock Grid.Row="2" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.DetailLabel}" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            MaxWidth="280"
            Classes="captionText"
            Text="{Binding Detail}"
            TextWrapping="Wrap" />
      </Grid>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Classes="memoryCoverageFill memoryCoverageMarker"
      Classes.changed="{Binding IsChanged}"
      Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
      Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
      Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
      Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
      Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
      Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
      Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
      Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
      Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:FocusToolTipBehavior.IsEnabled="True"
      Focusable="True"
      Width="{Binding BarWidth}"
      Height="22">
    <Border
        Background="{StaticResource KeptDiagonalStripeBrush}"
        IsVisible="{Binding UsesKeptPattern}" />
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentBarTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border
      Classes="memoryCoverageFill"
      Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
      Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
      Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
      Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
      Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
      Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
      Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
      Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
      Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleDetail}"
      behaviors:FocusToolTipBehavior.IsEnabled="True"
      Focusable="True"
      Width="{Binding BarWidth}"
      Height="22">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border Classes="listRow" Padding="0,8">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
    <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
      <Border
          Classes="memoryCoverageFill memoryCoverageMarker"
          Classes.changed="{Binding IsChanged}"
          Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
          Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
          Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
          Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
          Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
          Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
          Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
          Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
          Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
          Width="10"
          Height="10"
          Margin="0,3,0,0"
          VerticalAlignment="Top"
          CornerRadius="2">
        <Border
            Background="{StaticResource KeptDiagonalStripeBrush}"
            CornerRadius="2"
            IsVisible="{Binding UsesKeptPattern}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyEmphasisText" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding PreservationSummary}" TextWrapping="Wrap" />
      </StackPanel>
      <Button
          Grid.Column="2"
          AutomationProperties.HelpText="{Binding AccessibleDetail}"
          AutomationProperties.Name="{Binding DetailsLabel}"
          Classes="quietDisclosure"
          Content="{Binding DetailsLabel}"
          IsVisible="{Binding HasPreservationDetails}">
        <Button.Flyout>
          <Flyout Placement="RightEdgeAlignedTop">
            <Border Classes="surface" MaxWidth="420" Padding="12">
              <StackPanel Spacing="{DynamicResource NfcSpace8}">
                <TextBlock Classes="panelTitle" Text="{Binding PreservationSummary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PreservationDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DiffDlmPreservationDetailViewModel" x:DataType="vm:DiffDlmPreservationDetailViewModel">
                      <Border Classes="subtleSurface" Margin="0,0,0,6" Padding="9,7">
                        <StackPanel Spacing="{DynamicResource NfcSpace2}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
                            <TextBlock Classes="bodyEmphasisText" Text="{Binding IcLabel}" />
                            <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding BlockLabel}" />
                          </Grid>
                          <TextBlock Classes="technicalValue" Text="{Binding ArtifactRangeLabel}" TextWrapping="Wrap" />
                          <TextBlock Classes="technicalValue" Text="{Binding FlashRangeLabel}" TextWrapping="Wrap" />
                          <TextBlock Classes="captionText" Text="{Binding DispositionLabel}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoveragePlainSegmentListTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
  <Border Classes="listRow" Padding="0,8">
    <ToolTip.Tip>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
    </ToolTip.Tip>
    <Grid ColumnDefinitions="12,*" ColumnSpacing="{DynamicResource NfcSpace8}">
      <Border
          Classes="memoryCoverageFill"
          Classes.conflict="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Conflict}}"
          Classes.ctrlRam="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.CtrlRam}}"
          Classes.diffDlm="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.DiffDlm}}"
          Classes.dp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Dp}}"
          Classes.kept="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Kept}}"
          Classes.ldc="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Ldc}}"
          Classes.source="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Source}}"
          Classes.tp="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.Tp}}"
          Classes.tpBackup="{Binding FillRole, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:MemoryCoverageFillRole.TpBackup}}"
          Width="10"
          Height="10"
          Margin="0,3,0,0"
          VerticalAlignment="Top"
          CornerRadius="2" />
      <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyEmphasisText" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MemoryCoverageGroupTemplate" DataType="vm:MemoryCoverageGroupViewModel">
  <views:SpaciousPanel Classes="compact">
    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
      <Expander.Header>
        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="{DynamicResource NfcSpace2}">
            <TextBlock Classes="panelTitle" Text="{Binding Title}" />
            <TextBlock Classes="captionText" Text="{Binding ChangeSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <Label Grid.Column="1" Classes="compactBadge neutralBadge countBadge" Content="{Binding CountLabel}" />
        </Grid>
      </Expander.Header>
      <ItemsControl
          HorizontalAlignment="Stretch"
          ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
          ItemTemplate="{StaticResource MemoryCoverageSegmentListTemplate}"
          ItemsSource="{Binding Segments}" />
    </Expander>
  </views:SpaciousPanel>
</DataTemplate>

<DataTemplate x:Key="ReplaceMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <StackPanel Spacing="{DynamicResource NfcSpace2}">
        <TextBlock Classes="bodyStrongText" Text="{Binding PrimaryLabel}" TextWrapping="Wrap" />
        <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource NfcFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextSecondaryBrush}" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeMemoryMapRowTemplate" DataType="vm:MemoryMapRowViewModel">
  <Border Classes="listRow" Padding="0,9" ToolTip.Tip="{Binding Detail}">
    <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <TextBlock Classes="microInfoText" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Classes="technicalValue" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource NfcFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextSecondaryBrush}" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReplaceOutputLayoutPanelTemplate" DataType="vm:ReplacePresentationViewModel">
  <Border Classes="panelSurface">
    <views:SpaciousPanel>
      <StackPanel Spacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="{DynamicResource NfcSpace8}">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.OutputLayoutTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding ReplaceMemorySummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="compactSubtleSurface" Padding="8,4">
          <TextBlock Classes="monoText detailText" Text="{Binding ReplaceMemoryRangeLabel}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <StackPanel
          x:Name="ReplaceCoverageStateLegend"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Border
              Classes="memoryCoverageMarker changed"
              Width="18"
              Height="10"
              VerticalAlignment="Center"
              Background="{DynamicResource NfcAccentBrush}"
              CornerRadius="2" />
          <TextBlock Classes="microInfoText" Text="{Binding Text.OutputLayoutChangedStateLabel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Border
              Classes="memoryCoverageMarker"
              Width="18"
              Height="10"
              VerticalAlignment="Center"
              Background="{DynamicResource NfcBorderMutedBrush}"
              CornerRadius="2">
            <Border Background="{StaticResource KeptDiagonalStripeBrush}" CornerRadius="2" />
          </Border>
          <TextBlock Classes="microInfoText" Text="{Binding Text.OutputLayoutKeptStateLabel}" />
        </StackPanel>
      </StackPanel>

      <Border Padding="6" Background="{DynamicResource NfcInfoSurfaceBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="{DynamicResource NfcCompactCornerRadius}">
        <Viewbox Height="22" HorizontalAlignment="Stretch" Stretch="Fill">
          <ItemsControl Width="300" Height="22" ItemTemplate="{StaticResource MemoryCoverageSegmentBarTemplate}" ItemsSource="{Binding ReplaceCoverageSegments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Viewbox>
      </Border>

      <ItemsControl Classes="spaciousList" ItemTemplate="{StaticResource MemoryCoverageSegmentListTemplate}" ItemsSource="{Binding ReplaceCoverageSegments}"
          IsVisible="{Binding IsReplaceCoverageFlat}" />

      <ItemsControl Classes="spaciousList" HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
          ItemTemplate="{StaticResource MemoryCoverageGroupTemplate}" ItemsSource="{Binding ReplaceCoverageGroups}"
          IsVisible="{Binding IsReplaceCoverageGrouped}" />

      <TextBlock Classes="sectionLabel" Text="{Binding Text.PlanTitle}" />
      <ItemsControl ItemTemplate="{StaticResource ReplaceMemoryMapRowTemplate}" ItemsSource="{Binding ReplaceMemoryRows}" />
      <Border Classes="subtleSurface" Padding="10,8">
        <TextBlock Classes="readinessText"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding ReplaceReadinessStatus}"
                   TextWrapping="Wrap" />
      </Border>
      </StackPanel>
    </views:SpaciousPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="MergeOutputLayoutPanelTemplate" DataType="vm:MergePresentationViewModel">
  <Border Classes="panelSurface">
    <views:SpaciousPanel>
      <StackPanel Spacing="{DynamicResource NfcSpace16}">
      <StackPanel Spacing="{DynamicResource NfcSpace8}">
        <StackPanel Spacing="3">
          <TextBlock Classes="sectionTitle" Text="{Binding Text.OutputLayoutTitle}" />
          <TextBlock Classes="mutedText" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Classes="compactSubtleSurface" Padding="8,4">
          <TextBlock Classes="monoText detailText" Text="{Binding MergeMemoryRangeLabel}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Classes="subtleSurface" Padding="10">
        <Viewbox Height="22" HorizontalAlignment="Stretch" Stretch="Fill">
          <ItemsControl Width="300" Height="22" ItemTemplate="{StaticResource MemoryCoveragePlainSegmentBarTemplate}" ItemsSource="{Binding MergeCoverageSegments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Viewbox>
      </Border>

      <ItemsControl ItemTemplate="{StaticResource MemoryCoveragePlainSegmentListTemplate}" ItemsSource="{Binding MergeCoverageSegments}" />

      <TextBlock Classes="sectionLabel" Text="{Binding Text.PlanTitle}" />
      <ItemsControl ItemTemplate="{StaticResource MergeMemoryMapRowTemplate}" ItemsSource="{Binding MergeMemoryRows}" />
      </StackPanel>
    </views:SpaciousPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="FirmwareSlotInformationFactTemplate" DataType="vm:FirmwareSlotFactViewModel">
  <Border
      Classes="firmwareSlotFact"
      Classes.error="{Binding IsError}"
      Classes.pendingInput="{Binding IsPendingInput}"
      Classes.unknown="{Binding IsUnknown}"
      Classes.warning="{Binding IsWarning}"
      Margin="0,2,6,0"
      MinWidth="136"
      Padding="10,7"
      BorderThickness="1"
      CornerRadius="{DynamicResource NfcSurfaceCornerRadius}">
    <StackPanel Orientation="Vertical" Spacing="{DynamicResource NfcSpace2}">
      <TextBlock Classes="firmwareSlotFactLabel" FontSize="{DynamicResource NfcFontSize10}" FontWeight="SemiBold" Text="{Binding Label}" />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
        <TextBlock Classes="firmwareSlotFactValue" FontSize="{DynamicResource NfcFontSize10}" FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontWeight="SemiBold" Text="{Binding Value}" />
        <Path
            AutomationProperties.Name="{Binding StateAutomationText}"
            behaviors:FocusToolTipBehavior.IsEnabled="True"
            Classes="firmwareSlotFactStateIcon"
            Data="{Binding StateIconPathData}"
            Focusable="True"
            Height="12"
            IsVisible="{Binding HasStateIcon}"
            Stretch="Uniform"
            ToolTip.Tip="{Binding StateAutomationText}"
            Width="12" />
      </StackPanel>
    </StackPanel>
  </Border>
</DataTemplate>

</ResourceDictionary>
