<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="NavigationTrailPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Classes="shellBar" Padding="28,6">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{DynamicResource NfcSpace8}">
      <Button
          Classes="iconButton"
          Command="{Binding GoBackCommand}"
          ToolTip.Tip="{Binding Text.BackTooltip}">
        <TextBlock Text="←" />
      </Button>
      <ItemsControl ItemsSource="{Binding NavigationTrail}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShellNavigationEntryViewModel">
            <Button Classes="breadcrumb" Command="{Binding NavigateCommand}">
              <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" Foreground="{DynamicResource NfcTextDisabledBrush}" IsVisible="{Binding IsChevronVisible}" Text=">" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="DeviceContextPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Classes="shellBar" Padding="28,8">
    <Grid ColumnDefinitions="*,Auto">
      <Grid
          Grid.Column="0"
          ColumnDefinitions="154,132,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="{DynamicResource NfcSpace12}"
          RowSpacing="3"
          VerticalAlignment="Center"
          ToolTip.Tip="{Binding Text.DeviceContextTitle}">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="tableHeader" Text="{Binding Text.IcLabel}" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="0"
            Classes="technicalSelect"
            Width="154"
            IsVisible="{Binding IsDeviceContextSelectionVisible}"
            ItemsSource="{Binding IcChoices}"
            SelectedItem="{Binding SelectedIc, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontSize="{DynamicResource NfcFontSize13}" Text="{Binding}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            Classes="technicalCenteredInput"
            Width="154"
            IsReadOnly="True"
            IsVisible="{Binding IsRunInProgress}"
            Text="{Binding ActiveRunIc}" />

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="132"
            MinHeight="45"
            Background="Transparent"
            IsHitTestVisible="False"
            IsVisible="{Binding IsNumberSelectorPlaceholderVisible}" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Classes="tableHeader"
            IsVisible="{Binding IsNumberSelectorVisible}"
            Text="{Binding Text.NumberLabel}" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Classes="technicalSelect"
            Width="132"
            IsVisible="{Binding IsDeviceContextNumberSelectionVisible}"
            ItemsSource="{Binding NumberSelectionChoices}"
            SelectedItem="{Binding SelectedNumberChoice, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:IcNumberChoiceViewModel">
              <TextBlock FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontSize="{DynamicResource NfcFontSize13}" Text="{Binding DisplayLabel}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Classes="technicalCenteredInput"
            Width="132"
            IsReadOnly="True"
            IsVisible="{Binding IsNumberSelectorVisible}"
            Text="{Binding ActiveRunNumber}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace8}">
          <Border
              Width="8"
              Height="8"
              Background="{DynamicResource NfcSuccessAccentBrush}"
              CornerRadius="{DynamicResource NfcPillCornerRadius}" />
          <TextBlock
              VerticalAlignment="Center"
              Classes="bodyEmphasisText"
              Text="{Binding DeviceContextStatus}"
              TextAlignment="Left"
              TextWrapping="Wrap" />
          <Label
              Classes="compactBadge neutralBadge reportBadge info"
              Content="{Binding SelectedIcFamilyLabel}"
              IsVisible="{Binding IsDeviceContextFamilyBadgeVisible}"
              ToolTip.Tip="{Binding SelectedIcFamilyTooltip}" />
        </StackPanel>
      </Grid>
      <Border
          Grid.Column="1"
          MinWidth="360"
          MaxWidth="430"
          Margin="16,0,0,0"
          Classes="panelSurface contentPanel"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding RunProgressStatusLabel}"
          IsVisible="{Binding IsRunInProgress}">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
            <TextBlock
                Classes="bodyStrongText"
                Text="{Binding RunProgressDisplayLabel}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Classes="captionText"
                Text="{Binding CompositionProgress.StepOrdinalLabel}" />
          </Grid>
          <TextBlock
              Classes="captionText"
              Text="{Binding ActiveRunContextLabel}"
              TextTrimming="CharacterEllipsis" />
          <ItemsControl
              HorizontalAlignment="Center"
              IsVisible="{Binding HasTypedRunProgress}"
              ItemsSource="{Binding CompositionProgress.Steps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}" />
              </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CompositionRunProgressStepViewModel">
                <Border
                    Width="32"
                    AutomationProperties.Name="{Binding AccessibleLabel}"
                    Classes.active="{Binding IsActive}"
                    Classes.completed="{Binding IsCompleted}"
                    Classes="runProgressNode"
                    ToolTip.Tip="{Binding AccessibleLabel}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar
              Height="3"
              AutomationProperties.Name="{Binding RunProgressStatusLabel}"
              IsIndeterminate="True"
              IsVisible="{Binding ShouldAnimateRunProgress}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportToastPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border
      Classes="toastSurface"
      MaxWidth="460"
      Margin="0,12,0,0"
      Padding="12,10"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      >
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource NfcAccentBrush}" Text="▤" />
      <StackPanel Grid.Column="1" Spacing="1">
        <TextBlock Classes="bodyStrongText" Text="{Binding ShellToastTitle}" />
        <TextBlock Classes="detailText" Text="{Binding ReportToastText}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

</ResourceDictionary>
