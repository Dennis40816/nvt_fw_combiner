<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="NavigationTrailPanelTemplate" DataType="vm:ShellNavigationViewModel">
  <Border Classes="shellBar" Padding="28,6">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{DynamicResource NfcSpace8}">
      <Button
          Classes="semanticAction iconButton"
          Command="{Binding GoBackCommand}"
          ToolTip.Tip="{Binding Text.BackTooltip}">
        <TextBlock Text="←" />
      </Button>
      <ItemsControl ItemsSource="{Binding NavigationTrail}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShellNavigationEntryViewModel">
            <Button Classes="breadcrumb" Command="{Binding NavigateCommand}">
              <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" Foreground="{DynamicResource NfcTextDisabledBrush}" IsVisible="{Binding IsChevronVisible}" Text=">" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="DeviceContextPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Classes="shellBar" Padding="28,8">
    <Grid ColumnDefinitions="*,Auto">
      <Grid
          Grid.Column="0"
          ColumnDefinitions="154,132,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="{DynamicResource NfcSpace12}"
          RowSpacing="3"
          VerticalAlignment="Center">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="tableHeader" Text="{Binding Text.IcLabel}" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="0"
            Classes="technicalSelect"
            Width="154"
            AutomationProperties.HelpText="{Binding WorkflowSession.SelectedIcDetailAutomationText}"
            behaviors:FocusToolTipBehavior.IsEnabled="True"
            IsVisible="{Binding WorkflowSession.IsDeviceContextSelectionVisible}"
            ItemsSource="{Binding WorkflowSession.IcChoices}"
            SelectedItem="{Binding WorkflowSession.SelectedIc, Mode=TwoWay}"
            ToolTip.Placement="BottomEdgeAlignedLeft"
            ToolTip.ShowDelay="250">
          <ToolTip.Tip>
            <ToolTip IsHitTestVisible="False">
              <Border Classes="icDetailCard" MaxWidth="360">
                <StackPanel Spacing="{DynamicResource NfcSpace8}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource NfcSpace8}">
                    <Border Classes="icDetailHeroIcon">
                      <Path
                          Classes="icDetailHeroGlyph"
                          Data="M4 4H12V12H4Z M6 1V4 M10 1V4 M6 12V15 M10 12V15 M1 6H4 M1 10H4 M12 6H15 M12 10H15" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource NfcSpace2}">
                      <TextBlock Classes="captionText" Text="{Binding Text.IcDetailTitle}" />
                      <TextBlock Classes="technicalValue" Text="{Binding WorkflowSession.SelectedIc}" />
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource NfcBorderMutedBrush}" />
                  <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace8}" RowSpacing="{DynamicResource NfcSpace8}">
                    <Path
                        Classes="icDetailRowIcon"
                        Data="M3 3V13 M3 5H8 M8 5V3 M8 5H13 M13 5V8 M3 11H8 M8 11V9 M8 11H13 M13 11V14" />
                    <TextBlock Grid.Column="1" Classes="bodyText" Text="{Binding WorkflowSession.SelectedIcDetailFamily}" TextWrapping="Wrap" />
                    <Path
                        Grid.Row="1"
                        Classes="icDetailRowIcon"
                        Data="M3 3V13L13 8Z" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="bodyText" Text="{Binding WorkflowSession.SelectedIcDetailRuntime}" TextWrapping="Wrap" />
                    <Path
                        Grid.Row="2"
                        Classes="icDetailRowIcon"
                        Data="M8 2L13 4V8C13 11 11 13 8 14C5 13 3 11 3 8V4Z M5.5 8L7 9.5L10.5 6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="bodyText" Text="{Binding WorkflowSession.SelectedIcDetailEvidence}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </ToolTip>
          </ToolTip.Tip>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontSize="{DynamicResource NfcFontSize13}" Text="{Binding}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            Classes="technicalCenteredInput"
            Width="154"
            IsReadOnly="True"
            IsVisible="{Binding RunSession.IsRunInProgress}"
            Text="{Binding RunSession.ActiveRunIc}" />

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="132"
            MinHeight="45"
            Background="Transparent"
            IsHitTestVisible="False"
            IsVisible="{Binding WorkflowSession.IsNumberSelectorPlaceholderVisible}" />
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Classes="tableHeader"
            IsVisible="{Binding WorkflowSession.IsNumberSelectorVisible}"
            Text="{Binding Text.NumberLabel}" />
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Width="132"
            IsVisible="{Binding WorkflowSession.IsNumberSelectorVisible}">
          <ComboBox
              Classes="technicalSelect"
              Width="132"
              AutomationProperties.Name="{Binding Text.NumberLabel}"
              IsVisible="{Binding WorkflowSession.IsDeviceContextSelectionVisible}"
              ItemsSource="{Binding WorkflowSession.NumberSelectionChoices}"
              SelectedItem="{Binding WorkflowSession.SelectedNumberChoice, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IcNumberChoiceViewModel">
                <TextBlock FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontSize="{DynamicResource NfcFontSize13}" Text="{Binding DisplayLabel}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox
              Classes="technicalCenteredInput"
              Width="132"
              AutomationProperties.Name="{Binding Text.NumberLabel}"
              IsReadOnly="True"
              IsVisible="{Binding RunSession.IsRunInProgress}"
              Text="{Binding RunSession.ActiveRunNumber}" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace8}">
          <Border
              Width="8"
              Height="8"
              Background="{DynamicResource NfcSuccessAccentBrush}"
              CornerRadius="{DynamicResource NfcPillCornerRadius}" />
          <TextBlock
              VerticalAlignment="Center"
              Classes="bodyEmphasisText"
              Text="{Binding WorkflowSession.DeviceContextStatus}"
              TextAlignment="Left"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <Border
          Grid.Column="1"
          MinWidth="360"
          MaxWidth="430"
          Margin="16,0,0,0"
          Classes="panelSurface contentPanel"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding RunSession.RunProgressStatusLabel}"
          IsVisible="{Binding RunSession.IsRunInProgress}">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
            <TextBlock
                Classes="bodyStrongText"
                Text="{Binding RunSession.RunProgressDisplayLabel}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Classes="captionText"
                Text="{Binding RunSession.CompositionProgress.StepOrdinalLabel}" />
          </Grid>
          <TextBlock
              Classes="captionText"
              Text="{Binding RunSession.ActiveRunContextLabel}"
              TextTrimming="CharacterEllipsis" />
          <ItemsControl
              HorizontalAlignment="Center"
              IsVisible="{Binding RunSession.HasTypedRunProgress}"
              ItemsSource="{Binding RunSession.CompositionProgress.Steps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}" />
              </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CompositionRunProgressStepViewModel">
                <Border
                    Width="32"
                    AutomationProperties.Name="{Binding AccessibleLabel}"
                    Classes.active="{Binding IsActive}"
                    Classes.completed="{Binding IsCompleted}"
                    Classes="runProgressNode"
                    ToolTip.Tip="{Binding AccessibleLabel}">
                  <TextBlock
                      AutomationProperties.AccessibilityView="Raw"
                      Classes="runProgressMarker"
                      IsHitTestVisible="False"
                      Text="{Binding StateMarker}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar
              Height="3"
              AutomationProperties.Name="{Binding RunSession.RunProgressStatusLabel}"
              IsIndeterminate="True"
              IsVisible="{Binding RunSession.ShouldAnimateRunProgress}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportToastPanelTemplate" DataType="vm:ReportPresentationViewModel">
  <Border
      Classes="toastSurface"
      AutomationProperties.LiveSetting="Polite"
      AutomationProperties.Name="{Binding ShellToastAccessibleLabel}"
      MaxWidth="460"
      Margin="0,12,0,0"
      Padding="12,10"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      >
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource NfcAccentBrush}" Text="▤" />
      <StackPanel Grid.Column="1" Spacing="1">
        <TextBlock Classes="bodyStrongText" Text="{Binding ShellToastTitle}" />
        <TextBlock Classes="detailText" Text="{Binding ReportToastText}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

</ResourceDictionary>
