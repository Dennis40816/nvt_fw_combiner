<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportHistoryEntryTemplate" DataType="vm:ReportHistoryEntryViewModel">
  <Grid Margin="0,0,0,6" ColumnDefinitions="*,34" ColumnSpacing="{DynamicResource NfcSpace8}">
    <Button
        HorizontalAlignment="Stretch"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        Command="{ReflectionBinding $parent[Window].DataContext.OpenReportHistoryEntryAsyncCommand}"
        CommandParameter="{Binding}">
      <Border Classes="compactSurface" Padding="10">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
            <TextBlock FontSize="{DynamicResource NfcFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextMutedBrush}" Text="{Binding SequenceLabel}" />
            <TextBlock Grid.Column="1" FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextStrongBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" FontSize="{DynamicResource NfcFontSize11}" FontWeight="SemiBold" Foreground="{DynamicResource NfcAccentBrush}" Text="{Binding IssueSummary}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding Context}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Button>
    <Button
        Grid.Column="1"
        Classes="iconButton dangerIcon"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Command="{ReflectionBinding $parent[Window].DataContext.RemoveReportHistoryEntryCommand}"
        CommandParameter="{Binding}"
        ToolTip.Tip="{ReflectionBinding $parent[Window].DataContext.Text.DeleteReportTooltip}">
      <TextBlock FontSize="{DynamicResource NfcFontSize13}" Text="×" />
    </Button>
  </Grid>
</DataTemplate>
</ResourceDictionary>
