<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">

<DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
  <views:SpaciousPanel Classes="compact">
    <Border Classes="reportInputRow">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
        <StackPanel Spacing="3">
          <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasInputDetail}" />
          <TextBlock Classes="technicalCaption" Text="{Binding InputAddressSpace}" TextWrapping="Wrap" IsVisible="{Binding HasInputFields}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="{DynamicResource NfcSpace4}">
          <Label Classes="compactBadge neutralBadge reportBadge info" Content="{Binding InputRole}" />
          <TextBlock HorizontalAlignment="Right" Classes="technicalMeta" Text="{Binding InputSizeLabel}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </views:SpaciousPanel>
</DataTemplate>

<DataTemplate x:Key="ReportInputGroupTemplate" DataType="vm:ReportInputGroupViewModel">
  <Expander Margin="0,0,0,10" IsExpanded="False">
    <Expander.Header>
      <views:SpaciousPanel Classes="compact">
        <Border Classes="reportInputGroupHeader">
          <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
            <Border Background="{DynamicResource NfcAccentBrush}" CornerRadius="2" />
            <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
              <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
            </StackPanel>
            <Label Grid.Column="2" Classes="compactBadge neutralBadge reportBadge info" Content="{Binding Count}" />
          </Grid>
        </Border>
      </views:SpaciousPanel>
    </Expander.Header>
    <views:SpaciousPanel Classes="compact">
      <ItemsControl Classes="spaciousList" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportInputRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </views:SpaciousPanel>
  </Expander>
</DataTemplate>
</ResourceDictionary>
