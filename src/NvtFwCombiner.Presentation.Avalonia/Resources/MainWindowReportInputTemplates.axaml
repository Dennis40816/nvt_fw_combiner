<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="0,9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasInputDetail}" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
          <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding InputRole}" TextWrapping="Wrap" />
          <TextBlock HorizontalAlignment="Right" Classes="technicalMeta" Text="{Binding InputSizeLabel}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="technicalCaption" Text="{Binding InputAddressSpace}" TextWrapping="Wrap" IsVisible="{Binding HasInputFields}" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportInputGroupTemplate" DataType="vm:ReportInputGroupViewModel">
  <Border Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
        </StackPanel>
        <Label Grid.Column="1" Classes="reportBadge" Content="{Binding Count}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportInputRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>
</ResourceDictionary>
