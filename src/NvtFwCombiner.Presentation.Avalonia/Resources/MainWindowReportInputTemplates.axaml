<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Margin="0,0,0,6" Classes="reportInputRow">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="3">
        <TextBlock Classes="bodyStrongText" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasInputDetail}" />
        <TextBlock Classes="technicalCaption" Text="{Binding InputAddressSpace}" TextWrapping="Wrap" IsVisible="{Binding HasInputFields}" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
        <Label Classes="reportBadge info" Content="{Binding InputRole}" />
        <TextBlock HorizontalAlignment="Right" Classes="technicalMeta" Text="{Binding InputSizeLabel}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportInputGroupTemplate" DataType="vm:ReportInputGroupViewModel">
  <Expander Margin="0,0,0,10" IsExpanded="False">
    <Expander.Header>
      <Border Classes="reportInputGroupHeader">
        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
          <Border Background="#2563EB" CornerRadius="2" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="captionText" Text="{Binding Detail}" TextWrapping="Wrap" />
          </StackPanel>
          <Label Grid.Column="2" Classes="reportBadge info" Content="{Binding Count}" />
        </Grid>
      </Border>
    </Expander.Header>
    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <StaticResource ResourceKey="ReportInputRowTemplate" />
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Expander>
</DataTemplate>
</ResourceDictionary>
