<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportLineBadgeTemplate" DataType="vm:ReportLineBadgeViewModel">
  <Border Margin="0,0,6,6" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Text}" TextWrapping="Wrap" />
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportLineFactTemplate" DataType="vm:ReportLineFactViewModel">
  <Grid Margin="0,1" ColumnDefinitions="96,*" ColumnSpacing="10">
    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBlock Grid.Column="1" FontSize="11" Foreground="#475569" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsPlainText}" />
    <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsTechnical}" />
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportRangeTableRowTemplate" DataType="vm:ReportRangeTableRowViewModel">
  <Border Padding="0,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="112,128,*,150" ColumnSpacing="10">
      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Kind}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding AddressSpace}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="2" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding Range}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="3" FontSize="11" Foreground="#64748B" Text="{Binding Source}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportSelectionRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMissingRequiredRowTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="180,*" ColumnSpacing="12" Margin="0,0,0,8">
    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#7C2D12" Text="{Binding Title}" TextWrapping="Wrap" />
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportEvidenceChipTemplate" DataType="vm:ReportLineViewModel">
  <Border
      Width="128"
      MinHeight="76"
      Padding="11,8"
      Background="#FFFFFF"
      BorderBrush="#E2E8F0"
      BorderThickness="1"
      CornerRadius="8">
    <StackPanel Spacing="2">
      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Title}" />
      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="*,54,76" ColumnSpacing="10">
      <StackPanel Spacing="2">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock
          Grid.Column="1"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          FontSize="16"
          FontFamily="Cascadia Mono, Consolas"
          FontWeight="SemiBold"
          Foreground="#0F172A"
          Text="{Binding Count}" />
      <Border Grid.Column="2" Padding="7,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
        <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}" />
      </Border>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportDifferenceSummaryChipTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
  <Border Width="154" Margin="0,0,8,8" Padding="9,7" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Label}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" FontSize="15" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Count}" />
      <TextBlock Grid.Row="1" FontSize="10" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
      <Border Grid.Row="1" Grid.Column="1" Padding="6,1" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}" />
      </Border>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportTriageRowTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Margin="0,0,0,10">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#DBEAFE" />
      <Border
          Width="18"
          Height="18"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="#EFF6FF"
          BorderBrush="#93C5FD"
          BorderThickness="1"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportIssueRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
    <StackPanel Spacing="2">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
  <Border MinWidth="320" MaxWidth="380" Padding="12,10" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,12,12">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineBadgeTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Grid.Row="2" FontSize="11" Foreground="#475569" Text="{Binding Detail}" TextWrapping="Wrap" />
      <ItemsControl Grid.Row="3" ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportInputGroupTemplate" DataType="vm:ReportInputGroupViewModel">
  <Border Padding="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Padding="7,2" VerticalAlignment="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Count}" />
        </Border>
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportInputRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportOperationFlowNodeTemplate" DataType="vm:ReportOperationFlowNodeViewModel">
  <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
    <Grid>
      <Border
          Width="2"
          HorizontalAlignment="Center"
          Background="#BFDBFE"
          IsVisible="{Binding HasConnector}" />
      <Border Width="32" Height="32" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="999">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Number}" />
      </Border>
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,3,0,18" Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
        <Border Grid.Column="1" MinWidth="44" Height="22" Padding="8,0" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}" />
        </Border>
      </Grid>
      <TextBlock FontSize="12" Foreground="#475569" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
    <StackPanel Spacing="2">
      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportRangeTableTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="9,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
    <StackPanel Spacing="5">
      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeTableTitle}" />
      <Grid ColumnDefinitions="112,128,*,150" ColumnSpacing="10">
        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.KindLabel}" />
        <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.AddressSpaceLabel}" />
        <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" />
        <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.SourceLabel}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding RangeRows}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportRangeTableRowTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>
<DataTemplate x:Key="ReportCommandOperationTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="34,*">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#BFDBFE" />
      <Border
          Width="16"
          Height="16"
          Margin="0,10,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="#2563EB"
          BorderBrush="#DBEAFE"
          BorderThickness="2"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,6,0,16" Spacing="7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
        <Border Grid.Column="1" MinWidth="52" Height="22" Padding="8,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding OperationStatus}" />
        </Border>
      </Grid>
      <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
      <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineBadgeTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ContentControl
          Content="{Binding}"
          ContentTemplate="{StaticResource ReportRangeTableTemplate}"
          IsVisible="{Binding HasRangeRows}" />
      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.CommandArgvLabel}" IsVisible="{Binding HasCodeBlock}" />
      <Border Padding="8,6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding HasCodeBlock}">
        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding CodeBlock}" TextWrapping="Wrap" />
      </Border>
      <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</DataTemplate>
<DataTemplate x:Key="ReportStepOperationTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="34,*">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#CBD5E1" />
      <Border
          Width="13"
          Height="13"
          Margin="0,11,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="#64748B"
          BorderBrush="#F8FAFC"
          BorderThickness="2"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Margin="0,6,0,16" Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
        <Border Grid.Column="1" MinWidth="52" Height="22" Padding="8,0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding OperationStatus}" />
        </Border>
      </Grid>
      <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
      <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineBadgeTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ContentControl
          Content="{Binding}"
          ContentTemplate="{StaticResource ReportRangeTableTemplate}"
          IsVisible="{Binding HasRangeRows}" />
      <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</DataTemplate>
<DataTemplate x:Key="ReportOutputDifferenceRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="12" Background="#FFFFFF" BorderBrush="#D7E2F1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
        <Border MinWidth="72" Height="28" Padding="8,0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Title}" />
        </Border>
        <Border Grid.Column="1" Height="28" Padding="10,0" Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999" IsVisible="{Binding HasSectionLabel}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding SectionLabel}" />
        </Border>
        <StackPanel Grid.Column="2" Spacing="3">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Range}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding ChangedSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <StaticResource ResourceKey="ReportLineBadgeTemplate" />
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding HasBeforeAfter}">
        <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
          <StackPanel Spacing="4">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding BeforeLabel}" />
            <TextBlock FontSize="13" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding BeforeValue}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="#94A3B8" Text=">" />
        <Border Grid.Column="2" Padding="10,8" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6">
          <StackPanel Spacing="4">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#166534" Text="{Binding AfterLabel}" />
            <TextBlock FontSize="13" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding AfterValue}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Padding="9,7" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding HasReason}">
        <Grid ColumnDefinitions="72,*" ColumnSpacing="8">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{ReflectionBinding $parent[Window].DataContext.Text.ReasonLabel}" />
          <TextBlock Grid.Column="1" FontSize="11" Foreground="#334155" Text="{Binding Reason}" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Facts}" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <StaticResource ResourceKey="ReportLineFactTemplate" />
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</DataTemplate>
<DataTemplate x:Key="ReportHistoryEntryTemplate" DataType="vm:ReportHistoryEntryViewModel">
  <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Button
        HorizontalAlignment="Stretch"
        Padding="0"
        Background="Transparent"
        BorderBrush="Transparent"
        Command="{ReflectionBinding $parent[Window].DataContext.OpenReportHistoryEntryCommand}"
        CommandParameter="{Binding}">
      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding SequenceLabel}" />
            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding IssueSummary}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Context}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CommandSummary}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding EvidenceSummary}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#475569" Text="{Binding ArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding HasArtifactPath}" />
        </StackPanel>
      </Border>
    </Button>
    <Button
        Grid.Column="1"
        Classes="iconButton dangerIcon"
        VerticalAlignment="Top"
        Command="{ReflectionBinding $parent[Window].DataContext.RemoveReportHistoryEntryCommand}"
        CommandParameter="{Binding}"
        ToolTip.Tip="{ReflectionBinding $parent[Window].DataContext.Text.DeleteReportTooltip}">
      <TextBlock FontSize="13" Text="X" />
    </Button>
  </Grid>
</DataTemplate>
</ResourceDictionary>
