<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportLineBadgeTemplate" DataType="vm:ReportLineBadgeViewModel">
  <Label Margin="0,0,6,6" Classes="reportBadge" Content="{Binding Text}" />
</DataTemplate>

<DataTemplate x:Key="ReportLineFactTemplate" DataType="vm:ReportLineFactViewModel">
  <Grid Margin="0,1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
    <TextBlock Classes="tableHeader" Text="{Binding Label}" TextWrapping="Wrap" />
    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource UiBrush.TextSubtle}" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsPlainText}" />
    <TextBlock Grid.Column="1" Classes="technicalCompactDetail" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsTechnical}" />
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportRangeTableRowTemplate" DataType="vm:ReportRangeTableRowViewModel">
  <Border Padding="0,7" BorderBrush="{DynamicResource UiBrush.SubtleBorder}" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
      <TextBlock Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.KindLabel}" />
      <TextBlock Grid.Column="1" Classes="compactStrongText" Text="{Binding Kind}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.AddressSpaceLabel}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Classes="technicalCompactDetail" Text="{Binding AddressSpace}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.RangeLabel}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Classes="technicalCompactValue" Text="{Binding Range}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="3" Classes="tableHeader" Text="{ReflectionBinding $parent[Window].DataContext.Text.SourceLabel}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Classes="captionText" Text="{Binding Source}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportSelectionRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Classes="listRow" Padding="0,8">
    <StackPanel Spacing="2">
      <TextBlock Classes="panelTitle" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="bodyEmphasisText" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportMissingRequiredRowTemplate" DataType="vm:ReportLineViewModel">
  <StackPanel Margin="0,0,0,8" Spacing="2">
    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UiBrush.WarningDetail}" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock FontSize="12" Foreground="{DynamicResource UiBrush.WarningDetail}" Text="{Binding Detail}" TextWrapping="Wrap" />
    <TextBlock FontSize="11" Foreground="{DynamicResource UiBrush.WarningMeta}" Text="{Binding Meta}" TextWrapping="Wrap" />
  </StackPanel>
</DataTemplate>

<DataTemplate x:Key="ReportEvidenceChipTemplate" DataType="vm:ReportLineViewModel">
  <Border
      Classes="panelSurface"
      MinWidth="128"
      MaxWidth="220"
      MinHeight="76"
      Padding="11,8"
      >
    <StackPanel Spacing="2">
      <TextBlock Classes="fieldLabel" Text="{Binding Title}" />
      <TextBlock Classes="sectionTitle" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="ReportTriageRowTemplate" DataType="vm:ReportLineViewModel">
  <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Margin="0,0,0,10">
    <Grid>
      <Border Width="2" HorizontalAlignment="Center" Background="#DBEAFE" />
      <Border
          Width="18"
          Height="18"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="{DynamicResource UiBrush.AccentSurface}"
          BorderBrush="{DynamicResource UiBrush.AccentBorder}"
          BorderThickness="1"
          CornerRadius="999" />
    </Grid>
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="panelTitle" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="ReportIssueRowTemplate" DataType="vm:ReportLineViewModel">
  <Border Padding="10,8" Background="{DynamicResource UiBrush.WarningSurface}" BorderBrush="{DynamicResource UiBrush.WarningBorder}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
    <StackPanel Spacing="2">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UiBrush.TextWarning}" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock FontSize="12" Foreground="{DynamicResource UiBrush.WarningDetail}" Text="{Binding Detail}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="{DynamicResource UiBrush.WarningMeta}" Text="{Binding Meta}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>
</ResourceDictionary>
