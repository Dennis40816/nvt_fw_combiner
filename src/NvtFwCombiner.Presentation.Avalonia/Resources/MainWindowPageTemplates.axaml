<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">

<DataTemplate x:Key="HomePageTemplate" DataType="vm:MainWindowViewModel">
  <Grid
      ColumnDefinitions="*,*,*"
      ColumnSpacing="{DynamicResource NfcSpace16}"
      VerticalAlignment="Top">
    <Border Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock
              FontSize="{DynamicResource NfcFontSize12}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource NfcAccentBrush}"
              Text="{Binding Text.WorkflowKicker}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding ReplacePreview.Title}" />
          <TextBlock
              FontSize="{DynamicResource NfcFontSize13}"
              Foreground="{DynamicResource NfcTextMutedBrush}"
              Text="{Binding ReplacePreview.Subtitle}"
              TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding BeginDpReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="DP Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="1"
              Classes="command"
              Command="{Binding BeginCtrlRamReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="CtrlRAM Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="2"
              Classes="command"
              Command="{Binding BeginGeneralReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Customized Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock
              FontSize="{DynamicResource NfcFontSize12}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource NfcAccentBrush}"
              Text="{Binding Text.WorkflowKicker}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding MergePreview.Title}" />
          <TextBlock
              FontSize="{DynamicResource NfcFontSize13}"
              Foreground="{DynamicResource NfcTextMutedBrush}"
              Text="{Binding MergePreview.Subtitle}"
              TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding BeginNormalMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Standard Merge" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="1"
              Classes="command"
              Command="{Binding BeginAbMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="AB Code" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="2"
              Classes="command"
              Command="{Binding BeginGeneralMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Customized Merge" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2" Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock
              FontSize="{DynamicResource NfcFontSize12}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource NfcInfoTextBrush}"
              Text="{Binding Text.UtilToolsLabel}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding Text.UtilToolsHomeTitle}" />
          <TextBlock
              FontSize="{DynamicResource NfcFontSize13}"
              Foreground="{DynamicResource NfcTextMutedBrush}"
              Text="{Binding Text.UtilToolsHomeDetail}"
              TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding ShowHexEditorCommand}"
              ToolTip.Tip="{Binding Text.HexEditorDetail}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="{Binding Text.HexEditorTitle}" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="HexEditorPageTemplate" DataType="vm:MainWindowViewModel">
  <StackPanel Spacing="{DynamicResource NfcSpace16}">
    <StackPanel Margin="18,0,18,0" Spacing="{DynamicResource NfcSpace4}">
      <TextBlock
          FontSize="{DynamicResource NfcFontSize11}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcInfoTextBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.UtilToolsLabel}" />
      <TextBlock
          FontSize="24"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.HexEditorTitle}" />
      <TextBlock
          FontSize="{DynamicResource NfcFontSize13}"
          Foreground="{DynamicResource NfcTextMutedBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.HexEditorDetail}"
          TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="panelSurface roomyPanel">
      <views:HexEditorPanel DataContext="{Binding LoadedHexEditorWorkspace}" />
    </Border>
  </StackPanel>
</DataTemplate>

<DataTemplate x:Key="SettingsSummaryRowTemplate" DataType="vm:SettingSummaryViewModel">
  <Border Classes="settingRow" Margin="0,0,0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock Classes="panelTitle" Text="{Binding Title}" />
        <TextBlock Grid.Column="1" Classes="infoText" Text="{Binding Status}" />
      </Grid>
      <TextBlock Classes="technicalDetail" Text="{Binding Value}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="SettingsSupportMatrixRowTemplate" DataType="vm:SupportMatrixSettingsRowViewModel">
  <Border
      Classes="settingRow"
      AutomationProperties.HelpText="{Binding TraceabilityHelpText}"
      AutomationProperties.Name="{Binding AccessibleName}"
      ToolTip.Tip="{Binding RouteId}">
    <Grid
        ColumnDefinitions="88,132,76,150,72,72,96,112"
        ColumnSpacing="{DynamicResource NfcSpace8}">
      <TextBlock Classes="technicalDetail" Text="{Binding IcId}" />
      <TextBlock Grid.Column="1" Classes="technicalDetail" Text="{Binding WorkflowId}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="2" Classes="technicalDetail" Text="{Binding IcCountVariant}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="3" Classes="technicalDetail" Text="{Binding MapVariant}" TextWrapping="Wrap" />
      <Label
          Grid.Column="4"
          Classes="reportBadge"
          Classes.info="{Binding IsAuthoringInfo}"
          Classes.review="{Binding IsAuthoringReview}"
          Classes.success="{Binding IsAuthoringSuccess}"
          AutomationProperties.Name="{Binding AuthoringLabel}"
          Content="{Binding AuthoringMark}"
          ToolTip.Tip="{Binding AuthoringLabel}" />
      <Label
          Grid.Column="5"
          Classes="reportBadge"
          Classes.info="{Binding IsExecutionInfo}"
          Classes.review="{Binding IsExecutionReview}"
          Classes.success="{Binding IsExecutionSuccess}"
          AutomationProperties.Name="{Binding ExecutionLabel}"
          Content="{Binding ExecutionMark}"
          ToolTip.Tip="{Binding ExecutionLabel}" />
      <Label
          Grid.Column="6"
          Classes="reportBadge"
          Classes.info="{Binding IsPublicationInfo}"
          Classes.review="{Binding IsPublicationReview}"
          Classes.success="{Binding IsPublicationSuccess}"
          AutomationProperties.HelpText="{Binding PublicationTooltip}"
          Content="{Binding PublicationLabel}"
          ToolTip.Tip="{Binding PublicationTooltip}" />
      <Label
          Grid.Column="7"
          Classes="reportBadge"
          Classes.info="{Binding IsEvidenceInfo}"
          Classes.review="{Binding IsEvidenceReview}"
          Classes.success="{Binding IsEvidenceSuccess}"
          AutomationProperties.HelpText="{Binding EvidenceTooltip}"
          Content="{Binding EvidenceLabel}"
          ToolTip.Tip="{Binding EvidenceTooltip}" />
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="SettingsPageTemplate" DataType="vm:MainWindowViewModel">
  <StackPanel Spacing="{DynamicResource NfcSpace16}">
    <StackPanel Spacing="{DynamicResource NfcSpace4}">
      <TextBlock Classes="pageTitle" Text="{Binding SettingsPreview.Title}" />
      <TextBlock Classes="pageSubtitle" Text="{Binding SettingsPreview.Subtitle}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="1.2*,*" ColumnSpacing="{DynamicResource NfcSpace12}">
      <Border Classes="panelSurface roomyPanel">
        <StackPanel Spacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="strongText" Text="{Binding Text.SettingsOverviewTitle}" />
            <TextBlock Classes="supportingText" Text="{Binding Text.SettingsOverviewSubtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl
              ItemTemplate="{StaticResource SettingsSummaryRowTemplate}"
              ItemsSource="{Binding SettingsOverviewRows}" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace12}">
        <Border Classes="panelSurface roomyPanel">
          <StackPanel Spacing="{DynamicResource NfcSpace12}">
            <StackPanel Spacing="{DynamicResource NfcSpace4}">
              <TextBlock Classes="strongText" Text="{Binding Text.SettingsCapabilitiesTitle}" />
              <TextBlock Classes="supportingText" Text="{Binding Text.SettingsCapabilitiesSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl
                ItemTemplate="{StaticResource SettingsSummaryRowTemplate}"
                ItemsSource="{Binding SettingsCapabilityRows}" />
          </StackPanel>
        </Border>

        <Border Classes="panelSurface roomyPanel">
          <StackPanel Spacing="{DynamicResource NfcSpace12}">
            <StackPanel Spacing="{DynamicResource NfcSpace4}">
              <TextBlock Classes="strongText" Text="{Binding Text.SettingsPreferencesTitle}" />
              <TextBlock Classes="supportingText" Text="{Binding Text.SettingsPreferencesSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace12}" RowSpacing="10">
              <TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{Binding Text.ThemeLabel}" />
              <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

              <TextBlock Grid.Row="1" Classes="fieldLabel" VerticalAlignment="Center" Text="{Binding Text.LanguageLabel}" />
              <ComboBox Grid.Row="1" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

              <TextBlock Grid.Row="2" Classes="fieldLabel" VerticalAlignment="Center" Text="{Binding Text.ReducedMotionLabel}" />
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                <ToggleSwitch
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Text.ReducedMotionLabel}"
                    IsChecked="{Binding IsReducedMotionEnabled, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="supportingText"
                    Text="{Binding Text.ReducedMotionDescription}"
                    TextWrapping="Wrap" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Classes="panelSurface roomyPanel">
      <StackPanel Spacing="{DynamicResource NfcSpace12}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="strongText" Text="{Binding SettingsSupportMatrixTitle}" />
            <TextBlock Classes="supportingText" Text="{Binding SettingsSupportMatrixDescription}" TextWrapping="Wrap" />
          </StackPanel>
          <Label
              Grid.Column="1"
              Classes="reportBadge"
              Classes.review="{Binding IsSettingsSupportMatrixReview}"
              Classes.success="{Binding IsSettingsSupportMatrixSuccess}"
              Content="{Binding SettingsSupportMatrixStatus}"
              ToolTip.Tip="{Binding SettingsSupportMatrixDiagnostics}" />
        </Grid>

        <TextBlock Classes="technicalDetail" Text="{Binding SettingsSupportMatrixPolicyDetail}" TextWrapping="Wrap" />
        <TextBlock Classes="captionText" Text="{Binding SettingsSupportMatrixDiagnostics}" TextWrapping="Wrap" />

        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            MaxHeight="320"
            VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <Grid
                ColumnDefinitions="88,132,76,150,72,72,96,112"
                ColumnSpacing="{DynamicResource NfcSpace8}">
              <TextBlock Classes="fieldLabel" Text="{Binding SettingsSupportMatrixIcHeader}" />
              <TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixWorkflowHeader}" />
              <TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixIcCountHeader}" />
              <TextBlock Grid.Column="3" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixMapHeader}" />
              <TextBlock Grid.Column="4" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixAuthoringHeader}" />
              <TextBlock Grid.Column="5" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixExecutionHeader}" />
              <TextBlock Grid.Column="6" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixPublicationHeader}" />
              <TextBlock Grid.Column="7" Classes="fieldLabel" Text="{Binding SettingsSupportMatrixEvidenceHeader}" />
            </Grid>

            <ItemsControl
                ItemTemplate="{StaticResource SettingsSupportMatrixRowTemplate}"
                ItemsSource="{Binding SettingsSupportMatrixRows}" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </StackPanel>
</DataTemplate>

</ResourceDictionary>
