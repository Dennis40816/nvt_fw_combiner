<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">

<DataTemplate x:Key="HomePageTemplate" DataType="vm:MainWindowViewModel">
  <Grid
      ColumnDefinitions="*,*,*"
      ColumnSpacing="{DynamicResource NfcSpace16}"
      VerticalAlignment="Top">
    <Border Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock Classes="workflowKicker" Text="{Binding Text.WorkflowKicker}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding Replace.ReplacePreview.Title}" />
          <TextBlock Classes="pageSubtitle" Text="{Binding Replace.ReplacePreview.Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding BeginDpReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="DP Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="1"
              Classes="command"
              Command="{Binding BeginCtrlRamReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="CtrlRAM Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="2"
              Classes="command"
              Command="{Binding BeginGeneralReplaceFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Customized Replace" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock Classes="workflowKicker" Text="{Binding Text.WorkflowKicker}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding Merge.MergePreview.Title}" />
          <TextBlock Classes="pageSubtitle" Text="{Binding Merge.MergePreview.Subtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding BeginNormalMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Standard Merge" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="1"
              Classes="command"
              Command="{Binding BeginAbMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="AB Code" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
          <Button
              Grid.Row="2"
              Classes="command"
              Command="{Binding BeginGeneralMergeFromHomeCommand}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="Customized Merge" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="2" Classes="homePreviewSurface">
      <Grid RowDefinitions="Auto,Auto">
        <StackPanel MinHeight="88" Spacing="6">
          <TextBlock Classes="workflowKicker info" Text="{Binding Text.UtilToolsLabel}" />
          <TextBlock
              Classes="previewTitle"
              Text="{Binding Text.UtilToolsHomeTitle}" />
          <TextBlock Classes="pageSubtitle" Text="{Binding Text.UtilToolsHomeDetail}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto" RowSpacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="command"
              Command="{Binding ShowHexEditorCommand}"
              ToolTip.Tip="{Binding Text.HexEditorDetail}">
            <Border Classes="workflowCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Classes="strongText" Text="{Binding Text.HexEditorTitle}" />
                <Border Grid.Column="1" Classes="workflowOpenPill">
                  <TextBlock Classes="workflowActionText" Text="{Binding Text.OpenLabel}" />
                </Border>
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</DataTemplate>

<DataTemplate x:Key="HexEditorPageTemplate" DataType="vm:MainWindowViewModel">
  <StackPanel Spacing="{DynamicResource NfcSpace16}">
    <StackPanel Margin="18,0,18,0" Spacing="{DynamicResource NfcSpace4}">
      <TextBlock
          FontSize="{DynamicResource NfcFontSize11}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcInfoTextBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.UtilToolsLabel}" />
      <TextBlock
          FontSize="24"
          FontWeight="SemiBold"
          Foreground="{DynamicResource NfcTextStrongBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.HexEditorTitle}" />
      <TextBlock
          FontSize="{DynamicResource NfcFontSize13}"
          Foreground="{DynamicResource NfcTextMutedBrush}"
          Text="{Binding LoadedHexEditorWorkspace.Text.HexEditorDetail}"
          TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="panelSurface roomyPanel">
      <views:HexEditorPanel DataContext="{Binding LoadedHexEditorWorkspace}" />
    </Border>
  </StackPanel>
</DataTemplate>

<DataTemplate x:Key="SettingsSummaryRowTemplate" DataType="vm:SettingSummaryViewModel">
  <Border Classes="settingRow" Margin="0,0,0,8">
    <StackPanel Spacing="{DynamicResource NfcSpace2}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock Classes="panelTitle" Text="{Binding Title}" />
        <TextBlock Grid.Column="1" Classes="infoText" Text="{Binding Status}" />
      </Grid>
      <TextBlock Classes="technicalDetail" Text="{Binding Value}" TextWrapping="Wrap" />
      <TextBlock Classes="captionText" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="SettingsVersionRowTemplate" DataType="vm:SettingsVersionRowViewModel">
  <Border Classes="versionTableRow">
    <Grid MinHeight="52" Margin="14,0" ColumnDefinitions="1.1*,1.4*,1*,Auto,38" ColumnSpacing="{DynamicResource NfcSpace12}">
      <TextBlock VerticalAlignment="Center" Classes="bodyStrongText versionRowPrimary" Text="{Binding VersionLabel}" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
        <Ellipse
            Width="8"
            Height="8"
            VerticalAlignment="Center"
            Classes="versionStatusDot"
            Classes.available="{Binding IsAvailable}"
            Classes.damaged="{Binding IsDamaged}"
            Classes.healthy="{Binding IsHealthyInstalled}" />
        <TextBlock VerticalAlignment="Center" Classes="captionText versionRowStatus" Text="{Binding StatusLabel}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="technicalCaption versionRowPublished" Text="{Binding PublishedLabel}" />
      <Button
          Grid.Column="3"
          MinWidth="88"
          VerticalAlignment="Center"
          AutomationProperties.Name="{Binding PrimaryActionLabel}"
          Classes="semanticAction versionTableAction"
          Command="{ReflectionBinding $parent[Window].DataContext.Settings.RequestVersionPrimaryActionCommand}"
          CommandParameter="{Binding}"
          Content="{Binding PrimaryActionLabel}"
          IsEnabled="{Binding HasPrimaryAction}" />
      <Button
          Grid.Column="4"
          MinHeight="32"
          MinWidth="32"
          VerticalAlignment="Center"
          AutomationProperties.Name="{Binding DeleteActionLabel}"
          Classes="semanticAction iconButton danger"
          Command="{ReflectionBinding $parent[Window].DataContext.Settings.RequestDeleteVersionCommand}"
          CommandParameter="{Binding}"
          IsVisible="{Binding CanDelete}"
          ToolTip.Tip="{Binding DeleteActionLabel}">
        <Path Width="14" Height="14" Data="M3 4H13 M6 4V2H10V4 M5 6V13 M8 6V13 M11 6V13 M4 4L5 15H11L12 4Z" Stretch="Uniform" />
      </Button>
    </Grid>
  </Border>
</DataTemplate>

<ItemsPanelTemplate x:Key="HorizontalSupportMatrixPanel">
  <StackPanel Orientation="Horizontal" />
</ItemsPanelTemplate>

<DataTemplate x:Key="SupportMatrixWorkflowHeaderTemplate" DataType="vm:SupportMatrixWorkflowColumnViewModel">
  <Border Classes="supportMatrixWorkflowHeader" Padding="6" Width="176">
    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap" />
  </Border>
</DataTemplate>

<DataTemplate x:Key="SupportMatrixHoverRouteTemplate" DataType="vm:SupportMatrixRowViewModel">
  <Border Classes="supportMatrixHoverRoute" Padding="0,6">
    <StackPanel Spacing="{DynamicResource NfcSpace4}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock Classes="bodyStrongText" FontFamily="{DynamicResource NfcTechnicalFontFamily}" Text="{Binding MapVariant}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Classes="technicalCaption" Text="{Binding IcCountLabel}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
        <TextBlock Classes="captionText" Text="{Binding DecisionSummary}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Classes="technicalCaption" Text="{Binding FingerprintDisplay}" />
      </Grid>
      <TextBlock Classes="technicalCaption" Text="{Binding ProvenanceDetail}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</DataTemplate>

<DataTemplate x:Key="SupportMatrixCellTemplate" DataType="vm:SupportMatrixCellViewModel">
  <Border
      AutomationProperties.AccessibilityView="Content"
      AutomationProperties.HelpText="{Binding AccessibleDetail}"
      AutomationProperties.Name="{Binding AccessibleLabel}"
      Classes="supportMatrixCell"
      Classes.blocked="{Binding IsBlocked}"
      Classes.contract="{Binding IsContractOnly}"
      Classes.notDeclared="{Binding IsNotDeclared}"
      Classes.review="{Binding IsReviewRequired}"
      Classes.reviewed="{Binding IsReviewedEvidence}"
      behaviors:FocusToolTipBehavior.IsEnabled="True"
      Focusable="True"
      Height="38"
      ToolTip.Placement="BottomEdgeAlignedLeft"
      ToolTip.ShowDelay="220"
      Width="176">
    <ToolTip.Tip>
      <ToolTip IsHitTestVisible="False" Width="560">
      <StackPanel Margin="6" Spacing="{DynamicResource NfcSpace8}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <TextBlock Classes="sectionTitle" Text="{Binding IcId}" />
          <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding StatusLabel}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
          <TextBlock Classes="bodyStrongText" Text="{Binding WorkflowLabel}" />
          <TextBlock Grid.Column="1" Classes="captionText" Text="{Binding RouteCountLabel}" />
        </Grid>
        <TextBlock Classes="fieldLabel" Text="{Binding DecisionHeading}" />
        <ItemsControl
            ItemTemplate="{StaticResource SupportMatrixHoverRouteTemplate}"
            ItemsSource="{Binding Routes}" />
      </StackPanel>
      </ToolTip>
    </ToolTip.Tip>
    <Grid>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}" VerticalAlignment="Center">
        <Path Width="14" Height="14" Data="M3 11L8 16L19 5" IsVisible="{Binding IsReviewedEvidence}" Stretch="Uniform" Stroke="{DynamicResource NfcSuccessTextBrush}" StrokeThickness="2.2" />
        <Path Width="13" Height="13" Data="M4 2H13L18 7V20H4Z M13 2V7H18 M8 11H14 M8 15H14" IsVisible="{Binding IsContractOnly}" Stretch="Uniform" Stroke="{DynamicResource NfcInfoTextBrush}" StrokeThickness="1.5" />
        <Path Width="14" Height="14" Data="M11 2L21 20H1Z M11 8V13 M11 17V17.2" IsVisible="{Binding IsReviewRequired}" Stretch="Uniform" Stroke="{DynamicResource NfcWarningTextBrush}" StrokeThickness="1.8" />
        <Path Width="14" Height="14" Data="M11 2A9 9 0 1 0 11 20A9 9 0 1 0 11 2 M5 5L17 17" IsVisible="{Binding IsBlocked}" Stretch="Uniform" Stroke="{DynamicResource NfcDangerTextBrush}" StrokeThickness="1.8" />
        <TextBlock Classes="captionText" FontWeight="SemiBold" Text="{Binding StatusLabel}" TextAlignment="Center" />
        <TextBlock Classes="technicalCaption supportMatrixVariantCount" IsVisible="{Binding HasMultipleRoutes}" Text="{Binding VariantCountDisplay}" />
      </StackPanel>
    </Grid>
  </Border>
</DataTemplate>

<DataTemplate x:Key="SupportMatrixIcRowTemplate" DataType="vm:SupportMatrixIcRowViewModel">
  <Grid ColumnDefinitions="100,*">
    <Border Classes="supportMatrixIcHeader" Padding="10,6">
      <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource NfcTechnicalFontFamily}" FontWeight="SemiBold" Text="{Binding IcId}" />
    </Border>
    <ItemsControl
        Grid.Column="1"
        ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
        ItemTemplate="{StaticResource SupportMatrixCellTemplate}"
        ItemsPanel="{StaticResource HorizontalSupportMatrixPanel}"
        ItemsSource="{Binding Cells}" />
  </Grid>
</DataTemplate>

<DataTemplate x:Key="SettingsModalContentTemplate" DataType="vm:MainWindowViewModel">
  <Grid ColumnDefinitions="318,*">
      <Border
          x:Name="SettingsNavigationRail"
          Classes="settingsNavigationSurface"
          VerticalAlignment="Stretch">
        <StackPanel Spacing="{DynamicResource NfcSpace4}">
          <RadioButton
              AutomationProperties.Name="{Binding Text.SettingsOverviewNavigationLabel}"
              Classes="semanticAction command settingsNavItem"
              Classes.selected="{Binding Settings.IsOverviewSelected}"
              Command="{Binding Settings.SelectSectionCommand}"
              CommandParameter="{x:Static vm:SettingsSection.Overview}"
              GroupName="SettingsSections"
              IsChecked="{Binding Settings.IsOverviewSelected, Mode=OneWay}">
            <Grid ColumnDefinitions="32,*" ColumnSpacing="{DynamicResource NfcSpace8}">
              <Path Width="24" Height="24" Data="M11 2L13 3L15 2L18 5L17 7L18 9V13L17 15L18 17L15 20L13 19L11 20L8 19L6 20L3 17L4 15L3 13V9L4 7L3 5L6 2L8 3L11 2Z M11 7A4 4 0 1 0 11 15A4 4 0 1 0 11 7Z" Stretch="Uniform" />
              <TextBlock Grid.Column="1" Text="{Binding Text.SettingsOverviewNavigationLabel}" />
            </Grid>
          </RadioButton>
          <RadioButton
              AutomationProperties.Name="{Binding Text.SettingsPreferencesNavigationLabel}"
              Classes="semanticAction command settingsNavItem"
              Classes.selected="{Binding Settings.IsPreferencesSelected}"
              Command="{Binding Settings.SelectSectionCommand}"
              CommandParameter="{x:Static vm:SettingsSection.Preferences}"
              GroupName="SettingsSections"
              IsChecked="{Binding Settings.IsPreferencesSelected, Mode=OneWay}">
            <Grid ColumnDefinitions="32,*" ColumnSpacing="{DynamicResource NfcSpace8}">
              <Path Width="24" Height="24" Data="M12 3A9 9 0 1 0 12 21H14A2 2 0 0 0 14 17H13A2 2 0 0 1 13 13H18A3 3 0 0 0 21 10A9 9 0 0 0 12 3Z M7 11V11.2 M10 7V7.2 M15 7V7.2" Stretch="Uniform" />
              <TextBlock Grid.Column="1" Text="{Binding Text.SettingsPreferencesNavigationLabel}" />
            </Grid>
          </RadioButton>
          <RadioButton
              AutomationProperties.Name="{Binding Settings.VersionNavigationLabel}"
              Classes="semanticAction command settingsNavItem"
              Classes.selected="{Binding Settings.IsVersionSelected}"
              Command="{Binding Settings.SelectSectionCommand}"
              CommandParameter="{x:Static vm:SettingsSection.Version}"
              GroupName="SettingsSections"
              IsChecked="{Binding Settings.IsVersionSelected, Mode=OneWay}">
            <Grid ColumnDefinitions="32,*" ColumnSpacing="{DynamicResource NfcSpace8}">
              <Path Width="24" Height="24" Data="M12 3A9 9 0 1 0 12 21A9 9 0 1 0 12 3Z M12 10V17 M12 7V7.2" Stretch="Uniform" />
              <TextBlock Grid.Column="1" Text="{Binding Settings.VersionNavigationLabel}" />
            </Grid>
          </RadioButton>
          <RadioButton
              AutomationProperties.Name="{Binding Text.SupportMatrixTitle}"
              Classes="semanticAction command settingsNavItem"
              Classes.selected="{Binding Settings.IsSupportMatrixOpen}"
              Command="{Binding Settings.SelectSectionCommand}"
              CommandParameter="{x:Static vm:SettingsSection.SupportMatrix}"
              GroupName="SettingsSections"
              IsChecked="{Binding Settings.IsSupportMatrixOpen, Mode=OneWay}">
            <Grid ColumnDefinitions="32,*" ColumnSpacing="{DynamicResource NfcSpace8}">
              <Path Width="24" Height="24" Data="M3 3H9V9H3Z M15 3H21V9H15Z M3 15H9V21H3Z M15 15H21V21H15Z" Stretch="Uniform" />
              <TextBlock Grid.Column="1" Text="{Binding Text.SupportMatrixTitle}" />
            </Grid>
          </RadioButton>
        </StackPanel>
      </Border>

      <ScrollViewer
          x:Name="SettingsContentViewport"
          Grid.Column="1"
          Classes="contentScrollSurface"
          Margin="43,18,42,24"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
      <Grid>
        <StackPanel IsVisible="{Binding Settings.IsOverviewSelected}" Spacing="{DynamicResource NfcSpace16}">
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="sectionTitle" Text="{Binding Text.SettingsOverviewTitle}" />
            <TextBlock Classes="supportingText" Text="{Binding Text.SettingsOverviewSubtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="panelSurface roomyPanel">
            <ItemsControl ItemTemplate="{StaticResource SettingsSummaryRowTemplate}" ItemsSource="{Binding Settings.OverviewRows}" />
          </Border>
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="sectionTitle" Text="{Binding Text.SettingsCapabilitiesTitle}" />
            <TextBlock Classes="supportingText" Text="{Binding Text.SettingsCapabilitiesSubtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="panelSurface roomyPanel">
            <ItemsControl ItemTemplate="{StaticResource SettingsSummaryRowTemplate}" ItemsSource="{Binding Settings.CapabilityRows}" />
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding Settings.IsPreferencesSelected}" Spacing="{DynamicResource NfcSpace16}">
          <StackPanel Spacing="{DynamicResource NfcSpace4}">
            <TextBlock Classes="sectionTitle" Text="{Binding Text.SettingsPreferencesTitle}" />
            <TextBlock Classes="supportingText" Text="{Binding Text.SettingsPreferencesSubtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="panelSurface roomyPanel">
            <StackPanel Spacing="{DynamicResource NfcSpace8}">
              <Border Classes="compactSubtleSurface settingsOptionRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
                  <TextBlock Classes="strongText" VerticalAlignment="Center" Text="{Binding Text.ThemeLabel}" />
                  <ComboBox
                      Grid.Column="1"
                      AutomationProperties.Name="{Binding Text.ThemeLabel}"
                      Classes="settingsSelect"
                      ItemsSource="{Binding Settings.ThemeChoices}"
                      SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:SettingChoiceViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Classes="compactSubtleSurface settingsOptionRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
                  <TextBlock Classes="strongText" VerticalAlignment="Center" Text="{Binding Text.LanguageLabel}" />
                  <ComboBox
                      Grid.Column="1"
                      AutomationProperties.Name="{Binding Text.LanguageLabel}"
                      Classes="settingsSelect"
                      ItemsSource="{Binding Settings.LanguageChoices}"
                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Value}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:SettingChoiceViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Classes="compactSubtleSurface settingsOptionRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
                  <StackPanel Spacing="{DynamicResource NfcSpace2}">
                    <TextBlock Classes="strongText" Text="{Binding Text.ReducedMotionLabel}" />
                    <TextBlock Classes="supportingText" Text="{Binding Text.ReducedMotionDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Text.ReducedMotionLabel}"
                      IsChecked="{Binding IsReducedMotionEnabled, Mode=TwoWay}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <ContentControl
            Content="{Binding}"
            ContentTemplate="{StaticResource SettingsVersionPageTemplate}"
            IsVisible="{Binding Settings.IsVersionSelected}" />


        <StackPanel IsVisible="{Binding Settings.IsSupportMatrixOpen}" Spacing="{DynamicResource NfcSpace12}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace12}">
            <StackPanel Spacing="{DynamicResource NfcSpace4}">
              <TextBlock Classes="pageTitle" Text="{Binding Text.SupportMatrixTitle}" />
              <TextBlock Classes="pageSubtitle" Text="{Binding Text.SupportMatrixSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
              <Label Classes="compactBadge neutralBadge reportBadge info" Content="{Binding Settings.SupportMatrix.RouteCountLabel}" />
              <Label Classes="compactBadge neutralBadge reportBadge" Content="{Binding Settings.SupportMatrix.CatalogStateLabel}" />
            </WrapPanel>
          </Grid>
          <Border Classes="compactSubtleSurface" Padding="12,7">
            <WrapPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,18,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="fieldLabel" Text="{Binding Text.SupportMatrixCatalogVersionLabel}" />
                <TextBlock Classes="technicalCaption" Text="{Binding Settings.SupportMatrix.CatalogVersion}" />
              </StackPanel>
              <StackPanel Margin="0,0,18,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="fieldLabel" Text="{Binding Text.SupportMatrixSourceHashLabel}" />
                <TextBlock Classes="technicalCaption" Text="{Binding Settings.SupportMatrix.SourceHash}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="fieldLabel" Text="{Binding Text.SupportMatrixResolutionTokenLabel}" />
                <TextBlock
                    MaxWidth="420"
                    Classes="technicalCaption"
                    Text="{Binding Settings.SupportMatrix.ResolutionToken}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Settings.SupportMatrix.ResolutionToken}" />
              </StackPanel>
            </WrapPanel>
          </Border>
          <ContentControl
              Content="{Binding Settings.SupportMatrix.StatusNotice}"
              ContentTemplate="{StaticResource DisclosureStatusTemplate}"
              IsVisible="{Binding Settings.SupportMatrix.HasStatusNotice}" />
          <Border Classes="panelSurface" IsVisible="{Binding Settings.SupportMatrix.HasRows}">
            <StackPanel>
              <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource NfcSpace8}" Margin="12,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.SupportMatrixLegendTitle}" VerticalAlignment="Center" />
                  <TextBlock
                      Grid.Column="1"
                      HorizontalAlignment="Right"
                      Classes="captionText"
                      Text="{Binding Text.SupportMatrixHoverHint}"
                      TextAlignment="Right"
                      TextWrapping="Wrap"
                      VerticalAlignment="Center" />
                </Grid>
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                  <StackPanel Margin="0,0,16,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="supportMatrixLegend reviewed" Text="✓" />
                    <TextBlock Classes="captionText" Text="{Binding Text.SupportMatrixReviewedEvidenceLabel}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="supportMatrixLegend contract" Text="▣" />
                    <TextBlock Classes="captionText" Text="{Binding Text.SupportMatrixContractOnlyLabel}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="supportMatrixLegend review" Text="!" />
                    <TextBlock Classes="captionText" Text="{Binding Text.SupportMatrixReviewRequiredLabel}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="supportMatrixLegend blocked" Text="⊘" />
                    <TextBlock Classes="captionText" Text="{Binding Text.SupportMatrixBlockedLabel}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Classes="supportMatrixLegend notDeclared" Text="—" />
                    <TextBlock Classes="captionText" Text="{Binding Text.SupportMatrixNotDeclaredLabel}" />
                  </StackPanel>
                </WrapPanel>
              </Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel>
                  <Grid ColumnDefinitions="100,*">
                    <Border Classes="supportMatrixIcHeader supportMatrixWorkflowHeader" Padding="10,6">
                      <TextBlock HorizontalAlignment="Center" Classes="fieldLabel" Text="{Binding Text.SupportMatrixIcLabel}" TextAlignment="Center" />
                    </Border>
                    <ItemsControl
                        Grid.Column="1"
                        ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
                        ItemTemplate="{StaticResource SupportMatrixWorkflowHeaderTemplate}"
                        ItemsPanel="{StaticResource HorizontalSupportMatrixPanel}"
                        ItemsSource="{Binding Settings.SupportMatrix.WorkflowColumns}" />
                  </Grid>
                  <ItemsControl
                      AutomationProperties.Name="{Binding Text.SupportMatrixTitle}"
                      ItemContainerTheme="{StaticResource StretchContentPresenterTheme}"
                      ItemTemplate="{StaticResource SupportMatrixIcRowTemplate}"
                      ItemsSource="{Binding Settings.SupportMatrix.IcRows}" />
                </StackPanel>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      </ScrollViewer>
  </Grid>
</DataTemplate>

</ResourceDictionary>
