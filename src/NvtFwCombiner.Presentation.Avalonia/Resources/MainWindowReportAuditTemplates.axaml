<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportAuditDetailsPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border Margin="22,16,22,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*">
      <Grid Margin="16,14,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.EvidenceTitle}" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding LoadedReport.AuditSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Padding="7,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Text.TraceLabel}" />
        </Border>
      </Grid>

      <TabControl Grid.Row="1" Margin="12,0,12,12" Classes="reportTabs" FontSize="12">
        <TabItem Header="{Binding Text.ReportTabInputs}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="12">
              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.RunMetadataTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.Status}" />
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ReportFileLabel}" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StatusLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Status}" />
                    <TextBlock Grid.Row="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.OutputLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ArtifactPathLabel}" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasInputGroups}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.InputsAndHashesTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.InputCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.InputGroups}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportInputGroupTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoInputs}">
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyInputsMessage}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabChanges}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="12">
              <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoByteChanges}">
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyByteChangesMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasOutputDifferences}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OutputChangesTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#166534" Text="{Binding LoadedReport.OutputDifferenceCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.OutputDifferences}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportOutputDifferenceRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasMutations}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ChangedRangesTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.MutationCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Mutations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportMutationRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabOperations}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="12">
              <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoOperations}">
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyOperationsMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasOperationFlow}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OperationStepsTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.OperationFlow.Count}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.OperationFlow}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportOperationFlowNodeTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasStepOperations}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.DetailLabel}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.StepOperationCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.StepOperations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportStepOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabPostbuild}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="12">
              <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoCommandOperations}">
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyPostbuildMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasCommandOperations}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.HeaderRefreshTraceTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding LoadedReport.CommandOperationCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.CommandOperations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportCommandOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabIssues}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="12">
              <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoIssues}">
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyIssuesMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasIssues}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.IssuesAndWarningsTitle}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding LoadedReport.IssueCount}" />
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Issues}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportIssueRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabRaw}">
          <Border Margin="0,12,0,0" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <TextBox
                MinHeight="320"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="11"
                IsReadOnly="True"
                Text="{Binding LoadedReportJson, Mode=OneWay}"
                TextWrapping="NoWrap" />
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</DataTemplate>

</ResourceDictionary>
