<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportAuditDetailsPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border MinHeight="0" Classes="surface" Margin="16,14,16,0">
    <Grid RowDefinitions="Auto,*">
      <Grid Margin="16,14,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="{DynamicResource NfcSpace2}">
          <TextBlock Classes="panelTitle" Text="{Binding Text.EvidenceTitle}" />
          <TextBlock Classes="captionText" Text="{Binding LoadedReport.AuditSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding Text.TraceLabel}" />
      </Grid>

      <TabControl Grid.Row="1" Margin="12,0,12,12" Classes="reportTabs" FontSize="{DynamicResource NfcFontSize12}">
        <TabItem Header="{Binding Text.ReportTabInputs}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasInputGroups}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.InputsAndHashesTitle}" />
                    <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding LoadedReport.InputCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.InputGroups}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportInputGroupTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoInputs}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyInputsMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Classes="insetSurface contentPanel">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.RunMetadataTitle}" />
                    <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding LoadedReport.Status}" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <TextBlock Classes="fieldLabel" Text="{Binding Text.ReportFileLabel}" />
                    <TextBlock Grid.Column="1" Classes="bodyText" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Classes="fieldLabel" Text="{Binding Text.StatusLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="bodyStrongText" Text="{Binding LoadedReport.Status}" />
                    <TextBlock Grid.Row="2" Classes="fieldLabel" Text="{Binding Text.OutputLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="technicalDetail" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Classes="fieldLabel" Text="{Binding Text.ArtifactPathLabel}" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="bodyText" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabChanges}">
          <Grid MinHeight="0" Margin="0,12,0,0" RowDefinitions="*,Auto" RowSpacing="10">
            <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoByteChanges}">
              <TextBlock Classes="mutedText" Text="{Binding Text.EmptyByteChangesMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid
                MinHeight="0"
                ColumnDefinitions="2*,Auto,*"
                ColumnSpacing="{DynamicResource NfcSpace8}"
                IsVisible="{Binding LoadedReport.HexDiff.HasDifferenceWorkspace}">
              <Border Classes="reportHexDiffViewport">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                  <Border Padding="12,10" BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="panelTitle" Text="{Binding Text.HexDiffViewportTitle}" />
                        <TextBlock Classes="captionText" Text="{Binding LoadedReport.HexDiff.AvailabilityDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge success" Content="{Binding LoadedReport.OutputDifferenceCount}" />
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" Margin="10,8" ColumnDefinitions="Auto,160,Auto,*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
                    <TextBlock VerticalAlignment="Center" Classes="tableHeader" Text="{Binding Text.HexDiffJumpAddressLabel}" />
                    <TextBox
                        Grid.Column="1"
                        Classes="technicalCenteredInput addressInput"
                        AutomationProperties.Name="{Binding Text.HexDiffJumpAddressLabel}"
                        Text="{Binding LoadedReport.HexDiff.JumpAddress, Mode=TwoWay}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding LoadedReport.HexDiff.JumpAddressCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button
                        Grid.Column="2"
                        Classes="secondary"
                        AutomationProperties.Name="{Binding Text.HexDiffJumpActionLabel}"
                        Command="{Binding LoadedReport.HexDiff.JumpAddressCommand}"
                        Content="{Binding Text.HexDiffJumpActionLabel}" />
                    <ToggleSwitch
                        Grid.Column="4"
                        Classes="reportHexDiffOriginalToggle"
                        AutomationProperties.Name="{Binding Text.HexDiffShowOriginalRowsLabel}"
                        Content="{Binding Text.HexDiffShowOriginalRowsLabel}"
                        IsChecked="{Binding LoadedReport.HexDiff.ShowOriginalRows, Mode=TwoWay}" />
                  </Grid>

                  <TextBlock
                      Grid.Row="2"
                      Margin="10,0,10,8"
                      Classes="captionText"
                      AutomationProperties.LiveSetting="Polite"
                      AutomationProperties.Name="{Binding LoadedReport.HexDiff.JumpStatus}"
                      Text="{Binding LoadedReport.HexDiff.JumpStatus}"
                      TextWrapping="Wrap" />

                  <Grid Grid.Row="3" Margin="8,0,8,6" ColumnDefinitions="112,*,112,Auto" ColumnSpacing="10">
                    <TextBlock Classes="tableHeader" Text="{Binding Text.HexDiffAddressLabel}" />
                    <TextBlock Grid.Column="1" Classes="tableHeader" Text="{Binding Text.HexDiffOutputBytesLabel}" />
                    <TextBlock Grid.Column="2" Classes="tableHeader" Text="{Binding Text.HexDiffAsciiLabel}" />
                    <TextBlock Grid.Column="3" Classes="tableHeader" Text="{Binding Text.StateLabel}" />
                  </Grid>

                  <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LoadedReport.HexDiff.VisibleRows}">
                      <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ReportHexDiffViewportRowTemplate" />
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <GridSplitter
                  Grid.Column="1"
                  Width="6"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{Binding Text.HexDiffResizeAutomationName}"
                  ResizeDirection="Columns" />

              <Grid Grid.Column="2" MinHeight="0" RowDefinitions="*,*" RowSpacing="{DynamicResource NfcSpace8}">
                <Border Classes="compactSurface contentPanel">
                  <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
                      <TextBlock Classes="panelTitle" Text="{Binding Text.HexDiffChangeInformationTitle}" />
                      <Label
                          Grid.Column="1"
                          Classes="compactBadge neutralBadge reportBadge success"
                          Classes.review="{Binding LoadedReport.HexDiff.SelectedRange.IsReviewRequired}"
                          Content="{Binding LoadedReport.HexDiff.SelectedRange.Status}"
                          IsVisible="{Binding LoadedReport.HexDiff.HasSelectedRange}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Classes="mutedText"
                        Text="{Binding Text.HexDiffNoSelectionDetail}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding LoadedReport.HexDiff.HasNoSelectedRange}" />
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding LoadedReport.HexDiff.HasSelectedRange}">
                      <StackPanel Spacing="{DynamicResource NfcSpace8}">
                        <TextBlock Classes="bodyStrongText" Text="{Binding LoadedReport.HexDiff.SelectedRange.Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="bodyText" Text="{Binding LoadedReport.HexDiff.SelectedRange.Reason}" TextWrapping="Wrap" />
                        <TextBlock Classes="technicalCaption" Text="{Binding LoadedReport.HexDiff.SelectedRange.AccessibleRange}" TextWrapping="Wrap" />
                        <TextBlock Classes="captionText" Text="{Binding LoadedReport.HexDiff.SelectedRange.ChangedSummary}" />
                        <TextBlock
                            Classes="captionText"
                            Text="{Binding LoadedReport.HexDiff.SelectedRange.PreviewCoverage}"
                            TextWrapping="Wrap"
                            IsVisible="{Binding LoadedReport.HexDiff.IsReportedRangeMode}" />
                        <TextBlock Classes="captionText" Text="{Binding LoadedReport.HexDiff.SelectedRange.SectionLabel}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace8}" RowSpacing="6">
                          <TextBlock Classes="tableHeader" Text="{Binding Text.EvidenceTitle}" />
                          <TextBlock Grid.Column="1" Classes="technicalCaption" Text="{Binding LoadedReport.HexDiff.SelectedRange.Evidence}" TextWrapping="Wrap" />
                          <TextBlock Grid.Row="1" Classes="tableHeader" Text="{Binding Text.HexDiffBeforeSha256Label}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="technicalCaption" Text="{Binding LoadedReport.HexDiff.SelectedRange.BeforeSha256}" TextWrapping="Wrap" />
                          <TextBlock Grid.Row="2" Classes="tableHeader" Text="{Binding Text.HexDiffAfterSha256Label}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Classes="technicalCaption" Text="{Binding LoadedReport.HexDiff.SelectedRange.AfterSha256}" TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Classes="compactSurface contentPanel">
                  <Grid MinHeight="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource NfcSpace8}">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="panelTitle" Text="{Binding Text.HexDiffRangeNavigatorTitle}" />
                      <TextBlock Classes="captionText" Text="{Binding Text.HexDiffRangeNavigatorDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ContentControl
                        Grid.Row="1"
                        Content="{Binding LoadedReport.HexDiff.PinnedSelectedRange}"
                        ContentTemplate="{StaticResource ReportHexDiffRangeRowTemplate}"
                        IsVisible="{Binding LoadedReport.HexDiff.HasPinnedSelectedRange}" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding LoadedReport.HexDiff.NavigatorPage.Items}">
                        <ItemsControl.ItemTemplate>
                          <StaticResource ResourceKey="ReportHexDiffRangeRowTemplate" />
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <ContentControl
                        Grid.Row="3"
                        Content="{Binding LoadedReport.HexDiff.NavigatorPage}"
                        ContentTemplate="{StaticResource ReportWindowedPagerTemplate}" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <Expander Grid.Row="1" IsExpanded="False" IsVisible="{Binding LoadedReport.HasMutations}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="panelTitle" Text="{Binding Text.ChangedRangesTitle}" />
                  <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding LoadedReport.MutationCount}" />
                </Grid>
              </Expander.Header>
              <StackPanel>
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LoadedReport.MutationPage.Items}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportMutationRowTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl
                    Content="{Binding LoadedReport.MutationPage}"
                    ContentTemplate="{StaticResource ReportPagerTemplate}" />
              </StackPanel>
            </Expander>
          </Grid>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabOperations}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoOperations}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyOperationsMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasOperationFlow}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.OperationStepsTitle}" />
                    <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding LoadedReport.OperationFlow.Count}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.OperationFlowPage.Items}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportOperationFlowNodeTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ContentControl
                      Content="{Binding LoadedReport.OperationFlowPage}"
                      ContentTemplate="{StaticResource ReportPagerTemplate}" />
                </StackPanel>
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasStepOperations}">
                <StackPanel Spacing="{DynamicResource NfcSpace8}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.DetailLabel}" />
                    <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge" Content="{Binding LoadedReport.StepOperationCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.StepOperationPage.Items}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportStepOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ContentControl
                      Content="{Binding LoadedReport.StepOperationPage}"
                      ContentTemplate="{StaticResource ReportPagerTemplate}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabPostbuild}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoPostbuildInvocations}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyPostbuildMessage}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="{DynamicResource NfcSpace8}" IsVisible="{Binding LoadedReport.HasPostbuildInvocations}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="panelTitle" Text="{Binding Text.HeaderRefreshTraceTitle}" />
                  <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge info" Content="{Binding LoadedReport.PostbuildInvocationCount}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LoadedReport.PostbuildInvocationPage.Items}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportPostbuildInvocationTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl
                    Content="{Binding LoadedReport.PostbuildInvocationPage}"
                    ContentTemplate="{StaticResource ReportPagerTemplate}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabIssues}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="successInset" Padding="16" IsVisible="{Binding LoadedReport.HasNoIssues}">
                <Grid ColumnDefinitions="34,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                  <Border Width="26" Height="26" Background="{DynamicResource NfcSuccessAccentBrush}" CornerRadius="{DynamicResource NfcPillCornerRadius}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize14}" FontWeight="SemiBold" Foreground="{DynamicResource NfcSurfaceBrush}" Text="✓" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
                    <TextBlock FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcSuccessTextStrongBrush}" Text="{Binding Text.NoActionRequiredTitle}" />
                    <TextBlock FontSize="{DynamicResource NfcFontSize12}" Foreground="{DynamicResource NfcSuccessTextBrush}" Text="{Binding Text.EmptyIssuesMessage}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasIssues}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.IssuesAndWarningsTitle}" />
                    <Label Grid.Column="1" Classes="compactBadge neutralBadge reportBadge review" Content="{Binding LoadedReport.IssueCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.IssuePage.Items}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportIssueRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ContentControl
                      Content="{Binding LoadedReport.IssuePage}"
                      ContentTemplate="{StaticResource ReportPagerTemplate}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabRaw}">
          <Grid MinHeight="0" Margin="0,12,0,0" VerticalAlignment="Stretch" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Classes="insetSurface contentPanel">
              <StackPanel Spacing="{DynamicResource NfcSpace2}">
                <TextBlock Classes="panelTitle" Text="{Binding Text.RawReportTitle}" />
                <TextBlock Classes="mutedText" Text="{Binding Text.RawReportDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBox
                Grid.Row="1"
                Classes="readOnlyRaw"
                VerticalAlignment="Stretch"
                Text="{Binding LoadedReportJson, Mode=OneWay}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</DataTemplate>

</ResourceDictionary>
