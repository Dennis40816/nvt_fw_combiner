<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels">

<DataTemplate x:Key="ReportAuditDetailsPanelTemplate" DataType="vm:MainWindowViewModel">
  <Border MinHeight="0" Classes="surface" Margin="16,14,16,0">
    <Grid RowDefinitions="Auto,*">
      <Grid Margin="16,14,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="{DynamicResource NfcSpace2}">
          <TextBlock Classes="panelTitle" Text="{Binding Text.EvidenceTitle}" />
          <TextBlock Classes="captionText" Text="{Binding LoadedReport.AuditSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <Label Grid.Column="1" Classes="reportBadge" Content="{Binding Text.TraceLabel}" />
      </Grid>

      <TabControl Grid.Row="1" Margin="12,0,12,12" Classes="reportTabs" FontSize="{DynamicResource NfcFontSize12}">
        <TabItem Header="{Binding Text.ReportTabInputs}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasInputGroups}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.InputsAndHashesTitle}" />
                    <Label Grid.Column="1" Classes="reportBadge" Content="{Binding LoadedReport.InputCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.InputGroups}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportInputGroupTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoInputs}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyInputsMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Classes="insetSurface contentPanel">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.RunMetadataTitle}" />
                    <Label Grid.Column="1" Classes="reportBadge" Content="{Binding LoadedReport.Status}" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <TextBlock Classes="fieldLabel" Text="{Binding Text.ReportFileLabel}" />
                    <TextBlock Grid.Column="1" Classes="bodyText" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Classes="fieldLabel" Text="{Binding Text.StatusLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="bodyStrongText" Text="{Binding LoadedReport.Status}" />
                    <TextBlock Grid.Row="2" Classes="fieldLabel" Text="{Binding Text.OutputLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="technicalDetail" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Classes="fieldLabel" Text="{Binding Text.ArtifactPathLabel}" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="bodyText" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabChanges}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoByteChanges}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyByteChangesMessage}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="10" IsVisible="{Binding LoadedReport.HasOutputDifferences}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="panelTitle" Text="{Binding Text.OutputChangesTitle}" />
                  <Label Grid.Column="1" Classes="reportBadge success" Content="{Binding LoadedReport.OutputDifferenceCount}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LoadedReport.OutputDifferenceGroups}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportOutputDifferenceGroupTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Expander IsExpanded="False" IsVisible="{Binding LoadedReport.HasMutations}">
                <Expander.Header>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource NfcTextSecondaryBrush}" Text="{Binding Text.ChangedRangesTitle}" />
                    <Label Grid.Column="1" Classes="reportBadge" Content="{Binding LoadedReport.MutationCount}" />
                  </Grid>
                </Expander.Header>
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LoadedReport.Mutations}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportMutationRowTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabOperations}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoOperations}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyOperationsMessage}" TextWrapping="Wrap" />
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasOperationFlow}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.OperationStepsTitle}" />
                    <Label Grid.Column="1" Classes="reportBadge" Content="{Binding LoadedReport.OperationFlow.Count}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.OperationFlow}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportOperationFlowNodeTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasStepOperations}">
                <StackPanel Spacing="{DynamicResource NfcSpace8}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.DetailLabel}" />
                    <Label Grid.Column="1" Classes="reportBadge" Content="{Binding LoadedReport.StepOperationCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.StepOperations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportStepOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabPostbuild}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="insetSurface" Padding="14" IsVisible="{Binding LoadedReport.HasNoPostbuildInvocations}">
                <TextBlock Classes="mutedText" Text="{Binding Text.EmptyPostbuildMessage}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="{DynamicResource NfcSpace8}" IsVisible="{Binding LoadedReport.HasPostbuildInvocations}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Classes="panelTitle" Text="{Binding Text.HeaderRefreshTraceTitle}" />
                  <Label Grid.Column="1" Classes="reportBadge info" Content="{Binding LoadedReport.PostbuildInvocationCount}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LoadedReport.PostbuildInvocations}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportPostbuildInvocationTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabIssues}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0" Spacing="{DynamicResource NfcSpace12}">
              <Border Classes="successInset" Padding="16" IsVisible="{Binding LoadedReport.HasNoIssues}">
                <Grid ColumnDefinitions="34,*" ColumnSpacing="{DynamicResource NfcSpace12}">
                  <Border Width="26" Height="26" Background="{DynamicResource NfcSuccessAccentBrush}" CornerRadius="{DynamicResource NfcPillCornerRadius}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize14}" FontWeight="SemiBold" Foreground="{DynamicResource NfcSurfaceBrush}" Text="✓" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource NfcSpace2}">
                    <TextBlock FontSize="{DynamicResource NfcFontSize13}" FontWeight="SemiBold" Foreground="{DynamicResource NfcSuccessTextStrongBrush}" Text="{Binding Text.NoActionRequiredTitle}" />
                    <TextBlock FontSize="{DynamicResource NfcFontSize12}" Foreground="{DynamicResource NfcSuccessTextBrush}" Text="{Binding Text.EmptyIssuesMessage}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="compactSurface contentPanel" IsVisible="{Binding LoadedReport.HasIssues}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="panelTitle" Text="{Binding Text.IssuesAndWarningsTitle}" />
                    <Label Grid.Column="1" Classes="reportBadge review" Content="{Binding LoadedReport.IssueCount}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Issues}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportIssueRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Text.ReportTabRaw}">
          <Grid MinHeight="0" Margin="0,12,0,0" VerticalAlignment="Stretch" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Classes="insetSurface contentPanel">
              <StackPanel Spacing="{DynamicResource NfcSpace2}">
                <TextBlock Classes="panelTitle" Text="{Binding Text.RawReportTitle}" />
                <TextBlock Classes="mutedText" Text="{Binding Text.RawReportDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBox
                Grid.Row="1"
                Classes="readOnlyRaw"
                VerticalAlignment="Stretch"
                Text="{Binding LoadedReportJson, Mode=OneWay}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</DataTemplate>

</ResourceDictionary>
