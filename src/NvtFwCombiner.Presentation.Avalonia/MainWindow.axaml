<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    WindowState="Maximized"
    MinWidth="980"
    MinHeight="640"
    Background="#F4F6FA"
    FontFamily="fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI"
    Title="NVT FW Combiner">
  <Window.Resources>
    <ControlTheme x:Key="StretchContentPresenterTheme" TargetType="ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </ControlTheme>
    <DataTemplate x:Key="MemoryCoverageTooltipTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
      <Border
          MaxWidth="360"
          Padding="10"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border
                Width="10"
                Height="10"
                VerticalAlignment="Center"
                Background="{Binding FillBrush}"
                BorderBrush="{Binding OutlineBrush}"
                BorderThickness="{Binding OutlineThickness}"
                CornerRadius="2" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="{Binding SourceLabel}"
                TextWrapping="Wrap" />
            <Border
                Grid.Column="2"
                Padding="7,2"
                VerticalAlignment="Center"
                Background="{Binding ChangeBadgeBackgroundBrush}"
                BorderBrush="{Binding ChangeBadgeBorderBrush}"
                BorderThickness="1"
                CornerRadius="999">
              <TextBlock
                  FontSize="10"
                  FontWeight="SemiBold"
                  Foreground="{Binding ChangeBadgeForegroundBrush}"
                  Text="{Binding ChangeLabel}" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Range" />
            <TextBlock
                Grid.Column="1"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="#0F172A"
                Text="{Binding RangeLabel}"
                TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Result" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                FontSize="11"
                Foreground="#334155"
                Text="{Binding CompactDetail}"
                TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Detail" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                MaxWidth="280"
                FontSize="11"
                Foreground="#64748B"
                Text="{Binding Detail}"
                TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FirmwareSlotFactTemplate" DataType="vm:FirmwareSlotFactViewModel">
      <Border Margin="0,2,6,0" Padding="7,2" Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#475569" Text="{Binding Label}" />
          <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Value}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FirmwareSlotCardTemplate" DataType="vm:FirmwareSlotViewModel">
      <Border
          Classes="fileDropZone"
          HorizontalAlignment="Stretch"
          Margin="0,0,0,10"
          Padding="0"
          Background="{Binding SlotBackgroundBrush}"
          BorderBrush="{Binding SlotBorderBrush}"
          BorderThickness="{Binding SlotBorderThickness}"
          CornerRadius="8"
          DragDrop.AllowDrop="True"
          DragDrop.DragEnter="DropZone_OnDragEnter"
          DragDrop.DragOver="SlotDragOver_OnDragOver"
          DragDrop.DragLeave="DropZone_OnDragLeave"
          DragDrop.Drop="SlotDrop_OnDrop"
          Tag="{Binding SlotId}">
        <Grid>
          <Border Classes="dropZoneOverlay" />
          <Grid Margin="14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border
                    Classes="slotTypeIcon"
                    Background="{Binding SlotIconBackgroundBrush}"
                    BorderBrush="{Binding SlotIconBorderBrush}"
                    ToolTip.Tip="{Binding SlotIconTooltip}">
                  <Path
                      Data="{Binding SlotIconPathData}"
                      Stroke="{Binding SlotIconForegroundBrush}" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding RequirementBadgeBackgroundBrush}" BorderBrush="{Binding RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding RequirementBadgeForegroundBrush}" Text="{Binding RequirementLabel}" />
                </Border>
              </StackPanel>
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
              <ItemsControl IsVisible="{Binding HasFirmwareFacts}" ItemsSource="{Binding FirmwareFacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding HasFile}" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="action browseAction"
                Click="BrowseSlotButton_OnClick"
                Content="Browse"
                Tag="{Binding SlotId}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportSelectionRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportMissingRequiredRowTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="180,*" ColumnSpacing="12" Margin="0,0,0,8">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#7C2D12" Text="{Binding Title}" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportEvidenceChipTemplate" DataType="vm:ReportLineViewModel">
      <Border
          MinWidth="112"
          Padding="11,8"
          Margin="0,0,8,8"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel Spacing="2">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Title}" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportTriageRowTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Margin="0,0,0,10">
        <Grid>
          <Border Width="2" HorizontalAlignment="Center" Background="#DBEAFE" />
          <Border
              Width="18"
              Height="18"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="#EFF6FF"
              BorderBrush="#93C5FD"
              BorderThickness="1"
              CornerRadius="999" />
        </Grid>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportIssueRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportCommandOperationTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="24,*">
        <Grid>
          <Border Width="2" HorizontalAlignment="Center" Background="#BFDBFE" />
          <Border
              Width="14"
              Height="14"
              Margin="0,9,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="#2563EB"
              BorderBrush="#DBEAFE"
              BorderThickness="2"
              CornerRadius="999" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="0,6,0,14" Spacing="5">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Command" />
          <Border Padding="8,6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding HasCodeBlock}">
            <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding CodeBlock}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportStepOperationTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="24,*">
        <Grid>
          <Border Width="2" HorizontalAlignment="Center" Background="#CBD5E1" />
          <Border
              Width="12"
              Height="12"
              Margin="0,10,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="#64748B"
              BorderBrush="#F8FAFC"
              BorderThickness="2"
              CornerRadius="999" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="0,6,0,14" Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportHistoryEntryTemplate" DataType="vm:ReportHistoryEntryViewModel">
      <Button
          MinWidth="236"
          MaxWidth="292"
          Margin="0,0,8,0"
          Padding="0"
          Background="Transparent"
          BorderBrush="Transparent"
          Command="{Binding $parent[Window].DataContext.OpenReportHistoryEntryCommand}"
          CommandParameter="{Binding}">
        <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding SequenceLabel}" />
              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Status}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding IssueSummary}" TextWrapping="Wrap" />
            </Grid>
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Context}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OutputHash}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CommandSummary}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding EvidenceSummary}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#475569" Text="{Binding ArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding HasArtifactPath}" />
          </StackPanel>
        </Border>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.nav">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.nav:checked">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ToggleButton.segment TextBlock">
      <Setter Property="Foreground" Value="#334155" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ToggleButton.segment:checked TextBlock">
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.command:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.command:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.iconButton">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button.iconButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.iconButton TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconButton:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#CBD5E1" />
    </Style>
    <Style Selector="Button.iconButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.dangerIcon">
      <Setter Property="Background" Value="#FFF7F7" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="Foreground" Value="#B91C1C" />
    </Style>
    <Style Selector="Button.dangerIcon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFF7F7" />
      <Setter Property="BorderBrush" Value="#FECACA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.breadcrumb">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.breadcrumb /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="FontFamily" Value="Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="FontFamily" Value="Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox.technicalSelect">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>
    <Style Selector="ComboBox.settingsSelect">
      <Setter Property="Width" Value="180" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.browseAction">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.browseAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.browseAction:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.browseAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.toolbarAction">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.toolbarAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.toolbarAction:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.toolbarAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.reportAction">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="MinWidth" Value="154" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.reportAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.reportAction:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.reportAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.summaryChip">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.summaryChip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.segmentDisabled">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.segmentDisabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.slotTypeIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.slotTypeIcon Path">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.65" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Border.dropZoneOverlay">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.fileDropZone.dragActive Border.dropZoneOverlay">
      <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector="TextBox.addressInput">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MaxHeight" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Border
        Padding="28,12"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="2">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="NVT FW Combiner" />
          <TextBlock
              FontSize="12"
              Foreground="#64748B"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="Home" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <Button
              Classes="secondary"
              Click="LoadReportJsonButton_OnClick"
              ToolTip.Tip="Load report JSON">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock VerticalAlignment="Center" FontSize="14" Text="↥" />
              <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Load JSON" />
            </StackPanel>
          </Button>
          <Button
              Classes="reportAction"
              Command="{Binding ShowReportCommand}"
              IsEnabled="{Binding CanOpenReport}"
              ToolTip.Tip="{Binding ReportModalActionLabel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="15"
                  Text="▤" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding ReportActionLabel}" />
                <TextBlock
                    FontSize="10"
                    Opacity="0.82"
                    Text="{Binding ReportActionStatus}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="28,6"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            Classes="iconButton"
            Command="{Binding GoBackCommand}"
            ToolTip.Tip="Back">
          <TextBlock Text="←" />
        </Button>
        <ItemsControl ItemsSource="{Binding NavigationTrail}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShellNavigationEntryViewModel">
              <Button Classes="breadcrumb" Command="{Binding NavigateCommand}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                  <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" IsVisible="{Binding IsChevronVisible}" Text=">" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border
        Grid.Row="2"
        Padding="28,8"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1"
        IsVisible="{Binding IsDeviceContextVisible}">
      <Grid ColumnDefinitions="*,Auto">
        <Grid
            Grid.Column="0"
            ColumnDefinitions="154,132,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="3"
            VerticalAlignment="Center"
            ToolTip.Tip="{Binding DeviceContextTitle}">

          <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              Text="{Binding IcLabel}" />
          <ComboBox
              Grid.Row="1"
              Grid.Column="0"
              Classes="technicalSelect"
              Width="154"
              ItemsSource="{Binding IcChoices}"
              SelectedItem="{Binding SelectedIc, Mode=TwoWay}" />

          <Border
              Grid.Row="0"
              Grid.RowSpan="2"
              Grid.Column="1"
              Width="132"
              MinHeight="45"
              Background="Transparent"
              IsHitTestVisible="False"
              IsVisible="{Binding IsNumberSelectorPlaceholderVisible}" />
          <TextBlock
              Grid.Row="0"
              Grid.Column="1"
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              IsVisible="{Binding IsNumberSelectorVisible}"
              Text="{Binding NumberLabel}" />
          <ComboBox
              Grid.Row="1"
              Grid.Column="1"
              Classes="technicalSelect"
              Width="132"
              IsVisible="{Binding IsNumberSelectorVisible}"
              ItemsSource="{Binding NumberChoices}"
              SelectedItem="{Binding SelectedNumber, Mode=TwoWay}" />
          <StackPanel
              Grid.Row="1"
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <Border
                Width="8"
                Height="8"
                Background="#16A34A"
                CornerRadius="999" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#334155"
                Text="{Binding DeviceContextStatus}"
                TextAlignment="Left"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3">
      <Grid Margin="28,24,28,28" RowDefinitions="*" RowSpacing="0">
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="16"
            IsVisible="{Binding IsHomeVisible}"
            VerticalAlignment="Top">
          <Border
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="CONFIGURE" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding SettingsPreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding SettingsPreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl Grid.Row="1" Margin="0,18,0,0" ItemsSource="{Binding SettingsPreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Foreground="#334155"
                        Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button
                  Grid.Row="2"
                  Classes="primary"
                  HorizontalAlignment="Left"
                  Command="{Binding ShowSettingsCommand}">
                <TextBlock Foreground="#FFFFFF" Text="Open settings" />
              </Button>
            </Grid>
          </Border>

          <Border
              Grid.Column="1"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding ReplacePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowDpReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    Command="{Binding ShowCtrlRamReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="2"
                    Classes="command"
                    Command="{Binding ShowGeneralReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="General Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <Border
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  Background="#FFF7ED"
                  BorderBrush="#FED7AA"
                  BorderThickness="1"
                  CornerRadius="999">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#B45309"
                    Text="{Binding HomeReplaceStatus}"
                    TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Border>

          <Border
              Grid.Column="2"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding MergePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding MergePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowNormalMergeCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Normal Merge" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    IsEnabled="False">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#94A3B8" Text="AB Code" />
                      <Border Grid.Column="1" Padding="10,4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Text="Pending" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <Border
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  Background="#EFF6FF"
                  BorderBrush="#BFDBFE"
                  BorderThickness="1"
                  CornerRadius="999">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1D4ED8"
                    Text="{Binding HomeMergeStatus}"
                    TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="#0F172A"
                  Text="{Binding SettingsPreview.Title}" />
              <TextBlock
                  FontSize="13"
                  Foreground="#64748B"
                  Text="{Binding SettingsPreview.Subtitle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Catalog" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Profile and flash-map status from application catalogs." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsProfileRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            <TextBlock Grid.Row="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" MaxWidth="170" FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Tools" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Approved external tool binding and postbuild catalog." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsToolRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Diagnostics" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Report review and non-execution diagnostics access." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsDiagnosticsRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Preferences" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Runtime shell preferences; persistence remains a later adapter." TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="92,180,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Theme" />
                    <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding ThemePreferenceStatus}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Strictness" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding StrictnessChoices}" SelectedItem="{Binding SelectedStrictness, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding StrictnessPreferenceStatus}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Language" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding LanguagePreferenceStatus}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Settings readiness" />
              <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding SettingsPreview.Status}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SettingsReadinessRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                        </Grid>
                        <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.15*,430"
            ColumnSpacing="18"
            IsVisible="{Binding IsReplaceVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <Grid
                  Grid.Column="1"
                  ColumnDefinitions="158,Auto,Auto"
                  ColumnSpacing="12"
                  VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Mode" />
                  <ComboBox
                      MinHeight="32"
                      ItemsSource="{Binding ReplaceModeChoices}"
                      SelectedItem="{Binding SelectedReplaceMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Targets" />
                  <Button
                      Classes="summaryChip"
                      Command="{Binding ShowReplaceSelectionCommand}"
                      ToolTip.Tip="Review selected replacement inputs">
                    <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                      <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceSelectionCountLabel}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="▾" />
                    </Grid>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <Button
                      Classes="toolbarAction"
                      Command="{Binding PreviewReplaceCommand}"
                      ToolTip.Tip="{Binding ReplacePreviewUnavailableReason}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="▷" />
                      <TextBlock VerticalAlignment="Center" Text="Preview" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="toolbarAction"
                      Click="BuildReplaceButton_OnClick"
                      IsEnabled="{Binding CanBuildReplace}"
                      ToolTip.Tip="{Binding ReplaceBuildUnavailableReason}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="✓" />
                      <TextBlock VerticalAlignment="Center" Text="Build" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsNonCtrlRamStructuredReplaceModeSelected}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Input files" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedReplaceModeDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSlots}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsCtrlRamReplaceModeSelected}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Input files" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="Drop files only for CtrlRAM areas you want to change. Empty areas stay from the base firmware." TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Classes="fileDropZone"
                    MinHeight="92"
                    Padding="0"
                    Background="{Binding ReplaceBaseSlot.SlotBackgroundBrush}"
                    BorderBrush="{Binding ReplaceBaseSlot.SlotBorderBrush}"
                    BorderThickness="{Binding ReplaceBaseSlot.SlotBorderThickness}"
                    CornerRadius="8"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="DropZone_OnDragEnter"
                    DragDrop.DragOver="SlotDragOver_OnDragOver"
                    DragDrop.DragLeave="DropZone_OnDragLeave"
                    DragDrop.Drop="SlotDrop_OnDrop"
                    Tag="{Binding ReplaceBaseSlot.SlotId}">
                  <Grid>
                    <Border Classes="dropZoneOverlay" />
                    <Grid Margin="14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border
                              Classes="slotTypeIcon"
                              Background="{Binding ReplaceBaseSlot.SlotIconBackgroundBrush}"
                              BorderBrush="{Binding ReplaceBaseSlot.SlotIconBorderBrush}"
                              ToolTip.Tip="{Binding ReplaceBaseSlot.SlotIconTooltip}">
                            <Path
                                Data="{Binding ReplaceBaseSlot.SlotIconPathData}"
                                Stroke="{Binding ReplaceBaseSlot.SlotIconForegroundBrush}" />
                          </Border>
                          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceBaseSlot.Title}" />
                          <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding ReplaceBaseSlot.RequirementBadgeBackgroundBrush}" BorderBrush="{Binding ReplaceBaseSlot.RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ReplaceBaseSlot.RequirementBadgeForegroundBrush}" Text="{Binding ReplaceBaseSlot.RequirementLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceBaseSlot.Description}" TextWrapping="Wrap" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceBaseSlot.DisplayName}" TextWrapping="Wrap" />
                        <ItemsControl IsVisible="{Binding ReplaceBaseSlot.HasFirmwareFacts}" ItemsSource="{Binding ReplaceBaseSlot.FirmwareFacts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding ReplaceBaseSlot.HasFile}" Text="{Binding ReplaceBaseSlot.DisplayDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="action browseAction"
                          Click="BrowseSlotButton_OnClick"
                          Content="Browse"
                          Tag="{Binding ReplaceBaseSlot.SlotId}" />
                    </Grid>
                  </Grid>
                </Border>

                <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSlotGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FirmwareSlotGroupViewModel">
                      <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                          <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding CountLabel}" />
                            </Border>
                          </Grid>
                        </Expander.Header>
                        <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Slots}">
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsGeneralReplaceModeSelected}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="General replace mapping" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedReplaceModeDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Padding="9,3" VerticalAlignment="Top" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="999">
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" Text="Workbench wiring pending" />
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Border Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="Base image" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="Unmapped bytes stay from the selected base BIN." TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="Target bounds" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="Ranges must fit the base image and avoid protected regions." TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="Input length" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="Replacement BIN data must cover the mapped range length." TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Base image" />
                <Border
                    Classes="fileDropZone"
                    Padding="0"
                    Background="{Binding ReplaceBaseSlot.SlotBackgroundBrush}"
                    BorderBrush="{Binding ReplaceBaseSlot.SlotBorderBrush}"
                    BorderThickness="{Binding ReplaceBaseSlot.SlotBorderThickness}"
                    CornerRadius="8"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="DropZone_OnDragEnter"
                    DragDrop.DragOver="SlotDragOver_OnDragOver"
                    DragDrop.DragLeave="DropZone_OnDragLeave"
                    DragDrop.Drop="SlotDrop_OnDrop"
                    Tag="{Binding ReplaceBaseSlot.SlotId}">
                  <Grid>
                    <Border Classes="dropZoneOverlay" />
                    <Grid Margin="14" MinHeight="60" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border
                              Classes="slotTypeIcon"
                              Background="{Binding ReplaceBaseSlot.SlotIconBackgroundBrush}"
                              BorderBrush="{Binding ReplaceBaseSlot.SlotIconBorderBrush}"
                              ToolTip.Tip="{Binding ReplaceBaseSlot.SlotIconTooltip}">
                            <Path
                                Data="{Binding ReplaceBaseSlot.SlotIconPathData}"
                                Stroke="{Binding ReplaceBaseSlot.SlotIconForegroundBrush}" />
                          </Border>
                          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceBaseSlot.Title}" />
                          <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding ReplaceBaseSlot.RequirementBadgeBackgroundBrush}" BorderBrush="{Binding ReplaceBaseSlot.RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ReplaceBaseSlot.RequirementBadgeForegroundBrush}" Text="{Binding ReplaceBaseSlot.RequirementLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceBaseSlot.Description}" TextWrapping="Wrap" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceBaseSlot.DisplayName}" TextWrapping="Wrap" />
                        <ItemsControl IsVisible="{Binding ReplaceBaseSlot.HasFirmwareFacts}" ItemsSource="{Binding ReplaceBaseSlot.FirmwareFacts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding ReplaceBaseSlot.HasFile}" Text="{Binding ReplaceBaseSlot.DisplayDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="action browseAction"
                          VerticalAlignment="Center"
                          Click="BrowseSlotButton_OnClick"
                          Content="Browse"
                          Tag="{Binding ReplaceBaseSlot.SlotId}" />
                    </Grid>
                  </Grid>
                </Border>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Validation" />
                    <Border MinHeight="92" Padding="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Validated execution uses compiled explicit mappings; TP ranges require approved Combiner CRC/header refresh." TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Explicit mappings" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="Each row maps one inclusive target range to one replacement BIN." TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="action"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddGeneralReplaceMappingCommand}"
                        Content="+ Add range" />
                  </Grid>
                  <Grid ColumnDefinitions="34,128,22,128,*,82,40" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="#" />
                    <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Start" />
                    <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="End" />
                    <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="Replacement BIN" />
                  </Grid>
                  <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding GeneralReplaceMappings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GeneralReplaceMappingViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="7"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8">
                          <Grid ColumnDefinitions="34,128,22,128,*,82,40" ColumnSpacing="8">
                            <Border Width="30" Height="30" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Index}" />
                            </Border>
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="1"
                                Text="{Binding StartAddress, Mode=TwoWay}"
                                PlaceholderText="start" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#64748B"
                                Text="-" />
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="3"
                                Text="{Binding EndAddress, Mode=TwoWay}"
                                PlaceholderText="end" />
                            <Border
                                Classes="fileDropZone"
                                Grid.Column="4"
                                MinHeight="32"
                                Padding="0"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragEnter="DropZone_OnDragEnter"
                                DragDrop.DragOver="SlotDragOver_OnDragOver"
                                DragDrop.DragLeave="DropZone_OnDragLeave"
                                DragDrop.Drop="GeneralMappingDrop_OnDrop"
                                Tag="{Binding MappingId}">
                              <Grid>
                                <Border Classes="dropZoneOverlay" />
                                <StackPanel Margin="10,0" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                  <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding HasFile}" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <Button
                                Grid.Column="5"
                                Classes="action browseAction"
                                Click="BrowseGeneralMappingButton_OnClick"
                                Content="Browse"
                                Tag="{Binding MappingId}"
                                ToolTip.Tip="Select replacement BIN" />
                            <Button
                                Grid.Column="6"
                                Classes="iconButton dangerIcon"
                                Click="RemoveGeneralMappingButton_OnClick"
                                ToolTip.Tip="Remove range">
                              <TextBlock FontSize="13" Text="X" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>

          <Border Grid.Column="1" Padding="18,16" Background="#FFFFFF" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="14">
              <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Output layout" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceMemorySummary}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                  <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#475569" Text="{Binding ReplaceMemoryRangeLabel}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <Border Padding="6" Background="#EEF4FA" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                <ItemsControl ItemsSource="{Binding ReplaceCoverageSegments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                      <Border
                          Width="{Binding BarWidth}"
                          Height="22"
                          Background="{Binding FillBrush}"
                          BorderBrush="{Binding OutlineBrush}"
                          BorderThickness="{Binding OutlineThickness}">
                        <ToolTip.Tip>
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                        </ToolTip.Tip>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <ItemsControl ItemsSource="{Binding ReplaceCoverageSegments}" IsVisible="{Binding IsReplaceCoverageFlat}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                    <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                      <ToolTip.Tip>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                      </ToolTip.Tip>
                      <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                        <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="{Binding OutlineThickness}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceCoverageGroups}" IsVisible="{Binding IsReplaceCoverageGrouped}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageGroupViewModel">
                    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                      <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding ChangeSummary}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding CountLabel}" />
                          </Border>
                        </Grid>
                      </Expander.Header>
                      <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                            <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                              <ToolTip.Tip>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                              </ToolTip.Tip>
                              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                                <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="{Binding OutlineThickness}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                                  <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                                  <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Plan" />
              <ItemsControl ItemsSource="{Binding ReplaceMemoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                    <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding Detail}">
                      <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding PrimaryLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.15*,430"
            ColumnSpacing="18"
            IsVisible="{Binding IsMergeVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding MergePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="170,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Spacing="3" ToolTip.Tip="AB Code and General Merge are reserved placeholders until their workflow is implemented.">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Mode" />
                  <ComboBox
                      MinHeight="32"
                      IsEnabled="False"
                      ItemsSource="{Binding MergeModeChoices}"
                      SelectedItem="{Binding SelectedMergeMode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <Button Classes="toolbarAction" Command="{Binding PreviewMergeCommand}" ToolTip.Tip="{Binding PreviewActionLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="▷" />
                      <TextBlock VerticalAlignment="Center" Text="Preview" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="toolbarAction"
                      Click="BuildMergeButton_OnClick"
                      IsEnabled="{Binding CanBuildStandardMerge}"
                      ToolTip.Tip="{Binding BuildActionLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="✓" />
                      <TextBlock VerticalAlignment="Center" Text="Build" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Input files" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StandardMergeSupportSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding MergeSlots}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding MergeReadinessStatus}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="14">
              <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Output layout" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                  <TextBlock
                      FontFamily="Cascadia Mono, Consolas"
                      FontSize="12"
                      Foreground="#475569"
                      Text="{Binding MergeMemoryRangeLabel}"
                      TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <Border Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <ItemsControl ItemsSource="{Binding MergeCoverageSegments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                      <Border
                          Width="{Binding BarWidth}"
                          Height="22"
                          Background="{Binding FillBrush}">
                        <ToolTip.Tip>
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                        </ToolTip.Tip>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <ItemsControl ItemsSource="{Binding MergeCoverageSegments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                    <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                      <ToolTip.Tip>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                      </ToolTip.Tip>
                      <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                        <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Plan" />
              <ItemsControl ItemsSource="{Binding MergeMemoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                    <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding Detail}">
                      <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border
        Grid.Row="1"
        Grid.RowSpan="4"
        MaxWidth="460"
        Margin="0,12,0,0"
        Padding="12,10"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#FFFFFF"
        BorderBrush="#BFDBFE"
        BorderThickness="1"
        CornerRadius="8"
        Opacity="{Binding ReportToastOpacity}"
        IsVisible="{Binding HasReportToast}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="#2563EB" Text="▤" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="Report" />
          <TextBlock FontSize="12" Foreground="#475569" Text="{Binding ReportToastText}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.RowSpan="5"
        Background="#660F172A"
        IsVisible="{Binding IsReplaceSelectionModalOpen}">
      <Border
          Width="720"
          MaxHeight="640"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Replace selection" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceSelectionSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="iconButton"
                Command="{Binding CloseReplaceSelectionCommand}"
                ToolTip.Tip="Close selection overview">
              <TextBlock Text="×" />
            </Button>
          </Grid>

          <Border Grid.Row="1" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Width="8" Height="38" VerticalAlignment="Top" Background="#2563EB" CornerRadius="999" />
              <StackPanel Grid.Column="1" Spacing="3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceSelectionCountLabel}" />
                  <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ReplaceSelectionStatusLabel}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceSelectionRunHint}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Selected replacements" />
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionRows}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportSelectionRowTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Padding="12" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasReplaceSelectionMissingRows}">
                <StackPanel Spacing="8">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="Required before Preview" />
                  <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionMissingRows}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportMissingRequiredRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Classes="secondary"
                Command="{Binding CloseReplaceSelectionCommand}"
                Content="Close" />
            <Button
                Classes="secondary"
                Command="{Binding PreviewReplaceCommand}"
                Content="Preview"
                ToolTip.Tip="{Binding ReplacePreviewUnavailableReason}" />
            <Button
                Classes="primary"
                Click="BuildReplaceButton_OnClick"
                Content="Build"
                IsEnabled="{Binding CanBuildReplace}"
                ToolTip.Tip="{Binding ReplaceBuildUnavailableReason}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="5"
        Background="#990F172A"
        IsVisible="{Binding IsReportModalOpen}">
      <Border
          Width="1060"
          MaxHeight="740"
          Padding="0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">
          <Border Padding="22,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="5">
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Title}" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LoadedReport.Subtitle}" TextWrapping="Wrap" />
              </StackPanel>
              <Button
                  Grid.Column="1"
                  Classes="iconButton"
                  Command="{Binding CloseReportCommand}"
                  ToolTip.Tip="Close report">
                <TextBlock Text="×" />
              </Button>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Margin="22,14,22,0" Spacing="8" IsVisible="{Binding HasReportHistory}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Report history" />
              <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding ReportHistorySummary}" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ReportHistoryEntries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="ReportHistoryEntryTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <Grid Grid.Row="2" Margin="22,18,22,0" ColumnDefinitions="1.05*,1.4*" ColumnSpacing="16">
            <Border Padding="16" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Grid Width="38" Height="38" AutomationProperties.Name="{Binding LoadedReport.OutcomeAccessibilityLabel}">
                  <Border Background="#16A34A" CornerRadius="999" IsVisible="{Binding LoadedReport.IsSuccessful}" />
                  <Border Background="#EA580C" CornerRadius="999" IsVisible="{Binding LoadedReport.HasPrimaryIssue}" />
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFF"
                      Text="{Binding LoadedReport.OutcomeIcon}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.OutcomeTitle}" TextWrapping="Wrap" />
                    <Border Padding="8,2" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.OutcomeMeta}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                  <TextBlock FontSize="12" Foreground="#475569" Text="{Binding LoadedReport.OutcomeDetail}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.NextStepTitle}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LoadedReport.NextStepDetail}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Evidence map" />
              <ItemsControl ItemsSource="{Binding LoadedReport.EvidenceRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="ReportEvidenceChipTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="3" Margin="22,18,22,0">
            <Grid ColumnDefinitions="0.95*,1.25*" ColumnSpacing="18">
              <StackPanel Spacing="14">
                <Border Padding="14" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                  <StackPanel Spacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Where to look first" />
                    <ItemsControl ItemsSource="{Binding LoadedReport.TriageRows}">
                      <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ReportTriageRowTemplate" />
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Expander IsExpanded="{Binding LoadedReport.ShouldExpandIssues, Mode=OneWay}" IsVisible="{Binding LoadedReport.HasIssues}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Issues" />
                      <Border Grid.Column="1" Padding="7,2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding LoadedReport.IssueCount}" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Issues}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportIssueRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <Expander IsExpanded="False" IsVisible="{Binding LoadedReport.HasInputs}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Inputs and hashes" />
                      <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.InputCount}" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Inputs}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportInputRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <Border Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                  <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Report file" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Status" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Status}" />
                    <TextBlock Grid.Row="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Output" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Artifact path" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="14">
                <Expander IsExpanded="{Binding LoadedReport.ShouldExpandCommandOperations, Mode=OneWay}" IsVisible="{Binding LoadedReport.HasCommandOperations}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="External processor commands" />
                      <Border Grid.Column="1" Padding="7,2" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding LoadedReport.CommandOperationCount}" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding LoadedReport.CommandOperations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportCommandOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <Expander IsExpanded="{Binding LoadedReport.ShouldExpandStepOperations, Mode=OneWay}" IsVisible="{Binding LoadedReport.HasStepOperations}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Operation steps" />
                      <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.StepOperationCount}" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding LoadedReport.StepOperations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportStepOperationTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <Expander IsExpanded="False" IsVisible="{Binding LoadedReport.HasMutations}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="Changed ranges" />
                      <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.MutationCount}" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding LoadedReport.Mutations}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportMutationRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="4" Margin="22,18,22,18" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Classes="secondary"
                Command="{Binding CloseReportCommand}"
                Content="Close" />
            <Button
                Classes="primary"
                Click="SaveReportButton_OnClick"
                Content="Save report" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.Row="4"
        Padding="28,9"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,1,0,0">
      <TextBlock
          FontSize="12"
          Foreground="#64748B"
          Text="{Binding FooterStatus}"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
