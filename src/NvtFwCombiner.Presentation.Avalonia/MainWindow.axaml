<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Background="#F5F7FA"
    Title="NVT FW Combiner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border
        Padding="28,20"
        Background="White"
        BorderBrush="#D6DAE1"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock
              FontSize="24"
              FontWeight="SemiBold"
              Text="NVT FW Combiner" />
          <TextBlock
              Foreground="#475569"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
          <Button
              IsEnabled="False"
              Content="{Binding PreviewActionLabel}" />
          <Button
              IsEnabled="False"
              Content="{Binding BuildActionLabel}" />
          <Button
              IsEnabled="False"
              Content="{Binding ReportModalActionLabel}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="28,12,28,0"
        Background="White"
        BorderBrush="#D6DAE1"
        BorderThickness="0,0,0,1">
      <ItemsControl ItemsSource="{Binding NavigationItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItemViewModel">
            <Button
                MinWidth="108"
                Margin="0,0,8,0"
                Padding="18,10"
                HorizontalContentAlignment="Center"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Content="{Binding Label}"
                Foreground="#111827" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="28" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock
              FontSize="26"
              FontWeight="SemiBold"
              Text="{Binding WorkspaceTitle}" />
          <TextBlock
              Foreground="#475569"
              Text="{Binding WorkspaceSummary}"
              TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <Border
              Margin="0,0,9,9"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding MergePreview.Title}" />
              <TextBlock Foreground="#475569" Text="{Binding MergePreview.Subtitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding MergePreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,0,0,10" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="#B45309" Text="{Binding MergePreview.Status}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              Grid.Column="1"
              Margin="9,0,0,9"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ReplacePreview.Title}" />
              <TextBlock Foreground="#475569" Text="{Binding ReplacePreview.Subtitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ReplacePreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,0,0,10" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="#B45309" Text="{Binding ReplacePreview.Status}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              Margin="0,9,9,0"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SavedRulesAndReports.Title}" />
              <TextBlock Foreground="#475569" Text="{Binding SavedRulesAndReports.Subtitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SavedRulesAndReports.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,0,0,10" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="#B45309" Text="{Binding SavedRulesAndReports.Status}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              Grid.Column="1"
              Margin="9,9,0,0"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ReportModalPreview.Title}" />
              <TextBlock Foreground="#475569" Text="{Binding ReportModalPreview.Subtitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ReportModalPreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,0,0,10" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="#B45309" Text="{Binding ReportModalPreview.Status}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border
        Grid.Row="3"
        Padding="28,10"
        Background="#F8FAFC"
        BorderBrush="#D6DAE1"
        BorderThickness="0,1,0,0">
      <TextBlock
          Foreground="#475569"
          Text="{Binding FooterStatus}"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
