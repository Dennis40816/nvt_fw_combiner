<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Title="NVT FW Combiner">
  <StackPanel Margin="32" Spacing="16">
    <TextBlock FontSize="30" FontWeight="SemiBold" Text="NVT FW Combiner" />
    <TextBlock Text="0.1.1 UI planning shell" />
    <TextBlock Text="Merge: Standard • AB • General" />
    <TextBlock Text="Replace: Display • TP HW • TP FW • General" />
    <TextBlock Text="Saved Rules • Reports • Settings • Diagnostics" />
    <TextBlock TextWrapping="Wrap" Text="Demo only: no firmware files are read, no external combiner is executed, and no byte mutation logic lives in UI." />
    <TextBlock TextWrapping="Wrap" Text="Build is disabled conceptually until the 0.2.0 composition core returns a valid preview." />
  </StackPanel>
</Window>
