<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Background="#F4F6FA"
    FontFamily="fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI"
    Title="NVT FW Combiner">
  <Window.Styles>
    <Style Selector="ToggleButton.nav">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.nav:checked">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF3FF" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.command:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.command:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.segmentDisabled">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.segmentDisabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border
        Padding="28,12"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="2">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="NVT FW Combiner" />
          <TextBlock
              FontSize="12"
              Foreground="#64748B"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="Home" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <Button
              Classes="action"
              Click="LoadReportJsonButton_OnClick"
              Content="Load report JSON" />
          <Border
              Padding="10,5"
              VerticalAlignment="Center"
              Background="#F8FAFC"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="999">
            <TextBlock
                FontSize="12"
                Foreground="#64748B"
                Text="Report review only" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="28,8"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
          <Button
              Classes="action"
              Command="{Binding GoBackCommand}"
              Content="Back" />
          <Border
              Width="1"
              Height="30"
              VerticalAlignment="Center"
              Background="#E2E8F0" />
          <ItemsControl ItemsSource="{Binding NavigationTrail}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShellNavigationEntryViewModel">
                <Button Classes="command" Command="{Binding NavigateCommand}">
                  <Border Padding="10,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="999">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" Text=">" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid
            Grid.Column="1"
            ColumnDefinitions="Auto,1,Auto,Auto,Auto"
            ColumnSpacing="14"
            IsVisible="{Binding IsDeviceContextVisible}">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="{Binding DeviceContextTitle}" />
            <TextBlock
                FontSize="11"
                Foreground="#64748B"
                Text="Workflow context" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Width="1"
              Height="34"
              VerticalAlignment="Center"
              Background="#E2E8F0" />

          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#64748B"
                Text="{Binding IcLabel}" />
            <ComboBox
                Width="154"
                MinHeight="30"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                ItemsSource="{Binding IcChoices}"
                SelectedItem="{Binding SelectedIc, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="3">
            <TextBlock
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#64748B"
                Text="{Binding NumberLabel}" />
            <ComboBox
                Width="132"
                MinHeight="30"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                FontSize="13"
                ItemsSource="{Binding NumberChoices}"
                SelectedItem="{Binding SelectedNumber, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel
              Grid.Column="4"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <Border
                Width="8"
                Height="8"
                Background="#16A34A"
                CornerRadius="999" />
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#334155"
                Text="{Binding DeviceContextStatus}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2">
      <Grid Margin="28,24,28,28" RowDefinitions="Auto,*" RowSpacing="18">
        <Border
            Padding="18"
            Background="#FFFFFF"
            BorderBrush="#D6E0EC"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding HasLoadedReport}">
          <Grid ColumnDefinitions="1.05*,1.25*,1.25*" ColumnSpacing="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="LOADED REPORT" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding LoadedReport.Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="#64748B"
                    Text="{Binding LoadedReport.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="File" />
                <TextBlock Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Status" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Status}" />
                <TextBlock Grid.Row="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Output" />
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Inputs" />
                <ItemsControl ItemsSource="{Binding LoadedReport.Inputs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportLineViewModel">
                      <Border Padding="0,0,0,7" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Operations" />
              <ItemsControl ItemsSource="{Binding LoadedReport.Operations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReportLineViewModel">
                    <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                      <StackPanel Spacing="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="14">
              <StackPanel Spacing="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Issues" />
                <ItemsControl ItemsSource="{Binding LoadedReport.Issues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportLineViewModel">
                      <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Margin="0,0,0,7">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="Mutations" />
                <ItemsControl ItemsSource="{Binding LoadedReport.Mutations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportLineViewModel">
                      <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="16"
            IsVisible="{Binding IsHomeVisible}"
            VerticalAlignment="Top">
          <Border
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="CONFIGURE" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding SettingsPreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding SettingsPreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl Grid.Row="1" Margin="0,18,0,0" ItemsSource="{Binding SettingsPreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Foreground="#334155"
                        Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button
                  Grid.Row="2"
                  Classes="primary"
                  HorizontalAlignment="Left"
                  Command="{Binding ShowSettingsCommand}">
                <TextBlock Foreground="#FFFFFF" Text="Open settings" />
              </Button>
            </Grid>
          </Border>

          <Border
              Grid.Column="1"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding ReplacePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowDpReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    Command="{Binding ShowCtrlRamReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="2"
                    Classes="command"
                    Command="{Binding ShowGeneralReplaceCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="General Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <Border
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  Background="#FFF7ED"
                  BorderBrush="#FED7AA"
                  BorderThickness="1"
                  CornerRadius="999">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#B45309"
                    Text="{Binding HomeReplaceStatus}"
                    TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Border>

          <Border
              Grid.Column="2"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding MergePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding MergePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowNormalMergeCommand}">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Normal Merge" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="Open" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    IsEnabled="False">
                  <Border Padding="12,9" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#94A3B8" Text="AB Code" />
                      <Border Grid.Column="1" Padding="10,4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Text="Pending" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <Border
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  Background="#EFF6FF"
                  BorderBrush="#BFDBFE"
                  BorderThickness="1"
                  CornerRadius="999">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1D4ED8"
                    Text="{Binding HomeMergeStatus}"
                    TextTrimming="CharacterEllipsis" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="#0F172A"
                  Text="{Binding SettingsPreview.Title}" />
              <TextBlock
                  FontSize="13"
                  Foreground="#64748B"
                  Text="{Binding SettingsPreview.Subtitle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Catalog" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Profile and flash-map status from application catalogs." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsProfileRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            <TextBlock Grid.Row="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" MaxWidth="170" FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Tools" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Approved external tool binding and postbuild catalog." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsToolRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Diagnostics" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Report review and non-execution diagnostics access." TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsDiagnosticsRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Preferences" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="Local shell preferences; persistence is a later adapter." TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Theme" />
                      <ComboBox MinHeight="32" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Strictness" />
                      <ComboBox MinHeight="32" ItemsSource="{Binding StrictnessChoices}" SelectedItem="{Binding SelectedStrictness, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="4">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Language" />
                      <ComboBox MinHeight="32" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Settings readiness" />
              <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding SettingsPreview.Status}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SettingsReadinessRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                        </Grid>
                        <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsReplaceVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Classes="action" Content="{Binding PreviewActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding BuildActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding ReportModalActionLabel}" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Memory map" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceMemorySummary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#64748B" Text="{Binding ReplaceMemoryRangeLabel}" />
                </Grid>
                <Grid ColumnDefinitions="130,*,92,*,1.25*" ColumnSpacing="12">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="RANGE" />
                  <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="BEFORE" />
                  <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="ACTION" />
                  <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="AFTER" />
                  <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="NOTE" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ReplaceMemoryRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                      <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="130,*,92,*,1.25*" ColumnSpacing="12">
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" FontSize="13" Foreground="#334155" Text="{Binding BeforeSource}" TextWrapping="Wrap" />
                          <Border Grid.Column="2" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ActionLabel}" />
                          </Border>
                          <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding AfterSource}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="4" FontSize="12" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Input files" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="Drop BIN files into the active Replace slots." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ReplaceSlots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FirmwareSlotViewModel">
                      <Border
                          Margin="0,0,0,10"
                          Padding="14"
                          Background="#F8FAFC"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          CornerRadius="10"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="SlotDragOver_OnDragOver"
                          DragDrop.Drop="SlotDrop_OnDrop"
                          Tag="{Binding SlotId}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <Border Padding="8,2" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding RequirementLabel}" />
                              </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              Classes="action"
                              Click="BrowseSlotButton_OnClick"
                              Content="Browse"
                              Tag="{Binding SlotId}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsCtrlRamReplaceModeSelected}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM regions" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding CtrlRamRegionSummary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding SelectedIc}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CtrlRamRegions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CtrlRamRegionViewModel">
                      <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Name}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#475569" Text="{Binding StartAddress}" />
                          <TextBlock Grid.Column="2" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding SizeHex}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Replace readiness" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Replace mode" />
                <ComboBox
                    MinHeight="34"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    ItemsSource="{Binding ReplaceModeChoices}"
                    SelectedItem="{Binding SelectedReplaceMode, Mode=TwoWay}" />
                <TextBlock FontSize="13" Foreground="#334155" Text="{Binding SelectedReplaceModeDescription}" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ActiveReplaceRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                      <TextBlock FontSize="13" Foreground="#334155" Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsMergeVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding MergePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Classes="action" Command="{Binding PreviewMergeCommand}" Content="{Binding PreviewActionLabel}" />
                <Button Classes="action" Command="{Binding BuildMergeCommand}" Content="{Binding BuildActionLabel}" />
                <Button Classes="action" Content="{Binding ReportModalActionLabel}" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Memory map" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#64748B" Text="{Binding MergeMemoryRangeLabel}" />
                </Grid>
                <Grid ColumnDefinitions="130,*,92,*,1.25*" ColumnSpacing="12">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="RANGE" />
                  <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="BEFORE" />
                  <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="ACTION" />
                  <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="AFTER" />
                  <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="NOTE" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MergeMemoryRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                      <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="130,*,92,*,1.25*" ColumnSpacing="12">
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" FontSize="13" Foreground="#334155" Text="{Binding BeforeSource}" TextWrapping="Wrap" />
                          <Border Grid.Column="2" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ActionLabel}" />
                          </Border>
                          <TextBlock Grid.Column="3" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding AfterSource}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="4" FontSize="12" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Input files" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StandardMergeSupportSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding MergeSlots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FirmwareSlotViewModel">
                      <Border
                          Margin="0,0,0,10"
                          Padding="14"
                          Background="#F8FAFC"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          CornerRadius="10"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="SlotDragOver_OnDragOver"
                          DragDrop.Drop="SlotDrop_OnDrop"
                          Tag="{Binding SlotId}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <Border Padding="8,2" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding RequirementLabel}" />
                              </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              Classes="action"
                              Click="BrowseSlotButton_OnClick"
                              Content="Browse"
                              Tag="{Binding SlotId}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Merge readiness" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Merge mode" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Border Padding="12,9" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding SelectedMergeMode}" />
                  </Border>
                  <Border Grid.Column="1" Padding="12,9" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="999">
                    <TextBlock FontWeight="SemiBold" Foreground="#94A3B8" Text="AB disabled" />
                  </Border>
                </Grid>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ActiveMergeRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                      <TextBlock FontSize="13" Foreground="#334155" Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding MergeReadinessStatus}" TextWrapping="Wrap" />
              </Border>
              <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LastRunResult.Title}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Foreground="#475569" Text="{Binding LastRunResult.Detail}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding LastRunResult.Output}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border
        Grid.Row="3"
        Padding="28,9"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,1,0,0">
      <TextBlock
          FontSize="12"
          Foreground="#64748B"
          Text="{Binding FooterStatus}"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
