<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Background="#F4F6FA"
    FontFamily="fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI"
    Title="NVT FW Combiner">
  <Window.Styles>
    <Style Selector="ToggleButton.nav">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.nav:checked">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
      <Setter Property="Foreground" Value="#1D4ED8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#93C5FD" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Width" Value="212" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.command:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.command:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.segmentDisabled">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.segmentDisabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border
        Padding="28,12"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="2">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="NVT FW Combiner" />
          <TextBlock
              FontSize="12"
              Foreground="#64748B"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="Home" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <Border
            Grid.Column="2"
            Padding="10,5"
            VerticalAlignment="Center"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="999">
          <TextBlock
              FontSize="12"
              Foreground="#64748B"
              Text="Demo data only" />
        </Border>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="28,8"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,1,Auto,Auto,Auto,*,Auto" ColumnSpacing="14">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="{Binding DeviceContextTitle}" />
          <TextBlock
              FontSize="11"
              Foreground="#64748B"
              Text="Run context" />
        </StackPanel>

        <Border
            Grid.Column="1"
            Width="1"
            Height="34"
            VerticalAlignment="Center"
            Background="#E2E8F0" />

        <StackPanel Grid.Column="2" Spacing="3">
          <TextBlock
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              Text="{Binding IcLabel}" />
          <TextBox
              Width="142"
              MinHeight="30"
              Background="#F8FAFC"
              BorderBrush="#CBD5E1"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="13"
              Text="{Binding SelectedIcLabel, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Spacing="3">
          <TextBlock
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              Text="{Binding IcNumberLabel}" />
          <TextBox
              Width="142"
              MinHeight="30"
              Background="#F8FAFC"
              BorderBrush="#CBD5E1"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="13"
              Text="{Binding IcNumberText, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Spacing="3">
          <TextBlock
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              Text="{Binding IcNumberModeLabel}" />
          <ComboBox
              Width="112"
              MinHeight="30"
              Background="#F8FAFC"
              BorderBrush="#CBD5E1"
              FontSize="13"
              ItemsSource="{Binding IcNumberModes}"
              SelectedItem="{Binding SelectedIcNumberMode, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel
            Grid.Column="6"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <Border
              Width="8"
              Height="8"
              Background="#16A34A"
              CornerRadius="999" />
          <TextBlock
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="#334155"
              Text="{Binding DeviceContextStatus}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2">
      <Grid Margin="28,24,28,28">
        <Grid
            ColumnDefinitions="*,*,*"
            ColumnSpacing="16"
            IsVisible="{Binding IsHomeVisible}"
            VerticalAlignment="Top">
          <Border
              Height="284"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="CONFIGURE" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding SettingsPreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding SettingsPreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl Grid.Row="1" Margin="0,18,0,0" ItemsSource="{Binding SettingsPreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Foreground="#334155"
                        Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button
                  Grid.Row="2"
                  Classes="secondary"
                  HorizontalAlignment="Left"
                  Command="{Binding ShowSettingsCommand}"
                  Content="Open settings" />
            </Grid>
          </Border>

          <Border
              Grid.Column="1"
              Height="284"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding ReplacePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowDpReplaceCommand}">
                  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP Replace" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="Open" />
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    Command="{Binding ShowCtrlRamReplaceCommand}">
                  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM Replace" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="Open" />
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="2"
                    Classes="command"
                    Command="{Binding ShowGeneralReplaceCommand}">
                  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="General Replace" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="Open" />
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <TextBlock
                  Grid.Row="2"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#B45309"
                  Text="{Binding ReplacePreview.Status}" />
            </Grid>
          </Border>

          <Border
              Grid.Column="2"
              Height="284"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="WORKFLOW" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding MergePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding MergePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowNormalMergeCommand}">
                  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Normal Merge" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#64748B" Text="Open" />
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    IsEnabled="False">
                  <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#94A3B8" Text="AB Code" />
                      <TextBlock Grid.Column="1" FontSize="12" Foreground="#94A3B8" Text="Pending" />
                    </Grid>
                  </Border>
                </Button>
              </Grid>
              <TextBlock
                  Grid.Row="2"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#B45309"
                  Text="{Binding MergePreview.Status}" />
            </Grid>
          </Border>
        </Grid>

        <Grid
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="#0F172A"
                  Text="{Binding SettingsPreview.Title}" />
              <TextBlock
                  FontSize="13"
                  Foreground="#64748B"
                  Text="{Binding SettingsPreview.Subtitle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Profiles" />
                  <TextBlock FontSize="13" Foreground="#64748B" Text="Demo catalog only" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Tools" />
                  <TextBlock FontSize="13" Foreground="#64748B" Text="combiner.exe pending" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Diagnostics" />
                  <TextBlock FontSize="13" Foreground="#64748B" Text="Export planned" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Language" />
                  <TextBlock FontSize="13" Foreground="#64748B" Text="English default" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Readiness" />
              <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding SettingsPreview.Status}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsReplaceVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Classes="action" Content="{Binding PreviewActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding BuildActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding ReportModalActionLabel}" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Memory coverage" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="Replace before / after" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#64748B" Text="0x0000 - 0xFFFF" />
                </Grid>
                <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="Before" />
                  <Grid Grid.Column="1" ColumnDefinitions="1.25*,0.55*,0.9*,0.55*">
                    <Border Grid.Column="0" Height="14" Background="#2563EB" CornerRadius="5,0,0,5" />
                    <Border Grid.Column="1" Height="14" Background="#059669" />
                    <Border Grid.Column="2" Height="14" Background="#D97706" />
                    <Border Grid.Column="3" Height="14" Background="#CBD5E1" CornerRadius="0,5,5,0" />
                  </Grid>
                  <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="After" />
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="1.25*,0.55*,0.9*,0.55*">
                    <Border Grid.Column="0" Height="14" Background="#1D4ED8" CornerRadius="5,0,0,5" />
                    <Border Grid.Column="1" Height="14" Background="#047857" />
                    <Border Grid.Column="2" Height="14" Background="#B45309" />
                    <Border Grid.Column="3" Height="14" Background="#CBD5E1" CornerRadius="0,5,5,0" />
                  </Grid>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#2563EB" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="DP" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#059669" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="CtrlRAM" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#D97706" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="Overlay" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Replace mode" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding SelectedReplaceMode}" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <ToggleButton Classes="segment" Command="{Binding ShowDpReplaceCommand}" IsChecked="{Binding IsDpReplaceModeSelected, Mode=OneWay}">
                    <TextBlock Foreground="#334155" Text="DP" />
                  </ToggleButton>
                  <ToggleButton Grid.Column="1" Classes="segment" Command="{Binding ShowCtrlRamReplaceCommand}" IsChecked="{Binding IsCtrlRamReplaceModeSelected, Mode=OneWay}">
                    <TextBlock Foreground="#334155" Text="CtrlRAM" />
                  </ToggleButton>
                  <ToggleButton Grid.Column="2" Classes="segment" Command="{Binding ShowGeneralReplaceCommand}" IsChecked="{Binding IsGeneralReplaceModeSelected, Mode=OneWay}">
                    <TextBlock Foreground="#334155" Text="General" />
                  </ToggleButton>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="replacement bin" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="LD" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="separate bin" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="crc pending" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Replace readiness" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ReplacePreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                      <TextBlock FontSize="13" Foreground="#334155" Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#B45309" Text="{Binding ReplacePreview.Status}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsMergeVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding MergePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Classes="action" Content="{Binding PreviewActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding BuildActionLabel}" IsEnabled="False" />
                <Button Classes="action" Content="{Binding ReportModalActionLabel}" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Memory coverage" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="Normal merge before / after" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#64748B" Text="0x0000 - 0xFFFF" />
                </Grid>
                <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="Before" />
                  <Grid Grid.Column="1" ColumnDefinitions="1.25*,1.1*,0.55*,0.55*">
                    <Border Grid.Column="0" Height="14" Background="#2563EB" CornerRadius="5,0,0,5" />
                    <Border Grid.Column="1" Height="14" Background="#7C3AED" />
                    <Border Grid.Column="2" Height="14" Background="#059669" />
                    <Border Grid.Column="3" Height="14" Background="#CBD5E1" CornerRadius="0,5,5,0" />
                  </Grid>
                  <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Text="After" />
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="1.25*,1.1*,0.55*,0.55*">
                    <Border Grid.Column="0" Height="14" Background="#1D4ED8" CornerRadius="5,0,0,5" />
                    <Border Grid.Column="1" Height="14" Background="#6D28D9" />
                    <Border Grid.Column="2" Height="14" Background="#047857" />
                    <Border Grid.Column="3" Height="14" Background="#CBD5E1" CornerRadius="0,5,5,0" />
                  </Grid>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#2563EB" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="DP" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#7C3AED" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="TP" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Width="8" Height="8" Background="#059669" CornerRadius="999" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="LD" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Merge mode" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding SelectedMergeMode}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <ToggleButton Classes="segment" Command="{Binding ShowNormalMergeCommand}" IsChecked="{Binding IsNormalMergeModeSelected, Mode=OneWay}">
                    <TextBlock Foreground="#334155" Text="Normal" />
                  </ToggleButton>
                  <Button Grid.Column="1" Classes="segmentDisabled" Content="AB Code" IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="demo.bin" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="TP" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="demo.bin" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="LD" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="optional" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="INSPECTOR" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="Merge readiness" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding MergePreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                      <TextBlock FontSize="13" Foreground="#334155" Text="{Binding}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#B45309" Text="{Binding MergePreview.Status}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border
        Grid.Row="3"
        Padding="28,9"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,1,0,0">
      <TextBlock
          FontSize="12"
          Foreground="#64748B"
          Text="{Binding FooterStatus}"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
