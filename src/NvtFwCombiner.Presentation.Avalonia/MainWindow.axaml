<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:Name="RootWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    WindowState="Maximized"
    MinWidth="980"
    MinHeight="640"
    Background="#F4F6FA"
    FontFamily="fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI"
    Title="NVT FW Combiner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ShowReportHistoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding ClearReportHistoryCommand}" />
  </Window.KeyBindings>
  <Window.Resources>
    <ControlTheme x:Key="StretchContentPresenterTheme" TargetType="ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </ControlTheme>
    <DataTemplate x:Key="MemoryCoverageTooltipTemplate" DataType="vm:MemoryCoverageSegmentViewModel">
      <Border
          MaxWidth="360"
          Padding="10"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border
                Width="10"
                Height="10"
                VerticalAlignment="Center"
                Background="{Binding FillBrush}"
                BorderBrush="{Binding OutlineBrush}"
                BorderThickness="{Binding OutlineThickness}"
                CornerRadius="2" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="{Binding SourceLabel}"
                TextWrapping="Wrap" />
            <Border
                Grid.Column="2"
                Padding="7,2"
                VerticalAlignment="Center"
                Background="{Binding ChangeBadgeBackgroundBrush}"
                BorderBrush="{Binding ChangeBadgeBorderBrush}"
                BorderThickness="1"
                CornerRadius="999">
              <TextBlock
                  FontSize="10"
                  FontWeight="SemiBold"
                  Foreground="{Binding ChangeBadgeForegroundBrush}"
                  Text="{Binding ChangeLabel}" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.RangeLabel}" />
            <TextBlock
                Grid.Column="1"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="#0F172A"
                Text="{Binding RangeLabel}"
                TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.ResultLabel}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                FontSize="11"
                Foreground="#334155"
                Text="{Binding CompactDetail}"
                TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.DetailLabel}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                MaxWidth="280"
                FontSize="11"
                Foreground="#64748B"
                Text="{Binding Detail}"
                TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FirmwareSlotFactTemplate" DataType="vm:FirmwareSlotFactViewModel">
      <Border
          Margin="0,2,6,0"
          Padding="7,2"
          Background="{Binding BackgroundBrush}"
          BorderBrush="{Binding BorderBrush}"
          BorderThickness="1"
          CornerRadius="999">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding LabelForegroundBrush}" Text="{Binding Label}" />
          <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="{Binding ValueForegroundBrush}" Text="{Binding Value}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FirmwareSlotCardTemplate" DataType="vm:FirmwareSlotViewModel">
      <Border
          Classes="fileDropZone"
          HorizontalAlignment="Stretch"
          Margin="0,0,0,10"
          Padding="0"
          Background="{Binding SlotBackgroundBrush}"
          BorderBrush="{Binding SlotBorderBrush}"
          BorderThickness="{Binding SlotBorderThickness}"
          CornerRadius="8"
          DragDrop.AllowDrop="True"
          DragDrop.DragEnter="DropZone_OnDragEnter"
          DragDrop.DragOver="SlotDragOver_OnDragOver"
          DragDrop.DragLeave="DropZone_OnDragLeave"
          DragDrop.Drop="SlotDrop_OnDrop"
          Tag="{Binding SlotId}">
        <Grid>
          <Border Classes="dropZoneOverlay" />
          <Grid Margin="14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border
                    Classes="slotTypeIcon"
                    Background="{Binding SlotIconBackgroundBrush}"
                    BorderBrush="{Binding SlotIconBorderBrush}"
                    ToolTip.Tip="{Binding SlotIconTooltip}">
                  <Path
                      Data="{Binding SlotIconPathData}"
                      Stroke="{Binding SlotIconForegroundBrush}" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding RequirementBadgeBackgroundBrush}" BorderBrush="{Binding RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding RequirementBadgeForegroundBrush}" Text="{Binding RequirementLabel}" />
                </Border>
              </StackPanel>
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
              <ItemsControl IsVisible="{Binding HasFirmwareFacts}" ItemsSource="{Binding FirmwareFacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding HasFile}" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="action browseAction"
                Click="BrowseSlotButton_OnClick"
                Content="{Binding #RootWindow.DataContext.Text.BrowseLabel}"
                Tag="{Binding SlotId}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportSelectionRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportMissingRequiredRowTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="180,*" ColumnSpacing="12" Margin="0,0,0,8">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#7C2D12" Text="{Binding Title}" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportEvidenceChipTemplate" DataType="vm:ReportLineViewModel">
      <Border
          Width="128"
          MinHeight="76"
          Padding="11,8"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel Spacing="2">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Title}" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportDifferenceSummaryRowTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
      <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,54,76" ColumnSpacing="10">
          <StackPanel Spacing="2">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Label}" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock
              Grid.Column="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              FontSize="16"
              FontFamily="Cascadia Mono, Consolas"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="{Binding Count}" />
          <Border Grid.Column="2" Padding="7,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
            <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportDifferenceSummaryChipTemplate" DataType="vm:ReportDifferenceSummaryRowViewModel">
      <Border Width="154" Margin="0,0,8,8" Padding="9,7" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Label}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" FontSize="15" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Count}" />
          <TextBlock Grid.Row="1" FontSize="10" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
          <Border Grid.Row="1" Grid.Column="1" Padding="6,1" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportTriageRowTemplate" DataType="vm:ReportLineViewModel">
      <Grid ColumnDefinitions="26,*" ColumnSpacing="10" Margin="0,0,0,10">
        <Grid>
          <Border Width="2" HorizontalAlignment="Center" Background="#DBEAFE" />
          <Border
              Width="18"
              Height="18"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="#EFF6FF"
              BorderBrush="#93C5FD"
              BorderThickness="1"
              CornerRadius="999" />
        </Grid>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportIssueRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="10,8" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" Foreground="#7C2D12" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#B45309" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportInputRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportLineBadgeTemplate" DataType="vm:ReportLineBadgeViewModel">
      <Border Margin="0,0,6,6" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Text}" TextWrapping="Wrap" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportLineFactTemplate" DataType="vm:ReportLineFactViewModel">
      <Grid Margin="0,1" ColumnDefinitions="88,*" ColumnSpacing="8">
        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" FontSize="11" Foreground="#475569" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsPlainText}" />
        <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding IsTechnical}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ReportRangeTableRowTemplate" DataType="vm:ReportRangeTableRowViewModel">
      <Border Padding="0,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="112,128,*,150" ColumnSpacing="10">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Kind}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding AddressSpace}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="2" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding Range}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="3" FontSize="11" Foreground="#64748B" Text="{Binding Source}" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportRangeTableTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="9,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="5">
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.RangeTableTitle}" />
          <Grid ColumnDefinitions="112,128,*,150" ColumnSpacing="10">
            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.KindLabel}" />
            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.AddressSpaceLabel}" />
            <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.RangeLabel}" />
            <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.SourceLabel}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding RangeRows}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportRangeTableRowTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportCommandOperationTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="10,9" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="150,150,*,*,150,90" ColumnSpacing="10">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OperationKind}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding OperationSource}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding OperationTarget}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="4" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OperationProcessor}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding OperationStatus}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
          <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineBadgeTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ContentControl
              Content="{Binding}"
              ContentTemplate="{StaticResource ReportRangeTableTemplate}"
              IsVisible="{Binding HasRangeRows}" />
          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding #RootWindow.DataContext.Text.CommandArgvLabel}" IsVisible="{Binding HasCodeBlock}" />
          <Border Padding="8,6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding HasCodeBlock}">
            <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding CodeBlock}" TextWrapping="Wrap" />
          </Border>
          <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineFactTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportStepOperationTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="10,9" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="150,150,*,*,150,90" ColumnSpacing="10">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OperationKind}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding OperationSource}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="3" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding OperationTarget}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="4" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OperationProcessor}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding OperationStatus}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" IsVisible="{Binding HasMeta}" />
          <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineBadgeTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ContentControl
              Content="{Binding}"
              ContentTemplate="{StaticResource ReportRangeTableTemplate}"
              IsVisible="{Binding HasRangeRows}" />
          <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineFactTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportOutputDifferenceRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="10,9" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="130,210,*" ColumnSpacing="10">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#0F172A" Text="{Binding Detail}" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineBadgeTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="ReportLineFactTemplate" />
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportMutationRowTemplate" DataType="vm:ReportLineViewModel">
      <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
        <StackPanel Spacing="2">
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Meta}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ReportHistoryEntryTemplate" DataType="vm:ReportHistoryEntryViewModel">
      <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button
            HorizontalAlignment="Stretch"
            Padding="0"
            Background="Transparent"
            BorderBrush="Transparent"
            Command="{Binding $parent[Window].DataContext.OpenReportHistoryEntryCommand}"
            CommandParameter="{Binding}">
          <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding SequenceLabel}" />
                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding IssueSummary}" TextWrapping="Wrap" />
              </Grid>
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" TextWrapping="Wrap" />
              <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Context}" TextWrapping="Wrap" />
              <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding OutputHash}" TextWrapping="Wrap" />
              <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CommandSummary}" TextWrapping="Wrap" />
              <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding EvidenceSummary}" TextWrapping="Wrap" />
              <TextBlock FontSize="11" Foreground="#475569" Text="{Binding ArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding HasArtifactPath}" />
            </StackPanel>
          </Border>
        </Button>
        <Button
            Grid.Column="1"
            Classes="iconButton dangerIcon"
            VerticalAlignment="Top"
            Command="{Binding $parent[Window].DataContext.RemoveReportHistoryEntryCommand}"
            CommandParameter="{Binding}"
            ToolTip.Tip="{Binding #RootWindow.DataContext.Text.DeleteReportTooltip}">
          <TextBlock FontSize="13" Text="X" />
        </Button>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
