<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:converters="using:NvtFwCombiner.Presentation.Avalonia"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:Name="RootWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    WindowState="Maximized"
    MinWidth="980"
    MinHeight="640"
    Background="{DynamicResource NfcAppBackgroundBrush}"
    FontFamily="{DynamicResource NfcUiFontFamily}"
    Icon="/Assets/AppIcon.ico"
    Title="NVT FW Combiner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowSharedTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowPageTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowWorkflowTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowShellPanels.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowButtonStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowVisualStyles.axaml" />
  </Window.Styles>

  <Grid>
    <Grid x:Name="ShellInteractionHost" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <Grid.KeyBindings>
        <KeyBinding Gesture="Ctrl+H" Command="{Binding Reports.ShowReportHistoryCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding Reports.ClearReportHistoryCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding RequestHexEditorSaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding RequestHexEditorUndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RequestHexEditorRedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RequestHexEditorRedoCommand}" />
      </Grid.KeyBindings>
    <Border Classes="shellBar" Padding="28,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="{DynamicResource NfcSpace2}">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="{DynamicResource NfcTextStrongBrush}"
              Text="{Binding Text.ProductTitle}" />
          <TextBlock
              FontSize="{DynamicResource NfcFontSize12}"
              Foreground="{DynamicResource NfcTextMutedBrush}"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace4}">
          <ToggleButton
              x:Name="HomeNavigationButton"
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Text.HomeLabel}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Replace.ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Merge.MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="semanticAction secondary"
              Click="LoadReportJsonButton_OnClick"
              ToolTip.Tip="{Binding Text.LoadJsonTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize14}" Text="↥" />
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.LoadJsonLabel}" />
            </StackPanel>
          </Button>
          <Button
              Classes="semanticAction iconButton"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{Binding MessageCenter.MessageCenterAccessibleName}"
              Command="{Binding MessageCenter.OpenCommand}"
              ToolTip.Tip="{Binding Text.MessageCenterTooltip}">
            <Grid Width="28" Height="24">
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="17"
                  Text="▤" />
              <Border
                  MinWidth="16"
                  Height="16"
                  Padding="3,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="{DynamicResource NfcDangerTextBrush}"
                  CornerRadius="{DynamicResource NfcPillCornerRadius}"
                  IsVisible="{Binding MessageCenter.HasActiveDiagnostics}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Foreground="White"
                    Text="{Binding MessageCenter.ActiveBadgeCount}" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource NavigationTrailPanelTemplate}" />

    <ContentControl
        x:Name="DeviceContextHost"
        Grid.Row="2"
        ContentTemplate="{StaticResource DeviceContextPanelTemplate}"
        IsVisible="{Binding IsDeviceContextVisible}" />

    <ScrollViewer Grid.Row="3">
      <Grid Margin="28,24,28,132" RowDefinitions="*" RowSpacing="0">
        <ContentControl
            x:Name="HomePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsHomeVisible}"
            ContentTemplate="{StaticResource HomePageTemplate}" />

        <ContentControl
            x:Name="SettingsPageHost"
            Grid.Row="0"
            IsVisible="{Binding IsSettingsVisible}"
            ContentTemplate="{StaticResource SettingsPageTemplate}" />

        <ContentControl
            x:Name="HexEditorPageHost"
            Grid.Row="0"
            IsVisible="{Binding IsHexEditorVisible}"
            ContentTemplate="{StaticResource HexEditorPageTemplate}" />

        <ContentControl
            x:Name="ReplacePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsReplaceVisible}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:ReplacePresentationViewModel">
              <Grid ColumnDefinitions="1.15*,430" ColumnSpacing="18">
          <StackPanel Spacing="{DynamicResource NfcSpace16}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" Text="{Binding ReplacePreview.Title}" />
                <TextBlock Classes="pageSubtitle" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <Grid
                  Grid.Column="1"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="{DynamicResource NfcSpace12}"
                  VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ModeLabel}" />
                  <Grid ColumnDefinitions="158,Auto" ColumnSpacing="6">
                    <ComboBox
                        MinHeight="32"
                        ItemsSource="{Binding ReplaceModeChoices}"
                        SelectedItem="{Binding SelectedReplaceMode, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={x:Static converters:WorkflowModeDisplayConverters.DisplayName}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge success"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeGoldenVerified}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge review"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeEvidenceGated}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge info"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeUnavailable}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.TargetsLabel}" />
                  <Button
                      Classes="summaryChip"
                      Command="{Binding ShowReplaceSelectionCommand}"
                      ToolTip.Tip="{Binding Text.ReviewReplacementInputsTooltip}">
                    <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                      <TextBlock VerticalAlignment="Center" Classes="bodyEmphasisText" Text="{Binding ReplaceSelectionCountLabel}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="captionText" Text="▾" />
                    </Grid>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource ReplaceModeContentTemplate}" />
          </StackPanel>

          <ContentControl
              Grid.Column="1"
              Content="{Binding}"
              ContentTemplate="{StaticResource ReplaceOutputLayoutPanelTemplate}" />
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl
            x:Name="MergePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsMergeVisible}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:MergePresentationViewModel">
              <Grid ColumnDefinitions="1.15*,430" ColumnSpacing="18">
          <StackPanel Spacing="{DynamicResource NfcSpace16}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" Text="{Binding MergePreview.Title}" />
                <TextBlock Classes="pageSubtitle" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="170" ColumnSpacing="{DynamicResource NfcSpace12}" VerticalAlignment="Center">
                <StackPanel Spacing="3" ToolTip.Tip="{Binding Text.MergeModeTooltip}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ModeLabel}" />
                  <ComboBox
                      MinHeight="32"
                      ItemsSource="{Binding MergeModeChoices}"
                      SelectedItem="{Binding SelectedMergeMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static converters:WorkflowModeDisplayConverters.DisplayName}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
            </Grid>

            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource MergeModeContentTemplate}" />
          </StackPanel>

          <ContentControl
              Grid.Column="1"
              Content="{Binding}"
              ContentTemplate="{StaticResource MergeOutputLayoutPanelTemplate}" />
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </ScrollViewer>

    <StackPanel
        x:Name="CompositionBuildActionRail"
        Grid.Row="3"
        Margin="0,0,24,16"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        IsHitTestVisible="{Binding IsCompositionActionRailVisible}"
        IsVisible="{Binding IsCompositionActionRailVisible}"
        Orientation="Vertical"
        Spacing="{DynamicResource NfcSpace8}">
        <ContentControl
            Width="310"
            Padding="12,10"
            Content="{Binding Merge.Inspection.Loading}"
            ContentTemplate="{StaticResource ForegroundLoadingStatusTemplate}"
            IsVisible="{Binding Merge.Inspection.Loading.IsVisible}" />
        <ContentControl
            Width="310"
            Padding="12,10"
            Content="{Binding Replace.Inspection.Loading}"
            ContentTemplate="{StaticResource ForegroundLoadingStatusTemplate}"
            IsVisible="{Binding Replace.Inspection.Loading.IsVisible}" />
        <Button
            Classes="railAction outputRailAction"
            Classes.reducedMotion="{Binding IsReducedMotionEnabled}"
            AutomationProperties.HelpText="{Binding Text.LatestOutputOpenFolderLabel}"
            AutomationProperties.Name="{Binding Text.LatestOutputActionLabel}"
            Command="{Binding RevealFileCommand}"
            CommandParameter="{Binding BuildResult.LatestCommittedOutputPath}"
            IsVisible="{Binding IsLatestOutputActionVisible}">
          <Grid ColumnDefinitions="*,44">
            <TextBlock
                Grid.Column="0"
                Classes="railActionLabel"
                Text="{Binding Text.LatestOutputActionLabel}" />
            <Border Grid.Column="1" Classes="railActionIconSlot">
              <Path
                  Width="18"
                  Height="18"
                  Classes="railActionIcon"
                  Data="M2 5H7L9 7H16V9H7.5L5.5 16H2Z M7.8 10H16L14.2 16H6Z"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  StrokeThickness="1.7" />
            </Border>
          </Grid>
        </Button>
        <Grid IsVisible="{Binding IsMergeVisible}">
          <Button
              Classes="railAction primaryRailAction buildRailAction"
              Classes.reducedMotion="{Binding IsReducedMotionEnabled}"
              AutomationProperties.HelpText="{Binding Merge.MergeReadinessStatus}"
              AutomationProperties.Name="{Binding Text.BuildActionLabel}"
              Click="BuildMergeButton_OnClick"
              IsEnabled="{Binding Merge.CanBuildMerge}">
            <Grid ColumnDefinitions="*,44">
              <TextBlock Grid.Column="0" Classes="railActionLabel" Text="{Binding Text.BuildActionLabel}" />
              <Border Grid.Column="1" Classes="railActionIconSlot">
                <Path
                    Width="18"
                    Height="18"
                    Classes="railActionIcon"
                    Data="M4 8.5H11V5L16 10L11 15V11.5H4Z" />
              </Border>
            </Grid>
          </Button>
          <Border
              Width="24"
              Height="24"
              Classes="warningSurface buildBlockerBadge"
              Focusable="True"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              AutomationProperties.HelpText="{Binding MergeBuildBlockerText}"
              AutomationProperties.Name="{Binding MergeBuildBlockerText}"
              behaviors:FocusToolTipBehavior.IsEnabled="True"
              IsVisible="{Binding HasMergeBuildBlocker}"
              ToolTip.Tip="{Binding MergeBuildBlockerText}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource NfcWarningTextBrush}"
                Text="!" />
          </Border>
        </Grid>
        <Grid IsVisible="{Binding IsReplaceVisible}">
          <Button
              Classes="railAction primaryRailAction buildRailAction"
              Classes.reducedMotion="{Binding IsReducedMotionEnabled}"
              AutomationProperties.HelpText="{Binding Replace.ReplaceReadinessStatus}"
              AutomationProperties.Name="{Binding Text.BuildActionLabel}"
              Click="BuildReplaceButton_OnClick"
              IsEnabled="{Binding Replace.CanBuildReplace}">
            <Grid ColumnDefinitions="*,44">
              <TextBlock Grid.Column="0" Classes="railActionLabel" Text="{Binding Text.BuildActionLabel}" />
              <Border Grid.Column="1" Classes="railActionIconSlot">
                <Path
                    Width="18"
                    Height="18"
                    Classes="railActionIcon"
                    Data="M4 8.5H11V5L16 10L11 15V11.5H4Z" />
              </Border>
            </Grid>
          </Button>
          <Border
              Width="24"
              Height="24"
              Classes="warningSurface buildBlockerBadge"
              Focusable="True"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              AutomationProperties.HelpText="{Binding ReplaceBuildBlockerText}"
              AutomationProperties.Name="{Binding ReplaceBuildBlockerText}"
              behaviors:FocusToolTipBehavior.IsEnabled="True"
              IsVisible="{Binding HasReplaceBuildBlocker}"
              ToolTip.Tip="{Binding ReplaceBuildBlockerText}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource NfcWarningTextBrush}"
                Text="!" />
          </Border>
        </Grid>
    </StackPanel>

    <ContentControl
        x:Name="OptionalPreloadStatusHost"
        Grid.Row="4"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="{ReflectionBinding AccessibleStatus}"
        Focusable="True"
        Content="{ReflectionBinding}">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <Border
              Margin="28,0,28,12"
              Padding="14,10"
              Background="{DynamicResource NfcSurfaceBrush}"
              BorderBrush="{DynamicResource NfcBorderSoftBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource NfcCompactCornerRadius}"
              IsVisible="{ReflectionBinding HasOptionalStatus}">
            <Expander>
              <Expander.Header>
                <Grid
                    ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                    ColumnSpacing="{DynamicResource NfcSpace8}">
                  <TextBlock
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource NfcTextStrongBrush}"
                      Text="{ReflectionBinding $parent[Window].DataContext.Text.PreloadStatusTitle}" />
                  <TextBlock
                      Grid.Column="1"
                      Foreground="{DynamicResource NfcTextMutedBrush}"
                      Text="{ReflectionBinding SummaryStage.PositionLabel}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace4}">
                    <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{ReflectionBinding SummaryStage.Title}" />
                    <TextBlock Foreground="{DynamicResource NfcTextMutedBrush}" Text="·" />
                    <TextBlock Foreground="{DynamicResource NfcTextMutedBrush}" Text="{ReflectionBinding SummaryStage.Detail}" />
                  </StackPanel>
                  <TextBlock
                      Grid.Column="3"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource NfcAccentStrongBrush}"
                      IsVisible="{ReflectionBinding SummaryStage.HasProgress}"
                      Text="{ReflectionBinding SummaryStage.ProgressLabel}" />
                  <Button
                      Grid.Column="4"
                      Classes="semanticAction secondary"
                      Click="OptionalPreloadCancelButton_OnClick"
                      Content="{ReflectionBinding $parent[Window].DataContext.Text.CancelPreloadLabel}"
                      IsVisible="{ReflectionBinding CanCancelOptionals}" />
                </Grid>
              </Expander.Header>
              <ItemsControl Margin="0,10,0,0" ItemsSource="{ReflectionBinding Stages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3" ColumnDefinitions="44,180,*,90,Auto,Auto" ColumnSpacing="{DynamicResource NfcSpace8}">
                      <TextBlock
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource NfcTextMutedBrush}"
                          Text="{ReflectionBinding PositionLabel}" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource NfcTextBrush}"
                          Text="{ReflectionBinding Title}" />
                      <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{DynamicResource NfcTextMutedBrush}" Text="{ReflectionBinding Detail}" />
                        <TextBlock
                            FontSize="{DynamicResource NfcFontSize11}"
                            Foreground="{DynamicResource NfcDangerTextBrush}"
                            IsVisible="{ReflectionBinding HasDiagnostic}"
                            Text="{ReflectionBinding CurrentAttempt.Diagnostic}"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="{DynamicResource NfcSpace2}">
                        <ProgressBar
                            Height="4"
                            Maximum="1"
                            IsIndeterminate="{ReflectionBinding IsIndeterminate}"
                            IsVisible="{ReflectionBinding IsRunning}"
                            Value="{ReflectionBinding Progress}" />
                        <TextBlock
                            FontSize="{DynamicResource NfcFontSize11}"
                            Foreground="{DynamicResource NfcTextMutedBrush}"
                            IsVisible="{ReflectionBinding HasWork}"
                            Text="{ReflectionBinding WorkLabel}" />
                      </StackPanel>
                      <Button
                          Grid.Column="4"
                          Classes="semanticAction secondary"
                          AutomationProperties.Name="{ReflectionBinding RetryAccessibleLabel}"
                          Click="OptionalPreloadRetryButton_OnClick"
                          Content="{ReflectionBinding $parent[Window].DataContext.Text.RetryLabel}"
                          IsVisible="{ReflectionBinding CanRetry}"
                          Tag="{ReflectionBinding Id}" />
                      <Button
                          Grid.Column="5"
                          Classes="semanticAction secondary"
                          AutomationProperties.Name="{ReflectionBinding SkipAccessibleLabel}"
                          Click="OptionalPreloadSkipButton_OnClick"
                          Content="{ReflectionBinding $parent[Window].DataContext.Text.SkipPreloadLabel}"
                          IsVisible="{ReflectionBinding CanSkip}"
                          Tag="{ReflectionBinding Id}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="ReportToastHost"
        Grid.Row="1"
        Grid.RowSpan="4"
        ContentTemplate="{StaticResource ReportToastPanelTemplate}"
        IsVisible="{Binding Reports.HasReportToast}"
        Opacity="{Binding Reports.ReportToastOpacity}" />

    <ContentControl
        x:Name="ReplaceSelectionModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding Replace.IsReplaceSelectionModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:ReplacePresentationViewModel">
          <views:ReplaceSelectionModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="CtrlRamFirmwareVersionModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding Replace.IsCtrlRamFirmwareVersionModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:ReplacePresentationViewModel">
          <views:CtrlRamFirmwareVersionModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="AbAFlashCodeDeliveryPromptModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding Merge.IsAbAFlashCodeDeliveryPromptOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MergePresentationViewModel">
          <views:AbAFlashCodeDeliveryPromptModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="WorkflowContextSetupModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding WorkflowSession.IsWorkflowContextModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:WorkflowSessionPresentationViewModel">
          <views:WorkflowContextSetupModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="FirmwareIcMismatchModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding WorkflowSession.IsFirmwareIcMismatchModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:WorkflowSessionPresentationViewModel">
          <views:FirmwareIcMismatchModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="FirmwareNumberMismatchModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding WorkflowSession.IsFirmwareNumberMismatchModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:WorkflowSessionPresentationViewModel">
          <views:FirmwareNumberMismatchModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="NavigationClearConfirmationModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding IsNavigationClearConfirmationOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:NavigationClearConfirmationModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl Grid.RowSpan="5" Content="{Binding LoadedHexEditorWorkspace}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:HexEditorWorkspaceViewModel">
          <views:HexEditorInsertBytesModal IsVisible="{Binding IsInsertBytesPromptOpen}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl Grid.RowSpan="5" Content="{Binding LoadedHexEditorWorkspace}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:HexEditorWorkspaceViewModel">
          <views:HexEditorSaveModal IsVisible="{Binding IsSaveConfirmationOpen}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="MessageCenterModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding MessageCenter.IsOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MessageCenterViewModel">
          <views:MessageCenterModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="ReportModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding Reports.IsReportModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:ReportPresentationViewModel">
          <views:ReportModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="BuildCompletedModalHost"
        Grid.RowSpan="5"
        IsVisible="{Binding BuildResult.IsOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:BuildCompletedModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    </Grid>

    <ContentControl
        x:Name="CatalogLoadingSurfaceHost"
        IsHitTestVisible="{ReflectionBinding IsVisible}"
        IsVisible="{ReflectionBinding IsVisible}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:ForegroundLoadingState">
          <views:ForegroundLoadingSurface />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</Window>
