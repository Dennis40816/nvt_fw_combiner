      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Border
        Padding="28,12"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="2">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="#0F172A"
              Text="{Binding Text.ProductTitle}" />
          <TextBlock
              FontSize="12"
              Foreground="#64748B"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding Text.HomeLabel}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="#334155" Text="{Binding MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
          <Button
              Classes="secondary"
              Click="LoadReportJsonButton_OnClick"
              ToolTip.Tip="{Binding Text.LoadJsonTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock VerticalAlignment="Center" FontSize="14" Text="↥" />
              <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Text.LoadJsonLabel}" />
            </StackPanel>
          </Button>
          <Button
              Classes="reportAction"
              Command="{Binding ShowReportCommand}"
              IsEnabled="{Binding CanOpenReport}"
              ToolTip.Tip="{Binding ReportModalActionLabel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="15"
                  Text="▤" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding ReportActionLabel}" />
                <TextBlock
                    FontSize="10"
                    Opacity="0.82"
                    Text="{Binding ReportActionStatus}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Padding="28,6"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1">
      <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            Classes="iconButton"
            Command="{Binding GoBackCommand}"
            ToolTip.Tip="{Binding Text.BackTooltip}">
          <TextBlock Text="←" />
        </Button>
        <ItemsControl ItemsSource="{Binding NavigationTrail}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShellNavigationEntryViewModel">
              <Button Classes="breadcrumb" Command="{Binding NavigateCommand}">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                  <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" IsVisible="{Binding IsChevronVisible}" Text=">" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border
        Grid.Row="2"
        Padding="28,8"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,0,0,1"
        IsVisible="{Binding IsDeviceContextVisible}">
      <Grid ColumnDefinitions="*,Auto">
        <Grid
            Grid.Column="0"
            ColumnDefinitions="154,132,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="3"
            VerticalAlignment="Center"
            ToolTip.Tip="{Binding DeviceContextTitle}">

          <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              Text="{Binding IcLabel}" />
          <ComboBox
              Grid.Row="1"
              Grid.Column="0"
              Classes="technicalSelect"
              Width="154"
              ItemsSource="{Binding IcChoices}"
              SelectedItem="{Binding SelectedIc, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="13" Text="{Binding}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border
              Grid.Row="0"
              Grid.RowSpan="2"
              Grid.Column="1"
              Width="132"
              MinHeight="45"
              Background="Transparent"
              IsHitTestVisible="False"
              IsVisible="{Binding IsNumberSelectorPlaceholderVisible}" />
          <TextBlock
              Grid.Row="0"
              Grid.Column="1"
              FontSize="10"
              FontWeight="SemiBold"
              Foreground="#64748B"
              IsVisible="{Binding IsNumberSelectorVisible}"
              Text="{Binding NumberLabel}" />
          <ComboBox
              Grid.Row="1"
              Grid.Column="1"
              Classes="technicalSelect"
              Width="132"
              IsVisible="{Binding IsNumberSelectorVisible}"
              ItemsSource="{Binding NumberChoices}"
              SelectedItem="{Binding SelectedNumber, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="13" Text="{Binding}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel
              Grid.Row="1"
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <Border
                Width="8"
                Height="8"
                Background="#16A34A"
                CornerRadius="999" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#334155"
                Text="{Binding DeviceContextStatus}"
                TextAlignment="Left"
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3">
      <Grid Margin="28,24,28,28" RowDefinitions="*" RowSpacing="0">
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="16"
            IsVisible="{Binding IsHomeVisible}"
            VerticalAlignment="Top">
          <Border
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="{Binding Text.ConfigureKicker}" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding SettingsPreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding SettingsPreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl Grid.Row="1" Margin="0,18,0,0" ItemsSource="{Binding SettingsPreview.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        Foreground="#334155"
                        Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button
                  Grid.Row="2"
                  Classes="primary"
                  HorizontalAlignment="Left"
                  Command="{Binding ShowSettingsCommand}">
                <TextBlock Foreground="#FFFFFF" Text="{Binding Text.OpenSettingsLabel}" />
              </Button>
            </Grid>
          </Border>

          <Border
              Grid.Column="1"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="{Binding Text.WorkflowKicker}" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding ReplacePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowDpReplaceCommand}">
                  <Border Classes="workflowCard" Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="DP Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Text.OpenLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    Command="{Binding ShowCtrlRamReplaceCommand}">
                  <Border Classes="workflowCard" Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="CtrlRAM Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Text.OpenLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="2"
                    Classes="command"
                    Command="{Binding ShowGeneralReplaceCommand}">
                  <Border Classes="workflowCard" Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="General Replace" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Text.OpenLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
            </Grid>
          </Border>

          <Border
              Grid.Column="2"
              MinHeight="306"
              Padding="22"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto">
              <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="{Binding Text.WorkflowKicker}" />
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding MergePreview.Title}" />
                <TextBlock
                    FontSize="13"
                    Foreground="#64748B"
                    Text="{Binding MergePreview.Subtitle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,18,0,0" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button
                    Classes="command"
                    Command="{Binding ShowNormalMergeCommand}">
                  <Border Classes="workflowCard" Padding="12,9" Background="#F8FAFC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Normal Merge" />
                      <Border Grid.Column="1" Padding="10,4" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding Text.OpenLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
                <Button
                    Grid.Row="1"
                    Classes="command"
                    IsEnabled="False">
                  <Border Classes="workflowCard" Padding="12,9" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <TextBlock FontWeight="SemiBold" Foreground="#94A3B8" Text="AB Code" />
                      <Border Grid.Column="1" Padding="10,4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="999">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Text="{Binding Text.PendingLabel}" />
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.6*,360"
            ColumnSpacing="18"
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="#0F172A"
                  Text="{Binding SettingsPreview.Title}" />
              <TextBlock
                  FontSize="13"
                  Foreground="#64748B"
                  Text="{Binding SettingsPreview.Subtitle}"
                  TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <Border Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.SettingsCatalogTitle}" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Text.SettingsCatalogSubtitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsProfileRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            <TextBlock Grid.Row="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" MaxWidth="170" FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.SettingsRuntimeChecksTitle}" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Text.SettingsRuntimeChecksSubtitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsToolRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.SettingsDiagnosticsTitle}" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Text.SettingsDiagnosticsSubtitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SettingsDiagnosticsRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                        <Border Padding="0,0,0,9" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                          <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.SettingsPreferencesTitle}" />
                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Text.SettingsPreferencesSubtitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="92,180,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ThemeLabel}" />
                    <ComboBox Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding ThemePreferenceStatus}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StrictnessLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding StrictnessChoices}" SelectedItem="{Binding SelectedStrictness, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding StrictnessPreferenceStatus}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.LanguageLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Classes="settingsSelect" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="{Binding LanguagePreferenceStatus}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SettingsInspectorKicker}" />
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.SettingsReadinessTitle}" />
              <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding SettingsPreview.Status}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SettingsReadinessRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingSummaryViewModel">
                    <Border Padding="0,0,0,10" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                          <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding Status}" />
                        </Grid>
                        <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding Value}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.15*,430"
            ColumnSpacing="18"
            IsVisible="{Binding IsReplaceVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{Binding ReplacePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <Grid
                  Grid.Column="1"
                  ColumnDefinitions="158,Auto,Auto"
                  ColumnSpacing="12"
                  VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ModeLabel}" />
                  <ComboBox
                      MinHeight="32"
                      ItemsSource="{Binding ReplaceModeChoices}"
                      SelectedItem="{Binding SelectedReplaceMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.TargetsLabel}" />
                  <Button
                      Classes="summaryChip"
                      Command="{Binding ShowReplaceSelectionCommand}"
                      ToolTip.Tip="{Binding Text.ReviewReplacementInputsTooltip}">
                    <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                      <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceSelectionCountLabel}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="▾" />
                    </Grid>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <Button
                      Classes="toolbarAction"
                      Click="BuildReplaceButton_OnClick"
                      IsEnabled="{Binding CanBuildReplace}"
                      ToolTip.Tip="{Binding ReplaceBuildActionTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="✓" />
                       <TextBlock VerticalAlignment="Center" Text="{Binding Text.BuildActionLabel}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsNonCtrlRamStructuredReplaceModeSelected}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.InputFilesTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedReplaceModeDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSlots}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsCtrlRamReplaceModeSelected}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.InputFilesTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.CtrlRamInputFilesDetail}" TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Classes="fileDropZone"
                    MinHeight="92"
                    Padding="0"
                    Background="{Binding ReplaceBaseSlot.SlotBackgroundBrush}"
                    BorderBrush="{Binding ReplaceBaseSlot.SlotBorderBrush}"
                    BorderThickness="{Binding ReplaceBaseSlot.SlotBorderThickness}"
                    CornerRadius="8"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="DropZone_OnDragEnter"
                    DragDrop.DragOver="SlotDragOver_OnDragOver"
                    DragDrop.DragLeave="DropZone_OnDragLeave"
                    DragDrop.Drop="SlotDrop_OnDrop"
                    Tag="{Binding ReplaceBaseSlot.SlotId}">
                  <Grid>
                    <Border Classes="dropZoneOverlay" />
                    <Grid Margin="14" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border
                              Classes="slotTypeIcon"
                              Background="{Binding ReplaceBaseSlot.SlotIconBackgroundBrush}"
                              BorderBrush="{Binding ReplaceBaseSlot.SlotIconBorderBrush}"
                              ToolTip.Tip="{Binding ReplaceBaseSlot.SlotIconTooltip}">
                            <Path
                                Data="{Binding ReplaceBaseSlot.SlotIconPathData}"
                                Stroke="{Binding ReplaceBaseSlot.SlotIconForegroundBrush}" />
                          </Border>
                          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceBaseSlot.Title}" />
                          <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding ReplaceBaseSlot.RequirementBadgeBackgroundBrush}" BorderBrush="{Binding ReplaceBaseSlot.RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ReplaceBaseSlot.RequirementBadgeForegroundBrush}" Text="{Binding ReplaceBaseSlot.RequirementLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceBaseSlot.Description}" TextWrapping="Wrap" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceBaseSlot.DisplayName}" TextWrapping="Wrap" />
                        <ItemsControl IsVisible="{Binding ReplaceBaseSlot.HasFirmwareFacts}" ItemsSource="{Binding ReplaceBaseSlot.FirmwareFacts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding ReplaceBaseSlot.HasFile}" Text="{Binding ReplaceBaseSlot.DisplayDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="action browseAction"
                          Click="BrowseSlotButton_OnClick"
                          Content="{Binding Text.BrowseLabel}"
                          Tag="{Binding ReplaceBaseSlot.SlotId}" />
                    </Grid>
                  </Grid>
                </Border>

                <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSlotGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FirmwareSlotGroupViewModel">
                      <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                          <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectionSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding CountLabel}" />
                            </Border>
                          </Grid>
                        </Expander.Header>
                        <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Slots}">
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsGeneralReplaceModeSelected}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*" ColumnSpacing="16">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceMappingTitle}" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding SelectedReplaceModeDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Border Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceRuleBaseTitle}" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Text.GeneralReplaceRuleBaseDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceRuleBoundsTitle}" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Text.GeneralReplaceRuleBoundsDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceRuleLengthTitle}" />
                      <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Text.GeneralReplaceRuleLengthDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralReplaceRuleBaseTitle}" />
                <Border
                    Classes="fileDropZone"
                    Padding="0"
                    Background="{Binding ReplaceBaseSlot.SlotBackgroundBrush}"
                    BorderBrush="{Binding ReplaceBaseSlot.SlotBorderBrush}"
                    BorderThickness="{Binding ReplaceBaseSlot.SlotBorderThickness}"
                    CornerRadius="8"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="DropZone_OnDragEnter"
                    DragDrop.DragOver="SlotDragOver_OnDragOver"
                    DragDrop.DragLeave="DropZone_OnDragLeave"
                    DragDrop.Drop="SlotDrop_OnDrop"
                    Tag="{Binding ReplaceBaseSlot.SlotId}">
                  <Grid>
                    <Border Classes="dropZoneOverlay" />
                    <Grid Margin="14" MinHeight="60" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                      <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border
                              Classes="slotTypeIcon"
                              Background="{Binding ReplaceBaseSlot.SlotIconBackgroundBrush}"
                              BorderBrush="{Binding ReplaceBaseSlot.SlotIconBorderBrush}"
                              ToolTip.Tip="{Binding ReplaceBaseSlot.SlotIconTooltip}">
                            <Path
                                Data="{Binding ReplaceBaseSlot.SlotIconPathData}"
                                Stroke="{Binding ReplaceBaseSlot.SlotIconForegroundBrush}" />
                          </Border>
                          <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceBaseSlot.Title}" />
                          <Border Padding="8,2" VerticalAlignment="Center" Background="{Binding ReplaceBaseSlot.RequirementBadgeBackgroundBrush}" BorderBrush="{Binding ReplaceBaseSlot.RequirementBadgeBorderBrush}" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ReplaceBaseSlot.RequirementBadgeForegroundBrush}" Text="{Binding ReplaceBaseSlot.RequirementLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceBaseSlot.Description}" TextWrapping="Wrap" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceBaseSlot.DisplayName}" TextWrapping="Wrap" />
                        <ItemsControl IsVisible="{Binding ReplaceBaseSlot.HasFirmwareFacts}" ItemsSource="{Binding ReplaceBaseSlot.FirmwareFacts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="FirmwareSlotFactTemplate" />
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding ReplaceBaseSlot.HasFile}" Text="{Binding ReplaceBaseSlot.DisplayDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button
                          Grid.Column="1"
                          Classes="action browseAction"
                          VerticalAlignment="Center"
                          Click="BrowseSlotButton_OnClick"
                          Content="{Binding Text.BrowseLabel}"
                          Tag="{Binding ReplaceBaseSlot.SlotId}" />
                    </Grid>
                  </Grid>
                </Border>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ValidationTitle}" />
                    <Border MinHeight="92" Padding="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Text.GeneralReplaceValidationDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ExplicitMappingsTitle}" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.GeneralReplaceMappingsDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="action"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddGeneralReplaceMappingCommand}"
                        Content="{Binding Text.AddRangeLabel}" />
                  </Grid>
                  <Grid ColumnDefinitions="34,128,22,128,*,82,40" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="#" />
                    <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StartLabel}" />
                    <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.EndLabel}" />
                    <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ReplacementBinLabel}" />
                  </Grid>
                  <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding GeneralReplaceMappings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GeneralReplaceMappingViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="7"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8">
                          <Grid ColumnDefinitions="34,128,22,128,*,82,40" ColumnSpacing="8">
                            <Border Width="30" Height="30" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Index}" />
                            </Border>
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="1"
                                Text="{Binding StartAddress, Mode=TwoWay}"
                                PlaceholderText="start" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#64748B"
                                Text="-" />
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="3"
                                Text="{Binding EndAddress, Mode=TwoWay}"
                                PlaceholderText="end" />
                            <Border
                                Classes="fileDropZone"
                                Grid.Column="4"
                                MinHeight="32"
                                Padding="0"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragEnter="DropZone_OnDragEnter"
                                DragDrop.DragOver="SlotDragOver_OnDragOver"
                                DragDrop.DragLeave="DropZone_OnDragLeave"
                                DragDrop.Drop="GeneralMappingDrop_OnDrop"
                                Tag="{Binding MappingId}">
                              <Grid>
                                <Border Classes="dropZoneOverlay" />
                                <StackPanel Margin="10,0" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                  <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding HasFile}" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <Button
                                Grid.Column="5"
                                Classes="action browseAction"
                                Click="BrowseGeneralMappingButton_OnClick"
                                Content="{Binding #RootWindow.DataContext.Text.BrowseLabel}"
                                Tag="{Binding MappingId}"
                                ToolTip.Tip="{Binding #RootWindow.DataContext.Text.SelectReplacementBinTooltip}" />
                            <Button
                                Grid.Column="6"
                                Classes="iconButton dangerIcon"
                                Click="RemoveGeneralMappingButton_OnClick"
                                ToolTip.Tip="{Binding #RootWindow.DataContext.Text.RemoveRangeTooltip}">
                              <TextBlock FontSize="13" Text="X" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>

          <Border Grid.Column="1" Padding="18,16" Background="#FFFFFF" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="14">
              <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OutputLayoutTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceMemorySummary}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                  <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#475569" Text="{Binding ReplaceMemoryRangeLabel}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <Border Padding="6" Background="#EEF4FA" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                <ItemsControl ItemsSource="{Binding ReplaceCoverageSegments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                      <Border
                          Width="{Binding BarWidth}"
                          Height="22"
                          Background="{Binding FillBrush}"
                          BorderBrush="{Binding OutlineBrush}"
                          BorderThickness="{Binding OutlineThickness}">
                        <ToolTip.Tip>
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                        </ToolTip.Tip>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <ItemsControl ItemsSource="{Binding ReplaceCoverageSegments}" IsVisible="{Binding IsReplaceCoverageFlat}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                    <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                      <ToolTip.Tip>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                      </ToolTip.Tip>
                      <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                        <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="{Binding OutlineThickness}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceCoverageGroups}" IsVisible="{Binding IsReplaceCoverageGrouped}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageGroupViewModel">
                    <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                      <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Title}" />
                            <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding ChangeSummary}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding CountLabel}" />
                          </Border>
                        </Grid>
                      </Expander.Header>
                      <ItemsControl HorizontalAlignment="Stretch" ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                            <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                              <ToolTip.Tip>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                              </ToolTip.Tip>
                              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                                <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="{Binding OutlineThickness}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                                  <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                                  <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.PlanTitle}" />
              <ItemsControl ItemsSource="{Binding ReplaceMemoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                    <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding Detail}">
                      <Grid ColumnDefinitions="118,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding PrimaryLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding ReplaceReadinessStatus}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="1.15*,430"
            ColumnSpacing="18"
            IsVisible="{Binding IsMergeVisible}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding MergePreview.Title}" />
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="170,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Spacing="3" ToolTip.Tip="{Binding Text.MergeModeTooltip}">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ModeLabel}" />
                  <ComboBox
                      MinHeight="32"
                      ItemsSource="{Binding MergeModeChoices}"
                      SelectedItem="{Binding SelectedMergeMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                  <Button
                      Classes="toolbarAction"
                      Click="BuildMergeButton_OnClick"
                      IsEnabled="{Binding CanBuildMerge}"
                      ToolTip.Tip="{Binding MergeBuildActionTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="✓" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Text.BuildActionLabel}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsNormalMergeModeSelected}">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.InputFilesTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StandardMergeSupportSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding MergeSlots}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="FirmwareSlotCardTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding MergeReadinessStatus}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsGeneralMergeModeSelected}">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,180" ColumnSpacing="14">
                  <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.GeneralMergeMappingTitle}" />
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.GeneralMergeMappingDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.OutputLengthLabel}" />
                    <TextBox
                        Classes="addressInput"
                        Text="{Binding GeneralMergeOutputLength, Mode=TwoWay}"
                        PlaceholderText="0x100000" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ExplicitMappingsTitle}" />
                      <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.GeneralMergeMappingsDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="action"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddGeneralMergeMappingCommand}"
                        Content="{Binding Text.AddMappingLabel}" />
                  </Grid>

                  <Grid Margin="7,0,7,0" ColumnDefinitions="34,118,118,108,*,82,40" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="#" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SourceStartLabel}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.TargetStartLabel}" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.LengthLabel}" />
                    <TextBlock Grid.Column="4" Margin="10,0,0,0" HorizontalAlignment="Left" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SourceBinLabel}" />
                  </Grid>
                  <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding GeneralMergeMappings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GeneralMergeMappingViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="7"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8">
                          <Grid ColumnDefinitions="34,118,118,108,*,82,40" ColumnSpacing="8">
                            <Border Width="30" Height="30" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Index}" />
                            </Border>
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="1"
                                Text="{Binding SourceStartAddress, Mode=TwoWay}"
                                PlaceholderText="source" />
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="2"
                                Text="{Binding TargetStartAddress, Mode=TwoWay}"
                                PlaceholderText="target" />
                            <TextBox
                                Classes="addressInput"
                                Grid.Column="3"
                                Text="{Binding Length, Mode=TwoWay}"
                                PlaceholderText="length" />
                            <Border
                                Classes="fileDropZone"
                                Grid.Column="4"
                                MinHeight="32"
                                Padding="0"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragEnter="DropZone_OnDragEnter"
                                DragDrop.DragOver="SlotDragOver_OnDragOver"
                                DragDrop.DragLeave="DropZone_OnDragLeave"
                                DragDrop.Drop="GeneralMergeMappingDrop_OnDrop"
                                Tag="{Binding MappingId}">
                              <Grid>
                                <Border Classes="dropZoneOverlay" />
                                <StackPanel Margin="10,0" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                  <TextBlock FontSize="10" FontFamily="Cascadia Mono, Consolas" Foreground="#64748B" IsVisible="{Binding HasFile}" Text="{Binding DisplayDetail}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <Button
                                Grid.Column="5"
                                Classes="action browseAction"
                                Click="BrowseGeneralMergeMappingButton_OnClick"
                                Content="{Binding #RootWindow.DataContext.Text.BrowseLabel}"
                                Tag="{Binding MappingId}"
                                ToolTip.Tip="{Binding #RootWindow.DataContext.Text.SelectSourceBinTooltip}" />
                            <Button
                                Grid.Column="6"
                                Classes="iconButton dangerIcon"
                                Click="RemoveGeneralMergeMappingButton_OnClick"
                                ToolTip.Tip="{Binding #RootWindow.DataContext.Text.RemoveMappingTooltip}">
                              <TextBlock FontSize="13" Text="X" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="{Binding MergeReadinessStatus}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsAbCodeMergeModeSelected}">
              <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.AbCodeMergeTitle}" />
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.AbCodeMergeDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Padding="18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="14">
              <StackPanel Spacing="8">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OutputLayoutTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding MergeMemorySummary}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Padding="8,4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                  <TextBlock
                      FontFamily="Cascadia Mono, Consolas"
                      FontSize="12"
                      Foreground="#475569"
                      Text="{Binding MergeMemoryRangeLabel}"
                      TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <Border Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                <ItemsControl ItemsSource="{Binding MergeCoverageSegments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                      <Border
                          Width="{Binding BarWidth}"
                          Height="22"
                          Background="{Binding FillBrush}">
                        <ToolTip.Tip>
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                        </ToolTip.Tip>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <ItemsControl ItemsSource="{Binding MergeCoverageSegments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryCoverageSegmentViewModel">
                    <Border Padding="0,8" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                      <ToolTip.Tip>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MemoryCoverageTooltipTemplate}" />
                      </ToolTip.Tip>
                      <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                        <Border Width="10" Height="10" Margin="0,3,0,0" VerticalAlignment="Top" Background="{Binding FillBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                          <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                          <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding CompactDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.PlanTitle}" />
              <ItemsControl ItemsSource="{Binding MergeMemoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryMapRowViewModel">
                    <Border Padding="0,9" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding Detail}">
                      <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ActionLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#0F172A" Text="{Binding RangeLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{Binding FlowLabel}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border
        Grid.Row="1"
        Grid.RowSpan="4"
        MaxWidth="460"
        Margin="0,12,0,0"
        Padding="12,10"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#FFFFFF"
        BorderBrush="#BFDBFE"
        BorderThickness="1"
        CornerRadius="8"
        Opacity="{Binding ReportToastOpacity}"
        IsVisible="{Binding HasReportToast}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="#2563EB" Text="▤" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ReportToastTitle}" />
          <TextBlock FontSize="12" Foreground="#475569" Text="{Binding ReportToastText}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        Grid.RowSpan="5"
        Background="#660F172A"
        IsVisible="{Binding IsReplaceSelectionModalOpen}">
      <Border
          Width="720"
          MaxHeight="640"
          Padding="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ReplaceSelectionTitle}" />
              <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceSelectionSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="iconButton"
                Command="{Binding CloseReplaceSelectionCommand}"
                ToolTip.Tip="{Binding Text.CloseSelectionTooltip}">
              <TextBlock Text="×" />
            </Button>
          </Grid>

          <Border Grid.Row="1" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Width="8" Height="38" VerticalAlignment="Top" Background="#2563EB" CornerRadius="999" />
              <StackPanel Grid.Column="1" Spacing="3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ReplaceSelectionCountLabel}" />
                  <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Text="{Binding ReplaceSelectionStatusLabel}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReplaceSelectionRunHint}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SelectedReplacementsTitle}" />
                <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionRows}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportSelectionRowTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Padding="12" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasReplaceSelectionMissingRows}">
                <StackPanel Spacing="8">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding Text.RequiredBeforeBuildTitle}" />
                  <ItemsControl ItemContainerTheme="{StaticResource StretchContentPresenterTheme}" ItemsSource="{Binding ReplaceSelectionMissingRows}">
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportMissingRequiredRowTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Classes="secondary"
                Command="{Binding CloseReplaceSelectionCommand}"
                Content="{Binding Text.CloseLabel}" />
            <Button
                Classes="primary"
                Click="BuildReplaceButton_OnClick"
                Content="{Binding Text.BuildActionLabel}"
                IsEnabled="{Binding CanBuildReplace}"
                ToolTip.Tip="{Binding ReplaceBuildActionTip}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.RowSpan="5"
        Background="#990F172A"
        IsVisible="{Binding IsReportModalOpen}">
      <Border
          MinWidth="980"
          MaxWidth="1500"
          MaxHeight="940"
          Margin="22,16"
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#FFFFFF"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">
          <Border Padding="22,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="5">
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Title}" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LoadedReport.Subtitle}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="iconButton"
                    Command="{Binding CloseReportCommand}"
                    ToolTip.Tip="{Binding Text.CloseReportTooltip}">
                  <TextBlock Text="×" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border
              Grid.Row="1"
              Grid.RowSpan="3"
              Margin="22,18,22,0"
              Padding="16"
              Background="#FFFFFF"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="8"
              IsVisible="{Binding IsReportHistoryViewOpen}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ReportHistoryTitle}" />
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding ReportHistorySummary}" />
                  <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding ReportHistoryStorageSummary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Command="{Binding CloseReportHistoryCommand}" Content="{Binding Text.BackToReportLabel}" />
                  <Button
                      Classes="danger"
                      Command="{Binding ClearReportHistoryCommand}"
                      Content="{Binding Text.ClearAllLabel}"
                      ToolTip.Tip="{Binding Text.ClearHistoryTooltip}" />
                </StackPanel>
              </Grid>

              <Border Grid.Row="1" Padding="10" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasReportHistoryStorageWarning}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock FontSize="12" Foreground="#9A3412" Text="{Binding ReportHistoryStorageWarning}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="danger" Command="{Binding ClearReportHistoryCommand}" Content="{Binding Text.ClearHistoryLabel}" />
                </Grid>
              </Border>

              <Border Grid.Row="2" Padding="18" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" IsVisible="{Binding IsReportHistoryEmpty}">
                <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Text.NoReportHistoryLabel}" />
              </Border>

              <ScrollViewer Grid.Row="2" IsVisible="{Binding HasReportHistory}">
                <ItemsControl ItemsSource="{Binding ReportHistoryEntries}">
                  <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="ReportHistoryEntryTemplate" />
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="2" Margin="22,16,22,0" Padding="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" IsVisible="{Binding IsReportReviewViewOpen}">
            <Grid ColumnDefinitions="1.05*,1.15*,1.45*,Auto" ColumnSpacing="16">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Grid Width="36" Height="36" AutomationProperties.Name="{Binding LoadedReport.OutcomeAccessibilityLabel}">
                  <Border Background="#16A34A" CornerRadius="999" IsVisible="{Binding LoadedReport.IsClean}" />
                  <Border Background="#D97706" CornerRadius="999" IsVisible="{Binding LoadedReport.HasWarningsWithoutBlockingIssues}" />
                  <Border Background="#EA580C" CornerRadius="999" IsVisible="{Binding LoadedReport.HasPrimaryIssue}" />
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFF"
                      Text="{Binding LoadedReport.OutcomeIcon}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.RunLabel}" />
                    <Border Grid.Column="1" Padding="7,2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.OutcomeMeta}" TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                  <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.OutcomeTitle}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Foreground="#475569" Text="{Binding LoadedReport.OutcomeDetail}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.NextStepTitle}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Border Grid.Column="1" Padding="14,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.OutputLabel}" />
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.OutputFileName}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding LoadedReport.OutputHashLabel}" TextWrapping="Wrap" />
                  <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Padding="14,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ChangeReviewTitle}" />
                      <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.ByteDifferenceTitle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Top" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.ByteDifferenceMeta}" />
                    </Border>
                  </Grid>
                  <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding LoadedReport.ByteDifferenceDetail}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding LoadedReport.OutputDifferenceSummaryRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <StaticResource ResourceKey="ReportDifferenceSummaryChipTemplate" />
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Button
                  Grid.Column="3"
                  Classes="iconButton"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="{Binding Text.OpenReportHistoryAutomationName}"
                  Command="{Binding ShowReportHistoryCommand}"
                  IsVisible="{Binding HasReportHistory}"
                  ToolTip.Tip="{Binding Text.OpenReportHistoryTooltip}">
                <Path
                    Width="16"
                    Height="16"
                    Data="M10,2 A8,8 0 1 1 2,10 M2,10 L2,4 M2,10 L8,10 M10,6 L10,10 L13,12"
                    Stretch="Uniform"
                    Stroke="#475569"
                    StrokeThickness="1.7" />
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="3" Margin="22,16,22,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" IsVisible="{Binding IsReportReviewViewOpen}">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="16,14,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.EvidenceTitle}" />
                  <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding LoadedReport.AuditSummary}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Padding="7,2" VerticalAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Text.TraceLabel}" />
                </Border>
              </Grid>

              <TabControl Grid.Row="1" Margin="12,0,12,12" FontSize="13">
                <TabItem Header="{Binding Text.ReportTabInputs}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.RunMetadataTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.Status}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ReportFileLabel}" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.SourceName}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StatusLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding LoadedReport.Status}" />
                            <TextBlock Grid.Row="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.OutputLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#334155" Text="{Binding LoadedReport.Output}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ArtifactPathLabel}" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="#334155" Text="{Binding LoadedReport.OutputArtifactPath}" TextWrapping="Wrap" IsVisible="{Binding LoadedReport.HasOutputArtifactPath}" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasInputs}">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.InputsAndHashesTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.InputCount}" />
                            </Border>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.Inputs}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportInputRowTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoInputs}">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyInputsMessage}" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Text.ReportTabChanges}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                      <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoByteChanges}">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyByteChangesMessage}" TextWrapping="Wrap" />
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasOutputDifferences}">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OutputChangesTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#166534" Text="{Binding LoadedReport.OutputDifferenceCount}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="130,210,*" ColumnSpacing="10">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.DiffLabel}" />
                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.RangeLabel}" />
                            <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ExplanationLabel}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.OutputDifferences}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportOutputDifferenceRowTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasMutations}">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.ChangedRangesTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.MutationCount}" />
                            </Border>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.Mutations}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportMutationRowTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Text.ReportTabOperations}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                      <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoStepOperations}">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyOperationsMessage}" TextWrapping="Wrap" />
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasStepOperations}">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.OperationStepsTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#334155" Text="{Binding LoadedReport.StepOperationCount}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="150,150,*,*,150,90" ColumnSpacing="10">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StepLabel}" />
                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.KindLabel}" />
                            <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SourceLabel}" />
                            <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.TargetLabel}" />
                            <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ProcessorLabel}" />
                            <TextBlock Grid.Column="5" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StatusLabel}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.StepOperations}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportStepOperationTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Text.ReportTabPostbuild}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                      <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoCommandOperations}">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyPostbuildMessage}" TextWrapping="Wrap" />
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasCommandOperations}">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.HeaderRefreshTraceTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#EAF3FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8" Text="{Binding LoadedReport.CommandOperationCount}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="150,150,*,*,150,90" ColumnSpacing="10">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StepLabel}" />
                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.KindLabel}" />
                            <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.SourceLabel}" />
                            <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.TargetLabel}" />
                            <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.ProcessorLabel}" />
                            <TextBlock Grid.Column="5" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Text="{Binding Text.StatusLabel}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.CommandOperations}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportCommandOperationTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Text.ReportTabIssues}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                      <Border Padding="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasNoIssues}">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Text.EmptyIssuesMessage}" TextWrapping="Wrap" />
                      </Border>

                      <Border Padding="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" IsVisible="{Binding LoadedReport.HasIssues}">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Text.IssuesAndWarningsTitle}" />
                            <Border Grid.Column="1" Padding="7,2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="999">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#9A3412" Text="{Binding LoadedReport.IssueCount}" />
                            </Border>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding LoadedReport.Issues}">
                            <ItemsControl.ItemTemplate>
                              <StaticResource ResourceKey="ReportIssueRowTemplate" />
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Text.ReportTabRaw}">
                  <Border Margin="0,12,0,0" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                    <TextBox
                        MinHeight="320"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="11"
                        IsReadOnly="True"
                        Text="{Binding LoadedReportJson, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                  </Border>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>

          <StackPanel Grid.Row="4" Margin="22,18,22,18" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Classes="secondary"
                Command="{Binding CloseReportCommand}"
                Content="{Binding Text.CloseLabel}" />
            <Button
                Classes="primary"
                Click="SaveReportButton_OnClick"
                Content="{Binding Text.SaveReportLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border
        Grid.Row="4"
        Padding="28,9"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="0,1,0,0">
      <TextBlock
          FontSize="12"
          Foreground="#64748B"
          Text="{Binding FooterStatus}"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
