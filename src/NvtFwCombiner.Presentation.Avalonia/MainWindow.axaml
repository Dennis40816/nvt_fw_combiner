<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views"
    xmlns:vm="using:NvtFwCombiner.Presentation.Avalonia.ViewModels"
    x:Name="RootWindow"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    WindowState="Maximized"
    MinWidth="980"
    MinHeight="640"
    Background="{DynamicResource NfcAppBackgroundBrush}"
    FontFamily="{DynamicResource NfcUiFontFamily}"
    Icon="/Assets/AppIcon.ico"
    Title="NVT FW Combiner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ShowReportHistoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding ClearReportHistoryCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding RequestHexEditorSaveCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding RequestHexEditorUndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RequestHexEditorRedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RequestHexEditorRedoCommand}" />
  </Window.KeyBindings>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowSharedTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportChangeTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportInputTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportOperationTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportHistoryTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportAuditTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowReportPanels.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowPageTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowWorkflowTemplates.axaml" />
        <ResourceInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Resources/MainWindowShellPanels.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowButtonStyles.axaml" />
    <StyleInclude Source="avares://NvtFwCombiner.Presentation.Avalonia/Styles/MainWindowVisualStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Classes="shellBar" Padding="28,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
        <StackPanel Spacing="{DynamicResource NfcSpace2}">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="{DynamicResource NfcTextStrongBrush}"
              Text="{Binding Text.ProductTitle}" />
          <TextBlock
              FontSize="{DynamicResource NfcFontSize12}"
              Foreground="{DynamicResource NfcTextMutedBrush}"
              Text="{Binding ShellVersion}" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace4}">
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowHomeCommand}"
              IsChecked="{Binding IsHomeVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding Text.HomeLabel}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowSettingsCommand}"
              IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding SettingsPreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowReplaceCommand}"
              IsChecked="{Binding IsReplaceVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding ReplacePreview.Title}" />
          </ToggleButton>
          <ToggleButton
              Classes="nav"
              Command="{Binding ShowMergeCommand}"
              IsChecked="{Binding IsMergeVisible, Mode=OneWay}">
            <TextBlock Foreground="{DynamicResource NfcTextBrush}" Text="{Binding MergePreview.Title}" />
          </ToggleButton>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource NfcSpace8}">
          <Button
              Classes="secondary"
              Click="LoadReportJsonButton_OnClick"
              ToolTip.Tip="{Binding Text.LoadJsonTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize14}" Text="↥" />
              <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize12}" FontWeight="SemiBold" Text="{Binding Text.LoadJsonLabel}" />
            </StackPanel>
          </Button>
          <Button
              Classes="reportAction"
              Command="{Binding ShowReportCommand}"
              IsEnabled="{Binding CanOpenReport}"
              ToolTip.Tip="{Binding Text.ReportModalActionLabel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="15"
                  Text="▤" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock
                    FontSize="{DynamicResource NfcFontSize12}"
                    FontWeight="SemiBold"
                    Text="{Binding ReportActionLabel}" />
                <TextBlock
                    FontSize="{DynamicResource NfcFontSize10}"
                    Opacity="0.82"
                    Text="{Binding ReportActionStatus}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource NavigationTrailPanelTemplate}" />

    <ContentControl
        x:Name="DeviceContextHost"
        Grid.Row="2"
        ContentTemplate="{StaticResource DeviceContextPanelTemplate}"
        IsVisible="{Binding IsDeviceContextVisible}" />

    <ScrollViewer Grid.Row="3">
      <Grid Margin="28,24,28,28" RowDefinitions="*" RowSpacing="0">
        <ContentControl
            x:Name="HomePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsHomeVisible}"
            ContentTemplate="{StaticResource HomePageTemplate}" />

        <ContentControl
            x:Name="SettingsPageHost"
            Grid.Row="0"
            IsVisible="{Binding IsSettingsVisible}"
            ContentTemplate="{StaticResource SettingsPageTemplate}" />

        <ContentControl
            x:Name="HexEditorPageHost"
            Grid.Row="0"
            IsVisible="{Binding IsHexEditorVisible}"
            ContentTemplate="{StaticResource HexEditorPageTemplate}" />

        <ContentControl
            x:Name="ReplacePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsReplaceVisible}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:MainWindowViewModel">
              <Grid ColumnDefinitions="1.15*,430" ColumnSpacing="18">
          <StackPanel Spacing="{DynamicResource NfcSpace16}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" Text="{Binding ReplacePreview.Title}" />
                <TextBlock Classes="pageSubtitle" Text="{Binding ReplacePreview.Subtitle}" />
              </StackPanel>
              <Grid
                  Grid.Column="1"
                  ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="{DynamicResource NfcSpace12}"
                  VerticalAlignment="Center">
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ModeLabel}" />
                  <Grid ColumnDefinitions="158,Auto" ColumnSpacing="6">
                    <ComboBox
                        MinHeight="32"
                        ItemsSource="{Binding ReplaceModeChoices}"
                        SelectedItem="{Binding SelectedReplaceMode, Mode=TwoWay}" />
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge success"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeGoldenVerified}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge review"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeEvidenceGated}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                    <Label
                        Grid.Column="1"
                        Classes="compactBadge neutralBadge reportBadge info"
                        Content="{Binding SelectedReplaceModeEvidenceLabel}"
                        IsVisible="{Binding IsSelectedReplaceModeUnavailable}"
                        ToolTip.Tip="{Binding SelectedReplaceModeEvidenceTooltip}" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.TargetsLabel}" />
                  <Button
                      Classes="summaryChip"
                      Command="{Binding ShowReplaceSelectionCommand}"
                      ToolTip.Tip="{Binding Text.ReviewReplacementInputsTooltip}">
                    <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                      <TextBlock VerticalAlignment="Center" Classes="bodyEmphasisText" Text="{Binding ReplaceSelectionCountLabel}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="captionText" Text="▾" />
                    </Grid>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
                  <Button
                      Classes="toolbarAction"
                      Click="BuildReplaceButton_OnClick"
                      IsEnabled="{Binding CanBuildReplace}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" Text="✓" />
                       <TextBlock VerticalAlignment="Center" Text="{Binding Text.BuildActionLabel}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource ReplaceModeContentTemplate}" />
          </StackPanel>

          <ContentControl
              Grid.Column="1"
              Content="{Binding}"
              ContentTemplate="{StaticResource ReplaceOutputLayoutPanelTemplate}" />
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl
            x:Name="MergePageHost"
            Grid.Row="0"
            IsVisible="{Binding IsMergeVisible}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:MainWindowViewModel">
              <Grid ColumnDefinitions="1.15*,430" ColumnSpacing="18">
          <StackPanel Spacing="{DynamicResource NfcSpace16}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource NfcSpace16}">
              <StackPanel Spacing="{DynamicResource NfcSpace4}">
                <TextBlock Classes="pageTitle" Text="{Binding MergePreview.Title}" />
                <TextBlock Classes="pageSubtitle" Text="{Binding MergePreview.Subtitle}" />
              </StackPanel>
              <Grid Grid.Column="1" ColumnDefinitions="170,Auto" ColumnSpacing="{DynamicResource NfcSpace12}" VerticalAlignment="Center">
                <StackPanel Spacing="3" ToolTip.Tip="{Binding Text.MergeModeTooltip}">
                  <TextBlock Classes="fieldLabel" Text="{Binding Text.ModeLabel}" />
                  <ComboBox
                      MinHeight="32"
                      ItemsSource="{Binding MergeModeChoices}"
                      SelectedItem="{Binding SelectedMergeMode, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,15,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource NfcSpace8}">
                  <Button
                      Classes="toolbarAction"
                      Click="BuildMergeButton_OnClick"
                      IsEnabled="{Binding CanBuildMerge}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource NfcFontSize13}" Text="✓" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Text.BuildActionLabel}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>

            <ContentControl
                Content="{Binding}"
                ContentTemplate="{StaticResource MergeModeContentTemplate}" />
          </StackPanel>

          <ContentControl
              Grid.Column="1"
              Content="{Binding}"
              ContentTemplate="{StaticResource MergeOutputLayoutPanelTemplate}" />
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </ScrollViewer>

    <ContentControl
        x:Name="ReportToastHost"
        Grid.Row="1"
        Grid.RowSpan="3"
        ContentTemplate="{StaticResource ReportToastPanelTemplate}"
        IsVisible="{Binding HasReportToast}"
        Opacity="{Binding ReportToastOpacity}" />

    <ContentControl
        x:Name="ReplaceSelectionModalHost"
        Grid.RowSpan="4"
        IsVisible="{Binding IsReplaceSelectionModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:ReplaceSelectionModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="CtrlRamFirmwareVersionModalHost"
        Grid.RowSpan="4"
        IsVisible="{Binding IsCtrlRamFirmwareVersionModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:CtrlRamFirmwareVersionModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="WorkflowContextSetupModalHost"
        Grid.RowSpan="4"
        IsVisible="{Binding IsWorkflowContextModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:WorkflowContextSetupModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="FirmwareIcMismatchModalHost"
        Grid.RowSpan="4"
        IsVisible="{Binding IsFirmwareIcMismatchModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:FirmwareIcMismatchModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl Grid.RowSpan="4" Content="{Binding LoadedHexEditorWorkspace}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:HexEditorWorkspaceViewModel">
          <views:HexEditorInsertBytesModal IsVisible="{Binding IsInsertBytesPromptOpen}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl Grid.RowSpan="4" Content="{Binding LoadedHexEditorWorkspace}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:HexEditorWorkspaceViewModel">
          <views:HexEditorSaveModal IsVisible="{Binding IsSaveConfirmationOpen}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <ContentControl
        x:Name="ReportModalHost"
        Grid.RowSpan="4"
        IsVisible="{Binding IsReportModalOpen}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
          <views:ReportModal />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</Window>
