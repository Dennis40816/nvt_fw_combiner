<Window
    x:Class="NvtFwCombiner.Presentation.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1180"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Background="#F5F7FA"
    Title="NVT FW Combiner">
  <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*,Auto">
    <Border
        Grid.RowSpan="3"
        Padding="24"
        Background="#111827">
      <StackPanel Spacing="18">
        <TextBlock
            FontSize="21"
            FontWeight="SemiBold"
            Foreground="White"
            Text="NVT FW Combiner" />
        <TextBlock
            Foreground="#CBD5E1"
            Text="0.1.1 demo shell" />
        <StackPanel Margin="0,18,0,0" Spacing="10">
          <TextBlock Foreground="White" Text="Home" />
          <TextBlock Foreground="#CBD5E1" Text="Merge" />
          <TextBlock Foreground="#CBD5E1" Text="Replace" />
          <TextBlock Foreground="#CBD5E1" Text="Saved Rules" />
          <TextBlock Foreground="#CBD5E1" Text="Reports" />
          <TextBlock Foreground="#CBD5E1" Text="Settings" />
          <TextBlock Foreground="#CBD5E1" Text="Diagnostics" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border
        Grid.Column="1"
        Padding="28,22"
        Background="White"
        BorderBrush="#D6DAE1"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock
              FontSize="26"
              FontWeight="SemiBold"
              Text="UI planning workspace" />
          <TextBlock
              Foreground="#475569"
              Text="Synthetic preview only. No firmware files are read and no external tool is executed." />
        </StackPanel>
        <Button
            Grid.Column="1"
            IsEnabled="False"
            Content="Build disabled until 0.2.0" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="1">
      <StackPanel Margin="28" Spacing="18">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <Border
              Margin="0,0,9,9"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Merge preview" />
              <TextBlock Foreground="#475569" Text="Modes: Standard / AB / General" />
              <TextBlock Text="Profile selector: demo-standard-merge" />
              <TextBlock Text="Inputs: DP demo.bin, TP demo.bin, optional LD placeholder" />
              <TextBlock Text="Preview: mapping and occupancy table supplied by application core later" />
              <TextBlock Foreground="#B45309" Text="Status: synthetic data, build blocked" />
            </StackPanel>
          </Border>

          <Border
              Grid.Column="1"
              Margin="9,0,0,9"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Replace preview" />
              <TextBlock Foreground="#475569" Text="Personas: Display / TP HW / TP FW / General" />
              <TextBlock Text="Reference BIN: synthetic metadata only" />
              <TextBlock Text="Regions: DP whole, TP whole, CtrlRAM, TP firmware groups as policy output" />
              <TextBlock Text="Preview: before/after changed ranges and protected warnings" />
              <TextBlock Foreground="#B45309" Text="Status: access policy display only" />
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              Margin="0,9,9,0"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Saved rules and reports" />
              <TextBlock Text="Saved rules: draft / candidate / supported" />
              <TextBlock Text="Reports: runId, inputs, operations, processor invocations, mutations, output" />
              <TextBlock Text="Promotion requires validation, compatibility review, and evidence." />
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              Grid.Column="1"
              Margin="9,9,0,0"
              Padding="18"
              Background="White"
              BorderBrush="#D6DAE1"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics" />
              <TextBlock Text="[info] Loaded candidate profile: demo-standard-merge" />
              <TextBlock Text="[info] Compiled 6 synthetic operations" />
              <TextBlock Text="[warn] Build disabled until Composition Core milestone" />
              <TextBlock Text="[info] Terminal pane is read-only and sanitized" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border
        Grid.Row="2"
        Grid.Column="1"
        Padding="28,10"
        Background="#F8FAFC"
        BorderBrush="#D6DAE1"
        BorderThickness="0,1,0,0">
      <TextBlock
          Foreground="#475569"
          Text="Profile catalog: demo only | Validation: preview unavailable | Diagnostics: read-only transcript | Firmware mutation: none" />
    </Border>
  </Grid>
</Window>
