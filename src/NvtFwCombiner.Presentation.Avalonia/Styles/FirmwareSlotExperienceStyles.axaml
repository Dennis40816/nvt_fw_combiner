<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.fileDropZone.firmwareSlot.compactExperience">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.compactExperience.hasFile">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Label.slotBadge.firmwareSlotRequirement.availableInput.optional">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.checking">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.checking /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.pendingInput, ToggleButton.slotStateAction.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.pendingInput /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.slotStateAction.warning /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.verified">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.verified /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.error">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.error /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.notApplicable">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.notApplicable /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:checked">
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:pointerover">
    <Setter Property="Opacity" Value="0.86" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:pressed, ToggleButton.quietDisclosure:pressed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction:disabled, ToggleButton.quietDisclosure:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Path.slotStateIcon, Path.firmwareSlotFactStateIcon">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.checking Path.slotStateIcon, Border.firmwareSlotFact.pendingInput Path.firmwareSlotFactStateIcon">
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.pendingInput Path.slotStateIcon, ToggleButton.slotStateAction.warning Path.slotStateIcon, Border.firmwareSlotFact.warning Path.firmwareSlotFactStateIcon">
    <Setter Property="Stroke" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.verified Path.slotStateIcon">
    <Setter Property="Stroke" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="ToggleButton.slotStateAction.error Path.slotStateIcon, Border.firmwareSlotFact.error Path.firmwareSlotFactStateIcon">
    <Setter Property="Stroke" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="TextBlock.slotStateDetail">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.quietDisclosure">
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
  </Style>
  <Style Selector="ToggleButton.quietDisclosure /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.quietDisclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.quietDisclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
  </Style>
  <Style Selector="ToggleButton.quietDisclosure:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.quietDisclosure:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.firmwareSlotFact.pendingInput">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
  </Style>
  <Style Selector="Border.firmwareSlotFact.unknown">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
  </Style>
  <Style Selector="Border.firmwareSlotFact.error">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerBorderBrush}" />
  </Style>
  <Style Selector="Border.firmwareSlotFact.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="Path.firmwareSlotFactStateIcon:focus-visible">
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="StrokeThickness" Value="2.8" />
  </Style>
</Styles>
