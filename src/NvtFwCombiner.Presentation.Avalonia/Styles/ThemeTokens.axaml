<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="NfcAppBackgroundBrush" Color="#F4F6FA" />
  <SolidColorBrush x:Key="NfcSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NfcSurfaceSubtleBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="NfcSelectionSurfaceBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="NfcBorderBrush" Color="#CBD5E1" />
  <SolidColorBrush x:Key="NfcBorderMutedBrush" Color="#E2E8F0" />
  <SolidColorBrush x:Key="NfcBorderSoftBrush" Color="#D7E1ED" />
  <SolidColorBrush x:Key="NfcDividerBrush" Color="#EEF2F7" />
  <SolidColorBrush x:Key="NfcTextStrongBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="NfcTextBrush" Color="#334155" />
  <SolidColorBrush x:Key="NfcTextSecondaryBrush" Color="#475569" />
  <SolidColorBrush x:Key="NfcTextMutedBrush" Color="#64748B" />
  <SolidColorBrush x:Key="NfcTextDisabledBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="NfcAccentBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="NfcAccentStrongBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="NfcAccentSurfaceBrush" Color="#EAF3FF" />
  <SolidColorBrush x:Key="NfcAccentSurfaceSubtleBrush" Color="#EFF6FF" />
  <SolidColorBrush x:Key="NfcAccentBorderBrush" Color="#93C5FD" />
  <SolidColorBrush x:Key="NfcAccentBorderStrongBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="NfcAccentBorderLightBrush" Color="#BFDBFE" />
  <SolidColorBrush x:Key="NfcSuccessSurfaceBrush" Color="#F0FDF4" />
  <SolidColorBrush x:Key="NfcSuccessBorderBrush" Color="#BBF7D0" />
  <SolidColorBrush x:Key="NfcSuccessAccentBrush" Color="#16A34A" />
  <SolidColorBrush x:Key="NfcSuccessTextStrongBrush" Color="#14532D" />
  <SolidColorBrush x:Key="NfcSuccessTextBrush" Color="#166534" />
  <SolidColorBrush x:Key="NfcInfoSurfaceBrush" Color="#EEF4FA" />
  <SolidColorBrush x:Key="NfcInfoSurfaceStrongBrush" Color="#DBEAFE" />
  <SolidColorBrush x:Key="NfcInfoBorderBrush" Color="#D7E2F1" />
  <SolidColorBrush x:Key="NfcInfoTextBrush" Color="#0F766E" />
  <SolidColorBrush x:Key="NfcInfoTextStrongBrush" Color="#1E3A8A" />
  <SolidColorBrush x:Key="NfcWarningSurfaceBrush" Color="#FFF7ED" />
  <SolidColorBrush x:Key="NfcWarningBorderBrush" Color="#FED7AA" />
  <SolidColorBrush x:Key="NfcWarningAccentBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="NfcWarningAccentStrongBrush" Color="#D97706" />
  <SolidColorBrush x:Key="NfcWarningAccentCriticalBrush" Color="#EA580C" />
  <SolidColorBrush x:Key="NfcWarningTextSubtleBrush" Color="#7C2D12" />
  <SolidColorBrush x:Key="NfcWarningTextMutedBrush" Color="#B45309" />
  <SolidColorBrush x:Key="NfcWarningTextBrush" Color="#9A3412" />
  <SolidColorBrush x:Key="NfcWarningBorderStrongBrush" Color="#FDBA74" />
  <SolidColorBrush x:Key="NfcWarningTextStrongBrush" Color="#C2410C" />
  <SolidColorBrush x:Key="NfcCautionSurfaceBrush" Color="#FFFBEB" />
  <SolidColorBrush x:Key="NfcCautionBorderBrush" Color="#FCD34D" />
  <SolidColorBrush x:Key="NfcCautionTextBrush" Color="#92400E" />
  <SolidColorBrush x:Key="NfcDangerSurfaceBrush" Color="#FFF7F7" />
  <SolidColorBrush x:Key="NfcDangerBorderBrush" Color="#FECACA" />
  <SolidColorBrush x:Key="NfcDangerTextBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="NfcDangerSurfaceMutedBrush" Color="#FFF1F2" />
  <SolidColorBrush x:Key="NfcDangerBorderStrongBrush" Color="#FDA4AF" />
  <SolidColorBrush x:Key="NfcDangerTextStrongBrush" Color="#BE123C" />
  <SolidColorBrush x:Key="NfcCriticalSurfaceBrush" Color="#FEF2F2" />
  <SolidColorBrush x:Key="NfcCriticalBorderBrush" Color="#DC2626" />
  <CornerRadius x:Key="NfcCompactCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="NfcSurfaceCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="NfcPillCornerRadius">999</CornerRadius>
  <x:Double x:Key="NfcSpace2">2</x:Double>
  <x:Double x:Key="NfcSpace4">4</x:Double>
  <x:Double x:Key="NfcSpace8">8</x:Double>
  <x:Double x:Key="NfcSpace12">12</x:Double>
  <x:Double x:Key="NfcSpace16">16</x:Double>
  <x:Double x:Key="NfcFontSize10">10</x:Double>
  <x:Double x:Key="NfcFontSize11">11</x:Double>
  <x:Double x:Key="NfcFontSize12">12</x:Double>
  <x:Double x:Key="NfcFontSize13">13</x:Double>
  <x:Double x:Key="NfcFontSize14">14</x:Double>
  <FontFamily x:Key="NfcUiFontFamily">fonts:Inter#Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC, Segoe UI</FontFamily>
  <FontFamily x:Key="NfcTechnicalFontFamily">Cascadia Mono, Consolas</FontFamily>
  <BoxShadows x:Key="NfcWorkflowCardHoverShadow">0 6 14 0 #143B821A</BoxShadows>
  <BoxShadows x:Key="NfcWorkflowCardPressedShadow">0 1 4 0 #143B8214</BoxShadows>
  <SolidColorBrush x:Key="NfcModalScrimBrush" Color="#660F172A" />
  <SolidColorBrush x:Key="NfcReportModalScrimBrush" Color="#990F172A" />
  <SolidColorBrush x:Key="NfcHexEditorAccentBrush" Color="#6366F1" />
</ResourceDictionary>
