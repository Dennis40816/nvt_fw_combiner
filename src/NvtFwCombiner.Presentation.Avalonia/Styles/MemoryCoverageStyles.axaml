<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.memoryInfoPanel">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryPanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="TextBlock.memoryInfoDescription">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.memoryInfoAddress">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryAddressSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryAddressBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.memoryInfoAddressText">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryAddressTextBrush}" />
  </Style>
  <Style Selector="TextBlock.memoryInfoRangeSummary">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.memoryInfoRangeGroup">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryAddressTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.memoryInfoRow">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryDividerBrush}" />
  </Style>
  <Style Selector="TextBlock.memoryCoverageStateText">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.memorySupportingRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.memoryCoverageLinkedRow.linked">
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource NfcMemoryInteractionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="{DynamicResource NfcMemoryRowHoverShadow}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
    <Setter Property="Panel.ZIndex" Value="2" />
  </Style>
  <Style Selector="Border.memoryInfoRangeList">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.memoryInfoRangeList.multiple">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource NfcMemoryAddressSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryAddressBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryNeutralFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageMarker">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.memoryCoverageBarSegment">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.memoryCoverageBarSegment.linked">
    <Setter Property="BoxShadow" Value="{DynamicResource NfcMemorySegmentHoverShadow}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="RenderTransform" Value="scaleY(1.18)" />
    <Setter Property="Panel.ZIndex" Value="3" />
  </Style>
  <Style Selector="Border.memoryCoverageLinkedRow:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="Border.memoryCoverageLinkedRow.linked.reducedMotion, Border.memoryCoverageBarSegment.linked.reducedMotion"><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="Border.memoryExplorerSlice.linked, Border.memoryExplorerGroup.active">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="RenderTransform" Value="scaleY(1.18)" />
    <Setter Property="BoxShadow" Value="{DynamicResource NfcMemorySegmentHoverShadow}" />
    <Setter Property="Panel.ZIndex" Value="3" />
  </Style>
  <Style Selector="Border.memoryExplorerSlice, Border.memoryExplorerGroup">
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" /></Transitions></Setter>
  </Style>
  <Style Selector="Border.memoryExplorerSlice.reducedMotion, Border.memoryExplorerGroup.reducedMotion">
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <!-- Position markers are quiet navigation anchors, not floating memory slices. -->
  <Style Selector="Border.memoryFocusPosition">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Border.memoryFocusPosition.active">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryInteractionSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Border.memoryFocusPosition TextBlock.memoryPositionLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.memoryFocusPosition.active TextBlock.memoryPositionLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Border.memoryFocusPosition Border.memoryPositionUnderline"><Setter Property="Opacity" Value="0.4" /></Style>
  <Style Selector="Border.memoryFocusPosition.active Border.memoryPositionUnderline"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector=":is(Control).memoryHoverOnly"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.memoryFocusSlice.linked.reducedMotion"><Setter Property="RenderTransform" Value="none" /></Style>
  <Style Selector="Border#MemorySliceCard :is(Control).memoryHoverOnly"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Border#MemorySliceCard TextBlock.memoryInfoDescription, Border#MemorySliceCard Border#MemoryTechnicalSeparator"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="Border.memoryCoverageFill.dp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryDpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.tp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryTpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.tpBackup">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryTpBackupFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ldc">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryLdcFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.source">
    <Setter Property="Background" Value="{DynamicResource NfcMemorySourceFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.kept">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryKeptFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.conflict">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryConflictFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRam">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamNf">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamNfFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamNormal">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamNormalFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamMp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamMpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamVn">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamVnFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamVector">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamVectorFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.diffDlm">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryDiffDlmFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageMarker.changed">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
