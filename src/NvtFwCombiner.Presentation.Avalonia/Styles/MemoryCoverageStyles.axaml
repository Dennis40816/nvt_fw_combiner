<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">
  <Style Selector="Border.memoryInfoPanel">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryPanelSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryPanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="TextBlock.memoryInfoDescription">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.memoryInfoAddress">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryAddressSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryAddressBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.memoryInfoAddressText">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryAddressTextBrush}" />
  </Style>
  <Style Selector="views|SpaciousPanel.memoryCoverageGroup">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource NfcMemoryAddressSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryAddressBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="TextBlock.memoryInfoRangeSummary">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.memoryInfoRangeGroup">
    <Setter Property="Foreground" Value="{DynamicResource NfcMemoryAddressTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.memoryInfoRow">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryDividerBrush}" />
  </Style>
  <Style Selector="Border.memoryInfoRangeList">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.memoryInfoRangeList.multiple">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource NfcMemoryAddressSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemoryAddressBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryNeutralFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageMarker">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.memoryCoverageBarSegment">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcMemorySegmentDividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.dp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryDpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.tp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryTpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.tpBackup">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryTpBackupFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ldc">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryLdcFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.source">
    <Setter Property="Background" Value="{DynamicResource NfcMemorySourceFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.kept">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryKeptFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.conflict">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryConflictFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRam">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamNf">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamNfFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamNormal">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamNormalFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamMp">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamMpFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamVn">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamVnFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.ctrlRamVector">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryCtrlRamVectorFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageFill.diffDlm">
    <Setter Property="Background" Value="{DynamicResource NfcMemoryDiffDlmFillBrush}" />
  </Style>
  <Style Selector="Border.memoryCoverageMarker.changed">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
