<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:views="using:NvtFwCombiner.Presentation.Avalonia.Views">
  <!-- Semantic visual roles shared by pages, report templates, and modal views. -->
  <Style Selector="Border.surface, Border.modalSurface, Border.fileDropZone">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.panelSurface">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.subtleSurface">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.insetSurface">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.compactSurface">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.compactSubtleSurface, Border.statusNotice, Border.reportHexDiffViewport">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="TextBox.buildSettingInput">
    <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
  </Style>
  <Style Selector="TextBox.buildSettingInput.editable:pointerover"><Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" /></Style>
  <Style Selector="TextBox.buildSettingInput.editable:focus"><Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" /></Style>
  <Style Selector="CheckBox.buildSettingChoice">
    <Setter Property="Padding" Value="6,4" /><Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="CheckBox.buildSettingChoice:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Border.subtlePanel">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.warningSurface">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.diagnosticCard:focus-visible, Border.buildBlockerBadge:focus-visible, Border.supportMatrixCell:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.statusNotice.info">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
  </Style>
  <Style Selector="Border.statusNotice.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderBrush}" />
  </Style>
  <Style Selector="Border.statusNotice.error">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcRequiredMissingBorderBrush}" />
  </Style>
  <Style Selector="Border.statusNotice Border.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="Border.statusNotice Border.error">
    <Setter Property="Background" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="Border.supportMatrixWorkflowHeader">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.supportMatrixIcHeader">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.supportMatrixCell, Border.shellBar">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.supportMatrixCell.reviewed, Border.supportMatrixCell.contract">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Border.supportMatrixCell.review">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
  </Style>
  <Style Selector="Border.supportMatrixCell.blocked">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
  </Style>
  <Style Selector="Border.supportMatrixCell.notDeclared">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
  </Style>
  <Style Selector="Border.supportMatrixCell:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.supportMatrixHoverRoute">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.supportMatrixVariantCount">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.supportMatrixNotDeclared">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Width" Value="14" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend.reviewed">
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessTextBrush}" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend.contract">
    <Setter Property="Foreground" Value="{DynamicResource NfcInfoTextBrush}" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend.review, Border.firmwareSlotFact.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend.blocked">
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="TextBlock.supportMatrixLegend.notDeclared">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>
  <Style Selector="Border.successInset">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.mappingIndex">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.optional">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.hasFile">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcRequiredSelectedBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.hasFile.pending">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.hasFile.valid">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcRequiredSelectedBorderBrush}" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot.hasFile.warning, Border.firmwareSlotFact.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderStrongBrush}" />
  </Style>
  <Style Selector="Border.fileDropZone.firmwareSlot, Border.fileDropZone.firmwareSlot.hasFile.blocking">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcRequiredMissingBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.icDetailCard">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.icDetailHeroIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Path.icDetailHeroGlyph">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeThickness" Value="1.4" />
  </Style>
  <Style Selector="Path.icDetailRowIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeThickness" Value="1.45" />
  </Style>
  <Style Selector="Border.toastSurface">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.homePreviewSurface">
    <Setter Property="MinHeight" Value="306" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.roomyPanel">
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.contentPanel">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="views|SpaciousPanel">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="views|SpaciousPanel.compact">
    <Setter Property="Padding" Value="4,4,8,4" />
  </Style>
  <Style Selector="ItemsControl.spaciousList">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="{DynamicResource NfcSpace8}" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.listRow">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.reportInputGroupHeader">
    <Setter Property="Margin" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.reportInputRow">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.settingRow">
    <Setter Property="Padding" Value="0,0,0,9" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.settingsNavigationSurface">
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.settingsOptionRow">
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.pageSubtitle, TextBlock.supportingText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.previewTitle">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.modalTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize14}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.strongText">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.compactTitle">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.tableHeader">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize10}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.bodyText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="TextBlock.bodyStrongText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.bodyEmphasisText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="TextBlock.detailText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.readinessText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.mutedText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.captionText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.infoText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.microInfoText">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize10}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.monoText">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="TextBlock.technicalCaption">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize10}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.technicalMeta">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.technicalDetail">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="TextBlock.technicalValue">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.technicalCompactDetail">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="TextBlock.technicalCompactValue">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.mappingIndex">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>

  <Style Selector="Label.compactBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Label.neutralBadge">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize10}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="Label.reportBadge">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Label.reportBadge.success">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessTextBrush}" />
  </Style>
  <Style Selector="Label.reportBadge.review">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}" />
  </Style>
  <Style Selector="Label.reportBadge.info, Label.slotBadge.firmwareSlotRequirement.optional">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Label.reportBadge.large">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
  </Style>
  <Style Selector="Label.slotBadge">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
  </Style>
  <Style Selector="Label.slotBadge.firmwareSlotRequirement">
    <Setter Property="Background" Value="{DynamicResource NfcRequiredMissingBadgeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}" />
  </Style>
  <Style Selector="Label.slotBadge.firmwareSlotRequirement.hasFile">
    <Setter Property="Background" Value="{DynamicResource NfcRequiredSelectedBadgeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="Border.firmwareSlotFact">
    <Setter Property="Background" Value="{DynamicResource NfcSlotFactSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
  </Style>
  <Style Selector="TextBlock.firmwareSlotFactLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.firmwareSlotFactValue">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Label.countBadge">
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Label.countBadge.changed">
    <Setter Property="Background" Value="{DynamicResource NfcWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextStrongBrush}" />
  </Style>
  <Style Selector="Label.countBadge.coverageChangeBadge">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="Label.countBadge.coverageChangeBadge.changed">
    <Setter Property="Background" Value="{DynamicResource NfcInfoSurfaceStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.hexInspectorSection">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.reportHexDiffRanges">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.reportHexDiffRanges ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.reportHexDiffRanges ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleSwitch.reportHexDiffOriginalToggle, ToggleSwitch.hexWriteModeToggle">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.hexInspectorHint">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="Border.hexInspectorHint.error">
    <Setter Property="Background" Value="{DynamicResource NfcDangerSurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerBorderStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.hexInspectorNotice.error">
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextStrongBrush}" />
  </Style>
  <Style Selector="Button.hexChangedBlockNavigator">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NfcCautionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcCautionBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource NfcCautionTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.hexChangedBlockNavigator /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="Button.hexChangedBlockNavigator:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.hexChangedBlockRow">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.hexChangedBlockRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.hexChangedBlockRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.hexWriteModeLabel">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.hexApplyChange">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
  </Style>
  <Style Selector="Button.hexInspectorAction">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Button.hexInspectorAction Path">
    <Setter Property="Stroke" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hexInspectorAction:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentBrush}" />
  </Style>
  <Style Selector="Button.hexInspectorAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
  </Style>
  <Style Selector="Button.hexInspectorAction:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>

  <Style Selector="TextBox.readOnlyRaw">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="TextBox.hexCellEditor">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="TextBox.hexCellEditor.invalid">
    <Setter Property="Background" Value="{DynamicResource NfcCriticalSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcCriticalBorderBrush}" />
  </Style>
</Styles>
