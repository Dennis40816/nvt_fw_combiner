<Styles xmlns="https://github.com/avaloniaui">
  <!-- Semantic visual roles shared by pages, report templates, and modal views. -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.panelSurface">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.modalSurface">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.subtleSurface">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.insetSurface">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.compactSurface">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.compactSubtleSurface">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.subtlePanel">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.warningSurface">
    <Setter Property="Background" Value="#FFF7ED" />
    <Setter Property="BorderBrush" Value="#FED7AA" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.successSurface">
    <Setter Property="Background" Value="#F0FDF4" />
    <Setter Property="BorderBrush" Value="#BBF7D0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.successInset">
    <Setter Property="Background" Value="#F0FDF4" />
    <Setter Property="BorderBrush" Value="#BBF7D0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.mappingIndex">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Border.footerStatus">
    <Setter Property="Padding" Value="28,9" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.modalTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.compactTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="TextBlock.tableHeader">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.bodyText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>
  <Style Selector="TextBlock.detailText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#475569" />
  </Style>
  <Style Selector="TextBlock.readinessText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#475569" />
  </Style>
  <Style Selector="TextBlock.mutedText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.captionText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.monoText">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style Selector="TextBlock.mappingIndex">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>

  <Style Selector="Label.reportBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>
  <Style Selector="Label.reportBadge.success">
    <Setter Property="Background" Value="#F0FDF4" />
    <Setter Property="BorderBrush" Value="#BBF7D0" />
    <Setter Property="Foreground" Value="#166534" />
  </Style>
  <Style Selector="Label.reportBadge.review">
    <Setter Property="Background" Value="#FFF7ED" />
    <Setter Property="BorderBrush" Value="#FED7AA" />
    <Setter Property="Foreground" Value="#9A3412" />
  </Style>
  <Style Selector="Label.reportBadge.info">
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#BFDBFE" />
    <Setter Property="Foreground" Value="#1D4ED8" />
  </Style>
  <Style Selector="Label.reportBadge.large">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Label.slotBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Label.countBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>

  <Style Selector="TextBox.readOnlyRaw">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#0F172A" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
</Styles>
