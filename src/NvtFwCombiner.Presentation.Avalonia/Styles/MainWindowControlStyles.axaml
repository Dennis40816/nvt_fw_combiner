<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Shared semantic palette. Keep visual roles below; do not encode firmware state here. -->
    <SolidColorBrush x:Key="UiBrush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UiBrush.SubtleSurface" Color="#F8FAFC" />
    <SolidColorBrush x:Key="UiBrush.AccentSurface" Color="#EFF6FF" />
    <SolidColorBrush x:Key="UiBrush.AccentSelectedSurface" Color="#EAF3FF" />
    <SolidColorBrush x:Key="UiBrush.WarningSurface" Color="#FFF7ED" />
    <SolidColorBrush x:Key="UiBrush.DangerSurface" Color="#FFF7F7" />
    <SolidColorBrush x:Key="UiBrush.SuccessSurface" Color="#F0FDF4" />
    <SolidColorBrush x:Key="UiBrush.DisabledSurface" Color="#E2E8F0" />
    <SolidColorBrush x:Key="UiBrush.AccentSoftSurface" Color="#BFDBFE" />
    <SolidColorBrush x:Key="UiBrush.Border" Color="#CBD5E1" />
    <SolidColorBrush x:Key="UiBrush.SubtleBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="UiBrush.RowDivider" Color="#EEF2F7" />
    <SolidColorBrush x:Key="UiBrush.AccentBorder" Color="#93C5FD" />
    <SolidColorBrush x:Key="UiBrush.AccentStrongBorder" Color="#60A5FA" />
    <SolidColorBrush x:Key="UiBrush.AccentSoftBorder" Color="#BFDBFE" />
    <SolidColorBrush x:Key="UiBrush.WarningBorder" Color="#FED7AA" />
    <SolidColorBrush x:Key="UiBrush.DangerBorder" Color="#FECACA" />
    <SolidColorBrush x:Key="UiBrush.SuccessBorder" Color="#BBF7D0" />
    <SolidColorBrush x:Key="UiBrush.TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="UiBrush.TextSecondary" Color="#334155" />
    <SolidColorBrush x:Key="UiBrush.TextMuted" Color="#64748B" />
    <SolidColorBrush x:Key="UiBrush.TextSubtle" Color="#475569" />
    <SolidColorBrush x:Key="UiBrush.TextDisabled" Color="#94A3B8" />
    <SolidColorBrush x:Key="UiBrush.TextDisabledMuted" Color="#CBD5E1" />
    <SolidColorBrush x:Key="UiBrush.TextOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UiBrush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="UiBrush.AccentStrong" Color="#1D4ED8" />
    <SolidColorBrush x:Key="UiBrush.TextWarning" Color="#9A3412" />
    <SolidColorBrush x:Key="UiBrush.WarningDetail" Color="#7C2D12" />
    <SolidColorBrush x:Key="UiBrush.WarningMeta" Color="#B45309" />
    <SolidColorBrush x:Key="UiBrush.TextDanger" Color="#B91C1C" />
    <SolidColorBrush x:Key="UiBrush.TextSuccess" Color="#166534" />
    <SolidColorBrush x:Key="UiBrush.SuccessIndicator" Color="#16A34A" />
    <SolidColorBrush x:Key="UiBrush.ModalOverlay" Color="#660F172A" />
    <SolidColorBrush x:Key="UiBrush.StrongModalOverlay" Color="#990F172A" />
  </Styles.Resources>

  <!-- Semantic visual roles shared by pages, report templates, and modal views. -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.panelSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.modalSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.subtleSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.insetSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.compactSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.compactSubtleSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.subtlePanel">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.warningSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.WarningSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.WarningBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.successSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SuccessSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SuccessBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.successInset">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SuccessSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SuccessBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.mappingIndex">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Border.footerStatus">
    <Setter Property="Padding" Value="28,9" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.shellBar">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toastSurface">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentSoftBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.homePreviewSurface">
    <Setter Property="MinHeight" Value="306" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.roomyPanel">
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.contentPanel">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.listRow">
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.RowDivider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.reportInputGroupHeader">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentSoftBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.reportInputRow">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.settingRow">
    <Setter Property="Padding" Value="0,0,0,9" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.RowDivider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.previewTitle">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.modalTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.strongText">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.compactTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.compactStrongText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.tableHeader">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.bodyText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.bodyStrongText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.bodyEmphasisText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.detailText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSubtle}" />
  </Style>
  <Style Selector="TextBlock.readinessText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSubtle}" />
  </Style>
  <Style Selector="TextBlock.mutedText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.captionText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.supportingText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.infoText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.Accent}" />
  </Style>
  <Style Selector="TextBlock.microInfoText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.Accent}" />
  </Style>
  <Style Selector="TextBlock.monoText">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style Selector="TextBlock.technicalHeader">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.technicalCaption">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.technicalMeta">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.technicalDetail">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.technicalValue">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.technicalCompactDetail">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.technicalCompactValue">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.mappingIndex">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>

  <Style Selector="Label.reportBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="Label.reportBadge.success">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SuccessSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SuccessBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSuccess}" />
  </Style>
  <Style Selector="Label.reportBadge.review">
    <Setter Property="Background" Value="{DynamicResource UiBrush.WarningSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.WarningBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextWarning}" />
  </Style>
  <Style Selector="Label.reportBadge.info">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSelectedSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentSoftBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.AccentStrong}" />
  </Style>
  <Style Selector="Label.reportBadge.large">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Label.slotBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Label.countBadge">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="Label.countBadge.changed">
    <Setter Property="Background" Value="{DynamicResource UiBrush.WarningSurface}" />
    <Setter Property="BorderBrush" Value="#FDBA74" />
    <Setter Property="Foreground" Value="#C2410C" />
  </Style>
  <Style Selector="TextBlock.hexInspectorSection">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSubtle}" />
  </Style>
  <Style Selector="Border.hexInspectorHint">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="#D7E1ED" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.hexInspectorHint.error">
    <Setter Property="Background" Value="#FFF1F2" />
    <Setter Property="BorderBrush" Value="#FDA4AF" />
  </Style>
  <Style Selector="TextBlock.hexInspectorNotice.error">
    <Setter Property="Foreground" Value="#BE123C" />
  </Style>
  <Style Selector="Button.hexChangedBlockNavigator">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#FFFBEB" />
    <Setter Property="BorderBrush" Value="#FCD34D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="#92400E" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.hexChangedBlockNavigator:disabled">
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextDisabled}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.hexChangedBlockRow">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.SubtleBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.hexChangedBlockRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSurface}" />
  </Style>
  <Style Selector="TextBlock.hexWriteModeLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.AccentStrong}" />
  </Style>
  <Style Selector="ToggleSwitch.hexWriteModeToggle">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hexApplyChange">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.hexInspectorAction">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Button.hexInspectorAction Path">
    <Setter Property="Stroke" Value="{DynamicResource UiBrush.TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hexInspectorAction:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource UiBrush.Accent}" />
  </Style>
  <Style Selector="Button.hexInspectorAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentBorder}" />
  </Style>
  <Style Selector="Button.hexInspectorAction:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource UiBrush.TextDisabled}" />
  </Style>

  <Style Selector="TextBox.readOnlyRaw">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="TextBox.hexCellEditor">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="TextBox.hexCellEditor.invalid">
    <Setter Property="Background" Value="#FEF2F2" />
    <Setter Property="BorderBrush" Value="#DC2626" />
  </Style>
</Styles>
