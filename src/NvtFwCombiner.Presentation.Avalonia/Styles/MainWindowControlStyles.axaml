  <Style Selector="TextBlock.bodyEmphasisText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>
  <Style Selector="TextBlock.detailText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#475569" />
  </Style>
  <Style Selector="TextBlock.readinessText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#475569" />
  </Style>
  <Style Selector="TextBlock.mutedText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.captionText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.supportingText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>
  <Style Selector="TextBlock.infoText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#2563EB" />
  </Style>
  <Style Selector="TextBlock.microInfoText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#2563EB" />
