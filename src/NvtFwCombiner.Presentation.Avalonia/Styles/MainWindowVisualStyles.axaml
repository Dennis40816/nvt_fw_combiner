<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.slotTypeIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.slotTypeIcon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.65" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Border.workflowCard">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#D7E1ED" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowCard">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#60A5FA" />
    <Setter Property="BoxShadow" Value="0 6 14 0 #143B821A" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowCard">
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#2563EB" />
    <Setter Property="BoxShadow" Value="0 1 4 0 #143B8214" />
  </Style>
  <Style Selector="Border.workflowOpenPill">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#BFDBFE" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="#1D4ED8" />
  </Style>
  <Style Selector="Grid.hexRow.changedRow">
    <Setter Property="Background" Value="#FFFBEB" />
  </Style>
  <Style Selector="Grid.hexRow.referenceRow">
    <Setter Property="Background" Value="#F8FAFC" />
  </Style>
  <Style Selector="Border.hexCell">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.hexCell TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#334155" />
  </Style>
  <Style Selector="Border.hexCell:pointerover">
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#BFDBFE" />
  </Style>
  <Style Selector="Border.hexCell:pointerover TextBlock">
    <Setter Property="Foreground" Value="#1D4ED8" />
  </Style>
  <Style Selector="Border.hexCell.changed">
    <Setter Property="Background" Value="#FEF3C7" />
    <Setter Property="BorderBrush" Value="#FDE68A" />
  </Style>
  <Style Selector="Border.hexCell.changed TextBlock">
    <Setter Property="Foreground" Value="#92400E" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.hexCell.selected">
    <Setter Property="Background" Value="#DBEAFE" />
    <Setter Property="BorderBrush" Value="#2563EB" />
  </Style>
  <Style Selector="Border.hexCell.selected TextBlock">
    <Setter Property="Foreground" Value="#1D4ED8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill">
    <Setter Property="Background" Value="#2563EB" />
    <Setter Property="BorderBrush" Value="#2563EB" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill">
    <Setter Property="Background" Value="#1D4ED8" />
    <Setter Property="BorderBrush" Value="#1D4ED8" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="#EFF6FF" />
    <Setter Property="BorderBrush" Value="#2563EB" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.fileDropZone.dragActive Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
</Styles>
