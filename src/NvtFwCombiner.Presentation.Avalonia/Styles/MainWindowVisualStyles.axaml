<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.slotTypeIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.slotTypeIcon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.65" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Border.workflowCard">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.SubtleSurface}" />
    <Setter Property="BorderBrush" Value="#D7E1ED" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowCard">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentStrongBorder}" />
    <Setter Property="BoxShadow" Value="0 6 14 0 #143B821A" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowCard">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSelectedSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Accent}" />
    <Setter Property="BoxShadow" Value="0 1 4 0 #143B8214" />
  </Style>
  <Style Selector="Border.workflowOpenPill">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSelectedSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentSoftBorder}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.AccentStrong}" />
  </Style>
  <Style Selector="TextBlock.hexGridHeader">
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.hexGridHeader.selected">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSoftSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.AccentStrong}" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill">
    <Setter Property="Background" Value="{DynamicResource UiBrush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Accent}" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextOnAccent}" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill">
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentStrong}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.AccentStrong}" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiBrush.TextOnAccent}" />
  </Style>
  <Style Selector="Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource UiBrush.AccentSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiBrush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.fileDropZone.dragActive Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
</Styles>
