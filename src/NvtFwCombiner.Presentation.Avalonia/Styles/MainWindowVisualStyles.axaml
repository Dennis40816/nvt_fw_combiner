<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Border.slotTypeIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.slotTypeIcon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.65" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Border.workflowCard">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderSoftBrush}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowCard">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource NfcWorkflowCardHoverShadow}" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowCard">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource NfcWorkflowCardPressedShadow}" />
  </Style>
  <Style Selector="Border.workflowOpenPill">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.hexGridHeader">
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="TextBlock.hexGridHeader.selected">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
  </Style>
  <Style Selector="Button.command:pointerover Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill">
    <Setter Property="Background" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.command:pressed Border.workflowOpenPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.fileDropZone.dragActive Border.dropZoneOverlay">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
</Styles>
