<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:input="using:Avalonia.Input">
  <Style Selector="Border.runProgressNode">
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.runProgressNode.completed">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.runProgressMarker">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.completed TextBlock.runProgressMarker">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.active TextBlock.runProgressMarker">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="TabControl.reportTabs">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander#OptionalPreloadFocusTarget /template/ ToggleButton">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding $parent[Expander].(AutomationProperties.Name)}" />
  </Style>
  <Style Selector="Expander /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.segment TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.versionChoice">
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="ToggleButton.versionChoice /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.versionChoice Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="ToggleButton.versionChoice:checked Path">
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Border.versionSummaryCard">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="Border.versionValueBadge">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="TextBlock.versionValue">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize14}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBox.technicalSelect">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="ComboBox.technicalSelect ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="Width" Value="180" />
  </Style>
  <Style Selector="TextBox.technicalCenteredInput">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="input:InputMethod.IsInputMethodEnabled" Value="False" />
  </Style>
  <Style Selector="TextBox.addressInput">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="Address" />
  </Style>
  <Style Selector="TextBox.hexByteInput">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MaxLength" Value="2" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="ByteSequence" />
  </Style>
</Styles>
