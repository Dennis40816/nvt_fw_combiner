<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:input="using:Avalonia.Input">
  <Style Selector="Border.runProgressNode">
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.runProgressNode.completed">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TabControl.reportTabs">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.segment TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBox.technicalSelect">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="ComboBox.technicalSelect ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="Width" Value="180" />
  </Style>
  <Style Selector="TextBox.technicalCenteredInput">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="input:InputMethod.IsInputMethodEnabled" Value="False" />
  </Style>
  <Style Selector="TextBox.addressInput">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="Address" />
  </Style>
  <Style Selector="TextBox.hexByteInput">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MaxLength" Value="2" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="ByteSequence" />
  </Style>
</Styles>
