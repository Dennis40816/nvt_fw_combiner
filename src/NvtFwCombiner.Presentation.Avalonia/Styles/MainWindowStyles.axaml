<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:input="using:Avalonia.Input">
  <Style Selector="TabControl.reportTabs">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#475569" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem:selected TextBlock">
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="#475569" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Background" Value="#F1F5F9" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="Foreground" Value="#0F172A" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F1F5F9" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
  </Style>
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#334155" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ToggleButton.segment TextBlock">
    <Setter Property="Foreground" Value="#334155" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#60A5FA" />
    <Setter Property="Foreground" Value="#0F172A" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EAF3FF" />
    <Setter Property="BorderBrush" Value="#60A5FA" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ToggleButton.segment:checked TextBlock">
    <Setter Property="Foreground" Value="#0F172A" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="FontFamily" Value="Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="Inter, Microsoft JhengHei UI, Noto Sans CJK TC, Noto Sans TC" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox.technicalSelect">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style Selector="ComboBox.technicalSelect ComboBoxItem">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="Width" Value="180" />
  </Style>
  <Style Selector="TextBox.addressInput">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="Address" />
    <Setter Property="input:InputMethod.IsInputMethodEnabled" Value="False" />
  </Style>
  <Style Selector="TextBox.hexByteInput">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="MaxLength" Value="2" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="ByteSequence" />
    <Setter Property="input:InputMethod.IsInputMethodEnabled" Value="False" />
  </Style>
</Styles>
