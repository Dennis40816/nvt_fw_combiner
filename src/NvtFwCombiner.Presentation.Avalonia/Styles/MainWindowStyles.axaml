<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:NvtFwCombiner.Presentation.Avalonia.Behaviors"
    xmlns:input="using:Avalonia.Input">
  <Style Selector="Border.runProgressNode">
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.runProgressNode.completed">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessEmphasisBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.runProgressMarker">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Border.runProgressNode.completed TextBlock.runProgressMarker, Border.runProgressNode.active TextBlock.runProgressMarker">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="TabControl.reportTabs">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.reportTabs TabItem:selected /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:checked TextBlock">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander#OptionalPreloadFocusTarget /template/ ToggleButton">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding $parent[Expander].(AutomationProperties.Name)}" />
  </Style>
  <Style Selector="Expander /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.inlineDisclosure">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.inlineDisclosure">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize14}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.inlineDisclosure:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.inlineDisclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.inlineDisclosure:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander.inlineDisclosure /template/ ToggleButton, Expander.inlineDisclosure /template/ ToggleButton:checked, ToggleButton.inlineDisclosure, ToggleButton.inlineDisclosure:checked">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Expander.inlineDisclosure /template/ ToggleButton:pointerover, Expander.inlineDisclosure /template/ ToggleButton:checked:pointerover, ToggleButton.inlineDisclosure:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
  </Style>
  <Style Selector="Expander.inlineDisclosure /template/ ToggleButton:pressed, ToggleButton.inlineDisclosure:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="Expander.inlineDisclosure /template/ ToggleButton:focus-visible, ToggleButton.inlineDisclosure:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ Border#ExpanderContent">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader:pointerover, Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader:checked:pointerover, Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader:pressed">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Expander.firmwareSlotGroupDisclosure /template/ ToggleButton#ExpanderHeader:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <!-- Input groups retain a stable keyboard focus underline, without horizontal
       border/padding insets or changing the shared technical-detail disclosure. -->
  <Style Selector="Expander.firmwareInputGroupDisclosure /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Expander.firmwareInputGroupDisclosure /template/ ToggleButton#ExpanderHeader:pointerover, Expander.firmwareInputGroupDisclosure /template/ ToggleButton#ExpanderHeader:checked:pointerover, Expander.firmwareInputGroupDisclosure /template/ ToggleButton#ExpanderHeader:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander.firmwareInputGroupDisclosure /template/ ToggleButton#ExpanderHeader:focus-visible">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- FluentTheme's default ToggleButton/Button ClipToBounds is True, which clips the
         :focus-visible ring below to nothing (it is a BoxShadow on PART_ContentPresenter that
         extends outside the control's own bounds; F-3, review of 91214ef81). The nav bar's 4px
         inter-item spacing and the header row's own padding leave enough room for the ring
         without touching a neighboring tab or the header edge. -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <!-- The ContentPresenter never carries a BorderThickness: giving it one (even bottom-only, even
       via a sibling :checked rule) makes Avalonia's Border renderer clip the :focus-visible BoxShadow
       ring below to nothing, because the ring and a real border stroke share the same clipped paint
       pass (F-3, review of 91214ef81; verified by bisecting a minimal reproduction down to this one
       setter). The selected-page underline is therefore a separate sibling Border
       (Border.navSelectedUnderline below), not part of this ContentPresenter at all. -->
  <Style Selector="ToggleButton.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>
  <!-- The only "selected page" indicator: a sibling Border (see MainWindow.axaml), not the nav
       ToggleButton's own ContentPresenter border, so the ContentPresenter never carries a
       BorderThickness (see the comment above) and its :focus-visible BoxShadow ring renders
       unclipped. Visible only for the selected page's own tab, regardless of hover/pressed/focus.
       A 3px bottom margin holds it 3px clear of the tab's own bottom edge, so it never touches the
       focus ring drawn just outside that edge: without a gap the two bars read as one continuous
       line, especially in the dark theme where NfcAccentBrush and the ring's color are identical
       (F-4, review of edd9a71b4). -->
  <Style Selector="Border.navSelectedUnderline">
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- A full ring drawn as a BoxShadow, not the bottom-only selected underline and not the
       ContentPresenter's own BorderBrush/BorderThickness, so keyboard focus on an unselected nav
       tab never reads as a second selected page (BUG-20260926, owner decision 32) while the
       selected tab's own underline (a separate sibling Border, above) stays visible when that same
       tab is also focused (F-1, review of 6dee964a0). BoxShadow is an existing token pattern
       (NfcWorkflowCardHoverShadow etc.) reused here as an independent focus layer instead of a new
       mechanism. -->
  <Style Selector="ToggleButton.nav:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource NfcNavFocusRingShadow}" />
  </Style>
  <Style Selector="ToggleButton.segment">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ToggleButton.segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.segment TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcPillCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.versionChoice">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="ToggleButton.versionChoice /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.versionChoice Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource NfcTextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="ToggleButton.versionChoice:checked Path">
    <Setter Property="Stroke" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Border.versionValueBadge">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
  </Style>
  <Style Selector="TextBlock.versionValue">
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize14}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="ComboBox.technicalSelect, ComboBox.technicalSelect ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
  </Style>
  <Style Selector="ComboBox.settingsSelect">
    <Setter Property="Width" Value="180" />
  </Style>
  <Style Selector="TextBox.technicalCenteredInput">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MaxHeight" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource NfcTechnicalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="input:InputMethod.IsInputMethodEnabled" Value="False" />
  </Style>
  <Style Selector="TextBox.addressInput">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="Address" />
  </Style>
  <Style Selector="TextBox.hexByteInput">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="MaxLength" Value="2" />
    <Setter Property="behaviors:HexTextInputBehavior.Mode" Value="ByteSequence" />
  </Style>
</Styles>
