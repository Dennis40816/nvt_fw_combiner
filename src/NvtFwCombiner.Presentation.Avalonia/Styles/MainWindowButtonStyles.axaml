    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Button.railAction:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.railAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}" />
  </Style>
  <Style Selector="Button.railAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="Button.primaryRailAction:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Button.primaryRailAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Button.primaryRailAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}" />
  </Style>
  <Style Selector="Button.railAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.primaryRailAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSurfaceBrush}" />
  </Style>
  <Style Selector="Button.railAction.reducedMotion">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.railAction.reducedMotion /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.railAction.reducedMotion TextBlock.railActionLabel">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.railAction:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>
  <Style Selector="Button.railAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.railActionIconSlot">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.railActionIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Button.outputRailAction Path.railActionIcon">
    <Setter Property="Fill" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="Button.outputRailAction:pointerover Path.railActionIcon">
    <Setter Property="Fill" Value="{DynamicResource NfcAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.primaryRailAction Path.railActionIcon">
    <Setter Property="Fill" Value="{DynamicResource NfcSurfaceBrush}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="Button.railAction:disabled Path.railActionIcon">
    <Setter Property="Fill" Value="{DynamicResource NfcTextDisabledBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource NfcTextDisabledBrush}" />
  </Style>
  <Style Selector="Button.summaryChip">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize12}" />
  </Style>
