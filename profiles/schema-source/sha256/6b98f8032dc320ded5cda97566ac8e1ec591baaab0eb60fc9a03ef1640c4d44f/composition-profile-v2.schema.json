{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nfc/schemas/composition-profile-v2.schema.json",
  "title": "NVT FW Combiner Composition Profile 2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileVersion",
    "promotion",
    "compositionKind",
    "experience",
    "mapBinding",
    "inputSlots",
    "spaces",
    "views",
    "metadataBindings",
    "regionAccessRules",
    "operations",
    "validations",
    "processorStages",
    "output",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "2.2" },
    "profileId": { "$ref": "#/$defs/id" },
    "profileVersion": { "$ref": "#/$defs/semver" },
    "promotion": { "$ref": "#/$defs/promotion" },
    "compositionKind": { "enum": ["merge", "replace"] },
    "icNumberInputMode": {
      "enum": ["single-selector", "cascade-selector", "numeric-selector"]
    },
    "experience": { "$ref": "#/$defs/experience" },
    "mapBinding": { "$ref": "#/$defs/mapBinding" },
    "inputSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inputSlot" }
    },
    "spaces": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/space" },
      "contains": {
        "properties": { "kind": { "const": "output-image" } },
        "required": ["kind"]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/view" }
    },
    "metadataBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/metadataBinding" }
    },
    "regionAccessRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/regionAccessRule" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "validations": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation" }
    },
    "processorStages": {
      "type": "array",
      "items": { "$ref": "#/$defs/processorStage" }
    },
    "output": { "$ref": "#/$defs/output" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "compositionKind": { "const": "merge" } },
        "required": ["compositionKind"]
      },
      "then": {
        "not": { "required": ["icNumberInputMode"] },
        "properties": {
          "spaces": {
            "contains": {
              "properties": {
                "kind": { "const": "output-image" },
                "initializer": {
                  "properties": { "kind": { "const": "blank" } },
                  "required": ["kind"]
                }
              },
              "required": ["kind", "initializer"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "compositionKind": { "const": "replace" } },
        "required": ["compositionKind"]
      },
      "then": {
        "required": ["icNumberInputMode"],
        "properties": {
          "icNumberInputMode": {
            "enum": ["single-selector", "cascade-selector", "numeric-selector"]
          },
          "spaces": {
            "contains": {
              "properties": {
                "kind": { "const": "output-image" },
                "initializer": {
                  "properties": { "kind": { "const": "clone" } },
                  "required": ["kind"]
                }
              },
              "required": ["kind", "initializer"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inputSlots": {
            "contains": {
              "properties": {
                "acceptance": {
                  "properties": {
                    "normalization": {
                      "properties": { "kind": { "const": "pad-shorter" } },
                      "required": ["kind"]
                    }
                  },
                  "required": ["normalization"]
                }
              },
              "required": ["acceptance"]
            }
          }
        },
        "required": ["inputSlots"]
      },
      "then": {
        "properties": {
          "compositionKind": { "const": "replace" },
          "experience": {
            "properties": { "experienceId": { "const": "dp-replace" } }
          },
          "processorStages": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inputSlots": {
            "contains": {
              "properties": {
                "acceptance": {
                  "properties": {
                    "normalization": {
                      "properties": { "kind": { "const": "truncate-ctrlram" } },
                      "required": ["kind"]
                    }
                  },
                  "required": ["normalization"]
                }
              },
              "required": ["acceptance"]
            }
          }
        },
        "required": ["inputSlots"]
      },
      "then": {
        "properties": {
          "compositionKind": { "const": "replace" },
          "experience": {
            "properties": { "experienceId": { "const": "ctrlram-replace" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "externalToolBindingId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:-[0-9]+(?:\\.[0-9]+)*(?:[-+][0-9A-Za-z.-]+)?)?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hexBytes": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+(?![\\s\\S])"
    },
    "issueCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "scalar": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "relativeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "blockers"],
      "properties": {
        "stage": {
          "enum": [
            "known",
            "map-resolvable",
            "inspectable",
            "authorable",
            "compilable",
            "executable-candidate",
            "supported"
          ]
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotionBlocker" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stage": { "const": "supported" } },
            "required": ["stage"]
          },
          "then": {
            "properties": { "blockers": { "maxItems": 0 } }
          }
        }
      ]
    },
    "promotionBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockerId", "kind", "reason", "evidenceRefs"],
      "properties": {
        "blockerId": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "map",
            "metadata",
            "operation",
            "processor",
            "integrity",
            "golden",
            "human-review",
            "ui",
            "release"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experienceId",
        "audience",
        "layoutPolicy",
        "inputPolicy",
        "topologyAuthoring",
        "displayNameKey"
      ],
      "properties": {
        "experienceId": { "$ref": "#/$defs/id" },
        "audience": { "enum": ["system", "dp", "ctrlram", "advanced"] },
        "layoutPolicy": { "enum": ["fixed", "constrained", "user-defined"] },
        "inputPolicy": { "enum": ["fixed", "extensible"] },
        "topologyAuthoring": { "enum": ["hidden", "single-or-cascade", "exact-count"] },
        "displayNameKey": { "type": "string", "minLength": 1 }
      }
    },
    "mapBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId",
        "familyVersion",
        "familyContentHash",
        "mapIds",
        "requiredRegionIds",
        "requiredMetadataStructureIds",
        "requiredCapabilityIds"
      ],
      "properties": {
        "familyId": { "$ref": "#/$defs/id" },
        "familyVersion": { "$ref": "#/$defs/semver" },
        "familyContentHash": { "$ref": "#/$defs/sha256" },
        "mapIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requiredRegionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requiredMetadataStructureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requiredCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "inputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "role",
        "artifactClass",
        "required",
        "cardinality",
        "acceptedExtensions",
        "acceptance"
      ],
      "properties": {
        "slotId": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "artifactClass": {
          "enum": [
            "tp-firmware",
            "dp-firmware",
            "reference-image",
            "ctrlram-replacement",
            "auxiliary"
          ]
        },
        "required": { "type": "boolean" },
        "cardinality": { "enum": ["exactly-one", "zero-or-one", "one-or-more"] },
        "acceptedExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
        },
        "acceptance": { "$ref": "#/$defs/inputAcceptance" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "artifactClass": { "const": "tp-firmware" } },
            "required": ["artifactClass"]
          },
          "then": {
            "properties": {
              "acceptance": {
                "properties": {
                  "lengthRule": {
                    "oneOf": [
                      {
                        "properties": { "kind": { "const": "tp-maximum-256k" } },
                        "required": ["kind"]
                      },
                      {
                        "properties": {
                          "kind": { "const": "exact-bytes" },
                          "bytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
                        },
                        "required": ["kind", "bytes"]
                      }
                    ]
                  },
                  "normalization": {
                    "properties": { "kind": { "const": "none" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "artifactClass": { "const": "dp-firmware" } },
            "required": ["artifactClass"]
          },
          "then": {
            "properties": {
              "acceptance": {
                "properties": {
                  "lengthRule": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "exact-resolved-map-capacity",
                          "normal-dp-extract-with-warning"
                        ]
                      }
                    },
                    "required": ["kind"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "artifactClass": { "const": "reference-image" } },
            "required": ["artifactClass"]
          },
          "then": {
            "properties": {
              "acceptance": {
                "properties": {
                  "lengthRule": {
                    "properties": { "kind": { "const": "exact-resolved-map-capacity" } },
                    "required": ["kind"]
                  },
                  "normalization": {
                    "properties": { "kind": { "const": "none" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance": {
                "properties": {
                  "normalization": {
                    "properties": { "kind": { "const": "truncate-ctrlram" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": { "artifactClass": { "const": "ctrlram-replacement" } }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance": {
                "properties": {
                  "normalization": {
                    "properties": { "kind": { "const": "pad-shorter" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": { "artifactClass": { "const": "dp-firmware" } }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance": {
                "properties": {
                  "lengthRule": {
                    "properties": { "kind": { "const": "normal-dp-extract-with-warning" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "artifactClass": { "const": "dp-firmware" },
              "acceptance": {
                "properties": {
                  "normalization": {
                    "properties": { "kind": { "const": "none" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "acceptance": {
                "properties": {
                  "lengthRule": {
                    "properties": { "kind": { "const": "tp-maximum-256k" } },
                    "required": ["kind"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": { "artifactClass": { "const": "tp-firmware" } }
          }
        }
      ]
    },
    "inputAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthRule", "normalization"],
      "properties": {
        "lengthRule": { "$ref": "#/$defs/lengthRule" },
        "normalization": { "$ref": "#/$defs/inputNormalization" }
      }
    },
    "lengthRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bytes"],
          "properties": {
            "kind": { "const": "exact-bytes" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "exact-resolved-map-capacity" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimumBytes", "maximumBytes"],
          "properties": {
            "kind": { "const": "bounded" },
            "minimumBytes": { "type": "integer", "minimum": 1 },
            "maximumBytes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "issueCode"],
          "properties": {
            "kind": { "const": "normal-dp-extract-with-warning" },
            "issueCode": { "$ref": "#/$defs/issueCode" },
            "expectedInputLengths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maximumBytes"],
          "properties": {
            "kind": { "const": "tp-maximum-256k" },
            "maximumBytes": { "const": 262144 }
          }
        }
      ]
    },
    "inputNormalization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fillByte", "evidenceRef"],
          "properties": {
            "kind": { "const": "pad-shorter" },
            "fillByte": { "type": "integer", "minimum": 0, "maximum": 255 },
            "evidenceRef": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "warningIssueCode", "evidenceRef"],
          "properties": {
            "kind": { "const": "truncate-ctrlram" },
            "warningIssueCode": { "$ref": "#/$defs/issueCode" },
            "evidenceRef": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "capacity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "resolved-map" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bytes"],
          "properties": {
            "kind": { "const": "fixed" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "initializer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fillByte"],
          "properties": {
            "kind": { "const": "blank" },
            "fillByte": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceSlotId"],
          "properties": {
            "kind": { "const": "clone" },
            "sourceSlotId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "space": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spaceId", "kind", "slotId", "instancePolicy"],
          "properties": {
            "spaceId": { "$ref": "#/$defs/id" },
            "kind": { "const": "input-artifact" },
            "slotId": { "$ref": "#/$defs/id" },
            "instancePolicy": { "enum": ["singleton", "per-binding"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spaceId", "kind", "capacity", "initializer"],
          "properties": {
            "spaceId": { "$ref": "#/$defs/id" },
            "kind": { "enum": ["work-buffer", "output-image"] },
            "capacity": { "$ref": "#/$defs/capacity" },
            "initializer": { "$ref": "#/$defs/initializer" }
          }
        }
      ]
    },
    "viewSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "regionId"],
          "properties": {
            "kind": { "const": "map-region" },
            "regionId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "regionId", "offset", "length"],
          "properties": {
            "kind": { "const": "map-region-slice" },
            "regionId": { "$ref": "#/$defs/id" },
            "offset": { "type": "integer", "minimum": 0 },
            "length": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "range"],
          "properties": {
            "kind": { "const": "space-range" },
            "range": { "$ref": "#/$defs/relativeRange" }
          }
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewId", "spaceId", "selector"],
      "properties": {
        "viewId": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "selector": { "$ref": "#/$defs/viewSelector" }
      }
    },
    "metadataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "spaceId", "structureId", "fieldIds", "purposes"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "structureId": { "$ref": "#/$defs/id" },
        "fieldIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["map-resolution", "validation", "output-naming", "display", "version"]
          }
        }
      }
    },
    "regionAccessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "access", "reason"],
      "properties": {
        "regionId": { "$ref": "#/$defs/id" },
        "access": { "enum": ["hidden", "read-only", "whole", "parts", "explicit-range"] },
        "allowedSubregionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "overlapPolicy": {
      "enum": ["reject", "allow-declared", "replace-existing"]
    },
    "operationCommon": {
      "type": "object",
      "required": ["operationId", "sequence", "overlapPolicy", "reason"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "overlapPolicy": { "$ref": "#/$defs/overlapPolicy" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/operationCommon" },
            {
              "type": "object",
              "required": ["kind", "sourceViewId", "targetViewId"],
              "properties": {
                "kind": { "enum": ["copy-range", "replace-range"] },
                "sourceViewId": { "$ref": "#/$defs/id" },
                "targetViewId": { "$ref": "#/$defs/id" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/operationCommon" },
            {
              "type": "object",
              "required": ["kind", "targetViewId", "fillByte"],
              "properties": {
                "kind": { "const": "fill-range" },
                "targetViewId": { "$ref": "#/$defs/id" },
                "fillByte": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/operationCommon" },
            {
              "type": "object",
              "required": ["kind", "targetViewId", "valueHex"],
              "properties": {
                "kind": { "const": "patch-scalar" },
                "targetViewId": { "$ref": "#/$defs/id" },
                "valueHex": { "$ref": "#/$defs/hexBytes" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/operationCommon" },
            {
              "type": "object",
              "required": [
                "kind",
                "sourceViewId",
                "targetViewId",
                "widthBytes",
                "byteOrder",
                "valueInterpretation",
                "addend",
                "overflowPolicy"
              ],
              "properties": {
                "kind": { "const": "transform-scalar" },
                "sourceViewId": { "$ref": "#/$defs/id" },
                "targetViewId": { "$ref": "#/$defs/id" },
                "widthBytes": { "enum": [1, 2, 4, 8] },
                "byteOrder": { "enum": ["little", "big"] },
                "valueInterpretation": { "const": "unsigned" },
                "addend": { "type": "integer" },
                "expectedBefore": { "type": "integer", "minimum": 0 },
                "overflowPolicy": { "const": "reject" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/operationCommon" },
            {
              "type": "object",
              "required": ["kind", "processorStageId"],
              "properties": {
                "kind": { "const": "run-processor" },
                "processorStageId": { "$ref": "#/$defs/id" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "metadataFieldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "fieldId"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/id" },
        "fieldId": { "$ref": "#/$defs/id" }
      }
    },
    "validationCommon": {
      "type": "object",
      "required": ["ruleId", "stage", "severity", "issueCode"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/id" },
        "stage": {
          "enum": ["profile-compile", "input-load", "pre-operation", "post-operation", "final-output"]
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "issueCode": { "$ref": "#/$defs/issueCode" }
      }
    },
    "validation": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/validationCommon" },
            {
              "type": "object",
              "required": ["kind", "field", "operator", "expectedValues"],
              "properties": {
                "kind": { "const": "metadata-value" },
                "field": { "$ref": "#/$defs/metadataFieldRef" },
                "operator": { "enum": ["equals", "not-equals", "one-of"] },
                "expectedValues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/scalar" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/validationCommon" },
            {
              "type": "object",
              "required": ["kind", "field"],
              "properties": {
                "kind": { "const": "pid-sanity" },
                "field": { "$ref": "#/$defs/metadataFieldRef" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/validationCommon" },
            {
              "type": "object",
              "required": ["kind", "left", "right"],
              "properties": {
                "kind": { "const": "metadata-equality" },
                "left": { "$ref": "#/$defs/metadataFieldRef" },
                "right": { "$ref": "#/$defs/metadataFieldRef" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/validationCommon" },
            {
              "type": "object",
              "required": ["kind", "field", "rejectedPatterns"],
              "properties": {
                "kind": { "const": "reject-metadata-byte-pattern" },
                "field": { "$ref": "#/$defs/metadataFieldRef" },
                "rejectedPatterns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["all-zero", "all-ff"] }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/validationCommon" },
            {
              "type": "object",
              "required": ["kind", "viewId", "expectedHex"],
              "properties": {
                "kind": { "const": "view-byte-assertion" },
                "viewId": { "$ref": "#/$defs/id" },
                "expectedHex": { "$ref": "#/$defs/hexBytes" },
                "maskHex": { "$ref": "#/$defs/hexBytes" }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "processorPurpose": {
      "enum": [
        "checksum",
        "header",
        "header-and-integrity",
        "relocation",
        "composite-post-process"
      ]
    },
    "stagedSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceViewId", "targetViewId"],
      "properties": {
        "sourceViewId": { "$ref": "#/$defs/id" },
        "targetViewId": { "$ref": "#/$defs/id" }
      }
    },
    "stagedArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "sourceViewId"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "sourceViewId": { "$ref": "#/$defs/id" }
      }
    },
    "processorStage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processorStageId",
            "kind",
            "contractVersion",
            "calculationSetId",
            "targetSpaceId",
            "authority",
            "purpose",
            "integrityDisposition",
            "allowedReadViewIds",
            "allowedWriteViewIds",
            "failurePolicy"
          ],
          "properties": {
            "processorStageId": { "$ref": "#/$defs/id" },
            "kind": { "const": "crc-worker-v1" },
            "contractVersion": { "$ref": "#/$defs/semver" },
            "calculationSetId": { "$ref": "#/$defs/id" },
            "targetSpaceId": { "$ref": "#/$defs/id" },
            "authority": { "const": "calculate" },
            "purpose": { "const": "checksum" },
            "integrityDisposition": { "const": "verify-existing" },
            "allowedReadViewIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "allowedWriteViewIds": {
              "type": "array",
              "maxItems": 0,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "failurePolicy": { "const": "fail-closed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processorStageId",
            "kind",
            "toolBindingId",
            "invocationProfileId",
            "targetSpaceId",
            "authority",
            "purpose",
            "integrityDisposition",
            "allowedReadViewIds",
            "allowedWriteViewIds",
            "stagedSourceBindings",
            "stagedArtifactBindings",
            "evidenceRef",
            "failurePolicy"
          ],
          "properties": {
            "processorStageId": { "$ref": "#/$defs/id" },
            "kind": { "const": "legacy-combiner-v1" },
            "toolBindingId": { "$ref": "#/$defs/externalToolBindingId" },
            "invocationProfileId": { "$ref": "#/$defs/id" },
            "targetSpaceId": { "$ref": "#/$defs/id" },
            "authority": { "const": "transform" },
            "purpose": { "$ref": "#/$defs/processorPurpose" },
            "integrityDisposition": { "enum": ["none", "recalculate-and-write"] },
            "allowedReadViewIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "allowedWriteViewIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "stagedSourceBindings": {
              "type": "array",
              "items": { "$ref": "#/$defs/stagedSourceBinding" }
            },
            "stagedArtifactBindings": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/stagedArtifactBinding" }
            },
            "evidenceRef": { "$ref": "#/$defs/id" },
            "failurePolicy": { "const": "fail-closed" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "integrityDisposition": { "const": "none" } },
                "required": ["integrityDisposition"]
              },
              "then": {
                "properties": { "purpose": { "const": "relocation" } }
              }
            },
            {
              "if": {
                "properties": {
                  "purpose": {
                    "enum": ["checksum", "header", "header-and-integrity"]
                  }
                },
                "required": ["purpose"]
              },
              "then": {
                "properties": {
                  "integrityDisposition": { "const": "recalculate-and-write" }
                }
              }
            }
          ]
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileNameTemplate",
        "allowOverride",
        "invalidCharacterPolicy",
        "requiredTokenIds"
      ],
      "properties": {
        "fileNameTemplate": { "type": "string", "minLength": 1 },
        "allowOverride": { "type": "boolean" },
        "invalidCharacterPolicy": { "enum": ["reject", "replace-underscore"] },
        "requiredTokenIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
