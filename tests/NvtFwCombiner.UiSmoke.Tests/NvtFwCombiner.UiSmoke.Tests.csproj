<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NvtFwCombiner.Desktop\NvtFwCombiner.Desktop.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\NvtFwCombiner.Presentation.Avalonia\NvtFwCombiner.Presentation.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\NvtFwCombiner.DistributionLauncher\NvtFwCombiner.DistributionLauncher.csproj" />
    <ProjectReference Include="..\..\src\NvtFwCombiner.Bootstrap\NvtFwCombiner.Bootstrap.csproj" />
    <ProjectReference Include="..\..\src\NvtFwCombiner.VersionManagement.Application\NvtFwCombiner.VersionManagement.Application.csproj" />
    <ProjectReference Include="..\NvtFwCombiner.TestSupport\NvtFwCombiner.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyCatalogProbeHost" AfterTargets="Build">
    <MSBuild Projects="..\..\src\NvtFwCombiner.Desktop\NvtFwCombiner.Desktop.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_CatalogProbeHost" />
    </MSBuild>
    <PropertyGroup>
      <_CatalogProbeHostDirectory>@(_CatalogProbeHost->'%(RootDir)%(Directory)')</_CatalogProbeHostDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_CatalogProbeHostFiles Include="$(_CatalogProbeHostDirectory)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)catalog-probe-host" />
    <Copy SourceFiles="@(_CatalogProbeHostFiles)"
          DestinationFiles="@(_CatalogProbeHostFiles->'$(OutDir)catalog-probe-host\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
