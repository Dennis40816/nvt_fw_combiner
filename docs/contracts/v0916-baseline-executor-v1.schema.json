{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/v0916-baseline-executor-v1.schema.json",
  "title": "Exact-tag v0.9.16 source baseline CLI executor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "source", "toolchain", "lockFiles", "externalTools", "restore", "build", "cliAssembly", "runtimeClosure"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "exact-tag-source-built-cli" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "tagObject", "peeledCommit", "sourceTree", "cleanTreeRequired"],
      "properties": {
        "tag": { "const": "v0.9.16" },
        "tagObject": { "$ref": "#/$defs/gitSha" },
        "peeledCommit": { "$ref": "#/$defs/gitSha" },
        "sourceTree": { "$ref": "#/$defs/gitSha" },
        "cleanTreeRequired": { "const": true }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvedSdkVersion", "globalJson"],
      "properties": {
        "resolvedSdkVersion": { "const": "10.0.303" },
        "globalJson": { "$ref": "#/$defs/artifact" }
      }
    },
    "lockFiles": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "externalTools": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "restore": {
      "allOf": [
        { "$ref": "#/$defs/command" },
        { "properties": { "arguments": { "const": ["dotnet", "restore", "src/NvtFwCombiner.Cli/NvtFwCombiner.Cli.csproj", "--locked-mode"] } } }
      ]
    },
    "build": {
      "allOf": [
        { "$ref": "#/$defs/command" },
        { "properties": { "arguments": { "const": ["dotnet", "build", "src/NvtFwCombiner.Cli/NvtFwCombiner.Cli.csproj", "--configuration", "Release", "--no-restore", "-p:ContinuousIntegrationBuild=true", "-p:PathMap={sourceRoot}=/_/src"] } } }
      ]
    },
    "cliAssembly": { "$ref": "#/$defs/artifact" },
    "runtimeClosure": { "$ref": "#/$defs/runtimeClosure" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingDirectory", "arguments"],
      "properties": {
        "workingDirectory": { "const": "." },
        "arguments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtimeClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "fileCount", "totalSize", "sha256"],
      "properties": {
        "root": { "const": "src/NvtFwCombiner.Cli/bin/Release/net10.0/win-x64" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalSize": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
