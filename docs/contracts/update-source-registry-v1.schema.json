{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/nvt_fw_combiner/update-source-registry-v1.schema.json",
  "title": "NVT FW Combiner fixed update-source registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "contains": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "latest" } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "path"],
        "properties": {
          "status": { "enum": ["latest", "available", "deprecated"] },
          "path": { "type": "string", "minLength": 3, "maxLength": 1024 }
        }
      }
    }
  }
}
