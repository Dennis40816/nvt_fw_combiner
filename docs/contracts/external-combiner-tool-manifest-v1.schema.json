{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nfc/schemas/external-combiner-tool-manifest-v1.schema.json",
  "title": "NVT FW Combiner External Combiner Tool Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolBindingId",
    "toolId",
    "toolVersion",
    "displayName",
    "platform",
    "executableName",
    "sha256",
    "adapterId",
    "inputMode",
    "argumentTemplate",
    "workingDirectoryPolicy",
    "timeoutSeconds",
    "allowedExtraOutputFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "toolBindingId": {
      "$ref": "#/$defs/bindingId"
    },
    "toolId": {
      "$ref": "#/$defs/id"
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "win-x64",
        "win-arm64"
      ]
    },
    "executableName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.exe$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapterId": {
      "$ref": "#/$defs/id"
    },
    "inputMode": {
      "enum": [
        "in-place",
        "input-output-file"
      ]
    },
    "argumentTemplate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:[^{}]|\\{staging\\.(?:workBin|outputBin|runDir|artifact\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)\\})+$"
      }
    },
    "workingDirectoryPolicy": {
      "const": "staging-directory"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "allowedExtraOutputFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "bindingId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:-[0-9]+(?:\\.[0-9]+)*(?:[-+][0-9A-Za-z.-]+)?)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
