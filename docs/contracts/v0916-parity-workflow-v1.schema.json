{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/v0916-parity-workflow-v1.schema.json",
  "title": "Closed v0.9.16 parity workflow semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowPath",
    "workflowRef",
    "workflowHeadRelation",
    "candidateImplementationHead",
    "trigger",
    "topLevelPermissions",
    "actionPins",
    "jobs",
    "promotionGate",
    "forbidden"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workflowPath": { "const": ".github/workflows/release.yml" },
    "workflowRef": { "const": "refs/heads/main" },
    "workflowHeadRelation": { "const": "authenticated-protected-main-independent-of-candidate-source" },
    "candidateImplementationHead": { "const": "c8104f74de4af9d5131125eec54f402f20f9cd9f" },
    "trigger": { "const": "workflow_dispatch" },
    "topLevelPermissions": { "$ref": "#/$defs/readPermissions" },
    "actionPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout", "setupPython", "downloadArtifact", "uploadArtifact"],
      "properties": {
        "checkout": { "const": "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0" },
        "setupPython": { "const": "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1" },
        "downloadArtifact": { "const": "actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131" },
        "uploadArtifact": { "const": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a" }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v0916-parity-compare", "v0916-parity-attestation", "v0916-parity-finalize"],
      "properties": {
        "v0916-parity-compare": { "$ref": "#/$defs/job" },
        "v0916-parity-attestation": { "$ref": "#/$defs/job" },
        "v0916-parity-finalize": { "$ref": "#/$defs/job" }
      }
    },
    "promotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "needs", "if", "stepPrefixNames", "steps"],
      "properties": {
        "jobId": { "const": "promote" },
        "needs": {
          "prefixItems": [
            { "const": "candidate" },
            { "const": "v0916-parity-finalize" }
          ],
          "items": false
        },
        "if": { "type": "string", "pattern": "^\\$\\{\\{ .+ \\}\\}$" },
        "stepPrefixNames": {
          "prefixItems": [
            { "const": "Checkout protected release authority" },
            { "const": "Setup pinned Python for release policy" },
            { "const": "Download terminal v0.9.16 parity evidence" },
            { "const": "Require terminal parity pass before promotion" }
          ],
          "items": false
        },
        "steps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continueOnError",
        "unprotectedEnvironment",
        "unpinnedAction",
        "writePermissions",
        "alternateComparatorCommand",
        "artifactNameOrPathDrift",
        "conditionalBypass"
      ],
      "properties": {
        "continueOnError": { "const": true },
        "unprotectedEnvironment": { "const": true },
        "unpinnedAction": { "const": true },
        "writePermissions": { "const": true },
        "alternateComparatorCommand": { "const": true },
        "artifactNameOrPathDrift": { "const": true },
        "conditionalBypass": { "const": true }
      }
    }
  },
  "$defs": {
    "readPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "contents"],
      "properties": {
        "actions": { "const": "read" },
        "contents": { "const": "read" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "needs",
        "if",
        "runsOn",
        "timeoutMinutes",
        "environment",
        "permissions",
        "steps"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "needs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "if": { "type": "string", "pattern": "^\\$\\{\\{ .+ \\}\\}$" },
        "runsOn": { "const": "windows-latest" },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "environment": { "type": ["string", "null"] },
        "permissions": {
          "oneOf": [
            { "$ref": "#/$defs/readPermissions" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["actions", "contents", "deployments"],
              "properties": {
                "actions": { "const": "read" },
                "contents": { "const": "read" },
                "deployments": { "const": "read" }
              }
            }
          ]
        },
        "steps": { "type": "array", "minItems": 4, "maxItems": 7, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "if": { "type": "string", "pattern": "^\\$\\{\\{ .+ \\}\\}$" },
        "uses": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$" },
        "with": { "type": "object" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "shell": { "const": "pwsh" },
        "run": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["uses", "with"] },
        { "required": ["shell", "run"] }
      ]
    }
  }
}
