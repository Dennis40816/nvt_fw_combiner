{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novatek.example/nvt-fw-combiner/profile-bundle-package-trust-index-v1.schema.json",
  "title": "Profile Bundle Package Trust Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trustIndexId",
    "trustIndexVersion",
    "trustAnchorBindingId",
    "bundles"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "trustIndexId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "trustIndexVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trustAnchorBindingId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/bundle" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "relativeJsonPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
    },
    "icId": {
      "type": "string",
      "pattern": "^NT[0-9]{5}$"
    },
    "runtimeRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "icId", "profileId", "profileVersion"],
      "properties": {
        "workflowId": {
          "enum": [
            "standard-merge",
            "ab-merge",
            "dp-replace",
            "general-merge",
            "general-replace",
            "ctrlram-replace"
          ]
        },
        "icId": { "$ref": "#/$defs/icId" },
        "profileId": { "$ref": "#/$defs/token" },
        "profileVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        },
        "mapVariantSetId": { "$ref": "#/$defs/token" },
        "familyId": { "$ref": "#/$defs/token" },
        "postbuildProcessorId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "postbuildBranch": {
          "enum": ["single-chip", "two-chip", "three-chip", "cascade"]
        },
        "reportMetadataMapId": {
          "allOf": [{ "$ref": "#/$defs/token" }],
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workflowId": { "enum": ["standard-merge", "dp-replace"] }
            }
          },
          "else": { "not": { "required": ["mapVariantSetId"] } }
        },
        {
          "if": { "properties": { "workflowId": { "const": "general-merge" } } },
          "then": { "required": ["familyId"] },
          "else": { "not": { "required": ["familyId"] } }
        },
        {
          "if": { "properties": { "workflowId": { "const": "ctrlram-replace" } } },
          "then": { "required": ["postbuildProcessorId", "postbuildBranch"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["postbuildProcessorId"] },
                { "required": ["postbuildBranch"] },
                { "required": ["reportMetadataMapId"] }
              ]
            }
          }
        }
      ]
    },
    "canonicalFirmwareFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination"],
      "properties": {
        "source": { "$ref": "#/$defs/relativeJsonPath" },
        "destination": { "$ref": "#/$defs/relativeJsonPath" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compositionProfileSchemaFile",
        "firmwareFamilySchemaFile"
      ],
      "properties": {
        "compositionProfileSchemaFile": { "$ref": "#/$defs/fileName" },
        "firmwareFamilySchemaFile": { "$ref": "#/$defs/fileName" },
        "canonicalFirmwareFamily": { "$ref": "#/$defs/canonicalFirmwareFamily" }
      }
    },
    "metadataProviderFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "familyVersion"],
      "properties": {
        "familyId": { "$ref": "#/$defs/token" },
        "familyVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleDirectory",
        "bundleSchemaVersion",
        "bundleVersion",
        "contentHash",
        "materialization",
        "runtimeRegistrations"
      ],
      "properties": {
        "bundleDirectory": { "$ref": "#/$defs/token" },
        "bundleSchemaVersion": { "const": "1.0" },
        "bundleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "materialization": { "$ref": "#/$defs/materialization" },
        "metadataProviderFamilies": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/metadataProviderFamily" }
        },
        "runtimeRegistrations": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/runtimeRegistration" }
        }
      }
    }
  }
}
