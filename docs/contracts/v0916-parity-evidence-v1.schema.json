{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/v0916-parity-evidence-v1.schema.json",
  "title": "Payload-free v0.9.16 parity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "comparison", "planSha256", "policySha256", "comparator", "candidateAuthority", "baselineExecutor", "baselineReleaseReference", "candidatePackage", "candidateBuild", "protectedRun", "routeEvidenceSha256", "receiptSetSha256", "executedAtUtc", "firmwareOwnerApproval", "routes", "verdict"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "comparison": { "$ref": "#/$defs/artifact" },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "policySha256": { "$ref": "#/$defs/sha256" },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "scriptSha256"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "scriptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementationHead", "implementationTree", "authorityTrees", "policySha256", "sourceExecutorContract", "authorityTransfer"],
      "properties": {
        "implementationHead": { "$ref": "#/$defs/gitSha" },
        "implementationTree": { "$ref": "#/$defs/gitSha" },
        "authorityTrees": { "$ref": "#/$defs/authorityTrees" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "sourceExecutorContract": { "$ref": "#/$defs/artifact" },
        "authorityTransfer": { "$ref": "#/$defs/authorityTransfer" }
      }
    },
    "baselineExecutor": { "$ref": "#/$defs/baselineExecutor" },
    "baselineReleaseReference": { "$ref": "#/$defs/releaseReference" },
    "candidatePackage": {
      "allOf": [
        { "$ref": "#/$defs/package" },
        {
          "type": "object",
          "required": ["version", "sourceCommit"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "sourceCommit": { "$ref": "#/$defs/gitSha" }
          }
        }
      ]
    },
    "candidateBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowRef", "workflowCommitSha", "workflowBlobSha", "workflowRawSha256", "workflowSemanticContractSha256", "runId", "artifactId", "artifactName", "artifactDigest", "artifactWorkflowRun", "candidateManifest", "candidateSourceExecutorIdentitySha256", "provenanceSubjectsSha256", "candidateVerifierSha256", "packageVerifierSha256"],
      "properties": {
        "repository": { "const": "Dennis40816/nvt_fw_combiner" },
        "workflowPath": { "const": ".github/workflows/release.yml" },
        "workflowRef": { "const": "refs/heads/main" },
        "workflowCommitSha": { "$ref": "#/$defs/gitSha" },
        "workflowBlobSha": { "$ref": "#/$defs/gitSha" },
        "workflowRawSha256": { "$ref": "#/$defs/sha256" },
          "workflowSemanticContractSha256": { "const": "faa1be61a2072a8d7b7b0ebb57589cd4e20080f61d9a57533ee47c26ceddbb4d" },
        "runId": { "type": "integer", "minimum": 1 },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactName": { "type": "string", "pattern": "^stable-candidate-[1-9][0-9]*-[0-9a-f]{40}$" },
        "artifactDigest": { "$ref": "#/$defs/sha256Digest" },
        "artifactWorkflowRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "headSha", "headBranch", "repository", "repositoryId", "headRepositoryId"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "headSha": { "$ref": "#/$defs/gitSha" },
            "headBranch": { "const": "main" },
            "repository": { "const": "Dennis40816/nvt_fw_combiner" },
            "repositoryId": { "type": "integer", "minimum": 1 },
            "headRepositoryId": { "type": "integer", "minimum": 1 }
          }
        },
        "candidateManifest": { "$ref": "#/$defs/artifact" },
        "candidateSourceExecutorIdentitySha256": { "$ref": "#/$defs/sha256" },
        "provenanceSubjectsSha256": { "$ref": "#/$defs/sha256" },
        "candidateVerifierSha256": { "$ref": "#/$defs/sha256" },
        "packageVerifierSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "protectedRun": { "$ref": "#/$defs/protectedRun" },
    "routeEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "receiptSetSha256": { "$ref": "#/$defs/sha256" },
    "executedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
    "firmwareOwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "authority"],
      "properties": {
        "attestation": { "$ref": "#/$defs/artifact" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "verifierId", "verificationRecord", "attestationId", "firmwareOwnerId", "verifiedAtUtc"],
          "properties": {
            "kind": { "const": "external-firmware-owner-verification" },
            "verifierId": { "type": "string", "minLength": 1 },
            "verificationRecord": { "$ref": "#/$defs/artifact" },
            "attestationId": { "type": "string", "minLength": 1 },
            "firmwareOwnerId": { "type": "string", "minLength": 1 },
            "verifiedAtUtc": { "$ref": "#/$defs/canonicalUtc" }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": { "oneOf": [{ "$ref": "#/$defs/exactEvidence" }, { "$ref": "#/$defs/transitiveEvidence" }] }
    },
    "verdict": { "const": "pass" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonicalUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"
    },
    "routeId": { "type": "string", "pattern": "^route-[a-z0-9-]+$" },
    "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "authorityTrees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "profiles", "external-tools", "tools/crc-worker"],
      "properties": {
        "src": { "$ref": "#/$defs/gitSha" },
        "profiles": { "$ref": "#/$defs/gitSha" },
        "external-tools": { "$ref": "#/$defs/gitSha" },
        "tools/crc-worker": { "$ref": "#/$defs/gitSha" }
      }
    },
    "remoteArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "digest", "memberName", "createdAtUtc", "workflowRun", "member"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256Digest" },
        "memberName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "member": { "$ref": "#/$defs/artifact" },
        "workflowRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "repositoryId", "headRepositoryId", "headBranch", "headSha"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "repositoryId": { "type": "integer", "minimum": 1 },
            "headRepositoryId": { "type": "integer", "minimum": 1 },
            "headBranch": { "const": "main" },
            "headSha": { "$ref": "#/$defs/gitSha" }
          }
        }
      }
    },
    "protectedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "repositoryId", "headRepositoryId", "workflowPath", "workflowRef", "workflowCommitSha", "workflowBlobSha", "workflowRawSha256", "workflowSemanticContractSha256", "workflowRun", "attestationJob", "deployment", "deploymentStatus", "comparisonArtifact", "attestationArtifact", "verificationArtifact", "ownerVerification"],
      "properties": {
        "repository": { "const": "Dennis40816/nvt_fw_combiner" },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "headRepositoryId": { "type": "integer", "minimum": 1 },
        "workflowPath": { "const": ".github/workflows/release.yml" },
        "workflowRef": { "const": "refs/heads/main" },
        "workflowCommitSha": { "$ref": "#/$defs/gitSha" },
        "workflowBlobSha": { "$ref": "#/$defs/gitSha" },
        "workflowRawSha256": { "$ref": "#/$defs/sha256" },
        "workflowSemanticContractSha256": { "const": "faa1be61a2072a8d7b7b0ebb57589cd4e20080f61d9a57533ee47c26ceddbb4d" },
        "workflowRun": { "$ref": "#/$defs/protectedWorkflowRun" },
        "attestationJob": { "$ref": "#/$defs/protectedJob" },
        "deployment": { "$ref": "#/$defs/protectedDeployment" },
        "deploymentStatus": { "$ref": "#/$defs/protectedDeploymentStatus" },
        "comparisonArtifact": { "$ref": "#/$defs/remoteArtifact" },
        "attestationArtifact": { "$ref": "#/$defs/remoteArtifact" },
        "verificationArtifact": { "$ref": "#/$defs/remoteArtifact" },
        "ownerVerification": { "$ref": "#/$defs/ownerVerification" }
      }
    },
    "ownerVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestationId", "firmwareOwnerId", "verifiedAtUtc", "verificationRecordSha256"],
      "properties": {
        "attestationId": { "type": "string", "minLength": 1 },
        "firmwareOwnerId": { "type": "string", "minLength": 1 },
        "verifiedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "verificationRecordSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "protectedWorkflowRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runAttempt", "headSha", "headBranch", "event", "status", "conclusion", "repositoryId", "headRepositoryId", "createdAtUtc", "updatedAtUtc"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "headBranch": { "const": "main" },
        "event": { "enum": ["workflow_dispatch", "push"] },
        "status": { "enum": ["in_progress", "completed"] },
        "conclusion": { "type": ["string", "null"], "enum": [null, "success"] },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "headRepositoryId": { "type": "integer", "minimum": 1 },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "updatedAtUtc": { "$ref": "#/$defs/canonicalUtc" }
      }
    },
    "protectedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "runAttempt", "headSha", "headBranch", "name", "status", "conclusion", "startedAtUtc", "completedAtUtc", "htmlUrl"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "headBranch": { "const": "main" },
        "name": { "const": "release / v0.9.16 parity attestation" },
        "status": { "const": "completed" },
        "conclusion": { "const": "success" },
        "startedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "completedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "htmlUrl": { "type": "string", "pattern": "^https://github\\.com/Dennis40816/nvt_fw_combiner/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*$" }
      }
    },
    "protectedDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha", "ref", "environment", "createdAtUtc"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "sha": { "$ref": "#/$defs/gitSha" },
        "ref": { "const": "main" },
        "environment": { "const": "firmware-parity" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" }
      }
    },
    "protectedDeploymentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "createdAtUtc", "updatedAtUtc", "logUrl"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "state": { "const": "success" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "updatedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "logUrl": { "type": "string", "pattern": "^https://github\\.com/Dennis40816/nvt_fw_combiner/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 },
        "sourceCommit": { "$ref": "#/$defs/gitSha" }
      }
    },
    "authorityTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedBindingChildPaths"],
      "properties": {
        "allowedBindingChildPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "baselineExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tagObject", "peeledCommit", "sourceTree", "resolvedSdkVersion", "contract", "cliAssembly"],
      "properties": {
        "kind": { "const": "exact-tag-source-built-cli" },
        "tagObject": { "const": "578b2614632d6c2affdf2000324b134b5d1a16c1" },
        "peeledCommit": { "const": "462590e8b993b8e42d088bc07377571a4bb9f25d" },
        "sourceTree": { "const": "dc46c9aa9ecf00cb898ba3bc287e1b15acdab735" },
        "resolvedSdkVersion": { "const": "10.0.303" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "sha256"],
          "properties": {
            "size": { "const": 3730 },
            "sha256": { "const": "92e400212b5cdbb5e164b4d1401d59cdd1adbb0aef9a490be4777554d5b1e659" }
          }
        },
        "cliAssembly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "sha256"],
          "properties": {
            "size": { "const": 14848 },
            "sha256": { "const": "093212528d1048acdb43563ba795353e1ac872f8b6a3aa99251782e958ad1a30" }
          }
        }
      }
    },
    "releaseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "purpose"],
      "properties": {
        "name": { "const": "NvtFwCombiner-v0.9.16-win-x64.zip" },
        "size": { "const": 75556385 },
        "sha256": { "const": "e55687f9d98ca3a2b02eac5789f4443697a249dcc60b261e3e6cfeae7dc03c84" },
        "purpose": { "const": "release-provenance-reference-only" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icId", "workflowId", "icCountVariant", "mapVariant", "selectionToken", "outputCapacity", "orderedInputs"],
      "properties": {
        "icId": { "type": "string", "pattern": "^NT[0-9]{5}$" },
        "workflowId": { "enum": ["standard-merge", "ab-merge", "ctrlram-replace"] },
        "icCountVariant": { "type": "string", "minLength": 1 },
        "mapVariant": { "type": "string", "minLength": 1 },
        "selectionToken": { "type": "string", "minLength": 1 },
        "outputCapacity": { "type": "integer", "minimum": 1 },
        "orderedInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "role", "size", "sha256"],
            "properties": {
              "slotId": { "type": "string", "minLength": 1 },
              "role": { "enum": ["base", "replacement", "source"] },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "operatorLogin", "executorIdentitySha256", "receiptSha256", "invocationSha256", "report"],
      "properties": {
        "role": { "enum": ["baseline-exact", "candidate-exact", "candidate-tp"] },
        "operatorLogin": { "$ref": "#/$defs/githubLogin" },
        "executorIdentitySha256": { "$ref": "#/$defs/sha256" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "invocationSha256": { "$ref": "#/$defs/sha256" },
        "report": { "$ref": "#/$defs/artifact" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "baseline-exact" } }, "required": ["role"] },
          "then": { "properties": { "executorIdentitySha256": { "const": "92e400212b5cdbb5e164b4d1401d59cdd1adbb0aef9a490be4777554d5b1e659" } } }
        }
      ]
    },
    "exactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "capabilityFingerprint", "proofKind", "scenario", "compilationFingerprints", "reportValidation", "receipts", "baselineOutput", "candidateOutput", "equal", "passed"],
      "properties": {
        "routeId": { "$ref": "#/$defs/routeId" },
        "capabilityFingerprint": { "$ref": "#/$defs/sha256" },
        "proofKind": { "enum": ["exact-output", "exact-output-with-approved-semantic-correction"] },
        "scenario": { "$ref": "#/$defs/scenario" },
        "compilationFingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate"],
          "properties": {
            "baseline": { "$ref": "#/$defs/sha256" },
            "candidate": { "$ref": "#/$defs/sha256" }
          }
        },
        "reportValidation": { "$ref": "#/$defs/independentReportValidation" },
        "receipts": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/receipt" },
                { "properties": { "role": { "const": "baseline-exact" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/receipt" },
                { "properties": { "role": { "const": "candidate-exact" } } }
              ]
            }
          ],
          "items": false
        },
        "baselineOutput": { "$ref": "#/$defs/artifact" },
        "candidateOutput": { "$ref": "#/$defs/artifact" },
        "equal": { "type": "boolean" },
        "differenceValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ownerDecision", "differentByteCount", "differentRanges"],
          "properties": {
            "kind": { "const": "owner-approved-diff-nf-preservation" },
            "ownerDecision": { "const": "owner-decision:2026-08-28:nt51951-diff-nf-preservation-is-correct" },
            "differentByteCount": { "const": 2816 },
            "differentRanges": {
              "type": "array",
              "prefixItems": [
                { "const": { "start": 41244, "endExclusive": 41248 } },
                { "const": { "start": 41264, "endExclusive": 41268 } },
                { "const": { "start": 185384, "endExclusive": 185388 } },
                { "const": { "start": 185404, "endExclusive": 185408 } },
                { "const": { "start": 211728, "endExclusive": 214528 } }
              ],
              "items": false
            }
          }
        },
        "passed": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "proofKind": { "const": "exact-output" } }, "required": ["proofKind"] },
          "then": {
            "properties": { "equal": { "const": true } },
            "not": { "required": ["differenceValidation"] }
          }
        },
        {
          "if": { "properties": { "proofKind": { "const": "exact-output-with-approved-semantic-correction" } }, "required": ["proofKind"] },
          "then": {
            "required": ["differenceValidation"],
            "properties": {
              "routeId": { "const": "route-7-nt51951-15-ctrlram-replace-4-2-ic-39-nt51951-ctrlram-fw1x-cascade-full-flash" },
              "capabilityFingerprint": { "const": "6a8dfcce871d0aa5586a8bd2a393093776b687055e546d7dce37fb2e9f35909f" },
              "baselineOutput": { "const": { "size": 524288, "sha256": "7d657a3d0abc2cc6779e759c17567b40740de95235bf6d1e71c147d815edcca2" } },
              "candidateOutput": { "const": { "size": 524288, "sha256": "1536d344af83aafd29e5884d9d2d904f1efa03c8fdcc4e913832253814644ebd" } },
              "equal": { "const": false }
            }
          }
        }
      ]
    },
    "independentReportValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "baseline", "candidate", "crossVersionOperationComparison", "passed"],
      "properties": {
        "kind": { "const": "independent-executor-typed-authority" },
        "baseline": { "$ref": "#/$defs/validatedReport" },
        "candidate": { "$ref": "#/$defs/validatedReport" },
        "crossVersionOperationComparison": { "const": "not-applied-executor-specific" },
        "passed": { "const": true }
      }
    },
    "validatedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawReportSha256", "projectionSha256", "compiledAuthoritySha256", "passed"],
      "properties": {
        "rawReportSha256": { "$ref": "#/$defs/sha256" },
        "projectionSha256": { "$ref": "#/$defs/sha256" },
        "compiledAuthoritySha256": { "$ref": "#/$defs/sha256" },
        "passed": { "const": true }
      }
    },
    "transitiveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "capabilityFingerprint", "proofKind", "fullEvidence", "tpLength", "tpScenario", "candidateCompilationFingerprint", "receipts", "candidateTpOutput", "candidateFullInput", "candidateTpEqualsCandidateFullPrefix", "candidateTpEqualsBaselineFullPrefix", "candidateFullTailImmutable", "passed"],
      "properties": {
        "routeId": { "$ref": "#/$defs/routeId" },
        "capabilityFingerprint": { "$ref": "#/$defs/sha256" },
        "proofKind": { "const": "tp-prefix-transitive" },
        "fullEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routeId", "capabilityFingerprint", "evidenceSha256"],
          "properties": {
            "routeId": { "$ref": "#/$defs/routeId" },
            "capabilityFingerprint": { "$ref": "#/$defs/sha256" },
            "evidenceSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "tpLength": { "type": "integer", "minimum": 1 },
        "tpScenario": { "$ref": "#/$defs/scenario" },
        "candidateCompilationFingerprint": { "$ref": "#/$defs/sha256" },
        "receipts": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/receipt" },
                { "properties": { "role": { "const": "candidate-tp" } } }
              ]
            }
          ],
          "items": false
        },
        "candidateTpOutput": { "$ref": "#/$defs/artifact" },
        "candidateFullInput": { "$ref": "#/$defs/artifact" },
        "candidateTpEqualsCandidateFullPrefix": { "const": true },
        "candidateTpEqualsBaselineFullPrefix": { "const": true },
        "candidateFullTailImmutable": { "const": true },
        "passed": { "const": true }
      }
    }
  }
}
