{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/v0916-parity-owner-attestation-v1.schema.json",
  "title": "Payload-free firmware-owner parity approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "binding", "authorizedOperators", "issuedAtUtc", "verdict"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "attestationId", "firmwareOwnerId", "issuedAtUtc", "verificationRequired"],
      "properties": {
        "kind": { "const": "external-firmware-owner-attestation" },
        "attestationId": { "type": "string", "minLength": 1 },
        "firmwareOwnerId": { "type": "string", "minLength": 1 },
        "issuedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "verificationRequired": { "const": true }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonSha256", "comparisonArtifactId", "comparisonArtifactDigest", "planSha256", "policySha256", "implementationHead", "implementationTree", "candidatePackageSha256", "candidateManifestSha256", "candidateArtifactDigest", "routeEvidenceSha256", "receiptSetSha256"],
      "properties": {
        "comparisonSha256": { "$ref": "#/$defs/sha256" },
        "comparisonArtifactId": { "type": "integer", "minimum": 1 },
        "comparisonArtifactDigest": { "$ref": "#/$defs/sha256Digest" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "policySha256": { "$ref": "#/$defs/sha256" },
        "implementationHead": { "$ref": "#/$defs/gitSha" },
        "implementationTree": { "$ref": "#/$defs/gitSha" },
        "candidatePackageSha256": { "$ref": "#/$defs/sha256" },
        "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
        "candidateArtifactDigest": { "$ref": "#/$defs/sha256Digest" },
        "routeEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "receiptSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorizedOperators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/githubLogin" }
    },
    "issuedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
    "verdict": { "const": "approved" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonicalUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"
    },
    "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
  }
}
