{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/predecessor-comparison-report-v1.schema.json",
  "title": "NVT FW Combiner predecessor comparison report (proposed)",
  "$comment": "Proposed interface: the report-reader record revises it before any report of record. The schema holds only relations inside one report; source, coverage, declaration, approval and digest consistency across documents belongs to the comparator's single semantic validator.",
  "oneOf": [
    { "$ref": "#/$defs/rollingReport" },
    { "$ref": "#/$defs/v0916Report" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "stableTag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "routeId": { "type": "string", "pattern": "^route-[a-z0-9-]+$" },
    "entryId": { "type": "string", "pattern": "^RP-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-[0-9]{2,}$" },
    "stage": { "enum": ["build", "precursor-build", "precursor-preview", "preview"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/contracts/[a-z0-9.-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scriptSha256", "contracts"],
      "properties": {
        "scriptSha256": { "$ref": "#/$defs/sha256" },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fileIdentity" }
        }
      }
    },
    "executorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityTrees", "cliSha256", "commit", "lockFileSetSha256", "resolvedSdkVersion", "runtimeClosureSha256", "tagObject", "tree"],
      "properties": {
        "authorityTrees": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external-tools", "profiles", "src", "tools/crc-worker"],
          "properties": {
            "external-tools": { "$ref": "#/$defs/gitSha" },
            "profiles": { "$ref": "#/$defs/gitSha" },
            "src": { "$ref": "#/$defs/gitSha" },
            "tools/crc-worker": { "$ref": "#/$defs/gitSha" }
          }
        },
        "cliSha256": { "$ref": "#/$defs/sha256" },
        "commit": { "$ref": "#/$defs/gitSha" },
        "lockFileSetSha256": { "$ref": "#/$defs/sha256" },
        "resolvedSdkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "runtimeClosureSha256": { "$ref": "#/$defs/sha256" },
        "tagObject": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/gitSha" }] },
        "tree": { "$ref": "#/$defs/gitSha" }
      }
    },
    "taggedExecutorIdentity": {
      "allOf": [
        { "$ref": "#/$defs/executorIdentity" },
        { "properties": { "tagObject": { "$ref": "#/$defs/gitSha" } } }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executor"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "executor": { "$ref": "#/$defs/executorIdentity" }
      }
    },
    "settingsObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256Before", "sha256After"],
      "properties": {
        "sha256Before": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "sha256After": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "temporaryRootLength", "perUserSettings"],
      "properties": {
        "policy": { "const": "per-user-settings-absent-before-and-after" },
        "temporaryRootLength": { "type": "integer", "minimum": 1, "maximum": 64 },
        "perUserSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event-buffer-format.v1.json", "toolchain-runtime.v1.json"],
          "properties": {
            "event-buffer-format.v1.json": { "$ref": "#/$defs/settingsObservation" },
            "toolchain-runtime.v1.json": { "$ref": "#/$defs/settingsObservation" }
          }
        }
      }
    },
    "absentSettings": {
      "properties": {
        "sha256Before": { "const": null },
        "sha256After": { "const": null }
      }
    },
    "formalEnvironment": {
      "properties": {
        "perUserSettings": {
          "properties": {
            "event-buffer-format.v1.json": { "$ref": "#/$defs/absentSettings" },
            "toolchain-runtime.v1.json": { "$ref": "#/$defs/absentSettings" }
          }
        }
      }
    },
    "processFailureIssueCode": { "enum": ["external-tool.process.failed"] },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "source"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "info", "unspecified", "warning"] },
        "source": { "enum": ["report", "stderr"] }
      }
    },
    "capturedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "readerVersion", "unknownMembers"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "readerVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "unknownMembers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "exitCode", "timedOut", "stdoutSha256", "stderrSha256", "inputsUnchanged", "report"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrSha256": { "$ref": "#/$defs/sha256" },
        "inputsUnchanged": { "type": "boolean" },
        "report": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/capturedReport" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "timedOut": { "const": true } }, "required": ["timedOut"] },
          "then": { "properties": { "exitCode": { "const": null } } },
          "else": { "properties": { "exitCode": { "type": "integer" } } }
        }
      ]
    },
    "sideResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stoppedAt", "issues", "precursor", "output", "processes"],
      "properties": {
        "status": { "enum": ["invalid", "output", "rejected"] },
        "stoppedAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stage" }] },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "precursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "output": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/process" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "output" } }, "required": ["status"] },
          "then": {
            "properties": {
              "stoppedAt": { "const": null },
              "output": { "$ref": "#/$defs/artifact" },
              "issues": {
                "items": {
                  "properties": {
                    "severity": { "not": { "const": "error" } },
                    "source": { "const": "report" },
                    "code": { "not": { "$ref": "#/$defs/processFailureIssueCode" } }
                  }
                }
              },
              "processes": {
                "items": {
                  "properties": {
                    "exitCode": { "const": 0 },
                    "inputsUnchanged": { "const": true },
                    "report": { "$ref": "#/$defs/capturedReport" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": {
            "properties": {
              "stoppedAt": { "$ref": "#/$defs/stage" },
              "output": { "const": null },
              "issues": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "source": { "const": "report" },
                    "code": { "not": { "$ref": "#/$defs/processFailureIssueCode" } }
                  }
                },
                "contains": { "properties": { "severity": { "const": "error" } }, "required": ["severity"] }
              },
              "processes": {
                "items": {
                  "properties": {
                    "timedOut": { "const": false },
                    "inputsUnchanged": { "const": true },
                    "report": { "$ref": "#/$defs/capturedReport" }
                  }
                },
                "contains": {
                  "properties": {
                    "exitCode": { "type": "integer", "not": { "const": 0 } },
                    "report": { "$ref": "#/$defs/capturedReport" }
                  },
                  "required": ["exitCode", "report"]
                }
              }
            }
          }
        }
      ]
    },
    "outputSide": {
      "allOf": [
        { "$ref": "#/$defs/sideResult" },
        { "properties": { "status": { "const": "output" } }, "required": ["status"] }
      ]
    },
    "rejectedSide": {
      "allOf": [
        { "$ref": "#/$defs/sideResult" },
        { "properties": { "status": { "const": "rejected" } }, "required": ["status"] }
      ]
    },
    "optionalSide": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sideResult" }] },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "endExclusive"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "endExclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "rangeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["differentByteCount", "rangeCount", "rangeListSha256", "ranges", "rangesTruncated"],
      "properties": {
        "differentByteCount": { "type": "integer", "minimum": 1 },
        "rangeCount": { "type": "integer", "minimum": 1 },
        "rangeListSha256": { "$ref": "#/$defs/sha256" },
        "ranges": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/range" } },
        "rangesTruncated": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "rangesTruncated": { "const": true } }, "required": ["rangesTruncated"] },
          "then": { "properties": { "ranges": { "minItems": 32 }, "rangeCount": { "minimum": 33 } } },
          "else": { "properties": { "rangeCount": { "maximum": 32 } } }
        }
      ]
    },
    "optionalComparison": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rangeComparison" }] },
    "informational": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "baseline", "candidate"],
        "properties": {
          "field": { "enum": ["capability-fingerprint", "issue-codes", "map-id", "operation-projection-sha256"] },
          "baseline": { "type": ["string", "null"] },
          "candidate": { "type": ["string", "null"] }
        }
      }
    },
    "scenarioFailureCode": {
      "enum": [
        "PREDECESSOR_ENVIRONMENT_INVALID",
        "PREDECESSOR_EXECUTOR_INVALID",
        "PREDECESSOR_INPUT_INVALID",
        "PREDECESSOR_PROCESS_FAILED",
        "PREDECESSOR_REPORT_INVALID"
      ]
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "routeId",
        "inputRevision",
        "outcome",
        "baseline",
        "candidate",
        "comparison",
        "precursorComparison",
        "failureCode",
        "declarationEntryId",
        "informational"
      ],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "routeId": { "$ref": "#/$defs/routeId" },
        "inputRevision": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["baseline-rejects", "both-reject", "candidate-rejects", "different", "equal", "invalid"] },
        "baseline": { "$ref": "#/$defs/optionalSide" },
        "candidate": { "$ref": "#/$defs/optionalSide" },
        "comparison": { "$ref": "#/$defs/optionalComparison" },
        "precursorComparison": { "$ref": "#/$defs/optionalComparison" },
        "failureCode": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/scenarioFailureCode" }] },
        "declarationEntryId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/entryId" }] },
        "informational": { "$ref": "#/$defs/informational" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "precursorComparison": { "type": "object" } },
            "required": ["precursorComparison"]
          },
          "then": {
            "properties": {
              "baseline": { "type": "object", "properties": { "precursor": { "$ref": "#/$defs/artifact" } } },
              "candidate": { "type": "object", "properties": { "precursor": { "$ref": "#/$defs/artifact" } } }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "equal" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/outputSide" },
              "candidate": { "$ref": "#/$defs/outputSide" },
              "comparison": { "const": null },
              "precursorComparison": { "const": null },
              "failureCode": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "different" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/outputSide" },
              "candidate": { "$ref": "#/$defs/outputSide" },
              "failureCode": { "const": null }
            },
            "anyOf": [
              { "properties": { "comparison": { "$ref": "#/$defs/rangeComparison" } } },
              { "properties": { "precursorComparison": { "$ref": "#/$defs/rangeComparison" } } }
            ]
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "baseline-rejects" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/rejectedSide" },
              "candidate": { "$ref": "#/$defs/outputSide" },
              "comparison": { "const": null },
              "failureCode": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "candidate-rejects" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/outputSide" },
              "candidate": { "$ref": "#/$defs/rejectedSide" },
              "comparison": { "const": null },
              "failureCode": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "both-reject" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/rejectedSide" },
              "candidate": { "$ref": "#/$defs/rejectedSide" },
              "comparison": { "const": null },
              "failureCode": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "invalid" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "failureCode": { "$ref": "#/$defs/scenarioFailureCode" },
              "declarationEntryId": { "const": null }
            }
          }
        }
      ]
    },
    "clearScenario": {
      "properties": { "outcome": { "not": { "const": "invalid" } } },
      "if": { "properties": { "outcome": { "const": "equal" } }, "required": ["outcome"] },
      "then": { "properties": { "declarationEntryId": { "const": null } } },
      "else": { "properties": { "declarationEntryId": { "$ref": "#/$defs/entryId" } } }
    },
    "rollingFailureCode": {
      "enum": [
        "PREDECESSOR_BASELINE_INVALID",
        "PREDECESSOR_CONTRACT_PENDING",
        "PREDECESSOR_COVERAGE_INCOMPLETE",
        "PREDECESSOR_COVERAGE_UNDISPOSED",
        "PREDECESSOR_ENVIRONMENT_INVALID",
        "PREDECESSOR_EXECUTOR_INVALID",
        "PREDECESSOR_INPUT_INVALID",
        "PREDECESSOR_PROCESS_FAILED",
        "PREDECESSOR_RELEASE_NOTE_MISSING",
        "PREDECESSOR_REPORT_INVALID",
        "PREDECESSOR_SOURCE_MISMATCH",
        "PREDECESSOR_STALE_DECLARATION",
        "PREDECESSOR_UNDECLARED_CHANGE"
      ]
    },
    "v0916FailureCode": {
      "enum": [
        "PREDECESSOR_AMENDMENT_MISMATCH",
        "PREDECESSOR_BASELINE_INVALID",
        "PREDECESSOR_CONTRACT_PENDING",
        "PREDECESSOR_ENVIRONMENT_INVALID",
        "PREDECESSOR_EXECUTOR_INVALID",
        "PREDECESSOR_INPUT_INVALID",
        "PREDECESSOR_PROCESS_FAILED",
        "PREDECESSOR_REPORT_INVALID",
        "PREDECESSOR_SOURCE_MISMATCH",
        "PREDECESSOR_UNAPPROVED_DIFFERENCE"
      ]
    },
    "rollingGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "failures"],
      "properties": {
        "result": { "enum": ["blocked", "clear"] },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "subject", "detail"],
            "properties": {
              "code": { "$ref": "#/$defs/rollingFailureCode" },
              "subject": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "clear" } }, "required": ["result"] },
          "then": { "properties": { "failures": { "maxItems": 0 } } },
          "else": { "properties": { "failures": { "minItems": 1 } } }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe", "coveredRoutes", "scenarios", "debtSetInUniverse", "acceptedGaps", "pendingAcceptedGaps", "notCovered", "changesSinceBaseline"],
      "properties": {
        "universe": { "type": "integer", "minimum": 0 },
        "coveredRoutes": { "type": "integer", "minimum": 0 },
        "scenarios": { "type": "integer", "minimum": 0 },
        "debtSetInUniverse": { "type": "integer", "minimum": 0 },
        "acceptedGaps": { "type": "integer", "minimum": 0 },
        "pendingAcceptedGaps": { "type": "integer", "minimum": 0 },
        "notCovered": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["routeId", "reason", "evidenceKind"],
            "properties": {
              "routeId": { "$ref": "#/$defs/routeId" },
              "reason": { "enum": ["accepted-gap", "debt-set", "pending-gap"] },
              "evidenceKind": { "enum": ["approved-alias", "contract-only", "direct-golden", "missing", "synthetic-oracle"] }
            }
          }
        },
        "changesSinceBaseline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject", "declarationEntryId"],
            "properties": {
              "kind": { "enum": ["accepted-gap", "input-revision", "scenario-added", "scenario-retired"] },
              "subject": { "type": "string", "minLength": 1 },
              "declarationEntryId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/entryId" }] }
            }
          }
        }
      }
    },
    "clearCoverage": {
      "properties": {
        "pendingAcceptedGaps": { "const": 0 },
        "notCovered": { "items": { "properties": { "reason": { "not": { "const": "pending-gap" } } } } },
        "changesSinceBaseline": {
          "items": {
            "if": { "properties": { "kind": { "const": "scenario-added" } }, "required": ["kind"] },
            "then": true,
            "else": { "properties": { "declarationEntryId": { "$ref": "#/$defs/entryId" } } }
          }
        }
      }
    },
    "rollingReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "certification",
        "terminal",
        "mode",
        "formal",
        "comparator",
        "candidate",
        "baseline",
        "ledgerSha256",
        "declarationSha256",
        "environment",
        "scenarios",
        "coverage",
        "gate",
        "deterministicSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "predecessor-comparison-report" },
        "certification": { "const": "none" },
        "terminal": { "const": false },
        "mode": { "const": "rolling" },
        "formal": { "type": "boolean" },
        "comparator": { "$ref": "#/$defs/comparator" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tag", "executor"],
          "properties": {
            "kind": { "const": "previous-release" },
            "tag": { "$ref": "#/$defs/stableTag" },
            "executor": { "$ref": "#/$defs/taggedExecutorIdentity" }
          }
        },
        "ledgerSha256": { "$ref": "#/$defs/sha256" },
        "declarationSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "environment": { "$ref": "#/$defs/environment" },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioResult" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "gate": { "$ref": "#/$defs/rollingGate" },
        "deterministicSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "formal": { "const": true } }, "required": ["formal"] },
          "then": { "properties": { "environment": { "$ref": "#/$defs/formalEnvironment" } } }
        },
        {
          "if": {
            "properties": { "gate": { "properties": { "result": { "const": "clear" } }, "required": ["result"] } },
            "required": ["gate"]
          },
          "then": {
            "properties": {
              "scenarios": { "items": { "$ref": "#/$defs/clearScenario" } },
              "coverage": { "$ref": "#/$defs/clearCoverage" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "formal": { "const": true },
              "gate": { "properties": { "result": { "const": "clear" } }, "required": ["result"] }
            },
            "required": ["formal", "gate"]
          },
          "then": { "properties": { "declarationSha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "dispositionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "member", "routeId"],
      "properties": {
        "source": { "enum": ["amendment", "plan"] },
        "member": { "enum": ["approvedSemanticCorrections", "baselineNotApplicable"] },
        "routeId": { "$ref": "#/$defs/routeId" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "plan" } }, "required": ["source"] },
          "then": { "properties": { "member": { "const": "approvedSemanticCorrections" } } }
        }
      ]
    },
    "transitiveProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullRouteId", "tpLength", "candidateTpEqualsCandidateFullPrefix", "candidateTpEqualsBaselineFullPrefix", "candidateFullTailImmutable"],
      "properties": {
        "fullRouteId": { "$ref": "#/$defs/routeId" },
        "tpLength": { "type": "integer", "minimum": 1 },
        "candidateTpEqualsCandidateFullPrefix": { "type": "boolean" },
        "candidateTpEqualsBaselineFullPrefix": { "type": "boolean" },
        "candidateFullTailImmutable": { "type": "boolean" }
      }
    },
    "routeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planRouteId",
        "planCapabilityFingerprint",
        "proofKind",
        "result",
        "dispositionRow",
        "baseline",
        "candidate",
        "comparison",
        "transitive",
        "failureCode",
        "informational"
      ],
      "properties": {
        "planRouteId": { "$ref": "#/$defs/routeId" },
        "planCapabilityFingerprint": { "$ref": "#/$defs/sha256" },
        "proofKind": {
          "enum": ["canonical-binding-not-applicable-to-v0916", "exact-output", "exact-output-with-approved-semantic-correction", "not-covered", "tp-prefix-transitive"]
        },
        "result": { "enum": ["consistent", "inconsistent", "invalid", "not-covered"] },
        "dispositionRow": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dispositionRow" }] },
        "baseline": { "$ref": "#/$defs/optionalSide" },
        "candidate": { "$ref": "#/$defs/optionalSide" },
        "comparison": { "$ref": "#/$defs/optionalComparison" },
        "transitive": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/transitiveProof" }] },
        "failureCode": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/v0916FailureCode" }] },
        "informational": { "$ref": "#/$defs/informational" }
      },
      "allOf": [
        {
          "if": { "properties": { "proofKind": { "const": "not-covered" } }, "required": ["proofKind"] },
          "then": {
            "properties": {
              "result": { "const": "not-covered" },
              "dispositionRow": { "const": null },
              "baseline": { "const": null },
              "candidate": { "const": null },
              "comparison": { "const": null },
              "transitive": { "const": null },
              "failureCode": { "const": null }
            }
          },
          "else": { "properties": { "result": { "not": { "const": "not-covered" } } } }
        },
        {
          "if": { "properties": { "result": { "const": "consistent" } }, "required": ["result"] },
          "then": { "properties": { "failureCode": { "const": null } } }
        },
        {
          "if": { "properties": { "result": { "enum": ["inconsistent", "invalid"] } }, "required": ["result"] },
          "then": { "properties": { "failureCode": { "$ref": "#/$defs/v0916FailureCode" } } }
        },
        {
          "if": { "properties": { "proofKind": { "const": "exact-output" } }, "required": ["proofKind"] },
          "then": { "properties": { "dispositionRow": { "const": null }, "transitive": { "const": null } } }
        },
        {
          "if": { "properties": { "proofKind": { "const": "exact-output" }, "result": { "const": "consistent" } }, "required": ["proofKind", "result"] },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/outputSide" },
              "candidate": { "$ref": "#/$defs/outputSide" },
              "comparison": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "proofKind": { "const": "exact-output-with-approved-semantic-correction" } }, "required": ["proofKind"] },
          "then": {
            "properties": {
              "dispositionRow": {
                "$ref": "#/$defs/dispositionRow",
                "properties": { "member": { "const": "approvedSemanticCorrections" } }
              },
              "transitive": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": { "proofKind": { "const": "exact-output-with-approved-semantic-correction" }, "result": { "const": "consistent" } },
            "required": ["proofKind", "result"]
          },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/outputSide" },
              "candidate": { "$ref": "#/$defs/outputSide" },
              "comparison": { "$ref": "#/$defs/rangeComparison" }
            }
          }
        },
        {
          "if": { "properties": { "proofKind": { "const": "tp-prefix-transitive" } }, "required": ["proofKind"] },
          "then": {
            "properties": {
              "dispositionRow": { "const": null },
              "baseline": { "const": null },
              "comparison": { "const": null },
              "transitive": { "$ref": "#/$defs/transitiveProof" }
            }
          }
        },
        {
          "if": { "properties": { "proofKind": { "const": "tp-prefix-transitive" }, "result": { "const": "consistent" } }, "required": ["proofKind", "result"] },
          "then": {
            "properties": {
              "candidate": { "$ref": "#/$defs/outputSide" },
              "transitive": {
                "properties": {
                  "candidateTpEqualsCandidateFullPrefix": { "const": true },
                  "candidateTpEqualsBaselineFullPrefix": { "const": true },
                  "candidateFullTailImmutable": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "proofKind": { "const": "canonical-binding-not-applicable-to-v0916" } }, "required": ["proofKind"] },
          "then": {
            "properties": {
              "dispositionRow": {
                "$ref": "#/$defs/dispositionRow",
                "properties": { "source": { "const": "amendment" }, "member": { "const": "baselineNotApplicable" } }
              },
              "comparison": { "const": null },
              "transitive": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": { "proofKind": { "const": "canonical-binding-not-applicable-to-v0916" }, "result": { "const": "consistent" } },
            "required": ["proofKind", "result"]
          },
          "then": {
            "properties": {
              "baseline": { "$ref": "#/$defs/rejectedSide" },
              "candidate": { "$ref": "#/$defs/outputSide" }
            }
          }
        }
      ]
    },
    "v0916Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "certification",
        "terminal",
        "mode",
        "formal",
        "milestone",
        "comparator",
        "candidate",
        "baseline",
        "planBinding",
        "amendmentSha256",
        "environment",
        "routes",
        "summary",
        "result",
        "failures",
        "deterministicSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "predecessor-comparison-report" },
        "certification": { "const": "none" },
        "terminal": { "const": false },
        "mode": { "const": "v0916-1x" },
        "formal": { "type": "boolean" },
        "milestone": { "enum": ["1.1.13-final-candidate", "1.2.0-release-approval", "before-ro-1-decision", null] },
        "comparator": { "$ref": "#/$defs/comparator" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tag", "executor"],
          "properties": {
            "kind": { "const": "v0916" },
            "tag": { "const": "v0.9.16" },
            "executor": { "$ref": "#/$defs/taggedExecutorIdentity" }
          }
        },
        "planBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "withoutCandidateAuthorityJcsSha256", "canonicalInputAuthorityJcsSha256"],
          "properties": {
            "path": { "const": "docs/contracts/v0916-parity-certification-v1.json" },
            "withoutCandidateAuthorityJcsSha256": { "$ref": "#/$defs/sha256" },
            "canonicalInputAuthorityJcsSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "amendmentSha256": { "$ref": "#/$defs/sha256" },
        "environment": { "$ref": "#/$defs/environment" },
        "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routeResult" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consistent", "inconsistent", "invalid", "notCovered"],
          "properties": {
            "consistent": { "type": "integer", "minimum": 0 },
            "inconsistent": { "type": "integer", "minimum": 0 },
            "invalid": { "type": "integer", "minimum": 0 },
            "notCovered": { "type": "integer", "minimum": 0 }
          }
        },
        "result": { "enum": ["consistent", "inconsistent", "invalid"] },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "subject", "detail"],
            "properties": {
              "code": { "$ref": "#/$defs/v0916FailureCode" },
              "subject": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" }
            }
          }
        },
        "deterministicSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "formal": { "const": true } }, "required": ["formal"] },
          "then": {
            "properties": {
              "environment": { "$ref": "#/$defs/formalEnvironment" },
              "milestone": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "consistent" } }, "required": ["result"] },
          "then": {
            "properties": {
              "failures": { "maxItems": 0 },
              "routes": { "items": { "properties": { "result": { "enum": ["consistent", "not-covered"] } } } },
              "summary": { "properties": { "inconsistent": { "const": 0 }, "invalid": { "const": 0 } } }
            }
          },
          "else": { "properties": { "failures": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "result": { "const": "inconsistent" } }, "required": ["result"] },
          "then": {
            "properties": {
              "routes": {
                "items": { "properties": { "result": { "not": { "const": "invalid" } } } },
                "contains": { "properties": { "result": { "const": "inconsistent" } }, "required": ["result"] }
              },
              "summary": { "properties": { "inconsistent": { "minimum": 1 }, "invalid": { "const": 0 } } }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "invalid" } }, "required": ["result"] },
          "then": {
            "properties": {
              "routes": { "contains": { "properties": { "result": { "const": "invalid" } }, "required": ["result"] } },
              "summary": { "properties": { "invalid": { "minimum": 1 } } }
            }
          }
        }
      ]
    }
  }
}
