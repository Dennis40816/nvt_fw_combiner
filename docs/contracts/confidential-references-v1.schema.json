{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/nvt_fw_combiner/confidential-references-v1.schema.json",
  "title": "NVT FW Combiner Confidential Reference Manifest 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sizeBytes", "sha256", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+(?:\\.[a-z0-9]+)*)*$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "enum": ["flash-map", "postbuild-script", "mmap-header", "flash-header", "firmware-source"] }
        }
      }
    }
  }
}
