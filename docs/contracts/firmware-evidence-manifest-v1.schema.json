{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nfc/schemas/firmware-evidence-manifest-v1.schema.json",
  "title": "NVT FW Combiner Firmware Evidence Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "manifestVersion",
    "status",
    "sourceArtifacts",
    "facts",
    "reviews"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "manifestId": { "$ref": "#/$defs/id" },
    "manifestVersion": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["candidate", "approved", "superseded"] },
    "intakeProvenance": { "$ref": "#/$defs/intakeProvenance" },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "intakeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "toolVersion", "generatedAt", "candidateOnly"],
      "properties": {
        "toolId": { "$ref": "#/$defs/id" },
        "toolVersion": { "$ref": "#/$defs/semver" },
        "generatedAt": { "$ref": "#/$defs/utcDateTime" },
        "candidateOnly": { "const": true }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "sourceKind",
        "logicalName",
        "contentHash",
        "sizeBytes"
      ],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "sourceKind": {
          "enum": ["workbook", "source-code", "firmware", "document", "issue-export", "owner-record"]
        },
        "logicalName": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "repositoryPath": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "location"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "factSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId"],
      "properties": {
        "familyId": { "$ref": "#/$defs/id" },
        "memberId": { "type": "string", "pattern": "^NT[0-9A-Z-]+$" },
        "modeId": { "$ref": "#/$defs/id" },
        "profileId": { "$ref": "#/$defs/id" }
      }
    },
    "factValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "addressSpaceId", "range"],
          "properties": {
            "kind": { "const": "range" },
            "addressSpaceId": { "$ref": "#/$defs/id" },
            "range": { "$ref": "#/$defs/byteRange" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "scalar" },
            "value": {
              "oneOf": [
                { "type": "boolean" },
                { "type": "integer" },
                { "type": "string", "minLength": 1 }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "targetId"],
          "properties": {
            "kind": { "const": "reference" },
            "targetId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "statement" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "subject",
        "factKind",
        "value",
        "disposition",
        "promotionImpact",
        "citations"
      ],
      "properties": {
        "factId": { "$ref": "#/$defs/id" },
        "subject": { "$ref": "#/$defs/factSubject" },
        "factKind": {
          "enum": [
            "range",
            "locator",
            "metadata-layout",
            "topology",
            "capability",
            "alias",
            "processor",
            "integrity",
            "output-naming",
            "golden"
          ]
        },
        "value": { "$ref": "#/$defs/factValue" },
        "disposition": { "enum": ["observed", "accepted", "rejected", "unresolved"] },
        "promotionImpact": {
          "enum": ["none", "blocks-map-resolution", "blocks-execution", "blocks-support"]
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "factKind": { "const": "range" }
            },
            "required": ["factKind"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "value": {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "range" }
                    },
                    "required": ["kind"]
                  }
                },
                "required": ["value"]
              },
              {
                "properties": {
                  "value": {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "statement" }
                    },
                    "required": ["kind"]
                  },
                  "disposition": { "const": "unresolved" },
                  "promotionImpact": { "const": "blocks-map-resolution" }
                },
                "required": ["value", "disposition", "promotionImpact"]
              }
            ]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "reviewer", "reviewedAt", "decision", "factIds"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/id" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "$ref": "#/$defs/utcDateTime" },
        "decision": { "enum": ["accept", "reject", "request-changes"] },
        "factIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
