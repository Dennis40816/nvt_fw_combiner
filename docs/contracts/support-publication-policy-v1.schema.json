{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nfc/schemas/support-publication-policy-v1.schema.json",
  "title": "NVT FW Combiner Support Publication Policy 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "issuedOn",
    "decisions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "policyId": { "$ref": "#/$defs/id" },
    "policyVersion": { "$ref": "#/$defs/semver" },
    "issuedOn": { "$ref": "#/$defs/isoDate" },
    "supersedesPolicyVersion": { "$ref": "#/$defs/semver" },
    "supersedesPolicySha256": { "$ref": "#/$defs/sha256" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "allOf": [
    {
      "if": { "required": ["supersedesPolicyVersion"] },
      "then": { "required": ["supersedesPolicySha256"] }
    },
    {
      "if": { "required": ["supersedesPolicySha256"] },
      "then": { "required": ["supersedesPolicyVersion"] }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicationStatus": {
      "enum": ["supported", "candidate", "internal", "test-only", "unclassified"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityKind", "recordedOn", "recordRef", "rationale"],
      "properties": {
        "authorityKind": { "const": "owner-decision" },
        "recordedOn": { "$ref": "#/$defs/isoDate" },
        "recordRef": { "type": "string", "pattern": "\\S" },
        "rationale": { "type": "string", "pattern": "\\S" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "routeId", "status", "provenance"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "routeId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/publicationStatus" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "supersedesDecisionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
