{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/v0916-parity-finalize-v1.schema.json",
  "title": "Local v0.9.16 parity finalization inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "comparison", "firmwareOwnerAttestation", "protectedRun", "approvalAuthority"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "comparison": { "$ref": "#/$defs/localArtifact" },
    "firmwareOwnerAttestation": { "$ref": "#/$defs/localArtifact" },
    "protectedRun": { "$ref": "#/$defs/protectedRun" },
    "approvalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verifierId", "verificationRecord"],
      "properties": {
        "kind": { "const": "external-firmware-owner-verification" },
        "verifierId": { "type": "string", "minLength": 1 },
        "verificationRecord": { "$ref": "#/$defs/localArtifact" }
      }
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonicalUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"
    },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "filePath": { "type": "string", "minLength": 1 },
    "remoteArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "digest", "memberName", "createdAtUtc", "workflowRun"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256Digest" },
        "memberName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "workflowRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "repositoryId", "headRepositoryId", "headBranch", "headSha"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "repositoryId": { "type": "integer", "minimum": 1 },
            "headRepositoryId": { "type": "integer", "minimum": 1 },
            "headBranch": { "const": "main" },
            "headSha": { "$ref": "#/$defs/gitSha" }
          }
        }
      }
    },
    "protectedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "repositoryId", "headRepositoryId", "workflowPath", "workflowRef", "workflowCommitSha", "workflowBlobSha", "workflowRawSha256", "workflowSemanticContractSha256", "workflowRun", "attestationJob", "deployment", "deploymentStatus", "comparisonArtifact", "attestationArtifact", "verificationArtifact"],
      "properties": {
        "repository": { "const": "Dennis40816/nvt_fw_combiner" },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "headRepositoryId": { "type": "integer", "minimum": 1 },
        "workflowPath": { "const": ".github/workflows/release.yml" },
        "workflowRef": { "const": "refs/heads/main" },
        "workflowCommitSha": { "$ref": "#/$defs/gitSha" },
        "workflowBlobSha": { "$ref": "#/$defs/gitSha" },
        "workflowRawSha256": { "$ref": "#/$defs/sha256" },
        "workflowSemanticContractSha256": { "const": "eb0e20dc82bb466d938dbf426afa25cd0c93a63082f15c9bc4632b764b882e3b" },
        "workflowRun": { "$ref": "#/$defs/protectedWorkflowRun" },
        "attestationJob": { "$ref": "#/$defs/protectedJob" },
        "deployment": { "$ref": "#/$defs/protectedDeployment" },
        "deploymentStatus": { "$ref": "#/$defs/protectedDeploymentStatus" },
        "comparisonArtifact": { "$ref": "#/$defs/remoteArtifact" },
        "attestationArtifact": { "$ref": "#/$defs/remoteArtifact" },
        "verificationArtifact": { "$ref": "#/$defs/remoteArtifact" }
      }
    },
    "protectedWorkflowRun": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "runAttempt", "headSha", "headBranch", "event", "status", "conclusion", "repositoryId", "headRepositoryId", "createdAtUtc", "updatedAtUtc"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" }, "headBranch": { "const": "main" },
        "event": { "enum": ["workflow_dispatch", "push"] }, "status": { "enum": ["in_progress", "completed"] }, "conclusion": { "type": ["string", "null"], "enum": [null, "success"] },
        "repositoryId": { "type": "integer", "minimum": 1 }, "headRepositoryId": { "type": "integer", "minimum": 1 },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" }, "updatedAtUtc": { "$ref": "#/$defs/canonicalUtc" }
      }
    },
    "protectedJob": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "runId", "runAttempt", "headSha", "headBranch", "name", "status", "conclusion", "startedAtUtc", "completedAtUtc", "htmlUrl"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/gitSha" }, "headBranch": { "const": "main" },
        "name": { "const": "release / v0.9.16 parity attestation" }, "status": { "const": "completed" }, "conclusion": { "const": "success" },
        "startedAtUtc": { "$ref": "#/$defs/canonicalUtc" }, "completedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "htmlUrl": { "type": "string", "pattern": "^https://github\\.com/Dennis40816/nvt_fw_combiner/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*$" }
      }
    },
    "protectedDeployment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha", "ref", "environment", "createdAtUtc"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "sha": { "$ref": "#/$defs/gitSha" },
        "ref": { "const": "main" }, "environment": { "const": "firmware-parity" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" }
      }
    },
    "protectedDeploymentStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "state", "createdAtUtc", "updatedAtUtc", "logUrl"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "state": { "const": "success" },
        "createdAtUtc": { "$ref": "#/$defs/canonicalUtc" }, "updatedAtUtc": { "$ref": "#/$defs/canonicalUtc" },
        "logUrl": { "type": "string", "pattern": "^https://github\\.com/Dennis40816/nvt_fw_combiner/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*$" }
      }
    },
    "localArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/filePath" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
