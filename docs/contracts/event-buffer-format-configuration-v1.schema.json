{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nfc/schemas/event-buffer-format-configuration-v1.schema.json",
  "title": "Event Buffer Format configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopeId", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "entries": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["uniqueId", "recognitionValues"],
        "properties": {
          "uniqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "aliasName": { "type": ["string", "null"], "maxLength": 256 },
          "recognitionValues": {
            "type": "array", "maxItems": 256,
            "items": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{2}$", "minLength": 4, "maxLength": 4 }
          }
        }
      }
    }
  }
}
