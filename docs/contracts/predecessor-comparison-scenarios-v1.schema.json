{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvt.local/contracts/predecessor-comparison-scenarios-v1.schema.json",
  "title": "NVT FW Combiner predecessor comparison coverage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "scenarios", "debtSet", "acceptedGaps", "pendingAcceptedGaps", "retiredScenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "predecessor-comparison-coverage-ledger" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "debtSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "decisions", "routeIds"],
      "properties": {
        "source": { "const": "docs/contracts/v0916-parity-certification-v1.json#canonicalInputAuthority.currentlyMissingRouteIds" },
        "decisions": { "const": ["1.1.12 board decision 12", "1.1.12 board decision 47", "1.1.12 board decision 60"] },
        "routeIds": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/routeId" }
        }
      }
    },
    "acceptedGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/acceptedGap" }
    },
    "pendingAcceptedGaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "status", "routeIds"],
      "properties": {
        "decision": { "const": "1.1.12 board decision 60" },
        "status": { "enum": ["awaiting-owner-approval"] },
        "routeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/routeId" }
        }
      }
    },
    "retiredScenarios": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/retiredScenario" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "routeId": { "type": "string", "pattern": "^route-[a-z0-9-]+$" },
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "entryId": { "type": "string", "pattern": "^RP-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-[0-9]{2,}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boardDecision", "role", "date"],
      "properties": {
        "boardDecision": { "type": "string", "minLength": 1 },
        "role": { "const": "firmware-owner" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "origin",
        "icId",
        "workflowId",
        "icCountVariant",
        "mapVariant",
        "routeId",
        "binding",
        "evidenceCaseId",
        "inputCaseId",
        "planRouteId",
        "inputRevision",
        "cli",
        "ctrlRamBase",
        "inputs"
      ],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^NT[0-9]{5}:(standard-merge|ab-merge|ctrlram-replace):[a-z0-9-]+:[a-z0-9-]+:[a-z0-9][a-z0-9-]*$" },
        "origin": { "type": "string", "minLength": 1 },
        "icId": { "type": "string", "pattern": "^NT[0-9]{5}$" },
        "workflowId": { "enum": ["ab-merge", "ctrlram-replace", "standard-merge"] },
        "icCountVariant": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "mapVariant": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "routeId": { "$ref": "#/$defs/routeId" },
        "binding": { "enum": ["case", "route-evidence"] },
        "evidenceCaseId": { "$ref": "#/$defs/caseId" },
        "inputCaseId": { "$ref": "#/$defs/caseId" },
        "planRouteId": { "type": ["string", "null"], "pattern": "^route-[a-z0-9-]+$" },
        "inputRevision": { "type": "integer", "minimum": 1 },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "selectionOption", "selectionToken"],
          "properties": {
            "profile": { "type": "string", "pattern": "^NT[0-9]{5}$" },
            "selectionOption": { "enum": ["--ab-topology", "--ic-num", null] },
            "selectionToken": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
          }
        },
        "ctrlRamBase": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["standard-merge", "tp-input"] },
            "standardMergeMapVariant": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "slotId", "artifactId", "size", "sha256"],
            "properties": {
              "order": { "type": "integer", "minimum": 0 },
              "slotId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "artifactId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "acceptedGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "approvedInVersion", "reason", "approval", "declarationEntryId"],
      "properties": {
        "routeId": { "$ref": "#/$defs/routeId" },
        "approvedInVersion": { "$ref": "#/$defs/version" },
        "reason": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/approval" },
        "declarationEntryId": { "$ref": "#/$defs/entryId" }
      }
    },
    "retiredScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "retiredInVersion", "reason", "approval", "declarationEntryId"],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "retiredInVersion": { "$ref": "#/$defs/version" },
        "reason": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/approval" },
        "declarationEntryId": { "$ref": "#/$defs/entryId" }
      }
    }
  }
}
