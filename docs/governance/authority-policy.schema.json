{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dennis40816/nvt_fw_combiner/docs/governance/authority-policy.schema.json",
  "title": "NFC authority policy v1",
  "description": "ADR 0080 item 4: the path map with risk floors and authority roles, the role principals and the review-record principals. scripts/authority_check.py interprets exactly the keywords used here and rejects any other.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adr", "roles", "reviewers", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "adr": {"const": "docs/adr/0080-governance-reset.md"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governance-owner", "firmware-owner", "release-owner"],
      "properties": {
        "governance-owner": {"$ref": "#/$defs/principals"},
        "firmware-owner": {"$ref": "#/$defs/principals"},
        "release-owner": {"$ref": "#/$defs/principals"}
      }
    },
    "reviewers": {"$ref": "#/$defs/principals"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "id"],
      "properties": {
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:\\[bot\\])?$"
        },
        "id": {"type": "integer", "minimum": 1}
      }
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/principal"}
    },
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "role": {"enum": ["governance-owner", "firmware-owner", "release-owner"]},
    "pattern": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._*?-]+(?:/[A-Za-z0-9._*?-]+)*$"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pattern"}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "floor", "roles", "patterns"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "description": {"type": "string", "minLength": 1},
        "floor": {"$ref": "#/$defs/risk"},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "patterns": {"$ref": "#/$defs/patterns"},
        "default": {"type": "boolean"},
        "excludes": {"$ref": "#/$defs/patterns"}
      }
    }
  }
}
