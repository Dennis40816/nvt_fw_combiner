<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>urn:msp-fw3:nvt-fw-combiner:source</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>MSP/FW3</Authors>
    <Company>Novatek</Company>
    <Product>NVT FW Combiner</Product>
    <RepositoryVersionFile>$(MSBuildThisFileDirectory)VERSION</RepositoryVersionFile>
    <ProductVersion>$([System.IO.File]::ReadAllText('$(RepositoryVersionFile)').Trim())</ProductVersion>
    <InternalProjectVersion>1.0.0</InternalProjectVersion>
    <VersionPrefix>$(InternalProjectVersion)</VersionPrefix>
    <Version>$(InternalProjectVersion)</Version>
    <PackageVersion>$(InternalProjectVersion)</PackageVersion>
    <VersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(ProductVersion)', '^([0-9]+)\.([0-9]+)\.([0-9]+).*$','$1.$2.$3'))</VersionCore>
    <AssemblyVersion>$(VersionCore).0</AssemblyVersion>
    <FileVersion>$(VersionCore).0</FileVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © 2026 MSP/FW3</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!--
    Locked restore. The committed lock files of exactly these projects carry a net10.0/win-x64 target,
    because the packaging restores use -r win-x64. NuGet sets ExcludeRestorePackageImports only while it
    evaluates projects for restore, so this runtime reaches restore and never build or publish. A plain
    solution restore then matches the lock files in locked mode, and library projects stay RID-agnostic.
    Keep this list equal to the lock files that carry the target.
  -->
  <PropertyGroup Condition="'$(ExcludeRestorePackageImports)' == 'true' and (
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Application' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Bootstrap' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Cli' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Contracts' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.DistributionLauncher' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Domain' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Infrastructure' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Launcher' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.LauncherBootstrap' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Platform' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.PrebuiltProfileCatalogGenerator' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.Profiles' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.ReadyProbe' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.VersionManagement.Application' or
      '$(MSBuildProjectName)' == 'NvtFwCombiner.VersionManagement.Infrastructure')">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- Test processes must never resolve the developer's real local-state folder; see CompositionHostServices. -->
    <RuntimeHostConfigurationOption Include="NvtFwCombiner.LocalState.CurrentUserFolderForbidden" Value="true" />
  </ItemGroup>
</Project>
